def source_of(c):

    if c.startswith(
        "IMS__"
    ):

        return "IMS"


    if c.startswith(
        "RAW__"
    ):

        return "RAW_CCDR"


    return "GMLC"


def role_of(c):

    u = c.upper()


    if (

        c in DEVICE_CONTEXT

        or

        "USER_AGENT"
        in u
    ):

        return (
            "DEVICE_CONTEXT"
        )


    if c in NETWORK_NODE_CONTEXT:

        return (
            "NETWORK_NODE_CONTEXT"
        )


    if (

        "PRESENT" in u

        or

        "HEADER" in u

        or

        "PIDF" in u
    ):

        return (
            "SIGNALING_INPUT_PRESENCE"
        )


    if (

        "RESULT" in u

        or

        "ALLOCATE_" in u

        or

        "P2_" in u
    ):

        return (
            "LOCATION_PROCEDURE_RESULT"
        )


    if (

        "UNCERT" in u

        or

        "CONFIDENCE" in u

        or

        "LOCATE" in u

        or

        "ESPOSREQ" in u
    ):

        return (
            "LOCATION_ACQUISITION"
        )


    return (
        "OTHER_PRE_ROUTE_CONTEXT"
    )


