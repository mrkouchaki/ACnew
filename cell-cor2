def present_flag(series):

    s = (

        series
        .astype("string")
        .fillna("")
        .str.strip()
    )

    return (
        s.ne("")
        .astype("int8")
    )


def result_family(series):

    s = (

        series
        .astype("string")
        .fillna("")
        .str.upper()
    )

    return pd.Series(

        np.select(

            [

                s.str.contains(
                    r"POSITIONING[_ ]?FAILED|\b4225\b",
                    regex=True,
                ),

                s.str.contains(
                    r"TIMEOUT|TIMED[_ ]?OUT",
                    regex=True,
                ),

                s.str.contains(
                    r"SUCCESS|\b2001\b",
                    regex=True,
                ),

                s.str.contains(
                    r"ERROR|FAIL|UNABLE|REJECT",
                    regex=True,
                ),
            ],

            [

                "POSITIONING_FAILED",

                "TIMEOUT",

                "SUCCESS",

                "OTHER_ERROR",
            ],

            default="OTHER_OR_MISSING",
        ),

        index=series.index,

        dtype="string",
    )


def result_code_token(series):

    s = (

        series
        .astype("string")
        .fillna("")
    )

    code = s.str.extract(

        r"\((\d{3,5})\)",

        expand=False,
    )

    return (

        code
        .fillna("<NO_CODE>")
        .astype("string")
    )


def user_agent_family(series):

    s = (

        series
        .astype("string")
        .fillna("")
        .str.upper()
    )

    return pd.Series(

        np.select(

            [

                s.str.contains(
                    r"IPHONE|IOS|APPLE",
                    regex=True,
                ),

                s.str.contains(
                    r"SAMSUNG|SM-",
                    regex=True,
                ),

                s.str.contains(
                    r"MOTOROLA|MOTO",
                    regex=True,
                ),

                s.str.contains(
                    r"ALCATEL",
                    regex=True,
                ),

                s.str.contains(
                    r"ANDROID",
                    regex=True,
                ),
            ],

            [

                "APPLE_IOS",

                "SAMSUNG",

                "MOTOROLA",

                "ALCATEL",

                "ANDROID_OTHER",
            ],

            default="OTHER_OR_MISSING",
        ),

        index=series.index,

        dtype="string",
    )


