# ---------------------------------------------------------------------
# Explain exactly why a row failed verification.
# ---------------------------------------------------------------------

def verification_reason(
    row
):

    reasons = []


    if not row.CID_EXACT_MATCH:

        reasons.append(
            "CID_NOT_FOUND"
        )


    if (
        row.CID_EXACT_MATCH

        and

        not row.CID_UNIQUE_DATABASE_MATCH
    ):

        reasons.append(
            "CID_NOT_UNIQUE"
        )


    if (

        row.RECALC_ROUTE_INTEGRITY_STATUS

        != "DEFINITE_MISROUTE"
    ):

        reasons.append(

            "FRESH_GEOMETRY_NOT_DEFINITE_MISROUTE"
        )


    if not bool(
        row.RECALC_OVER_25KM
    ):

        reasons.append(
            "FRESH_DISTANCE_NOT_OVER_25KM"
        )


    if not bool(
        row.EXPECTED_PSAP_DB_VS_RECALC_MATCH
    ):

        reasons.append(
            "EXPECTED_PSAP_CHANGED"
        )


    if not bool(
        row.POINT_PSAP_VS_RECALC_EXPECTED_MATCH
    ):

        reasons.append(
            "POINT_PSAP_DISAGREES"
        )


    if not bool(
        row.ROUTED_DISTANCE_DB_VS_RECALC_MATCH
    ):

        reasons.append(
            "ROUTED_DISTANCE_CHANGED"
        )


    if not bool(
        row.EXPECTED_DISTANCE_DB_VS_RECALC_MATCH
    ):

        reasons.append(
            "EXPECTED_DISTANCE_CHANGED"
        )


    return (

        "VERIFIED"

        if not reasons

        else "|".join(
            reasons
        )
    )


verify[
    "VERIFICATION_REASON"
] = verify.apply(

