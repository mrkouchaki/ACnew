# ---------------------------------------------------------------------
# 13. CALL DURATION DOUBLE-CHECK
#
# DB_CALL_DURATION_SEC is the source value.
# TIMESTAMP_DURATION_SEC is independently calculated:
#
#       CALL_END_TIME_UTC - CALL_BEGIN_TIME_UTC
# ---------------------------------------------------------------------

def parse_call_timestamp(
    series
):

    s = (

        series
        .astype("string")
        .fillna("")
        .str.strip()
    )


    # Oracle exports may appear like:
    # 31-AUG-23 11.58.06.388762000 PM UTC
    #
    # Convert hh.mm.ss -> hh:mm:ss while leaving fractional seconds.

    s = s.str.replace(

        r"(\s\d{1,2})\.(\d{2})\.(\d{2})(\.\d+)?",

        lambda m:
            f"{m.group(1)}:"
            f"{m.group(2)}:"
            f"{m.group(3)}"
            f"{m.group(4) or ''}",

        regex=True
    )


    return pd.to_datetime(

        s,

        errors="coerce",

        utc=True
    )


begin_ts = parse_call_timestamp(

    verify[
        "DB_CALL_BEGIN_TIME_UTC"
    ]
)


end_ts = parse_call_timestamp(

    verify[
        "DB_CALL_END_TIME_UTC"
    ]
)


verify[
    "TIMESTAMP_DURATION_SEC"
] = (

    end_ts
    -
    begin_ts

).dt.total_seconds()


# Negative calculated durations are invalid.
verify.loc[

    verify[
        "TIMESTAMP_DURATION_SEC"
    ] < 0,

    "TIMESTAMP_DURATION_SEC"

] = np.nan


