    WITH counts AS (

        SELECT

            FCC_PSAP_ID,

            PSAP_NAME,

            COUNT(*) AS N

        FROM psap_routing_call_handoff_v5

        WHERE

            FCC_PSAP_ID IS NOT NULL

            AND TRIM(
                CAST(FCC_PSAP_ID AS TEXT)
            ) <> ''

            AND PSAP_NAME IS NOT NULL

            AND TRIM(PSAP_NAME) <> ''

        GROUP BY

            FCC_PSAP_ID,

            PSAP_NAME
    ),

    ranked AS (

        SELECT

            *,

            ROW_NUMBER() OVER (

                PARTITION BY FCC_PSAP_ID

                ORDER BY
                    N DESC,
                    PSAP_NAME

            ) AS RN

        FROM counts
    )

    SELECT
        FCC_PSAP_ID,
        PSAP_NAME

    FROM ranked

    WHERE RN = 1

    """,

    check_con
)


