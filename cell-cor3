# ---------------------------------------------------------------------
# 7. INDEPENDENT POINT-ONLY PSAP SANITY CHECK
#
# This is separate from the uncertainty-area label.
#
# It asks:
#   "Which PSAP polygon contains the reported LAT/LON point?"
#
# For a strong definite misroute, the unique point PSAP should normally
# be the same PSAP found by the full uncertainty-area calculation.
# ---------------------------------------------------------------------

def point_psap_check(
    lat_value,
    lon_value
):

    lat = pd.to_numeric(
        lat_value,
        errors="coerce"
    )

    lon = pd.to_numeric(
        lon_value,
        errors="coerce"
    )


    if (
        pd.isna(lat)
        or pd.isna(lon)
    ):

        return (
            "MISSING_LOCATION",
            None,
            None,
            0
        )


    lat = float(lat)

    lon = float(lon)


    if not (
        -90 <= lat <= 90
        and
        -180 <= lon <= 180
    ):

        return (
            "INVALID_LOCATION",
            None,
            None,
            0
        )


    point = Point(
        lon,
        lat
    )


    inside = sorted(
        set(

            boundary_fcc[pos]

            for pos in candidate_positions(
                point
            )

            if boundary_geometries[
                pos
            ].covers(
                point
            )
        )
    )


    if len(inside) == 1:

        return (

            "UNIQUE_POINT_PSAP",

            inside[0],

            psap_name_map.get(
                inside[0]
            ),

            1
        )


    if len(inside) == 0:

        return (

            "NO_POINT_PSAP",

            None,

            None,

            0
        )


    return (

        "MULTIPLE_POINT_PSAP",

        "|".join(
            inside
        ),

        None,

        len(inside)
    )


