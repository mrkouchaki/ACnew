    "DB_CALL_DURATION_SEC"
] = pd.to_numeric(

    verify[
        "DB_CALL_DURATION_SEC"
    ],

    errors="coerce"
)


verify[
    "CALL_DURATION_ABS_DIFF_SEC"
] = (

    verify[
        "DB_CALL_DURATION_SEC"
    ]

    -

    verify[
        "TIMESTAMP_DURATION_SEC"
    ]

).abs()


both_duration = (

    verify[
        "DB_CALL_DURATION_SEC"
    ].notna()

    &

    verify[
        "TIMESTAMP_DURATION_SEC"
    ].notna()
)


verify[
    "CALL_DURATION_CHECK"
] = np.select(

    [

        both_duration

        &

        (
            verify[
                "CALL_DURATION_ABS_DIFF_SEC"
            ]

            <= DURATION_TOLERANCE_SEC
        ),

        both_duration

        &

        (
            verify[
                "CALL_DURATION_ABS_DIFF_SEC"
            ]

            > DURATION_TOLERANCE_SEC
        ),

        verify[
            "DB_CALL_DURATION_SEC"
        ].notna(),

        verify[
            "TIMESTAMP_DURATION_SEC"
        ].notna(),
    ],

    [

        "MATCH",

        "DIFFERENT",

        "ONLY_DATABASE_DURATION",

        "ONLY_TIMESTAMP_DURATION",
    ],

    default=
        "NO_DURATION_AVAILABLE"
)


# Effective review duration:
# Prefer explicit GMLC call duration, fall back to timestamps.

verify[
    "CALL_DURATION_EFFECTIVE_SEC"
] = (

    verify[
        "DB_CALL_DURATION_SEC"
    ]

    .where(

        verify[
            "DB_CALL_DURATION_SEC"
        ]

        .ge(0),

        verify[
            "TIMESTAMP_DURATION_SEC"
        ]
    )
)


verify[
    "IS_ZERO_DURATION"
] = (

    verify[
        "CALL_DURATION_EFFECTIVE_SEC"
    ]

    .eq(0)
)


verify[
    "IS_LONG_DURATION"
] = (

    verify[
        "CALL_DURATION_EFFECTIVE_SEC"
    ]

    >= LONG_CALL_MIN_SEC
)


# ---------------------------------------------------------------------
# 14. CONFIRM IMS / RAW CCDR ATTACHMENT
