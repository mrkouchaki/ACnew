if b.crs is None:
    raise RuntimeError("Final_Join.tab has no CRS.")
if b.crs.to_epsg() != 4326:
    b = b.to_crs(4326)

B_NENA = find_col(b.columns, ["NENA_ID"], True)
B_FCC = find_col(b.columns, ["FCC_ID", "FCC_PSAP_ID"], True)
B_AGENCY = find_col(b.columns, ["AGENCY", "AGENCY_NAME"])
B_PSAP_NAME = find_col(b.columns, ["PSAP_NAME"])
B_PSAP_ESRK = find_col(b.columns, ["PSAP_NAME_ESRK"])

b["_NENA_RAW"] = b[B_NENA].map(raw_id)
b["_NENA"] = b[B_NENA].map(canon_id)
b["_FCC"] = b[B_FCC].map(canon_id)

b["_AGENCY"] = b[B_AGENCY].fillna("").astype(str).str.strip() if B_AGENCY else ""
b["_PSAP_NAME"] = b[B_PSAP_NAME].fillna("").astype(str).str.strip() if B_PSAP_NAME else ""
b["_PSAP_ESRK"] = b[B_PSAP_ESRK].fillna("").astype(str).str.strip() if B_PSAP_ESRK else ""

b["geometry"] = b.geometry.apply(repair_geom)
b = b.loc[b["_NENA"].ne("") & b.geometry.notna()].copy()

# Dissolve -> one polygon identity per canonical NENA ID.
bg = b[["_NENA", "geometry"]].dissolve(by="_NENA", as_index=False)
bg["geometry"] = bg.geometry.apply(repair_geom)
bg = bg.loc[bg.geometry.notna()].copy()

# Approximate map point: guaranteed inside polygon.
rep = bg.geometry.representative_point()
bg["_CENTER_LAT"] = rep.y
bg["_CENTER_LON"] = rep.x

boundary_by_nena = dict(zip(bg["_NENA"], bg.geometry))
center_by_nena = dict(zip(bg["_NENA"], zip(bg["_CENTER_LAT"], bg["_CENTER_LON"])))

# Metadata by NENA.
meta = (
    b.groupby("_NENA", as_index=False)
     .agg(
         NENA_ID_BOUNDARY=("_NENA_RAW", uniq_join),
         FCC_ID_BOUNDARY=("_FCC", uniq_join),
         AGENCY_BOUNDARY=("_AGENCY", uniq_join),
         PSAP_NAME_BOUNDARY=("_PSAP_NAME", uniq_join),
         PSAP_NAME_ESRK_BOUNDARY=("_PSAP_ESRK", uniq_join),
     )
)

meta["PSAP_CENTER_LAT"] = meta["_NENA"].map(
    lambda x: center_by_nena.get(x, (np.nan, np.nan))[0]
)
meta["PSAP_CENTER_LON"] = meta["_NENA"].map(
    lambda x: center_by_nena.get(x, (np.nan, np.nan))[1]
)

meta_by_nena = meta.set_index("_NENA").to_dict("index")

# FCC -> NENA index.
fcc_to_nena = defaultdict(set)
for nena, fcc in b[["_NENA", "_FCC"]].drop_duplicates().itertuples(index=False, name=None):
    if fcc:
        fcc_to_nena[fcc].add(nena)

print("Usable boundary PSAPs:", f"{len(boundary_by_nena):,}")


# =====================================================================
# 3. ROUTED PSAP RESOLUTION
# =====================================================================

route_cache = {}

def resolve_routed(psap_value, fcc_value):
    psap = canon_id(psap_value)
    fcc = canon_id(fcc_value)
    key = (psap, fcc)

    if key in route_cache:
        return route_cache[key]

    chosen = ""
    status = "UNRESOLVED"

    # Primary identity: GMLC PSAP_ID -> Boundary NENA_ID
    if psap and psap in boundary_by_nena:
        boundary_fccs = {canon_id(x) for x in txt(meta_by_nena[psap]["FCC_ID_BOUNDARY"]).split(" | ") if x}

        if fcc and fcc in boundary_fccs:
            chosen, status = psap, "CONFIRMED_PSAP_AND_FCC"
        elif not fcc:
            chosen, status = psap, "PSAP_MATCH_NO_GMLC_FCC"
        elif not boundary_fccs:
            chosen, status = psap, "PSAP_MATCH_NO_BOUNDARY_FCC"
        else:
            status = "PSAP_FCC_CONFLICT"

    elif ALLOW_FCC_ONLY_FALLBACK and len(fcc_to_nena.get(fcc, set())) == 1:
        chosen = next(iter(fcc_to_nena[fcc]))
        status = "FCC_UNIQUE_FALLBACK"
    elif len(fcc_to_nena.get(fcc, set())) > 1:
        status = "PSAP_NOT_FOUND_FCC_AMBIGUOUS"
    else:
        status = "PSAP_NOT_FOUND"

    m = meta_by_nena.get(chosen, {}) if chosen else {}

    result = {
        "ROUTED_NENA_CANON": chosen,
        "ROUTED_NENA_ID_BOUNDARY": m.get("NENA_ID_BOUNDARY", ""),
        "ROUTED_FCC_ID_BOUNDARY": m.get("FCC_ID_BOUNDARY", ""),
        "ROUTED_AGENCY_BOUNDARY": m.get("AGENCY_BOUNDARY", ""),
        "ROUTED_PSAP_NAME_BOUNDARY": m.get("PSAP_NAME_BOUNDARY", ""),
        "ROUTED_PSAP_NAME_ESRK_BOUNDARY": m.get("PSAP_NAME_ESRK_BOUNDARY", ""),
        "ROUTED_PSAP_CENTER_LAT": m.get("PSAP_CENTER_LAT", np.nan),
        "ROUTED_PSAP_CENTER_LON": m.get("PSAP_CENTER_LON", np.nan),
        "ROUTED_ID_STATUS": status,
    }
    route_cache[key] = result
    return result


# =====================================================================
# 4. EXPECTED PSAP FROM A LOCATION
# =====================================================================

def assign_expected(frame, prefix, lat_col, lon_col):
    frame = frame.reset_index(drop=True)
    lat = numeric_series(frame[lat_col])
    lon = numeric_series(frame[lon_col])
    valid = valid_xy(lat, lon)

    result_cols = {
        f"{prefix}_EXPECTED_NENA_CANON": "",
        f"{prefix}_EXPECTED_NENA_ID_BOUNDARY": "",
        f"{prefix}_EXPECTED_FCC_ID_BOUNDARY": "",
        f"{prefix}_EXPECTED_AGENCY_BOUNDARY": "",
        f"{prefix}_EXPECTED_PSAP_NAME_BOUNDARY": "",
        f"{prefix}_EXPECTED_PSAP_NAME_ESRK_BOUNDARY": "",
        f"{prefix}_EXPECTED_PSAP_CENTER_LAT": np.nan,
        f"{prefix}_EXPECTED_PSAP_CENTER_LON": np.nan,
        f"{prefix}_EXPECTED_SPATIAL_STATUS": "INVALID_OR_MISSING",
    }
    for c, default in result_cols.items():
        frame[c] = default

    if not valid.any():
        return frame

    pts = pd.DataFrame({
        "_ROW": np.flatnonzero(valid.to_numpy()),
        "_LAT": lat[valid].to_numpy(float),
        "_LON": lon[valid].to_numpy(float),
    })

    # Deduplicate coordinate work.
    unique = pts[["_LAT", "_LON"]].drop_duplicates().reset_index(drop=True)
    unique["_PID"] = np.arange(len(unique))

    pg = gpd.GeoDataFrame(
        unique,
        geometry=gpd.points_from_xy(unique["_LON"], unique["_LAT"]),
        crs="EPSG:4326"
    )

    joined = gpd.sjoin(
        pg,
        bg[["_NENA", "geometry"]],
        how="left",
        predicate="intersects"
    )

    lookup = {}
    for pid, group in joined.groupby("_PID", sort=False):
        ids = sorted({txt(x) for x in group["_NENA"] if txt(x)})
        key = (float(unique.at[int(pid), "_LAT"]), float(unique.at[int(pid), "_LON"]))

        if len(ids) == 1:
            nena = ids[0]
            m = meta_by_nena.get(nena, {})
            lookup[key] = (
                nena, m.get("NENA_ID_BOUNDARY", ""), m.get("FCC_ID_BOUNDARY", ""),
                m.get("AGENCY_BOUNDARY", ""), m.get("PSAP_NAME_BOUNDARY", ""),
                m.get("PSAP_NAME_ESRK_BOUNDARY", ""), m.get("PSAP_CENTER_LAT", np.nan),
                m.get("PSAP_CENTER_LON", np.nan), "UNIQUE_PSAP"
            )
        elif len(ids) == 0:
            lookup[key] = ("", "", "", "", "", "", np.nan, np.nan, "NO_CONTAINING_PSAP")
        else:
            lookup[key] = ("|".join(ids), "", "", "", "", "", np.nan, np.nan, "MULTIPLE_PSAP")

    for pos in np.flatnonzero(valid.to_numpy()):
        r = lookup.get((float(lat.iloc[pos]), float(lon.iloc[pos])))
        if r is None:
            continue
        (
            frame.at[pos, f"{prefix}_EXPECTED_NENA_CANON"],
            frame.at[pos, f"{prefix}_EXPECTED_NENA_ID_BOUNDARY"],
            frame.at[pos, f"{prefix}_EXPECTED_FCC_ID_BOUNDARY"],
            frame.at[pos, f"{prefix}_EXPECTED_AGENCY_BOUNDARY"],
            frame.at[pos, f"{prefix}_EXPECTED_PSAP_NAME_BOUNDARY"],
            frame.at[pos, f"{prefix}_EXPECTED_PSAP_NAME_ESRK_BOUNDARY"],
            frame.at[pos, f"{prefix}_EXPECTED_PSAP_CENTER_LAT"],
            frame.at[pos, f"{prefix}_EXPECTED_PSAP_CENTER_LON"],
            frame.at[pos, f"{prefix}_EXPECTED_SPATIAL_STATUS"],
        ) = r

    return frame


# =====================================================================
# 5. DISTANCE TO PSAP BOUNDARY
# =====================================================================

HAS_VECTOR_SHAPELY = all(
    hasattr(shapely, x)
    for x in ["points", "shortest_line", "get_point", "get_x", "get_y", "covers"]
)

def add_boundary_distance(frame, prefix, lat_col, lon_col, id_col, target="ROUTED"):
    frame = frame.reset_index(drop=True)
    lat = numeric_series(frame[lat_col]).to_numpy(float)
    lon = numeric_series(frame[lon_col]).to_numpy(float)
    ids = frame[id_col].fillna("").astype(str).to_numpy()

    dist = np.full(len(frame), np.nan)
    relation = np.full(len(frame), "INVALID_OR_MISSING", dtype=object)

    valid = (
        np.isfinite(lat) & np.isfinite(lon) &
        (lat >= -90) & (lat <= 90) &
        (lon >= -180) & (lon <= 180) &
        ~(np.isclose(lat, 0) & np.isclose(lon, 0))
    )
    relation[valid] = "UNRESOLVED_BOUNDARY"

    for nena in pd.unique(ids[valid & (ids != "")]):
        if "|" in nena:
            continue

        geom = boundary_by_nena.get(canon_id(nena))
        if geom is None:
            continue

        idx = np.flatnonzero(valid & (ids == nena))
        if not len(idx):
            continue

        if HAS_VECTOR_SHAPELY:
            points = shapely.points(lon[idx], lat[idx])
            lines = shapely.shortest_line(points, geom.boundary)
            near = shapely.get_point(lines, 1)
            nlon = np.asarray(shapely.get_x(near), dtype=float)
            nlat = np.asarray(shapely.get_y(near), dtype=float)
            _, _, meters = GEOD.inv(lon[idx], lat[idx], nlon, nlat)
            meters = np.abs(np.asarray(meters, float))
            inside = np.asarray(shapely.covers(geom, points), dtype=bool)

            dist[idx] = meters
            relation[idx] = np.where(
                meters <= 0.01, "BOUNDARY",
                np.where(inside, "INSIDE", "OUTSIDE")
            )
        else:
            for p in idx:
                point = Point(lon[p], lat[p])
                try:
                    _, near = nearest_points(point, geom.boundary)
                    _, _, meters = GEOD.inv(lon[p], lat[p], near.x, near.y)
                    meters = abs(float(meters))
                    dist[p] = meters
                    relation[p] = (
                        "BOUNDARY" if meters <= 0.01
                        else "INSIDE" if geom.covers(point)
                        else "OUTSIDE"
                    )
                except Exception:
                    relation[p] = "DISTANCE_ERROR"

    frame[f"{prefix}_TO_{target}_BOUNDARY_M"] = dist
    frame[f"{prefix}_{target}_RELATION"] = relation
    return frame


# =====================================================================
# 6. DISTANCE BETWEEN LOCATION SOURCES
# =====================================================================

def geod_distance(lat1, lon1, lat2, lon2):
    a = numeric_series(lat1).to_numpy(float)
    b = numeric_series(lon1).to_numpy(float)
    c = numeric_series(lat2).to_numpy(float)
    d = numeric_series(lon2).to_numpy(float)

    valid = (
        np.isfinite(a) & np.isfinite(b) &
        np.isfinite(c) & np.isfinite(d) &
        (a >= -90) & (a <= 90) & (c >= -90) & (c <= 90) &
        (b >= -180) & (b <= 180) & (d >= -180) & (d <= 180)
    )

    out = np.full(len(a), np.nan)
    if valid.any():
        _, _, meters = GEOD.inv(b[valid], a[valid], d[valid], c[valid])
        out[valid] = np.abs(np.asarray(meters, float))
    return out


# =====================================================================
# 7. ID-ONLY EXPECTED VS ROUTED STATUS
# =====================================================================

def add_identity_status(frame, prefix):
    rn = frame["ROUTED_NENA_CANON"].fillna("").astype(str).map(canon_id)
    rf = frame["ROUTED_FCC_ID_BOUNDARY"].fillna("").astype(str).map(canon_id)
    en = frame[f"{prefix}_EXPECTED_NENA_CANON"].fillna("").astype(str)
    ef = frame[f"{prefix}_EXPECTED_FCC_ID_BOUNDARY"].fillna("").astype(str).map(canon_id)

    en = en.map(lambda x: canon_id(x) if "|" not in x else "")

    frame[f"{prefix}_NENA_VS_ROUTED"] = np.where(
        rn.ne("") & en.ne(""), np.where(rn == en, "SAME", "DIFFERENT"), "UNRESOLVED"
    )
    frame[f"{prefix}_FCC_VS_ROUTED"] = np.where(
        rf.ne("") & ef.ne(""), np.where(rf == ef, "SAME", "DIFFERENT"), "UNRESOLVED"
    )

    frame[f"{prefix}_EXPECTED_VS_ROUTED"] = np.where(
        (frame[f"{prefix}_NENA_VS_ROUTED"] == "SAME") &
        (frame[f"{prefix}_FCC_VS_ROUTED"] == "SAME"),
        "SAME",
        np.where(
            (frame[f"{prefix}_NENA_VS_ROUTED"] == "DIFFERENT") |
            (frame[f"{prefix}_FCC_VS_ROUTED"] == "DIFFERENT"),
            "DIFFERENT",
            "UNRESOLVED"
        )
    )
    return frame


# =====================================================================
# 8. FILTER HELPERS
# =====================================================================

def range_filter(frame, prefix, minimum, maximum):
    if minimum is None and maximum is None:
        return None

    d = numeric_series(frame[f"{prefix}_TO_ROUTED_BOUNDARY_M"])
    mask = d.notna() & frame[f"{prefix}_ROUTED_RELATION"].eq("OUTSIDE")

    if minimum is not None:
        mask &= d >= float(minimum)
    if maximum is not None:
        mask &= d <= float(maximum)

    return mask

def candidate_mask(frame):
    masks = [
        x for x in [
            range_filter(frame, "CALLER", MIN_CALLER_OUTSIDE_M, MAX_CALLER_OUTSIDE_M),
            range_filter(frame, "CELL", MIN_CELL_OUTSIDE_M, MAX_CELL_OUTSIDE_M),
            range_filter(frame, "ESPOSREQ", MIN_ESPOSREQ_OUTSIDE_M, MAX_ESPOSREQ_OUTSIDE_M),
        ]
        if x is not None
    ]

    if not masks:
        mask = pd.Series(True, index=frame.index)
    elif len(masks) == 1:
        mask = masks[0]
    elif FILTER_MODE.upper() == "AND":
        mask = masks[0].copy()
        for x in masks[1:]:
            mask &= x
    else:
        mask = masks[0].copy()
        for x in masks[1:]:
            mask |= x

    if "CALL_DURATION_SEC" in frame:
        dur = numeric_series(frame["CALL_DURATION_SEC"])
        if MIN_CALL_DURATION_SEC is not None:
            mask &= dur >= MIN_CALL_DURATION_SEC
        if MAX_CALL_DURATION_SEC is not None:
            mask &= dur <= MAX_CALL_DURATION_SEC

    if INCLUDE_MARKETS is not None and "MARKET" in frame:
        mask &= frame["MARKET"].fillna("").str.upper().isin({x.upper() for x in INCLUDE_MARKETS})

    if EXCLUDE_MARKETS and "MARKET" in frame:
        mask &= ~frame["MARKET"].fillna("").str.upper().isin({x.upper() for x in EXCLUDE_MARKETS})

    return mask


