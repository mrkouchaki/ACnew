        chunksize=CSV_CHUNK_ROWS, low_memory=False,
        encoding_errors="replace"
    ),
    start=1
):
    chunk.columns = [str(c).strip().upper() for c in chunk.columns]
    chunk = chunk.reset_index(drop=True)

    chunk["SOURCE_GMLC_ROW_ID"] = np.arange(
        processed + 1, processed + len(chunk) + 1, dtype=np.int64
    )
    processed += len(chunk)

    # GMLC routed identity + names.
    chunk["ROUTED_PSAP_ID_GMLC"] = chunk["PSAP_ID"].map(raw_id)
    chunk["ROUTED_FCC_PSAP_ID_GMLC"] = chunk["FCC_PSAP_ID"].map(raw_id)

    chunk["ROUTED_NAME_GMLC_ROUTE_PSAP_NAME"] = (
        chunk["ROUTE_PSAP_NAME"].fillna("").str.strip()
        if "ROUTE_PSAP_NAME" in chunk else ""
    )
    chunk["ROUTED_NAME_GMLC_PSAP_NAME"] = (
        chunk["PSAP_NAME"].fillna("").str.strip()
        if "PSAP_NAME" in chunk else ""
    )
    chunk["ROUTED_NAME_GMLC_PSAP_NAME_ESRK"] = (
        chunk["PSAP_NAME_ESRK"].fillna("").str.strip()
        if "PSAP_NAME_ESRK" in chunk else ""
    )

    rr = pd.DataFrame(
        [resolve_routed(p, f) for p, f in zip(chunk["PSAP_ID"], chunk["FCC_PSAP_ID"])],
        index=chunk.index
    )
    chunk = pd.concat([chunk, rr], axis=1)

    # Location aliases.
    chunk["CALLER_LATITUDE"] = numeric_series(chunk["LATITUDE"])
    chunk["CALLER_LONGITUDE"] = numeric_series(chunk["LONGITUDE"])
    chunk["CELL_LATITUDE_USED"] = numeric_series(chunk["CELL_LATITUDE"])
    chunk["CELL_LONGITUDE_USED"] = numeric_series(chunk["CELL_LONGITUDE"])

    chunk["ESPOSREQ_LATITUDE"] = (
        numeric_series(chunk["ESPOSREQ_LOC_LATITUDE"])
        if "ESPOSREQ_LOC_LATITUDE" in chunk else np.nan
    )
    chunk["ESPOSREQ_LONGITUDE"] = (
        numeric_series(chunk["ESPOSREQ_LOC_LONGITUDE"])
        if "ESPOSREQ_LOC_LONGITUDE" in chunk else np.nan
    )

    # Distances to ROUTED PSAP.
    for prefix, latc, lonc in [
        ("CALLER", "CALLER_LATITUDE", "CALLER_LONGITUDE"),
        ("CELL", "CELL_LATITUDE_USED", "CELL_LONGITUDE_USED"),
        ("ESPOSREQ", "ESPOSREQ_LATITUDE", "ESPOSREQ_LONGITUDE"),
    ]:
        chunk = add_boundary_distance(
            chunk, prefix, latc, lonc,
            "ROUTED_NENA_CANON", target="ROUTED"
        )

    # Between-location distances.
    chunk["CALLER_TO_CELL_M"] = geod_distance(
        chunk["CALLER_LATITUDE"], chunk["CALLER_LONGITUDE"],
        chunk["CELL_LATITUDE_USED"], chunk["CELL_LONGITUDE_USED"]
    )
    chunk["CALLER_TO_ESPOSREQ_M"] = geod_distance(
        chunk["CALLER_LATITUDE"], chunk["CALLER_LONGITUDE"],
        chunk["ESPOSREQ_LATITUDE"], chunk["ESPOSREQ_LONGITUDE"]
    )
    chunk["CELL_TO_ESPOSREQ_M"] = geod_distance(
        chunk["CELL_LATITUDE_USED"], chunk["CELL_LONGITUDE_USED"],
        chunk["ESPOSREQ_LATITUDE"], chunk["ESPOSREQ_LONGITUDE"]
    )

    # Early distance/duration filtering.
    candidate = chunk.loc[candidate_mask(chunk)].copy().reset_index(drop=True)

    if candidate.empty:
        print(f"Chunk {chunk_no:03d} | processed {processed:,} | saved {saved:,}")
        continue

    # Spatial expected PSAP for all 3 location sources.
    candidate = assign_expected(
        candidate, "CALLER", "CALLER_LATITUDE", "CALLER_LONGITUDE"
    )
    candidate = assign_expected(
        candidate, "CELL", "CELL_LATITUDE_USED", "CELL_LONGITUDE_USED"
    )
    candidate = assign_expected(
        candidate, "ESPOSREQ", "ESPOSREQ_LATITUDE", "ESPOSREQ_LONGITUDE"
    )

    # Distance to each location's expected PSAP.
    for prefix, latc, lonc in [
        ("CALLER", "CALLER_LATITUDE", "CALLER_LONGITUDE"),
        ("CELL", "CELL_LATITUDE_USED", "CELL_LONGITUDE_USED"),
        ("ESPOSREQ", "ESPOSREQ_LATITUDE", "ESPOSREQ_LONGITUDE"),
    ]:
        candidate = add_boundary_distance(
            candidate, prefix, latc, lonc,
            f"{prefix}_EXPECTED_NENA_CANON", target="EXPECTED"
        )
        candidate = add_identity_status(candidate, prefix)

    # Optional SAME/DIFFERENT filters.
    for prefix, allowed in [
        ("CALLER", INCLUDE_CALLER_STATUS),
        ("CELL", INCLUDE_CELL_STATUS),
        ("ESPOSREQ", INCLUDE_ESPOSREQ_STATUS),
    ]:
        if allowed is not None:
            candidate = candidate.loc[
                candidate[f"{prefix}_EXPECTED_VS_ROUTED"].isin(allowed)
            ].copy()

    if candidate.empty:
        continue

    # Fast abnormality columns near beginning of report.
    candidate["ABNORMAL_SOURCE_COUNT"] = (
        candidate[
            [
                "CALLER_EXPECTED_VS_ROUTED",
                "CELL_EXPECTED_VS_ROUTED",
                "ESPOSREQ_EXPECTED_VS_ROUTED",
            ]
        ]
        .eq("DIFFERENT")
        .sum(axis=1)
    )

    outside_values = pd.DataFrame(index=candidate.index)
    for prefix in ["CALLER", "CELL", "ESPOSREQ"]:
        outside_values[prefix] = np.where(
            candidate[f"{prefix}_ROUTED_RELATION"].eq("OUTSIDE"),
            numeric_series(candidate[f"{prefix}_TO_ROUTED_BOUNDARY_M"]),
            0.0
        )

    candidate["MAX_OUTSIDE_ROUTED_M"] = outside_values.max(axis=1)
    candidate["COORDINATE_PATTERN"] = (
        candidate["CALLER_EXPECTED_VS_ROUTED"] + "|" +
        candidate["CELL_EXPECTED_VS_ROUTED"] + "|" +
        candidate["ESPOSREQ_EXPECTED_VS_ROUTED"]
    )

    # Update routed-PSAP MIN/MEAN/MAX.
    for routed_id, group in candidate.groupby("ROUTED_NENA_CANON"):
        if not routed_id:
            continue
        a = stats_acc[routed_id]
        a["CALLS"] += len(group)

        for prefix in ["CALLER", "CELL", "ESPOSREQ"]:
            vals = numeric_series(group[f"{prefix}_TO_ROUTED_BOUNDARY_M"]).dropna()
            if vals.empty:
                continue
            a[f"{prefix}_N"] += len(vals)
            a[f"{prefix}_SUM"] += float(vals.sum())
            a[f"{prefix}_MIN"] = min(a[f"{prefix}_MIN"], float(vals.min()))
            a[f"{prefix}_MAX"] = max(a[f"{prefix}_MAX"], float(vals.max()))

    # -------------------------------------------------------------
    # CLEAN COLUMN ORDER
    # -------------------------------------------------------------
    first = [
        "SOURCE_GMLC_ROW_ID", "UNIQ911_CID",
        "ABNORMAL_SOURCE_COUNT", "MAX_OUTSIDE_ROUTED_M", "COORDINATE_PATTERN",
        "CALLER_EXPECTED_VS_ROUTED", "CALLER_ROUTED_RELATION", "CALLER_TO_ROUTED_BOUNDARY_M",
        "CELL_EXPECTED_VS_ROUTED", "CELL_ROUTED_RELATION", "CELL_TO_ROUTED_BOUNDARY_M",
        "ESPOSREQ_EXPECTED_VS_ROUTED", "ESPOSREQ_ROUTED_RELATION", "ESPOSREQ_TO_ROUTED_BOUNDARY_M",
        "CALLER_TO_CELL_M", "CALLER_TO_ESPOSREQ_M", "CELL_TO_ESPOSREQ_M",
        "CALL_DURATION_SEC", "CALL_BEGIN_TIME_UTC",
        "MARKET", "STATE", "COUNTY",

        # Routed identity / names / approximate PSAP location.
        "ROUTED_PSAP_ID_GMLC", "ROUTED_FCC_PSAP_ID_GMLC", "ROUTED_ID_STATUS",
        "ROUTED_NENA_ID_BOUNDARY", "ROUTED_FCC_ID_BOUNDARY",
        "ROUTED_NAME_GMLC_ROUTE_PSAP_NAME", "ROUTED_NAME_GMLC_PSAP_NAME",
        "ROUTED_NAME_GMLC_PSAP_NAME_ESRK",
        "ROUTED_AGENCY_BOUNDARY", "ROUTED_PSAP_NAME_BOUNDARY",
        "ROUTED_PSAP_NAME_ESRK_BOUNDARY",
        "ROUTED_PSAP_CENTER_LAT", "ROUTED_PSAP_CENTER_LON",

        # Caller expected.
        "CALLER_LATITUDE", "CALLER_LONGITUDE",
        "CALLER_EXPECTED_NENA_ID_BOUNDARY", "CALLER_EXPECTED_FCC_ID_BOUNDARY",
        "CALLER_EXPECTED_AGENCY_BOUNDARY", "CALLER_EXPECTED_PSAP_NAME_BOUNDARY",
        "CALLER_EXPECTED_PSAP_NAME_ESRK_BOUNDARY",
        "CALLER_EXPECTED_PSAP_CENTER_LAT", "CALLER_EXPECTED_PSAP_CENTER_LON",
        "CALLER_NENA_VS_ROUTED", "CALLER_FCC_VS_ROUTED",
        "CALLER_TO_EXPECTED_BOUNDARY_M", "CALLER_EXPECTED_RELATION",

        # Cell expected.
        "CELL_LATITUDE_USED", "CELL_LONGITUDE_USED",
        "CELL_EXPECTED_NENA_ID_BOUNDARY", "CELL_EXPECTED_FCC_ID_BOUNDARY",
        "CELL_EXPECTED_AGENCY_BOUNDARY", "CELL_EXPECTED_PSAP_NAME_BOUNDARY",
        "CELL_EXPECTED_PSAP_NAME_ESRK_BOUNDARY",
        "CELL_EXPECTED_PSAP_CENTER_LAT", "CELL_EXPECTED_PSAP_CENTER_LON",
        "CELL_NENA_VS_ROUTED", "CELL_FCC_VS_ROUTED",
        "CELL_TO_EXPECTED_BOUNDARY_M", "CELL_EXPECTED_RELATION",

        # ESPOSREQ expected.
        "ESPOSREQ_LATITUDE", "ESPOSREQ_LONGITUDE",
        "ESPOSREQ_EXPECTED_NENA_ID_BOUNDARY", "ESPOSREQ_EXPECTED_FCC_ID_BOUNDARY",
        "ESPOSREQ_EXPECTED_AGENCY_BOUNDARY", "ESPOSREQ_EXPECTED_PSAP_NAME_BOUNDARY",
        "ESPOSREQ_EXPECTED_PSAP_NAME_ESRK_BOUNDARY",
        "ESPOSREQ_EXPECTED_PSAP_CENTER_LAT", "ESPOSREQ_EXPECTED_PSAP_CENTER_LON",
        "ESPOSREQ_NENA_VS_ROUTED", "ESPOSREQ_FCC_VS_ROUTED",
        "ESPOSREQ_TO_EXPECTED_BOUNDARY_M", "ESPOSREQ_EXPECTED_RELATION",

        # Essential GMLC context.
        "SETUP_ECGI_DEC", "PHASE",
        "UNCERT_METERS", "ESPOSREQ_LOC_HORIZONTAL_UNCERT", "ESPOSREQ_LOC_CONFIDENCE",
        "LOCATION_FIRST_HORIZONTAL_UNCERT", "LOCATION_FIRST_CONFIDENCE",
        "VERTICAL_UNCERT", "CONFIDENCE",
        "ESPOSREQ_INITIAL_LOCATION_SOURCE", "ESPOSREQ_LASTKNOWN_LOCATION_SOURCE",
        "ROUTE_LOCATION_POS_SOURCE", "POS_METHOD_USED", "NW_METHOD_USED",
        "ROUTE_STATUS_GMLC", "ROUTE_ESZ", "ROUTE_ESRK", "ROUTE_ESINET",
        "ROUTE_FALLBACK", "DEFAULT_ROUTED_CALL",
        "LBR_ATTEMPTED", "LBR_SUCCESS", "LBR_PSAP_DIFF",
        "DISTCELL2XY_M", "DISTCELL2PSAPXY_M", "DISTXY2PSAPXY_M",
        "CALL_ANOMALY", "COMPLETE_CALL",
    ]

    first = [c for c in first if c in candidate.columns]
    rest = [c for c in candidate.columns if c not in first and not c.startswith("_")]
    out = candidate[first + rest].copy()

    # Measurement columns -> numeric.
    for c in out.columns:
        if (
            c.endswith("_M") or c.endswith("_LAT") or c.endswith("_LON") or
            c.endswith("_LATITUDE") or c.endswith("_LONGITUDE") or
            c.endswith("_SEC")
        ):
            out[c] = pd.to_numeric(out[c], errors="coerce")

    out.to_csv(
        TEMP_CSV,
        mode="a" if header_written else "w",
        header=not header_written,
        index=False,
        float_format="%.3f"
    )
    header_written = True
    saved += len(out)

    print(f"Chunk {chunk_no:03d} | processed {processed:,} | saved {saved:,}")


# =====================================================================
# 11. CREATE ROUTED-PSAP MIN / MEAN / MAX
# =====================================================================

stats_rows = []

for routed_id, a in stats_acc.items():
    m = meta_by_nena.get(routed_id, {})

    row = {
        "ROUTED_NENA_CANON": routed_id,
        "ROUTED_NENA_ID_BOUNDARY": m.get("NENA_ID_BOUNDARY", ""),
        "ROUTED_FCC_ID_BOUNDARY": m.get("FCC_ID_BOUNDARY", ""),
        "ROUTED_AGENCY_BOUNDARY": m.get("AGENCY_BOUNDARY", ""),
        "ROUTED_PSAP_CENTER_LAT": m.get("PSAP_CENTER_LAT", np.nan),
        "ROUTED_PSAP_CENTER_LON": m.get("PSAP_CENTER_LON", np.nan),
        "ROUTED_PSAP_CALLS_IN_OUTPUT": a["CALLS"],
    }

    for prefix in ["CALLER", "CELL", "ESPOSREQ"]:
        n = a[f"{prefix}_N"]
        row[f"{prefix}_SAME_ROUTED_PSAP_MIN_M"] = a[f"{prefix}_MIN"] if n else np.nan
        row[f"{prefix}_SAME_ROUTED_PSAP_MEAN_M"] = a[f"{prefix}_SUM"] / n if n else np.nan
        row[f"{prefix}_SAME_ROUTED_PSAP_MAX_M"] = a[f"{prefix}_MAX"] if n else np.nan

    stats_rows.append(row)

stats = pd.DataFrame(stats_rows)
stats.to_csv(STATS_CSV, index=False, float_format="%.3f")

stats_lookup = stats.set_index("ROUTED_NENA_CANON").to_dict("index") if not stats.empty else {}


# =====================================================================
# 12. ADD MIN / MEAN / MAX TO MAIN CSV
# =====================================================================

if not TEMP_CSV.exists():
    raise RuntimeError("No rows passed the configured filters.")

delete_if_exists(OUTPUT_CSV)
final_header = False

for part in pd.read_csv(TEMP_CSV, chunksize=100_000, low_memory=False):
    rid = part["ROUTED_NENA_CANON"].fillna("").astype(str)

    for prefix in ["CALLER", "CELL", "ESPOSREQ"]:
        for stat in ["MIN", "MEAN", "MAX"]:
            col = f"{prefix}_SAME_ROUTED_PSAP_{stat}_M"
            part[col] = rid.map(
                lambda x: stats_lookup.get(x, {}).get(col, np.nan)
            )

    part["ROUTED_PSAP_CALLS_IN_OUTPUT"] = rid.map(
        lambda x: stats_lookup.get(x, {}).get("ROUTED_PSAP_CALLS_IN_OUTPUT", np.nan)
    )

    # Put group statistics near the front.
    stat_cols = [
        "ROUTED_PSAP_CALLS_IN_OUTPUT",
        "CALLER_SAME_ROUTED_PSAP_MIN_M", "CALLER_SAME_ROUTED_PSAP_MEAN_M", "CALLER_SAME_ROUTED_PSAP_MAX_M",
        "CELL_SAME_ROUTED_PSAP_MIN_M", "CELL_SAME_ROUTED_PSAP_MEAN_M", "CELL_SAME_ROUTED_PSAP_MAX_M",
        "ESPOSREQ_SAME_ROUTED_PSAP_MIN_M", "ESPOSREQ_SAME_ROUTED_PSAP_MEAN_M", "ESPOSREQ_SAME_ROUTED_PSAP_MAX_M",
    ]

    anchor = [
        "SOURCE_GMLC_ROW_ID", "UNIQ911_CID",
        "ABNORMAL_SOURCE_COUNT", "MAX_OUTSIDE_ROUTED_M", "COORDINATE_PATTERN",
        "CALLER_EXPECTED_VS_ROUTED", "CALLER_ROUTED_RELATION", "CALLER_TO_ROUTED_BOUNDARY_M",
        "CELL_EXPECTED_VS_ROUTED", "CELL_ROUTED_RELATION", "CELL_TO_ROUTED_BOUNDARY_M",
        "ESPOSREQ_EXPECTED_VS_ROUTED", "ESPOSREQ_ROUTED_RELATION", "ESPOSREQ_TO_ROUTED_BOUNDARY_M",
        "CALLER_TO_CELL_M", "CALLER_TO_ESPOSREQ_M", "CELL_TO_ESPOSREQ_M",
        "CALL_DURATION_SEC",
    ]

    anchor = [c for c in anchor if c in part]
    stat_cols = [c for c in stat_cols if c in part]
    rest = [c for c in part.columns if c not in anchor + stat_cols]

    part = part[anchor + stat_cols + rest]

    part.to_csv(
        OUTPUT_CSV,
        mode="a" if final_header else "w",
        header=not final_header,
        index=False,
        float_format="%.3f"
    )
    final_header = True

if DELETE_TEMP_AFTER_FINISH and TEMP_CSV.exists():
    TEMP_CSV.unlink()

print("\nDONE")
print("GMLC rows processed :", f"{processed:,}")
print("Rows saved          :", f"{saved:,}")
print("Main report         :", OUTPUT_CSV)
print("PSAP stats          :", STATS_CSV)






