# =====================================================================
# 1. HELPERS
# =====================================================================

def txt(x):
    if x is None or pd.isna(x):
        return ""
    x = str(x).strip()
    return "" if x.upper() in {"", "NAN", "NONE", "<NA>"} else x

def raw_id(x):
    return re.sub(r"\.0$", "", txt(x))

def canon_id(x):
    x = raw_id(x)
    if not x:
        return ""
    if re.fullmatch(r"\d+", x):
        try:
            return str(int(x))
        except Exception:
            pass
    return x.upper()

def split_joined_ids(x):
    return {canon_id(v) for v in txt(x).split(" | ") if canon_id(v)}

def single_joined_id(x):
    vals = split_joined_ids(x)
    return next(iter(vals)) if len(vals) == 1 else ""

def find_col(columns, choices, required=False):
    lookup = {str(c).strip().upper(): c for c in columns}
    for c in choices:
        if c.upper() in lookup:
            return lookup[c.upper()]
    if required:
        raise RuntimeError(f"Missing required column. Tried: {choices}")
    return None

def repair_geom(g):
    if g is None or g.is_empty:
        return None
    try:
        if not g.is_valid:
            g = g.buffer(0)
        return None if g is None or g.is_empty or not g.is_valid else g
    except Exception:
        return None

def uniq_join(series):
    vals = []
    for x in series:
        x = txt(x)
        if x and x not in vals:
            vals.append(x)
    return " | ".join(vals)

def numeric_series(s):
    return pd.to_numeric(s, errors="coerce")

def valid_xy(lat, lon):
    lat = pd.to_numeric(lat, errors="coerce")
    lon = pd.to_numeric(lon, errors="coerce")
    return (
        lat.notna() & lon.notna() &
        lat.between(-90, 90) & lon.between(-180, 180) &
        ~(lat.abs().lt(1e-10) & lon.abs().lt(1e-10))
    )

def delete_if_exists(path):
    if path.exists():
        try:
            path.unlink()
        except PermissionError:
            raise PermissionError(f"Close this file first:\n{path}")

