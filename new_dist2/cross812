            "ROUTED_FCC_PSAP_ID_GMLC",
            "ROUTE_ESZ",
            "ROUTE_ESRK",
            "ROUTE_ESINET",
        }
        or "NENA" in c
        or "FCC_ID" in c
    )

dtype_map = {
    c: "string"
    for c in temp_columns
    if protect_as_string(c)
}

final_header_written = False

for part in pd.read_csv(
    TEMP_CSV,
    chunksize=100_000,
    dtype=dtype_map,
    low_memory=False
):

    routed_ids = (
        part["ROUTED_NENA_CANON"]
        .fillna("")
        .astype(str)
        .map(canon_id)
    )

    for prefix in ["CALLER", "CELL", "ESPOSREQ"]:
        for stat in ["MIN", "MEAN", "MAX"]:
            col = f"{prefix}_ROUTED_PSAP_FILTERED_{stat}_M"

            part[col] = routed_ids.map(
                lambda x: stats_lookup.get(
                    x, {}
                ).get(
                    col, np.nan
                )
            )

    part["ROUTED_PSAP_CALLS_IN_FILTERED_COHORT"] = routed_ids.map(
        lambda x: stats_lookup.get(
            x, {}
        ).get(
            "ROUTED_PSAP_CALLS_IN_FILTERED_COHORT",
            np.nan
        )
    )

    anchor = [
        "SOURCE_GMLC_ROW_ID", "UNIQ911_CID",
        "ABNORMAL_SOURCE_COUNT", "MAX_OUTSIDE_ROUTED_M", "COORDINATE_PATTERN",

        "CALLER_EXPECTED_VS_ROUTED", "CALLER_ROUTED_RELATION",
        "CALLER_TO_ROUTED_BOUNDARY_M", "CALLER_TO_EXPECTED_BOUNDARY_M",

        # NEW
        "CALLER_EXPECTED_TO_ROUTED_PSAP_DISTANCE_M",
        "CALLER_EXPECTED_ROUTED_PSAP_BOUNDARIES_CONNECTED",

        "CELL_EXPECTED_VS_ROUTED", "CELL_ROUTED_RELATION",
        "CELL_TO_ROUTED_BOUNDARY_M", "CELL_TO_EXPECTED_BOUNDARY_M",

        # NEW
        "CELL_EXPECTED_TO_ROUTED_PSAP_DISTANCE_M",
        "CELL_EXPECTED_ROUTED_PSAP_BOUNDARIES_CONNECTED",

        "ESPOSREQ_EXPECTED_VS_ROUTED", "ESPOSREQ_ROUTED_RELATION",
        "ESPOSREQ_TO_ROUTED_BOUNDARY_M", "ESPOSREQ_TO_EXPECTED_BOUNDARY_M",

        "CALLER_TO_CELL_M",
        "CALLER_TO_ESPOSREQ_M",
        "CELL_TO_ESPOSREQ_M",
        "CALL_DURATION_SEC",
    ]

    stat_cols = [
        "ROUTED_PSAP_CALLS_IN_FILTERED_COHORT",

        "CALLER_ROUTED_PSAP_FILTERED_MIN_M",
        "CALLER_ROUTED_PSAP_FILTERED_MEAN_M",
        "CALLER_ROUTED_PSAP_FILTERED_MAX_M",

        "CELL_ROUTED_PSAP_FILTERED_MIN_M",
        "CELL_ROUTED_PSAP_FILTERED_MEAN_M",
        "CELL_ROUTED_PSAP_FILTERED_MAX_M",

        "ESPOSREQ_ROUTED_PSAP_FILTERED_MIN_M",
        "ESPOSREQ_ROUTED_PSAP_FILTERED_MEAN_M",
        "ESPOSREQ_ROUTED_PSAP_FILTERED_MAX_M",
    ]

    anchor = [
        c for c in anchor
        if c in part.columns
    ]

    stat_cols = [
        c for c in stat_cols
        if c in part.columns
    ]

    rest = [
        c for c in part.columns
        if c not in anchor + stat_cols
    ]

    part = part[
        anchor + stat_cols + rest
    ]

    for c in part.columns:
        if (
            c.endswith("_M") or
            c.endswith("_LAT") or
            c.endswith("_LON") or
            c.endswith("_LATITUDE") or
            c.endswith("_LONGITUDE") or
            c.endswith("_SEC")
        ):
            part[c] = pd.to_numeric(
                part[c],
                errors="coerce"
            )

    part.to_csv(
        OUTPUT_CSV,
        mode="a" if final_header_written else "w",
        header=not final_header_written,
        index=False,
        float_format="%.3f"
    )

    final_header_written = True

# =====================================================================
# 14. CLEANUP / SUMMARY
# =====================================================================

if DELETE_TEMP_AFTER_FINISH and TEMP_CSV.exists():
    TEMP_CSV.unlink()

print("\nDONE")
print("GMLC rows processed :", f"{processed:,}")
print("Rows saved          :", f"{saved:,}")
print("Main report         :", OUTPUT_CSV)
print("PSAP stats          :", STATS_CSV)
print("Distance method     : local AEQD nearest point + final WGS84 Geod")
print("Caller filter       :", MIN_CALLER_OUTSIDE_M, "to", MAX_CALLER_OUTSIDE_M, "m OUTSIDE")
print("Cell filter         :", MIN_CELL_OUTSIDE_M, "to", MAX_CELL_OUTSIDE_M, "m OUTSIDE")
print("ESPOSREQ filter     :", MIN_ESPOSREQ_OUTSIDE_M, "to", MAX_ESPOSREQ_OUTSIDE_M, "m OUTSIDE")
print("Filter mode         :", FILTER_MODE)
print("Stats               : FINAL FILTERED COHORT only")
print("Identity            : NENA + FCC IDs only; names never affect status")