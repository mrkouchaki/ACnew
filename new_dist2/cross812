B_FCC = find_col(boundary.columns, ["FCC_ID", "FCC_PSAP_ID"], True)
B_AGENCY = find_col(boundary.columns, ["AGENCY", "AGENCY_NAME"])
B_PSAP_NAME = find_col(boundary.columns, ["PSAP_NAME"])
B_PSAP_ESRK = find_col(boundary.columns, ["PSAP_NAME_ESRK"])

boundary["_NENA_RAW"] = boundary[B_NENA].map(raw_id)
boundary["_NENA"] = boundary[B_NENA].map(canon_id)
boundary["_FCC"] = boundary[B_FCC].map(canon_id)
boundary["_AGENCY"] = boundary[B_AGENCY].fillna("").astype(str).str.strip() if B_AGENCY else ""
boundary["_PSAP_NAME"] = boundary[B_PSAP_NAME].fillna("").astype(str).str.strip() if B_PSAP_NAME else ""
boundary["_PSAP_ESRK"] = boundary[B_PSAP_ESRK].fillna("").astype(str).str.strip() if B_PSAP_ESRK else ""
boundary["geometry"] = boundary.geometry.apply(repair_geom)

boundary = boundary.loc[
    boundary["_NENA"].ne("") & boundary.geometry.notna()
].copy()

# One geometry per NENA identity.
psap_geo = boundary[["_NENA", "geometry"]].dissolve(by="_NENA", as_index=False)
psap_geo["geometry"] = psap_geo.geometry.apply(repair_geom)
psap_geo = psap_geo.loc[psap_geo.geometry.notna()].copy()

# Interior reference point for approximate map location + local AEQD center.
rep = psap_geo.geometry.representative_point()
psap_geo["_CENTER_LAT"] = rep.y
psap_geo["_CENTER_LON"] = rep.x

boundary_by_nena = dict(zip(psap_geo["_NENA"], psap_geo.geometry))
center_by_nena = dict(zip(
    psap_geo["_NENA"],
    zip(psap_geo["_CENTER_LAT"], psap_geo["_CENTER_LON"])
))

meta = (
    boundary.groupby("_NENA", as_index=False)
    .agg(
        NENA_ID_BOUNDARY=("_NENA_RAW", uniq_join),
        FCC_ID_BOUNDARY=("_FCC", uniq_join),
        AGENCY_BOUNDARY=("_AGENCY", uniq_join),
        PSAP_NAME_BOUNDARY=("_PSAP_NAME", uniq_join),
        PSAP_NAME_ESRK_BOUNDARY=("_PSAP_ESRK", uniq_join),
    )
)

meta["PSAP_CENTER_LAT"] = meta["_NENA"].map(
    lambda x: center_by_nena.get(x, (np.nan, np.nan))[0]
)
meta["PSAP_CENTER_LON"] = meta["_NENA"].map(
    lambda x: center_by_nena.get(x, (np.nan, np.nan))[1]
)

meta_by_nena = meta.set_index("_NENA").to_dict("index")

fcc_to_nena = defaultdict(set)
for nena, fcc in boundary[["_NENA", "_FCC"]].drop_duplicates().itertuples(index=False, name=None):
    if fcc:
        fcc_to_nena[fcc].add(nena)

print("Usable boundary PSAPs:", f"{len(boundary_by_nena):,}")

# =====================================================================
# 3. LOCAL METRIC PSAP MODELS
# =====================================================================

metric_geometry_cache = {}

def get_metric_model(nena):
    nena = canon_id(nena)
    if not nena:
        return None
    if nena in metric_geometry_cache:
        return metric_geometry_cache[nena]

    geom = boundary_by_nena.get(nena)
    center = center_by_nena.get(nena)
    if geom is None or center is None:
        metric_geometry_cache[nena] = None
        return None

    lat0, lon0 = center
    local_crs = CRS.from_proj4(
        f"+proj=aeqd +lat_0={float(lat0)} +lon_0={float(lon0)} "
        f"+datum=WGS84 +units=m +no_defs"
    )

    forward = Transformer.from_crs("EPSG:4326", local_crs, always_xy=True)
    inverse = Transformer.from_crs(local_crs, "EPSG:4326", always_xy=True)
    metric_geom = repair_geom(shapely_transform(forward.transform, geom))

    model = {
        "WGS84_GEOMETRY": geom,
        "METRIC_GEOMETRY": metric_geom,
        "FORWARD": forward,
        "INVERSE": inverse,
    }
    metric_geometry_cache[nena] = model
    return model

# =====================================================================
# 4. ROUTED PSAP RESOLUTION
# =====================================================================

route_cache = {}

def resolve_routed(psap_value, fcc_value):
    psap = canon_id(psap_value)
    fcc = canon_id(fcc_value)
    key = (psap, fcc)

    if key in route_cache:
        return route_cache[key]

    chosen = ""
    status = "UNRESOLVED"

    if psap and psap in boundary_by_nena:
        boundary_fccs = split_joined_ids(
            meta_by_nena[psap].get("FCC_ID_BOUNDARY", "")
        )

        if fcc and fcc in boundary_fccs:
            chosen, status = psap, "CONFIRMED_PSAP_AND_FCC"
        elif not fcc:
            chosen, status = psap, "PSAP_MATCH_NO_GMLC_FCC"
        elif not boundary_fccs:
            chosen, status = psap, "PSAP_MATCH_NO_BOUNDARY_FCC"
        else:
            status = "PSAP_FCC_CONFLICT"

    elif ALLOW_FCC_ONLY_FALLBACK and len(fcc_to_nena.get(fcc, set())) == 1:
        chosen = next(iter(fcc_to_nena[fcc]))
        status = "FCC_UNIQUE_FALLBACK"

    elif len(fcc_to_nena.get(fcc, set())) > 1:
        status = "PSAP_NOT_FOUND_FCC_AMBIGUOUS"
    else:
        status = "PSAP_NOT_FOUND"

    m = meta_by_nena.get(chosen, {}) if chosen else {}

    result = {
        "ROUTED_NENA_CANON": chosen,
        "ROUTED_NENA_ID_BOUNDARY": m.get("NENA_ID_BOUNDARY", ""),
        "ROUTED_FCC_ID_BOUNDARY": m.get("FCC_ID_BOUNDARY", ""),
        "ROUTED_AGENCY_BOUNDARY": m.get("AGENCY_BOUNDARY", ""),
        "ROUTED_PSAP_NAME_BOUNDARY": m.get("PSAP_NAME_BOUNDARY", ""),
        "ROUTED_PSAP_NAME_ESRK_BOUNDARY": m.get("PSAP_NAME_ESRK_BOUNDARY", ""),
        "ROUTED_PSAP_CENTER_LAT": m.get("PSAP_CENTER_LAT", np.nan),
        "ROUTED_PSAP_CENTER_LON": m.get("PSAP_CENTER_LON", np.nan),
        "ROUTED_ID_STATUS": status,
    }

    route_cache[key] = result
    return result

