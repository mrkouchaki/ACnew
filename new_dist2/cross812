        candidate,
        "ESPOSREQ",
        "ESPOSREQ_LATITUDE",
        "ESPOSREQ_LONGITUDE"
    )

    # Expected boundary distance + Expected-vs-Routed ID status.
    for prefix, cfg in LOCATION_CONFIG.items():
