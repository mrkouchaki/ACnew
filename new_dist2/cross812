            candidate[f"{prefix}_ROUTED_RELATION"].eq("OUTSIDE"),
            numeric_series(candidate[f"{prefix}_TO_ROUTED_BOUNDARY_M"]),
            0.0
        )

    candidate["MAX_OUTSIDE_ROUTED_M"] = outside.max(axis=1)

    candidate["COORDINATE_PATTERN"] = (
        candidate["CALLER_EXPECTED_VS_ROUTED"] + "|" +
        candidate["CELL_EXPECTED_VS_ROUTED"] + "|" +
        candidate["ESPOSREQ_EXPECTED_VS_ROUTED"]
    )

    # Filtered-cohort stats grouped by routed PSAP.
    for routed_id, group in candidate.groupby("ROUTED_NENA_CANON"):
        routed_id = canon_id(routed_id)
        if not routed_id:
