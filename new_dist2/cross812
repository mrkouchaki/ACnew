def assign_expected(frame, prefix, lat_col, lon_col):
    frame = frame.reset_index(drop=True)
    lat = numeric_series(frame[lat_col])
    lon = numeric_series(frame[lon_col])
    valid = valid_xy(lat, lon)

    defaults = {
        f"{prefix}_EXPECTED_NENA_CANON": "",
        f"{prefix}_EXPECTED_NENA_ID_BOUNDARY": "",
        f"{prefix}_EXPECTED_FCC_ID_BOUNDARY": "",
        f"{prefix}_EXPECTED_AGENCY_BOUNDARY": "",
        f"{prefix}_EXPECTED_PSAP_NAME_BOUNDARY": "",
        f"{prefix}_EXPECTED_PSAP_NAME_ESRK_BOUNDARY": "",
        f"{prefix}_EXPECTED_PSAP_CENTER_LAT": np.nan,
        f"{prefix}_EXPECTED_PSAP_CENTER_LON": np.nan,
        f"{prefix}_EXPECTED_SPATIAL_STATUS": "INVALID_OR_MISSING",
    }
    for col, default in defaults.items():
        frame[col] = default

    if not valid.any():
        return frame

    pos = np.flatnonzero(valid.to_numpy())
    points = pd.DataFrame({
        "_LAT": lat.iloc[pos].to_numpy(float),
        "_LON": lon.iloc[pos].to_numpy(float),
    })

    unique = points.drop_duplicates().reset_index(drop=True)
    unique["_POINT_ID"] = np.arange(len(unique))

    point_gdf = gpd.GeoDataFrame(
        unique,
        geometry=gpd.points_from_xy(unique["_LON"], unique["_LAT"]),
        crs="EPSG:4326"
    )

    joined = gpd.sjoin(
        point_gdf,
        psap_geo[["_NENA", "geometry"]],
        how="left",
        predicate="intersects"
    )

    lookup = {}

    for point_id, group in joined.groupby("_POINT_ID", sort=False):
        ids = sorted({txt(x) for x in group["_NENA"] if txt(x)})
        key = (
            float(unique.at[int(point_id), "_LAT"]),
            float(unique.at[int(point_id), "_LON"])
        )

        if len(ids) == 1:
            nena = ids[0]
            m = meta_by_nena.get(nena, {})
            lookup[key] = (
                nena,
                m.get("NENA_ID_BOUNDARY", ""),
                m.get("FCC_ID_BOUNDARY", ""),
                m.get("AGENCY_BOUNDARY", ""),
                m.get("PSAP_NAME_BOUNDARY", ""),
                m.get("PSAP_NAME_ESRK_BOUNDARY", ""),
                m.get("PSAP_CENTER_LAT", np.nan),
                m.get("PSAP_CENTER_LON", np.nan),
                "UNIQUE_PSAP",
            )

        elif len(ids) == 0:
            lookup[key] = ("", "", "", "", "", "", np.nan, np.nan, "NO_CONTAINING_PSAP")
        else:
            lookup[key] = ("|".join(ids), "", "", "", "", "", np.nan, np.nan, "MULTIPLE_PSAP")

    for p in pos:
        result = lookup.get((float(lat.iloc[p]), float(lon.iloc[p])))
        if result is None:
            continue

        (
            frame.at[p, f"{prefix}_EXPECTED_NENA_CANON"],
            frame.at[p, f"{prefix}_EXPECTED_NENA_ID_BOUNDARY"],
            frame.at[p, f"{prefix}_EXPECTED_FCC_ID_BOUNDARY"],
            frame.at[p, f"{prefix}_EXPECTED_AGENCY_BOUNDARY"],
            frame.at[p, f"{prefix}_EXPECTED_PSAP_NAME_BOUNDARY"],
            frame.at[p, f"{prefix}_EXPECTED_PSAP_NAME_ESRK_BOUNDARY"],
            frame.at[p, f"{prefix}_EXPECTED_PSAP_CENTER_LAT"],
            frame.at[p, f"{prefix}_EXPECTED_PSAP_CENTER_LON"],
            frame.at[p, f"{prefix}_EXPECTED_SPATIAL_STATUS"],
        ) = result

    return frame

# =====================================================================
# 6. PRECISE DISTANCE TO PSAP BOUNDARY
# =====================================================================

HAS_VECTOR_SHAPELY = all(
    hasattr(shapely, x)
    for x in ["points", "shortest_line", "get_point", "get_x", "get_y", "covers"]
)

def add_boundary_distance(frame, prefix, lat_col, lon_col, id_col, target="ROUTED"):
    frame = frame.reset_index(drop=True)

    lat = numeric_series(frame[lat_col]).to_numpy(float)
    lon = numeric_series(frame[lon_col]).to_numpy(float)
    ids = frame[id_col].fillna("").astype(str).to_numpy()

    distance_m = np.full(len(frame), np.nan)
    relation = np.full(len(frame), "INVALID_OR_MISSING", dtype=object)

    valid = (
        np.isfinite(lat) & np.isfinite(lon) &
        (lat >= -90) & (lat <= 90) &
        (lon >= -180) & (lon <= 180) &
        ~(np.isclose(lat, 0) & np.isclose(lon, 0))
    )
    relation[valid] = "UNRESOLVED_BOUNDARY"

    for nena in pd.unique(ids[valid & (ids != "")]):
        if "|" in nena:
            continue

        model = get_metric_model(nena)
        if model is None or model["METRIC_GEOMETRY"] is None:
            continue

        wgs84_geom = model["WGS84_GEOMETRY"]
        metric_geom = model["METRIC_GEOMETRY"]
        forward = model["FORWARD"]
        inverse = model["INVERSE"]

        idx = np.flatnonzero(valid & (ids == nena))
        if not len(idx):
            continue

        x, y = forward.transform(lon[idx], lat[idx])
        x = np.asarray(x, float)
        y = np.asarray(y, float)

        if HAS_VECTOR_SHAPELY:
            metric_points = shapely.points(x, y)
            lines = shapely.shortest_line(metric_points, metric_geom.boundary)
            near = shapely.get_point(lines, 1)

            nx = np.asarray(shapely.get_x(near), float)
            ny = np.asarray(shapely.get_y(near), float)
            nlon, nlat = inverse.transform(nx, ny)

            _, _, meters = GEOD.inv(
                lon[idx], lat[idx],
                np.asarray(nlon, float),
                np.asarray(nlat, float)
            )
            meters = np.abs(np.asarray(meters, float))

            source_points = shapely.points(lon[idx], lat[idx])
            inside = np.asarray(shapely.covers(wgs84_geom, source_points), dtype=bool)

            distance_m[idx] = meters
            relation[idx] = np.where(
                meters <= 0.05,
                "BOUNDARY",
                np.where(inside, "INSIDE", "OUTSIDE")
            )

        else:
            for local_pos, row_pos in enumerate(idx):
                try:
                    point_m = Point(float(x[local_pos]), float(y[local_pos]))
                    _, nearest = nearest_points(point_m, metric_geom.boundary)
                    nlon, nlat = inverse.transform(nearest.x, nearest.y)

                    _, _, meters = GEOD.inv(
                        float(lon[row_pos]), float(lat[row_pos]),
                        float(nlon), float(nlat)
                    )
                    meters = abs(float(meters))
                    distance_m[row_pos] = meters

                    point_ll = Point(float(lon[row_pos]), float(lat[row_pos]))
                    relation[row_pos] = (
                        "BOUNDARY" if meters <= 0.05
                        else "INSIDE" if wgs84_geom.covers(point_ll)
                        else "OUTSIDE"
                    )
                except Exception:
                    relation[row_pos] = "DISTANCE_ERROR"

    frame[f"{prefix}_TO_{target}_BOUNDARY_M"] = distance_m
    frame[f"{prefix}_{target}_RELATION"] = relation
    return frame

# =====================================================================
# 6B. MINIMUM DISTANCE BETWEEN EXPECTED AND ROUTED PSAP BOUNDARIES
# =====================================================================
# NEW:
#   CALLER_EXPECTED_TO_ROUTED_PSAP_DISTANCE_M
#   CALLER_EXPECTED_ROUTED_PSAP_BOUNDARIES_CONNECTED
#   CELL_EXPECTED_TO_ROUTED_PSAP_DISTANCE_M
#   CELL_EXPECTED_ROUTED_PSAP_BOUNDARIES_CONNECTED
#
# Distance = minimum boundary-to-boundary distance.
# Connected = YES when the two PSAP boundaries touch/intersect.
# Same PSAP => distance 0 and connected YES.
# =====================================================================

psap_pair_cache = {}

def get_psap_pair_relationship(routed_nena, expected_nena):
    routed_nena = canon_id(routed_nena)
    expected_nena = canon_id(expected_nena)

    # Must resolve to exactly one PSAP on each side.
    if (
        not routed_nena or
        not expected_nena or
        "|" in routed_nena or
        "|" in expected_nena
    ):
        return np.nan, ""

    # Pair relationship is symmetric, so use one shared cache key.
    key = tuple(sorted((routed_nena, expected_nena)))

    if key in psap_pair_cache:
        return psap_pair_cache[key]

    routed_geom = boundary_by_nena.get(routed_nena)
    expected_geom = boundary_by_nena.get(expected_nena)

    if routed_geom is None or expected_geom is None:
        result = (np.nan, "")
        psap_pair_cache[key] = result
        return result

    # Same PSAP.
    if routed_nena == expected_nena:
        result = (0.0, "YES")
        psap_pair_cache[key] = result
        return result

    try:
        routed_boundary = routed_geom.boundary
        expected_boundary = expected_geom.boundary

        # Exact topological boundary connection.
        connected = bool(routed_boundary.intersects(expected_boundary))

        if connected:
            result = (0.0, "YES")
            psap_pair_cache[key] = result
            return result

        # Use one PSAP-centered local AEQD model to identify the nearest
        # boundary points, then measure those final points geodesically.
        base_nena = key[0]
        other_nena = key[1]

        base_model = get_metric_model(base_nena)
        other_geom = boundary_by_nena.get(other_nena)

        if (
            base_model is None or
            base_model["METRIC_GEOMETRY"] is None or
            other_geom is None
        ):
            result = (np.nan, "")
            psap_pair_cache[key] = result
            return result

        forward = base_model["FORWARD"]
        inverse = base_model["INVERSE"]

        base_metric = base_model["METRIC_GEOMETRY"]
        other_metric = repair_geom(
            shapely_transform(forward.transform, other_geom)
        )

        if other_metric is None:
            result = (np.nan, "")
            psap_pair_cache[key] = result
            return result

        p1_m, p2_m = nearest_points(
            base_metric.boundary,
            other_metric.boundary
        )

        lon1, lat1 = inverse.transform(p1_m.x, p1_m.y)
        lon2, lat2 = inverse.transform(p2_m.x, p2_m.y)

        _, _, meters = GEOD.inv(
            float(lon1), float(lat1),
            float(lon2), float(lat2)
        )

        meters = abs(float(meters))

        result = (meters, "NO")
        psap_pair_cache[key] = result
        return result

    except Exception:
        result = (np.nan, "")
        psap_pair_cache[key] = result
        return result


def add_expected_routed_psap_distance(frame, prefix):
    frame = frame.reset_index(drop=True)

    routed_ids = (
        frame["ROUTED_NENA_CANON"]
        .fillna("")
        .astype(str)
        .to_numpy()
    )

    expected_ids = (
        frame[f"{prefix}_EXPECTED_NENA_CANON"]
        .fillna("")
        .astype(str)
        .to_numpy()
    )

    distance_m = np.full(len(frame), np.nan)
    connected = np.full(len(frame), "", dtype=object)

    # Resolve each unique routed/expected pair only once.
    pair_rows = defaultdict(list)

    for i, (routed_id, expected_id) in enumerate(
        zip(routed_ids, expected_ids)
    ):
        routed_id = canon_id(routed_id)

        if "|" in expected_id:
            continue

        expected_id = canon_id(expected_id)

        if not routed_id or not expected_id:
            continue

        pair_rows[(routed_id, expected_id)].append(i)

    for pair, rows in pair_rows.items():
        d, c = get_psap_pair_relationship(pair[0], pair[1])

        idx = np.asarray(rows, dtype=int)
        distance_m[idx] = d
        connected[idx] = c

    frame[f"{prefix}_EXPECTED_TO_ROUTED_PSAP_DISTANCE_M"] = distance_m
    frame[f"{prefix}_EXPECTED_ROUTED_PSAP_BOUNDARIES_CONNECTED"] = connected

    return frame

# =====================================================================
# 7. DISTANCE BETWEEN LOCATION SOURCES
# =====================================================================

def geod_distance(lat1, lon1, lat2, lon2):
    lat1 = numeric_series(lat1).to_numpy(float)
    lon1 = numeric_series(lon1).to_numpy(float)
    lat2 = numeric_series(lat2).to_numpy(float)
    lon2 = numeric_series(lon2).to_numpy(float)

    valid = (
        np.isfinite(lat1) & np.isfinite(lon1) &
        np.isfinite(lat2) & np.isfinite(lon2) &
        (lat1 >= -90) & (lat1 <= 90) &
        (lat2 >= -90) & (lat2 <= 90) &
        (lon1 >= -180) & (lon1 <= 180) &
        (lon2 >= -180) & (lon2 <= 180) &
        ~(np.isclose(lat1, 0) & np.isclose(lon1, 0)) &
        ~(np.isclose(lat2, 0) & np.isclose(lon2, 0))
    )

    out = np.full(len(lat1), np.nan)

    if valid.any():
        _, _, meters = GEOD.inv(
            lon1[valid], lat1[valid],
            lon2[valid], lat2[valid]
        )
        out[valid] = np.abs(np.asarray(meters, float))

    return out

# =====================================================================
# 8. ID-ONLY EXPECTED VS ROUTED
# =====================================================================

def add_identity_status(frame, prefix):
    rn = frame["ROUTED_NENA_CANON"].fillna("").astype(str).map(canon_id)
    rf = frame["ROUTED_FCC_ID_BOUNDARY"].fillna("").astype(str).map(single_joined_id)

    en = frame[f"{prefix}_EXPECTED_NENA_CANON"].fillna("").astype(str)
    en = en.map(lambda x: canon_id(x) if "|" not in x else "")

    ef = (
        frame[f"{prefix}_EXPECTED_FCC_ID_BOUNDARY"]
        .fillna("").astype(str).map(single_joined_id)
    )

    frame[f"{prefix}_NENA_VS_ROUTED"] = np.where(
        rn.ne("") & en.ne(""),
        np.where(rn == en, "SAME", "DIFFERENT"),
        "UNRESOLVED"
    )

    frame[f"{prefix}_FCC_VS_ROUTED"] = np.where(
        rf.ne("") & ef.ne(""),
        np.where(rf == ef, "SAME", "DIFFERENT"),
        "UNRESOLVED"
    )

    frame[f"{prefix}_EXPECTED_VS_ROUTED"] = np.where(
        (frame[f"{prefix}_NENA_VS_ROUTED"] == "SAME") &
        (frame[f"{prefix}_FCC_VS_ROUTED"] == "SAME"),
        "SAME",
        np.where(
            (frame[f"{prefix}_NENA_VS_ROUTED"] == "DIFFERENT") |
            (frame[f"{prefix}_FCC_VS_ROUTED"] == "DIFFERENT"),
            "DIFFERENT",
            "UNRESOLVED"
        )
    )

    return frame

# =====================================================================
# 9. FILTERS
# =====================================================================

def distance_filter_enabled(minimum, maximum):
    return minimum is not None or maximum is not None

def range_filter(frame, prefix, minimum, maximum):
    if not distance_filter_enabled(minimum, maximum):
        return None

    d = numeric_series(frame[f"{prefix}_TO_ROUTED_BOUNDARY_M"])
    mask = d.notna() & frame[f"{prefix}_ROUTED_RELATION"].eq("OUTSIDE")

    if minimum is not None:
        mask &= d >= float(minimum)
    if maximum is not None:
        mask &= d <= float(maximum)

    return mask

def candidate_mask(frame):
    masks = []

    for prefix, mn, mx in [
        ("CALLER", MIN_CALLER_OUTSIDE_M, MAX_CALLER_OUTSIDE_M),
        ("CELL", MIN_CELL_OUTSIDE_M, MAX_CELL_OUTSIDE_M),
        ("ESPOSREQ", MIN_ESPOSREQ_OUTSIDE_M, MAX_ESPOSREQ_OUTSIDE_M),
    ]:
        m = range_filter(frame, prefix, mn, mx)
        if m is not None:
            masks.append(m)

    if not masks:
        mask = pd.Series(True, index=frame.index)
    elif len(masks) == 1:
        mask = masks[0]
    elif FILTER_MODE.upper() == "AND":
        mask = masks[0].copy()
        for m in masks[1:]:
            mask &= m
    elif FILTER_MODE.upper() == "OR":
        mask = masks[0].copy()
        for m in masks[1:]:
            mask |= m
    else:
        raise ValueError("FILTER_MODE must be OR or AND.")

    if "CALL_DURATION_SEC" in frame.columns:
        duration = numeric_series(frame["CALL_DURATION_SEC"])
        if MIN_CALL_DURATION_SEC is not None:
            mask &= duration >= float(MIN_CALL_DURATION_SEC)
        if MAX_CALL_DURATION_SEC is not None:
            mask &= duration <= float(MAX_CALL_DURATION_SEC)

    if INCLUDE_MARKETS is not None and "MARKET" in frame.columns:
        allowed = {str(x).upper() for x in INCLUDE_MARKETS}
        mask &= frame["MARKET"].fillna("").str.upper().isin(allowed)

    if EXCLUDE_MARKETS and "MARKET" in frame.columns:
        blocked = {str(x).upper() for x in EXCLUDE_MARKETS}
        mask &= ~frame["MARKET"].fillna("").str.upper().isin(blocked)

    return mask

