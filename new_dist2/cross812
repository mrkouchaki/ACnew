        "CALLER_TO_CELL_M", "CALLER_TO_ESPOSREQ_M", "CELL_TO_ESPOSREQ_M",
        "CALL_DURATION_SEC", "CALL_BEGIN_TIME_UTC", "MARKET", "STATE", "COUNTY",

        # Routed identity.
        "ROUTED_PSAP_ID_GMLC", "ROUTED_FCC_PSAP_ID_GMLC", "ROUTED_ID_STATUS",
        "ROUTED_NENA_CANON", "ROUTED_NENA_ID_BOUNDARY", "ROUTED_FCC_ID_BOUNDARY",

        # Routed names, display only.
