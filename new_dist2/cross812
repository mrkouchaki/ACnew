                candidate[f"{prefix}_EXPECTED_VS_ROUTED"].isin(allowed)
            ].copy()

    if candidate.empty:
        continue

    candidate = candidate.reset_index(drop=True)

    # Abnormality summary.
    candidate["ABNORMAL_SOURCE_COUNT"] = (
        candidate[
            [
