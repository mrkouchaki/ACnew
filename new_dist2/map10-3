# STRONG MISROUTE PRESENTATION MAP v3 - LIGHT / RELIABLE
# Reads strong_misroute_evidence_from_gmlc_v2.csv
# =====================================================================

from pathlib import Path
from html import escape
import re
import pandas as pd
import geopandas as gpd
import folium

from shapely.geometry import Point, mapping
from shapely.ops import nearest_points

# =====================================================================
# 0. SETTINGS
# =====================================================================

DATA_DIR = Path(r"C:\temp\gmlc_v2")
OUTPUT_DIR = DATA_DIR / "outputs_psap_rca_v5"

INPUT_CSV = OUTPUT_DIR / "strong_misroute_evidence_from_gmlc_v2.csv"
BOUNDARY_PATH = DATA_DIR / "psap" / "Final_Join.tab"
OUTPUT_HTML = OUTPUT_DIR / "strong_misroute_evidence_from_gmlc_v2_map.html"

MAX_CALLS = 70

# Map-only polygon simplification.
# Does NOT affect any analysis/distance results.
MAP_SIMPLIFY_DEG = 0.0015

# Optional filters
MIN_CALLER_OUTSIDE_M = None
MAX_CALLER_OUTSIDE_M = None

MIN_CELL_OUTSIDE_M = None
MAX_CELL_OUTSIDE_M = None

MAX_CALLER_CELL_M = None

MIN_CALL_DURATION_SEC = None
MAX_CALL_DURATION_SEC = None

INCLUDE_MARKETS = None
EXCLUDE_MARKETS = set()

# Layers
SHOW_ROUTED_BOUNDARIES = True
SHOW_EXPECTED_BOUNDARIES = True

SHOW_CALLER = True
SHOW_CELL = True
SHOW_ESPOSREQ = True

SHOW_CALLER_TO_ROUTED = True
SHOW_CELL_TO_ROUTED = True

SHOW_CALLER_TO_EXPECTED = False
SHOW_CELL_TO_EXPECTED = False

SHOW_CALLER_TO_CELL = True

AUTO_FIT_POINTS = False

MAP_CENTER = [39.5, -98.35]
MAP_ZOOM = 4


# =====================================================================
# 1. HELPERS
# =====================================================================

def canon(x):
    if x is None or pd.isna(x):
        return ""

    x = re.sub(r"\.0$", "", str(x).strip())

    if not x or x.upper() in {"NAN", "NONE", "<NA>"}:
        return ""

    if x.isdigit():
        return str(int(x))

    return x.upper()


def valid(lat, lon):
    lat = pd.to_numeric(lat, errors="coerce")
    lon = pd.to_numeric(lon, errors="coerce")

    return (
        pd.notna(lat) and pd.notna(lon)
        and -90 <= float(lat) <= 90
        and -180 <= float(lon) <= 180
        and not (
            abs(float(lat)) < 1e-10
            and abs(float(lon)) < 1e-10
        )
    )


def fmt(x, digits=1):
    x = pd.to_numeric(x, errors="coerce")

    return (
        "N/A"
        if pd.isna(x)
        else f"{float(x):,.{digits}f}"
    )


def safe(x):
    if x is None or pd.isna(x):
        return ""

    return escape(str(x))


def repair_geom(g):
    if g is None or g.is_empty:
        return None

    try:
        if not g.is_valid:
            g = g.buffer(0)

        return (
            None
            if g is None or g.is_empty or not g.is_valid
            else g
        )

    except Exception:
        return None


def nearest_boundary_point(lat, lon, geom):
    if geom is None or not valid(lat, lon):
        return None

    try:
        p = Point(float(lon), float(lat))
        _, q = nearest_points(p, geom.boundary)

        return [float(q.y), float(q.x)]

    except Exception:
        return None


# =====================================================================
# 2. READ STRONG-EVIDENCE CSV
# =====================================================================

df = pd.read_csv(
    INPUT_CSV,
    dtype="string",
    low_memory=False
)

numeric_cols = [
    "CALLER_TO_ROUTED_BOUNDARY_M",
    "CELL_TO_ROUTED_BOUNDARY_M",
    "CALLER_CELL_DISTANCE_M",
    "CALL_DURATION_SEC",

    "CALLER_LATITUDE",
    "CALLER_LONGITUDE",

    "CELL_LATITUDE_USED",
    "CELL_LONGITUDE_USED",

    "ESPOSREQ_LOC_LATITUDE",
    "ESPOSREQ_LOC_LONGITUDE",

    "DISTCELL2XY_M",
    "UNCERT_METERS",

    "ROUTE_NAME_VS_EXPECTED_SIMILARITY",
    "ROUTE_NAME_VS_ROUTED_SIMILARITY",
]

for c in numeric_cols:
    if c in df.columns:
        df[c] = pd.to_numeric(
            df[c],
            errors="coerce"
        )


# =====================================================================
# 3. APPLY OPTIONAL FILTERS
# =====================================================================

map_df = df.copy()

if MIN_CALLER_OUTSIDE_M is not None:
    map_df = map_df.loc[
        map_df["CALLER_TO_ROUTED_BOUNDARY_M"]
        >= MIN_CALLER_OUTSIDE_M
    ]

if MAX_CALLER_OUTSIDE_M is not None:
    map_df = map_df.loc[
        map_df["CALLER_TO_ROUTED_BOUNDARY_M"]
        <= MAX_CALLER_OUTSIDE_M
    ]

if MIN_CELL_OUTSIDE_M is not None:
    map_df = map_df.loc[
        map_df["CELL_TO_ROUTED_BOUNDARY_M"]
        >= MIN_CELL_OUTSIDE_M
    ]

if MAX_CELL_OUTSIDE_M is not None:
    map_df = map_df.loc[
        map_df["CELL_TO_ROUTED_BOUNDARY_M"]
        <= MAX_CELL_OUTSIDE_M
    ]

if MAX_CALLER_CELL_M is not None:
    map_df = map_df.loc[
        map_df["CALLER_CELL_DISTANCE_M"]
        <= MAX_CALLER_CELL_M
    ]

if MIN_CALL_DURATION_SEC is not None:
    map_df = map_df.loc[
        map_df["CALL_DURATION_SEC"]
        >= MIN_CALL_DURATION_SEC
    ]

if MAX_CALL_DURATION_SEC is not None:
    map_df = map_df.loc[
        map_df["CALL_DURATION_SEC"]
        <= MAX_CALL_DURATION_SEC
    ]

if INCLUDE_MARKETS is not None:
    allowed = {
        str(x).upper()
        for x in INCLUDE_MARKETS
    }

    map_df = map_df.loc[
        map_df["MARKET"]
        .fillna("")
        .str.upper()
        .isin(allowed)
    ]

if EXCLUDE_MARKETS:
    blocked = {
        str(x).upper()
        for x in EXCLUDE_MARKETS
    }

    map_df = map_df.loc[
        ~map_df["MARKET"]
        .fillna("")
        .str.upper()
        .isin(blocked)
    ]


# =====================================================================
# 4. SORT STRONGEST FIRST
# =====================================================================

map_df["MIN_CALLER_CELL_OUTSIDE_M"] = (
    map_df[
        [
            "CALLER_TO_ROUTED_BOUNDARY_M",
            "CELL_TO_ROUTED_BOUNDARY_M"
        ]
    ]
    .min(axis=1)
)

map_df = map_df.sort_values(
    [
        "MIN_CALLER_CELL_OUTSIDE_M",
        "CALLER_CELL_DISTANCE_M"
    ],
    ascending=[False, True],
    na_position="last"
)

if MAX_CALLS is not None:
    map_df = map_df.head(
        int(MAX_CALLS)
    ).copy()

if map_df.empty:
    raise RuntimeError(
        "No calls remain after filters."
    )

print("Input calls :", f"{len(df):,}")
print("Map calls   :", f"{len(map_df):,}")


# =====================================================================
# 5. LOAD BOUNDARIES
# =====================================================================

try:
    b = gpd.read_file(
        BOUNDARY_PATH,
        engine="pyogrio"
    )
except Exception:
    b = gpd.read_file(
        BOUNDARY_PATH
    )

if b.crs is None:
    raise RuntimeError(
        "Boundary file has no CRS."
    )

if b.crs.to_epsg() != 4326:
    b = b.to_crs(4326)

lookup = {
    str(c).strip().upper(): c
    for c in b.columns
}

NENA_COL = lookup["NENA_ID"]

AGENCY_COL = lookup.get(
    "AGENCY",
    lookup.get("AGENCY_NAME")
)

b["_NENA"] = b[NENA_COL].map(
    canon
)

b["_NAME"] = (
    b[AGENCY_COL]
    .fillna("")
    .astype(str)
    .str.strip()

    if AGENCY_COL

    else ""
)

b["geometry"] = b.geometry.apply(
    repair_geom
)

b = b.loc[
    b["_NENA"].ne("")
    & b.geometry.notna()
].copy()


# =====================================================================
# 6. DISSOLVE FULL GEOMETRY
# =====================================================================

bg_full = (
    b[
        [
            "_NENA",
            "_NAME",
            "geometry"
        ]
    ]
    .dissolve(
        by="_NENA",
        as_index=False,
        aggfunc={"_NAME": "first"}
    )
)

bg_full["geometry"] = (
    bg_full.geometry.apply(
        repair_geom
    )
)

bg_full = bg_full.loc[
    bg_full.geometry.notna()
].copy()

# Full geometry used for nearest-boundary lines.
geom_full = dict(
    zip(
        bg_full["_NENA"],
        bg_full.geometry
    )
)

name_by_id = dict(
    zip(
        bg_full["_NENA"],
        bg_full["_NAME"]
    )
)


# =====================================================================
# 7. CREATE LIGHT DISPLAY GEOMETRY
# =====================================================================

bg_display = bg_full.copy()

bg_display["geometry"] = (
    bg_display.geometry
    .simplify(
        MAP_SIMPLIFY_DEG,
        preserve_topology=True
    )
    .apply(
        repair_geom
    )
)

geom_display = dict(
    zip(
        bg_display["_NENA"],
        bg_display.geometry
    )
)


# =====================================================================
# 8. DEBUG POLYGON COUNTS
# =====================================================================

routed_ids = {
    canon(x)
    for x in map_df["ROUTED_NENA_ID_BOUNDARY"]
    if canon(x)
}

expected_ids = {
    canon(x)
    for x in map_df["EXPECTED_PSAP_NENA_ID"]
    if canon(x)
}

print(
    "Unique routed PSAPs  :",
    len(routed_ids)
)

print(
    "Unique expected PSAPs:",
    len(expected_ids)
)

print(
    "Total display polygons:",
    len(routed_ids | expected_ids)
)


# =====================================================================
# 9. CREATE MAP
# =====================================================================
#
# Use the exact simple CartoDB setup that worked in your older map.
# NO OpenStreetMap layer.
# =====================================================================

m = folium.Map(
    location=MAP_CENTER,
    zoom_start=MAP_ZOOM,
    control_scale=True,
    tiles="CartoDB positron",
    prefer_canvas=True
)


# =====================================================================
# 10. FEATURE GROUPS
# =====================================================================

routed_layer = folium.FeatureGroup(
    "PSAP A - Final/Routed",
    show=SHOW_ROUTED_BOUNDARIES
)

expected_layer = folium.FeatureGroup(
    "PSAP B - Expected",
    show=SHOW_EXPECTED_BOUNDARIES
)

caller_layer = folium.FeatureGroup(
    "Caller locations",
    show=SHOW_CALLER
)

cell_layer = folium.FeatureGroup(
    "Cell locations",
    show=SHOW_CELL
)

espos_layer = folium.FeatureGroup(
    "ESPOSREQ locations",
    show=SHOW_ESPOSREQ
)

caller_routed_lines = folium.FeatureGroup(
    "Caller → PSAP A",
    show=SHOW_CALLER_TO_ROUTED
)

cell_routed_lines = folium.FeatureGroup(
    "Cell → PSAP A",
    show=SHOW_CELL_TO_ROUTED
)

caller_expected_lines = folium.FeatureGroup(
    "Caller → PSAP B",
    show=SHOW_CALLER_TO_EXPECTED
)

cell_expected_lines = folium.FeatureGroup(
    "Cell → PSAP B",
    show=SHOW_CELL_TO_EXPECTED
)

caller_cell_lines = folium.FeatureGroup(
    "Caller ↔ Cell",
    show=SHOW_CALLER_TO_CELL
)


# =====================================================================
# 11. DRAW UNIQUE PSAP POLYGONS
# =====================================================================

def draw_psaps(
    ids,
    layer,
    color,
    label
):
    ids = sorted({
        canon(x)
        for x in ids
        if canon(x)
    })

    for nena in ids:
        geom = geom_display.get(
            nena
        )

        if geom is None:
            continue

        folium.GeoJson(
            mapping(geom),
            style_function=lambda feature, c=color: {
                "color": c,
                "weight": 2.5,
                "fillOpacity": 0.025,
            },
            tooltip=(
                f"{label}<br>"
                f"NENA: {safe(nena)}<br>"
                f"{safe(name_by_id.get(nena,''))}"
            )
        ).add_to(layer)


draw_psaps(
    map_df["ROUTED_NENA_ID_BOUNDARY"],
    routed_layer,
    "red",
    "PSAP A - Final/Routed"
)

draw_psaps(
    map_df["EXPECTED_PSAP_NENA_ID"],
    expected_layer,
    "green",
    "PSAP B - Expected"
)


# =====================================================================
# 12. DRAW CALLS
# =====================================================================

for _, r in map_df.iterrows():

    call_id = str(
        r.get(
            "UNIQ911_CID",
            ""
        )
    )

    routed_id = canon(
        r.get(
            "ROUTED_NENA_ID_BOUNDARY",
            ""
        )
    )

    expected_id = canon(
        r.get(
            "EXPECTED_PSAP_NENA_ID",
            ""
        )
    )

    # Full polygons for nearest-line calculation.
    routed_geom = geom_full.get(
        routed_id
    )

    expected_geom = geom_full.get(
        expected_id
    )

    clat = r.get(
        "CALLER_LATITUDE"
    )

    clon = r.get(
        "CALLER_LONGITUDE"
    )

    cellat = r.get(
        "CELL_LATITUDE_USED"
    )

    cellon = r.get(
        "CELL_LONGITUDE_USED"
    )

    elat = r.get(
        "ESPOSREQ_LOC_LATITUDE"
    )

    elon = r.get(
        "ESPOSREQ_LOC_LONGITUDE"
    )


    # -------------------------------------------------------------
    # ONE detailed popup per call — Caller only.
    # -------------------------------------------------------------

    popup = f"""
    <div style="font-size:12px; line-height:1.35; min-width:410px">

    <b>CALL</b><br>
    CID: {safe(call_id)}<br>
    Market: {safe(r.get('MARKET',''))}<br>
    Duration: {fmt(r.get('CALL_DURATION_SEC'))} sec<br>
    USID: {safe(r.get('USID',''))}<br><br>

    <b style="color:#b00000">PSAP A - FINAL / ROUTED</b><br>
    PSAP_ID: {safe(r.get('PSAP_ID',''))}<br>
    FCC_PSAP_ID: {safe(r.get('FCC_PSAP_ID',''))}<br>
    PSAP_NAME: <b>{safe(r.get('PSAP_NAME',''))}</b><br>
    Boundary agency: {safe(r.get('ROUTED_AGENCY_BOUNDARY',''))}<br><br>

    <b style="color:#137333">PSAP B - EXPECTED</b><br>
    NENA: {safe(r.get('EXPECTED_PSAP_NENA_ID',''))}<br>
    FCC: {safe(r.get('EXPECTED_PSAP_FCC_ID',''))}<br>
    Agency: <b>{safe(r.get('EXPECTED_PSAP_AGENCY',''))}</b><br><br>

    <b>ROUTE_PSAP_NAME</b><br>
    {safe(r.get('ROUTE_PSAP_NAME',''))}<br>
    Role: <b>{safe(r.get('ROUTE_PSAP_NAME_ROLE',''))}</b><br>
    Similarity to B:
    {fmt(r.get('ROUTE_NAME_VS_EXPECTED_SIMILARITY'),3)}<br><br>

    <b>GEOGRAPHY</b><br>
    Caller → A boundary:
    <b>{fmt(r.get('CALLER_TO_ROUTED_BOUNDARY_M'))} m</b><br>

    Cell → A boundary:
    <b>{fmt(r.get('CELL_TO_ROUTED_BOUNDARY_M'))} m</b><br>

    Caller ↔ Cell:
    <b>{fmt(r.get('CALLER_CELL_DISTANCE_M'))} m</b>

    </div>
    """


    # -------------------------------------------------------------
    # CALLER
    # -------------------------------------------------------------

    if valid(
        clat,
        clon
    ):
        folium.CircleMarker(
            location=[
                float(clat),
                float(clon)
            ],
            radius=5,
            weight=2,
            fill=True,
            fill_opacity=0.9,
            tooltip=(
                f"CALLER | {call_id} | "
                f"{fmt(r.get('CALLER_TO_ROUTED_BOUNDARY_M'))} m"
            ),
            popup=folium.Popup(
                popup,
                max_width=520
            )
        ).add_to(
            caller_layer
        )


    # -------------------------------------------------------------
    # CELL
    # -------------------------------------------------------------

    if valid(
        cellat,
        cellon
    ):
        folium.CircleMarker(
            location=[
                float(cellat),
                float(cellon)
            ],
            radius=5,
            weight=2,
            fill=True,
            fill_opacity=0.9,
            tooltip=(
                f"CELL | {call_id} | "
                f"{fmt(r.get('CELL_TO_ROUTED_BOUNDARY_M'))} m"
            )
        ).add_to(
            cell_layer
        )


    # -------------------------------------------------------------
    # ESPOSREQ
    # -------------------------------------------------------------

    if valid(
        elat,
        elon
    ):
        folium.CircleMarker(
            location=[
                float(elat),
                float(elon)
            ],
            radius=4,
            weight=1,
            fill=True,
            fill_opacity=0.75,
            tooltip=(
                f"ESPOSREQ | {call_id}"
            )
        ).add_to(
            espos_layer
        )


    # -------------------------------------------------------------
    # CALLER -> ROUTED A
    # -------------------------------------------------------------

    if SHOW_CALLER_TO_ROUTED:

        q = nearest_boundary_point(
            clat,
            clon,
            routed_geom
        )

        if q is not None:

            folium.PolyLine(
                [
                    [
                        float(clat),
                        float(clon)
                    ],
                    q
                ],
                weight=2,
                opacity=0.75,
                tooltip=(
                    f"Caller → A: "
                    f"{fmt(r.get('CALLER_TO_ROUTED_BOUNDARY_M'))} m"
                )
            ).add_to(
                caller_routed_lines
            )


    # -------------------------------------------------------------
    # CELL -> ROUTED A
    # -------------------------------------------------------------

    if SHOW_CELL_TO_ROUTED:

        q = nearest_boundary_point(
            cellat,
            cellon,
            routed_geom
        )

        if q is not None:

            folium.PolyLine(
                [
                    [
                        float(cellat),
                        float(cellon)
                    ],
                    q
                ],
                weight=2,
                opacity=0.55,
                dash_array="6,5",
                tooltip=(
                    f"Cell → A: "
                    f"{fmt(r.get('CELL_TO_ROUTED_BOUNDARY_M'))} m"
                )
            ).add_to(
                cell_routed_lines
            )


    # -------------------------------------------------------------
    # OPTIONAL CALLER -> EXPECTED B
    # -------------------------------------------------------------

    if SHOW_CALLER_TO_EXPECTED:

        q = nearest_boundary_point(
            clat,
            clon,
            expected_geom
        )

        if q is not None:

            folium.PolyLine(
                [
                    [
                        float(clat),
                        float(clon)
                    ],
                    q
                ],
                weight=2,
                dash_array="7,5"
            ).add_to(
                caller_expected_lines
            )


    # -------------------------------------------------------------
    # OPTIONAL CELL -> EXPECTED B
    # -------------------------------------------------------------

    if SHOW_CELL_TO_EXPECTED:

        q = nearest_boundary_point(
            cellat,
            cellon,
            expected_geom
        )

        if q is not None:

            folium.PolyLine(
                [
                    [
                        float(cellat),
                        float(cellon)
                    ],
                    q
                ],
                weight=2,
                dash_array="7,5"
            ).add_to(
                cell_expected_lines
            )


    # -------------------------------------------------------------
    # CALLER <-> CELL
    # -------------------------------------------------------------

    if (
        SHOW_CALLER_TO_CELL
        and valid(clat, clon)
        and valid(cellat, cellon)
    ):

        folium.PolyLine(
            [
                [
                    float(clat),
                    float(clon)
                ],
                [
                    float(cellat),
                    float(cellon)
                ]
            ],
            weight=2,
            opacity=0.55,
            dash_array="5,5",
            tooltip=(
                f"Caller ↔ Cell: "
                f"{fmt(r.get('CALLER_CELL_DISTANCE_M'))} m"
            )
        ).add_to(
            caller_cell_lines
        )


# =====================================================================
# 13. ADD LAYERS
# =====================================================================

for layer in [
    routed_layer,
    expected_layer,

    caller_routed_lines,
    cell_routed_lines,

    caller_expected_lines,
    cell_expected_lines,

    caller_cell_lines,

    caller_layer,
    cell_layer,
    espos_layer,
]:
    layer.add_to(m)

folium.LayerControl(
    collapsed=False
).add_to(m)


# =====================================================================
# 14. OPTIONAL AUTO FIT
# =====================================================================

if AUTO_FIT_POINTS:

    points = []

    for _, r in map_df.iterrows():

        if valid(
            r.get("CALLER_LATITUDE"),
            r.get("CALLER_LONGITUDE")
        ):

            points.append([
                float(r["CALLER_LATITUDE"]),
                float(r["CALLER_LONGITUDE"])
            ])

        if valid(
            r.get("CELL_LATITUDE_USED"),
            r.get("CELL_LONGITUDE_USED")
        ):

            points.append([
                float(r["CELL_LATITUDE_USED"]),
                float(r["CELL_LONGITUDE_USED"])
            ])

    if len(points) > 1:
        m.fit_bounds(
            points
        )


# =====================================================================
# 15. SAVE + DISPLAY
# =====================================================================

m.save(
    OUTPUT_HTML
)

size_mb = (
    OUTPUT_HTML.stat().st_size
    /
    1024
    /
    1024
)

print("\nSaved map :", OUTPUT_HTML)
print("Mapped    :", len(map_df))
print("HTML size :", f"{size_mb:.2f} MB")

display(m)

