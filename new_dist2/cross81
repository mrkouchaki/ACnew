route_cache = {}


def resolve_routed(
    psap_value,
    fcc_value
):

    psap = canon_id(
        psap_value
    )


    fcc = canon_id(
        fcc_value
    )


    key = (
        psap,
        fcc
    )


    if key in route_cache:

        return route_cache[
            key
        ]


    chosen = ""

    status = (
        "UNRESOLVED"
    )


    # -----------------------------------------------------------------
    # Primary:
    # GMLC.PSAP_ID -> Boundary.NENA_ID
    # -----------------------------------------------------------------

    if (
        psap
        and
        psap
        in boundary_by_nena
    ):

        boundary_fccs = split_joined_ids(

            meta_by_nena[
                psap
            ].get(
                "FCC_ID_BOUNDARY",
                ""
            )
        )


        if (
            fcc
            and
            fcc
            in boundary_fccs
        ):

            chosen = psap

            status = (
                "CONFIRMED_PSAP_AND_FCC"
            )


        elif not fcc:

            chosen = psap

            status = (
                "PSAP_MATCH_NO_GMLC_FCC"
            )


        elif not boundary_fccs:

            chosen = psap

            status = (
                "PSAP_MATCH_NO_BOUNDARY_FCC"
            )


        else:

            status = (
                "PSAP_FCC_CONFLICT"
            )


    # -----------------------------------------------------------------
    # Optional unique FCC fallback
    # -----------------------------------------------------------------

    elif (
        ALLOW_FCC_ONLY_FALLBACK
        and
        len(
            fcc_to_nena.get(
                fcc,
                set()
            )
        )
        == 1
    ):

        chosen = next(
            iter(
                fcc_to_nena[
                    fcc
                ]
            )
        )

        status = (
            "FCC_UNIQUE_FALLBACK"
        )


    elif (
        len(
            fcc_to_nena.get(
                fcc,
                set()
            )
        )
        > 1
    ):

        status = (
            "PSAP_NOT_FOUND_FCC_AMBIGUOUS"
        )


    else:

        status = (
            "PSAP_NOT_FOUND"
        )


    metadata = (

        meta_by_nena.get(
            chosen,
            {}
        )

        if chosen

        else {}
    )


    result = {

        "ROUTED_NENA_CANON":
            chosen,

        "ROUTED_NENA_ID_BOUNDARY":
            metadata.get(
                "NENA_ID_BOUNDARY",
                ""
            ),

        "ROUTED_FCC_ID_BOUNDARY":
            metadata.get(
                "FCC_ID_BOUNDARY",
                ""
            ),

        "ROUTED_AGENCY_BOUNDARY":
            metadata.get(
                "AGENCY_BOUNDARY",
                ""
            ),

        "ROUTED_PSAP_NAME_BOUNDARY":
            metadata.get(
                "PSAP_NAME_BOUNDARY",
                ""
            ),

        "ROUTED_PSAP_NAME_ESRK_BOUNDARY":
            metadata.get(
                "PSAP_NAME_ESRK_BOUNDARY",
                ""
            ),

        "ROUTED_PSAP_CENTER_LAT":
            metadata.get(
                "PSAP_CENTER_LAT",
                np.nan
            ),

        "ROUTED_PSAP_CENTER_LON":
            metadata.get(
                "PSAP_CENTER_LON",
                np.nan
            ),

        "ROUTED_ID_STATUS":
            status,
    }


    route_cache[
        key
    ] = result


    return result


