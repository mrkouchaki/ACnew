    ]


    stats_columns = [

        "ROUTED_PSAP_CALLS_IN_FILTERED_COHORT",


        "CALLER_ROUTED_PSAP_FILTERED_MIN_M",

        "CALLER_ROUTED_PSAP_FILTERED_MEAN_M",

        "CALLER_ROUTED_PSAP_FILTERED_MAX_M",


        "CELL_ROUTED_PSAP_FILTERED_MIN_M",

        "CELL_ROUTED_PSAP_FILTERED_MEAN_M",

        "CELL_ROUTED_PSAP_FILTERED_MAX_M",


        "ESPOSREQ_ROUTED_PSAP_FILTERED_MIN_M",

        "ESPOSREQ_ROUTED_PSAP_FILTERED_MEAN_M",

        "ESPOSREQ_ROUTED_PSAP_FILTERED_MAX_M",
    ]


    anchor_columns = [

        column

        for column
        in anchor_columns

        if column
        in part.columns
    ]


    stats_columns = [

        column

        for column
        in stats_columns

        if column
        in part.columns
    ]


    remaining_columns = [

        column

        for column
        in part.columns

        if column
        not in (
            anchor_columns
            +
            stats_columns
        )
    ]


    part = part[

        anchor_columns

        +

        stats_columns

        +

        remaining_columns
    ]


    # -----------------------------------------------------------------
    # Final numeric normalization.
    # -----------------------------------------------------------------

    for column in part.columns:

        if (

            column.endswith(
                "_M"
            )

            or

            column.endswith(
                "_LAT"
            )

            or

            column.endswith(
                "_LON"
            )

            or

            column.endswith(
                "_LATITUDE"
            )

            or

            column.endswith(
                "_LONGITUDE"
            )

            or

            column.endswith(
                "_SEC"
            )
        ):

            part[
                column
            ] = pd.to_numeric(

                part[
                    column
                ],

                errors="coerce"
            )


    part.to_csv(

        OUTPUT_CSV,

        mode=(
            "a"
            if final_header_written
            else "w"
        ),

        header=(
            not final_header_written
        ),

        index=False,

        float_format="%.3f"
    )


    final_header_written = True


