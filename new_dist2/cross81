    )


    chunk[
        "ROUTED_FCC_PSAP_ID_GMLC"
    ] = (
        chunk[
            "FCC_PSAP_ID"
        ]
        .map(
            raw_id
        )
    )


    # -----------------------------------------------------------------
    # GMLC names — DISPLAY ONLY
    # -----------------------------------------------------------------

    chunk[
        "ROUTED_NAME_GMLC_ROUTE_PSAP_NAME"
    ] = (

        chunk[
            "ROUTE_PSAP_NAME"
        ]
        .fillna("")
        .str.strip()

        if "ROUTE_PSAP_NAME"
        in chunk.columns

        else ""
    )


    chunk[
        "ROUTED_NAME_GMLC_PSAP_NAME"
    ] = (

        chunk[
            "PSAP_NAME"
        ]
        .fillna("")
        .str.strip()

        if "PSAP_NAME"
        in chunk.columns

        else ""
    )


    chunk[
        "ROUTED_NAME_GMLC_PSAP_NAME_ESRK"
    ] = (

        chunk[
            "PSAP_NAME_ESRK"
        ]
        .fillna("")
        .str.strip()

        if "PSAP_NAME_ESRK"
        in chunk.columns

        else ""
    )


    # =================================================================
    # RESOLVE ROUTED PSAP
    # =================================================================

    routed_results = pd.DataFrame(

        [

            resolve_routed(
                psap_id,
                fcc_id
            )

            for psap_id, fcc_id
            in zip(

                chunk[
                    "PSAP_ID"
                ],

                chunk[
                    "FCC_PSAP_ID"
                ]
            )
        ],

        index=chunk.index
    )


    chunk = pd.concat(

        [
            chunk,
            routed_results
        ],

        axis=1
    )


    # =================================================================
    # LOCATION ALIASES
    # =================================================================

    chunk[
        "CALLER_LATITUDE"
    ] = numeric_series(
        chunk[
            "LATITUDE"
        ]
    )


    chunk[
        "CALLER_LONGITUDE"
    ] = numeric_series(
        chunk[
            "LONGITUDE"
        ]
    )


    chunk[
        "CELL_LATITUDE_USED"
    ] = numeric_series(
        chunk[
            "CELL_LATITUDE"
        ]
    )


    chunk[
        "CELL_LONGITUDE_USED"
    ] = numeric_series(
        chunk[
            "CELL_LONGITUDE"
        ]
    )


    chunk[
        "ESPOSREQ_LATITUDE"
    ] = (

        numeric_series(
            chunk[
                "ESPOSREQ_LOC_LATITUDE"
            ]
        )

        if "ESPOSREQ_LOC_LATITUDE"
        in chunk.columns

        else np.nan
    )


    chunk[
        "ESPOSREQ_LONGITUDE"
    ] = (

        numeric_series(
            chunk[
                "ESPOSREQ_LOC_LONGITUDE"
            ]
        )

        if "ESPOSREQ_LOC_LONGITUDE"
        in chunk.columns

        else np.nan
    )


    # =================================================================
    # PRE-FILTER ROUTED DISTANCES
    #
    # Only calculate a full-dataset routed distance for location sources
    # whose distance filters are enabled.
    #
    # Example with default configuration:
    #
    #     Caller: YES
    #     Cell: NO
    #     ESPOSREQ: NO
    #
    # This materially reduces work on ~4.6M rows.
    # =================================================================

    routed_distance_computed = set()


    for prefix, config in (
        LOCATION_CONFIG.items()
    ):

        if distance_filter_enabled(

            config[
                "MIN"
            ],

            config[
                "MAX"
            ]
        ):

            chunk = add_boundary_distance(

                chunk,

                prefix,

                config[
                    "LAT"
                ],

                config[
                    "LON"
                ],

                "ROUTED_NENA_CANON",

                target="ROUTED"
            )


            routed_distance_computed.add(
                prefix
            )


    # =================================================================
    # EARLY DISTANCE / DURATION / MARKET FILTER
    # =================================================================

    candidate = (

        chunk.loc[
            candidate_mask(
                chunk
            )
        ]

        .copy()

        .reset_index(
            drop=True
        )
    )


    if candidate.empty:

        print(

            f"Chunk {chunk_number:03d} | "
            f"processed {processed:,} | "
            f"saved {saved:,}"
        )

        continue


    # =================================================================
    # CALCULATE MISSING ROUTED DISTANCES ON CANDIDATE SUBSET ONLY
    # =================================================================

    for prefix, config in (
        LOCATION_CONFIG.items()
    ):

        if prefix in routed_distance_computed:

            continue


        candidate = add_boundary_distance(

            candidate,

            prefix,

            config[
                "LAT"
            ],

            config[
                "LON"
            ],

            "ROUTED_NENA_CANON",

            target="ROUTED"
        )


    # =================================================================
    # BETWEEN-LOCATION DISTANCES
    # =================================================================

    candidate[
        "CALLER_TO_CELL_M"
    ] = geod_distance(

        candidate[
            "CALLER_LATITUDE"
        ],

        candidate[
            "CALLER_LONGITUDE"
        ],

        candidate[
            "CELL_LATITUDE_USED"
        ],

        candidate[
            "CELL_LONGITUDE_USED"
        ]
    )


    candidate[
        "CALLER_TO_ESPOSREQ_M"
    ] = geod_distance(

        candidate[
            "CALLER_LATITUDE"
        ],

        candidate[
            "CALLER_LONGITUDE"
        ],

        candidate[
            "ESPOSREQ_LATITUDE"
        ],

        candidate[
            "ESPOSREQ_LONGITUDE"
        ]
    )


    candidate[
        "CELL_TO_ESPOSREQ_M"
    ] = geod_distance(

        candidate[
            "CELL_LATITUDE_USED"
        ],

        candidate[
            "CELL_LONGITUDE_USED"
        ],

        candidate[
            "ESPOSREQ_LATITUDE"
        ],

        candidate[
            "ESPOSREQ_LONGITUDE"
        ]
    )


    # =================================================================
    # EXPECTED PSAP — SPATIAL JOIN
    # =================================================================

    candidate = assign_expected(

        candidate,

        "CALLER",

        "CALLER_LATITUDE",

        "CALLER_LONGITUDE"
    )


    candidate = assign_expected(

        candidate,

        "CELL",

        "CELL_LATITUDE_USED",

        "CELL_LONGITUDE_USED"
    )


    candidate = assign_expected(

        candidate,

        "ESPOSREQ",

        "ESPOSREQ_LATITUDE",

        "ESPOSREQ_LONGITUDE"
    )


    # =================================================================
    # EXPECTED PSAP DISTANCE + ID COMPARISON
    # =================================================================

    for prefix, config in (
        LOCATION_CONFIG.items()
    ):

        candidate = add_boundary_distance(

            candidate,

            prefix,

            config[
                "LAT"
            ],

            config[
                "LON"
            ],

            f"{prefix}_EXPECTED_NENA_CANON",

            target="EXPECTED"
        )


        candidate = add_identity_status(

            candidate,

            prefix
        )


    # =================================================================
    # OPTIONAL SAME / DIFFERENT FILTERS
    # =================================================================

    for prefix, allowed in [

        (
            "CALLER",
            INCLUDE_CALLER_STATUS
        ),

        (
            "CELL",
            INCLUDE_CELL_STATUS
        ),

        (
            "ESPOSREQ",
            INCLUDE_ESPOSREQ_STATUS
        ),

    ]:

        if allowed is not None:

            candidate = candidate.loc[
                candidate[
                    f"{prefix}_EXPECTED_VS_ROUTED"
                ]
                .isin(
                    allowed
                )
            ].copy()


    if candidate.empty:

        continue


    candidate = candidate.reset_index(
        drop=True
    )


    # =================================================================
    # ABNORMALITY SUMMARY COLUMNS
    # =================================================================

    candidate[
        "ABNORMAL_SOURCE_COUNT"
    ] = (

        candidate[
            [

                "CALLER_EXPECTED_VS_ROUTED",

                "CELL_EXPECTED_VS_ROUTED",

                "ESPOSREQ_EXPECTED_VS_ROUTED",
            ]
        ]

        .eq(
            "DIFFERENT"
        )

        .sum(
            axis=1
        )
    )


    outside_values = pd.DataFrame(
        index=candidate.index
    )


    for prefix in [

        "CALLER",
        "CELL",
        "ESPOSREQ",

    ]:

        outside_values[
            prefix
        ] = np.where(

            candidate[
                f"{prefix}_ROUTED_RELATION"
            ]
            .eq(
                "OUTSIDE"
            ),

            numeric_series(

                candidate[
                    f"{prefix}_TO_ROUTED_BOUNDARY_M"
                ]
            ),

            0.0
        )


    candidate[
        "MAX_OUTSIDE_ROUTED_M"
    ] = outside_values.max(
        axis=1
    )


    candidate[
        "COORDINATE_PATTERN"
    ] = (

        candidate[
            "CALLER_EXPECTED_VS_ROUTED"
        ]

        + "|"

        + candidate[
            "CELL_EXPECTED_VS_ROUTED"
        ]

        + "|"

        + candidate[
            "ESPOSREQ_EXPECTED_VS_ROUTED"
        ]
    )


    # =================================================================
    # FILTERED-COHORT ROUTED PSAP STATISTICS
    # =================================================================
    #
    # IMPORTANT:
    #
    # These are calculated ONLY from rows that survived:
    #
    #   distance filters
    #   duration filters
    #   market filters
    #   optional SAME/DIFFERENT filters
    #
    # =================================================================

    for routed_id, group in candidate.groupby(
        "ROUTED_NENA_CANON"
    ):

        routed_id = canon_id(
            routed_id
        )


        if not routed_id:

            continue


        accumulator = (
            stats_accumulator[
                routed_id
            ]
        )


        accumulator[
            "CALLS"
        ] += len(
            group
        )


        for prefix in [

            "CALLER",
            "CELL",
            "ESPOSREQ",

        ]:

            values = (
                numeric_series(

                    group[
                        f"{prefix}_TO_ROUTED_BOUNDARY_M"
                    ]
                )

                .dropna()
            )


            if values.empty:

                continue


            accumulator[
                f"{prefix}_N"
            ] += len(
                values
            )


            accumulator[
                f"{prefix}_SUM"
            ] += float(
                values.sum()
            )


            accumulator[
                f"{prefix}_MIN"
            ] = min(

                accumulator[
                    f"{prefix}_MIN"
                ],

                float(
                    values.min()
                )
            )


            accumulator[
                f"{prefix}_MAX"
            ] = max(

                accumulator[
                    f"{prefix}_MAX"
                ],

                float(
                    values.max()
                )
            )


    # =================================================================
    # CLEAN COLUMN ORDER
    # =================================================================

    first_columns = [

        # -------------------------------------------------------------
        # PRIMARY FILTER / ABNORMALITY FIELDS
        # -------------------------------------------------------------

        "SOURCE_GMLC_ROW_ID",

        "UNIQ911_CID",

        "ABNORMAL_SOURCE_COUNT",

        "MAX_OUTSIDE_ROUTED_M",

        "COORDINATE_PATTERN",


        # Caller
        "CALLER_EXPECTED_VS_ROUTED",

        "CALLER_ROUTED_RELATION",

        "CALLER_TO_ROUTED_BOUNDARY_M",

        "CALLER_TO_EXPECTED_BOUNDARY_M",


        # Cell
        "CELL_EXPECTED_VS_ROUTED",

        "CELL_ROUTED_RELATION",

        "CELL_TO_ROUTED_BOUNDARY_M",

        "CELL_TO_EXPECTED_BOUNDARY_M",


        # ESPOSREQ
        "ESPOSREQ_EXPECTED_VS_ROUTED",

        "ESPOSREQ_ROUTED_RELATION",

        "ESPOSREQ_TO_ROUTED_BOUNDARY_M",

        "ESPOSREQ_TO_EXPECTED_BOUNDARY_M",


        # Between locations
        "CALLER_TO_CELL_M",

        "CALLER_TO_ESPOSREQ_M",

        "CELL_TO_ESPOSREQ_M",


        # Call
        "CALL_DURATION_SEC",

        "CALL_BEGIN_TIME_UTC",

        "MARKET",

        "STATE",

        "COUNTY",


        # -------------------------------------------------------------
        # ROUTED PSAP IDENTITY
        # -------------------------------------------------------------

        "ROUTED_PSAP_ID_GMLC",

        "ROUTED_FCC_PSAP_ID_GMLC",

        "ROUTED_ID_STATUS",

        "ROUTED_NENA_CANON",

        "ROUTED_NENA_ID_BOUNDARY",

        "ROUTED_FCC_ID_BOUNDARY",


        # Routed names — display only
        "ROUTED_NAME_GMLC_ROUTE_PSAP_NAME",

        "ROUTED_NAME_GMLC_PSAP_NAME",

        "ROUTED_NAME_GMLC_PSAP_NAME_ESRK",

        "ROUTED_AGENCY_BOUNDARY",

        "ROUTED_PSAP_NAME_BOUNDARY",

        "ROUTED_PSAP_NAME_ESRK_BOUNDARY",


        # Approximate routed PSAP map location
        "ROUTED_PSAP_CENTER_LAT",

        "ROUTED_PSAP_CENTER_LON",


        # -------------------------------------------------------------
        # CALLER LOCATION + EXPECTED PSAP
        # -------------------------------------------------------------

        "CALLER_LATITUDE",

        "CALLER_LONGITUDE",

        "CALLER_EXPECTED_NENA_CANON",

        "CALLER_EXPECTED_NENA_ID_BOUNDARY",

        "CALLER_EXPECTED_FCC_ID_BOUNDARY",

        "CALLER_NENA_VS_ROUTED",

        "CALLER_FCC_VS_ROUTED",

        "CALLER_EXPECTED_AGENCY_BOUNDARY",

        "CALLER_EXPECTED_PSAP_NAME_BOUNDARY",

        "CALLER_EXPECTED_PSAP_NAME_ESRK_BOUNDARY",

        "CALLER_EXPECTED_PSAP_CENTER_LAT",

        "CALLER_EXPECTED_PSAP_CENTER_LON",

        "CALLER_EXPECTED_SPATIAL_STATUS",

        "CALLER_EXPECTED_RELATION",


        # -------------------------------------------------------------
        # CELL LOCATION + EXPECTED PSAP
        # -------------------------------------------------------------

        "CELL_LATITUDE_USED",

        "CELL_LONGITUDE_USED",

        "CELL_EXPECTED_NENA_CANON",

        "CELL_EXPECTED_NENA_ID_BOUNDARY",

        "CELL_EXPECTED_FCC_ID_BOUNDARY",

        "CELL_NENA_VS_ROUTED",

        "CELL_FCC_VS_ROUTED",

        "CELL_EXPECTED_AGENCY_BOUNDARY",

        "CELL_EXPECTED_PSAP_NAME_BOUNDARY",

        "CELL_EXPECTED_PSAP_NAME_ESRK_BOUNDARY",

        "CELL_EXPECTED_PSAP_CENTER_LAT",

        "CELL_EXPECTED_PSAP_CENTER_LON",

        "CELL_EXPECTED_SPATIAL_STATUS",

        "CELL_EXPECTED_RELATION",


        # -------------------------------------------------------------
        # ESPOSREQ LOCATION + EXPECTED PSAP
        # -------------------------------------------------------------

        "ESPOSREQ_LATITUDE",

        "ESPOSREQ_LONGITUDE",

        "ESPOSREQ_EXPECTED_NENA_CANON",

        "ESPOSREQ_EXPECTED_NENA_ID_BOUNDARY",

        "ESPOSREQ_EXPECTED_FCC_ID_BOUNDARY",

        "ESPOSREQ_NENA_VS_ROUTED",

        "ESPOSREQ_FCC_VS_ROUTED",

        "ESPOSREQ_EXPECTED_AGENCY_BOUNDARY",

        "ESPOSREQ_EXPECTED_PSAP_NAME_BOUNDARY",

        "ESPOSREQ_EXPECTED_PSAP_NAME_ESRK_BOUNDARY",

        "ESPOSREQ_EXPECTED_PSAP_CENTER_LAT",

        "ESPOSREQ_EXPECTED_PSAP_CENTER_LON",

        "ESPOSREQ_EXPECTED_SPATIAL_STATUS",

        "ESPOSREQ_EXPECTED_RELATION",


        # -------------------------------------------------------------
        # GMLC CONTEXT
        # -------------------------------------------------------------

        "SETUP_ECGI_DEC",

        "PHASE",

        "UNCERT_METERS",

        "ESPOSREQ_LOC_HORIZONTAL_UNCERT",

        "ESPOSREQ_LOC_CONFIDENCE",

        "LOCATION_FIRST_HORIZONTAL_UNCERT",

        "LOCATION_FIRST_CONFIDENCE",

        "VERTICAL_UNCERT",

        "CONFIDENCE",

        "ESPOSREQ_INITIAL_LOCATION_SOURCE",

        "ESPOSREQ_LASTKNOWN_LOCATION_SOURCE",

        "ROUTE_LOCATION_POS_SOURCE",

        "POS_METHOD_USED",

        "NW_METHOD_USED",

        "ROUTE_STATUS_GMLC",

        "ROUTE_ESZ",

        "ROUTE_ESRK",

        "ROUTE_ESINET",

        "ROUTE_FALLBACK",

        "DEFAULT_ROUTED_CALL",

        "LBR_ATTEMPTED",

        "LBR_SUCCESS",

        "LBR_PSAP_DIFF",

        "DISTCELL2XY_M",

        "DISTCELL2PSAPXY_M",

        "DISTXY2PSAPXY_M",

        "CALL_ANOMALY",

        "COMPLETE_CALL",
    ]


    first_columns = [

        column

        for column
        in first_columns

        if column
        in candidate.columns
    ]


    remaining_columns = [

        column

        for column
        in candidate.columns

        if (
            column
            not in first_columns
            and
            not column.startswith(
                "_"
            )
        )
    ]


    output = candidate[
        first_columns
        +
        remaining_columns
    ].copy()


    # -----------------------------------------------------------------
    # Measurement columns -> numeric.
    # -----------------------------------------------------------------

    for column in output.columns:

        if (

            column.endswith(
                "_M"
            )

            or

            column.endswith(
                "_LAT"
            )

            or

            column.endswith(
                "_LON"
            )

            or

            column.endswith(
                "_LATITUDE"
            )

            or

            column.endswith(
                "_LONGITUDE"
            )

            or

            column.endswith(
                "_SEC"
            )
        ):

            output[
                column
            ] = pd.to_numeric(

                output[
                    column
                ],

                errors="coerce"
            )


    # =================================================================
    # TEMP SAVE
    # =================================================================

    output.to_csv(

        TEMP_CSV,

        mode=(
            "a"
            if header_written
            else "w"
        ),

        header=(
            not header_written
        ),

        index=False,

        float_format="%.3f"
    )


    header_written = True


    saved += len(
        output
    )


    print(

        f"Chunk {chunk_number:03d} | "
        f"processed {processed:,} | "
        f"saved {saved:,}"
    )


# =====================================================================
# 16. CREATE FILTERED-COHORT MIN / MEAN / MAX
