# =====================================================================
# 6. LOCAL METRIC PSAP GEOMETRY CACHE
# =====================================================================
#
# Why:
#
# Shapely should not choose a nearest boundary point directly using
# raw longitude/latitude degree units.
#
# For each PSAP we create one local Azimuthal Equidistant projection
# centered on the PSAP's interior reference point.
#
# Workflow:
#
#   WGS84 point/polygon
#       -> local AEQD meters
#       -> nearest boundary point
#       -> inverse to WGS84
#       -> final WGS84 Geod distance
#
# =====================================================================

metric_geometry_cache = {}


def get_metric_model(
    nena
):

    nena = canon_id(
        nena
    )


    if not nena:

        return None


    if nena in metric_geometry_cache:

        return metric_geometry_cache[
            nena
        ]


    geometry = (
        boundary_by_nena.get(
            nena
        )
    )


    center = (
        center_by_nena.get(
            nena
        )
    )


    if (
        geometry is None
        or
        center is None
    ):

        metric_geometry_cache[
            nena
        ] = None

        return None


    lat0, lon0 = (
        center
    )


    local_crs = CRS.from_proj4(

        f"+proj=aeqd "
        f"+lat_0={float(lat0)} "
        f"+lon_0={float(lon0)} "
        f"+datum=WGS84 "
        f"+units=m "
        f"+no_defs"
    )


    forward = Transformer.from_crs(

        "EPSG:4326",

        local_crs,

        always_xy=True
    )


    inverse = Transformer.from_crs(

        local_crs,

        "EPSG:4326",

        always_xy=True
    )


    metric_geometry = shapely_transform(

        forward.transform,

        geometry
    )


    metric_geometry = repair_geom(
        metric_geometry
    )


    model = {

        "WGS84_GEOMETRY":
            geometry,

        "METRIC_GEOMETRY":
            metric_geometry,

        "FORWARD":
            forward,

        "INVERSE":
            inverse,
    }


    metric_geometry_cache[
        nena
    ] = model


    return model


# =====================================================================
# 7. ROUTED PSAP RESOLUTION
