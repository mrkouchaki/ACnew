def txt(value):

    if value is None or pd.isna(value):
        return ""

    value = str(
        value
    ).strip()

    if value.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:

        return ""

    return value


def raw_id(value):
    """
    Reporting representation.
    Preserves leading zeros.
    """

    return re.sub(
        r"\.0$",
        "",
        txt(
            value
        )
    )


def canon_id(value):
    """
    Comparison representation.

    Example:

        GMLC PSAP_ID:
            20200005

        Boundary NENA_ID:
            020200005

        canonical:
            20200005
            20200005
    """

    value = raw_id(
        value
    )

    if not value:
        return ""

    if re.fullmatch(
        r"\d+",
        value
    ):

        try:

            return str(
                int(
                    value
                )
            )

        except Exception:

            pass

    return value.upper()


def split_joined_ids(
    value
):

    values = set()

    for item in txt(
        value
    ).split(
        " | "
    ):

        item = canon_id(
            item
        )

        if item:

            values.add(
                item
            )

    return values


def single_joined_id(
    value
):

    values = split_joined_ids(
        value
    )

    if len(
        values
    ) == 1:

        return next(
            iter(
                values
            )
        )

    return ""


def find_col(
    columns,
    choices,
    required=False
):

    lookup = {

        str(column)
        .strip()
        .upper():
            column

        for column
        in columns
    }


    for choice in choices:

        if choice.upper() in lookup:

            return lookup[
                choice.upper()
            ]


    if required:

        raise RuntimeError(
            f"Missing required column. Tried: {choices}"
        )

    return None


def repair_geom(
    geometry
):

    if (
        geometry is None
        or
        geometry.is_empty
    ):

        return None


    try:

        if not geometry.is_valid:

            geometry = (
                geometry.buffer(
                    0
                )
            )


        if (
            geometry is None
            or
            geometry.is_empty
            or
            not geometry.is_valid
        ):

            return None


        return geometry


    except Exception:

        return None


def uniq_join(
    series
):

    values = []

    for value in series:

        value = txt(
            value
        )


        if (
            value
            and
            value not in values
        ):

            values.append(
                value
            )


    return " | ".join(
        values
    )


def numeric_series(
    series
):

    return pd.to_numeric(
        series,
        errors="coerce"
    )


def valid_xy(
    lat,
    lon
):

    lat = pd.to_numeric(
        lat,
        errors="coerce"
    )


    lon = pd.to_numeric(
        lon,
        errors="coerce"
    )


    return (

        lat.notna()

        &

        lon.notna()

        &

        lat.between(
            -90,
            90
        )

        &

        lon.between(
            -180,
            180
        )

        &

        ~(
            lat.abs().lt(
                1e-10
            )

            &

            lon.abs().lt(
                1e-10
            )
        )
    )


