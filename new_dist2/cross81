# =====================================================================

if not TEMP_CSV.exists():

    raise RuntimeError(
        "No rows passed the configured filters."
    )


delete_if_exists(
    OUTPUT_CSV
)


temp_columns = list(

    pd.read_csv(
        TEMP_CSV,
        nrows=0
    ).columns
)


def protect_as_string(
    column
):

    return (

        column
        in {

            "UNIQ911_CID",

            "PSAP_ID",

            "FCC_PSAP_ID",

            "SETUP_ECGI_DEC",

            "ROUTED_PSAP_ID_GMLC",

            "ROUTED_FCC_PSAP_ID_GMLC",

            "ROUTE_ESZ",

            "ROUTE_ESRK",

            "ROUTE_ESINET",
        }

        or

        "NENA"
        in column

        or

        "FCC_ID"
        in column
    )


final_dtype_map = {

    column:
        "string"

    for column
    in temp_columns

    if protect_as_string(
        column
    )
}


final_header_written = False


for part in pd.read_csv(

    TEMP_CSV,

    chunksize=100_000,

    dtype=final_dtype_map,

    low_memory=False
):

    routed_ids = (
        part[
            "ROUTED_NENA_CANON"
        ]
        .fillna("")
        .astype(str)
        .map(
