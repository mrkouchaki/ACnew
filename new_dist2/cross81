def assign_expected(
    frame,
    prefix,
    lat_col,
    lon_col
):

    frame = frame.reset_index(
        drop=True
    )


    lat = numeric_series(
        frame[
            lat_col
        ]
    )


    lon = numeric_series(
        frame[
            lon_col
        ]
    )


    valid = valid_xy(
        lat,
        lon
    )


    result_columns = {

        f"{prefix}_EXPECTED_NENA_CANON":
            "",

        f"{prefix}_EXPECTED_NENA_ID_BOUNDARY":
            "",

        f"{prefix}_EXPECTED_FCC_ID_BOUNDARY":
            "",

        f"{prefix}_EXPECTED_AGENCY_BOUNDARY":
            "",

        f"{prefix}_EXPECTED_PSAP_NAME_BOUNDARY":
            "",

        f"{prefix}_EXPECTED_PSAP_NAME_ESRK_BOUNDARY":
            "",

        f"{prefix}_EXPECTED_PSAP_CENTER_LAT":
            np.nan,

        f"{prefix}_EXPECTED_PSAP_CENTER_LON":
            np.nan,

        f"{prefix}_EXPECTED_SPATIAL_STATUS":
            "INVALID_OR_MISSING",
    }


    for column, default in (
        result_columns.items()
    ):

        frame[
            column
        ] = default


    if not valid.any():

        return frame


    # -----------------------------------------------------------------
    # Deduplicate identical coordinates.
    # -----------------------------------------------------------------

    valid_positions = np.flatnonzero(
        valid.to_numpy()
    )


    point_rows = pd.DataFrame(
        {

            "_LAT":
                lat.iloc[
                    valid_positions
                ].to_numpy(
                    dtype=float
                ),

            "_LON":
                lon.iloc[
                    valid_positions
                ].to_numpy(
                    dtype=float
                ),
        }
    )


    unique_points = (

        point_rows

        .drop_duplicates()

        .reset_index(
            drop=True
        )
    )


    unique_points[
        "_POINT_ID"
    ] = np.arange(
        len(
            unique_points
        )
    )


    point_gdf = gpd.GeoDataFrame(

        unique_points,

        geometry=gpd.points_from_xy(

            unique_points[
                "_LON"
            ],

            unique_points[
                "_LAT"
            ]
        ),

        crs="EPSG:4326"
    )


    joined = gpd.sjoin(

        point_gdf,

        psap_geo[
            [
                "_NENA",
                "geometry"
            ]
        ],

        how="left",

        predicate="intersects"
    )


    point_lookup = {}


    for point_id, group in joined.groupby(
        "_POINT_ID",
        sort=False
    ):

        ids = sorted(
            {

                txt(
                    value
                )

                for value
                in group[
                    "_NENA"
                ]

                if txt(
                    value
                )
            }
        )


        point_key = (

            float(
                unique_points.at[
                    int(
                        point_id
                    ),
                    "_LAT"
                ]
            ),

            float(
                unique_points.at[
                    int(
                        point_id
                    ),
                    "_LON"
                ]
            )
        )


        if len(
            ids
        ) == 1:

            nena = ids[
                0
            ]


            metadata = (
                meta_by_nena.get(
                    nena,
                    {}
                )
            )


            point_lookup[
                point_key
            ] = (

                nena,

                metadata.get(
                    "NENA_ID_BOUNDARY",
                    ""
                ),

                metadata.get(
                    "FCC_ID_BOUNDARY",
                    ""
                ),

                metadata.get(
                    "AGENCY_BOUNDARY",
                    ""
                ),

                metadata.get(
                    "PSAP_NAME_BOUNDARY",
                    ""
                ),

                metadata.get(
                    "PSAP_NAME_ESRK_BOUNDARY",
                    ""
                ),

                metadata.get(
                    "PSAP_CENTER_LAT",
                    np.nan
                ),

                metadata.get(
                    "PSAP_CENTER_LON",
                    np.nan
                ),

                "UNIQUE_PSAP"
            )


        elif len(
            ids
        ) == 0:

            point_lookup[
                point_key
            ] = (

                "",
                "",
                "",
                "",
                "",
                "",
                np.nan,
                np.nan,
                "NO_CONTAINING_PSAP"
            )


        else:

            point_lookup[
                point_key
            ] = (

                "|".join(
                    ids
                ),

                "",
                "",
                "",
                "",
                "",
                np.nan,
                np.nan,
                "MULTIPLE_PSAP"
            )


    # -----------------------------------------------------------------
    # Apply result to original candidate rows.
    # -----------------------------------------------------------------

    for position in valid_positions:

        result = (
            point_lookup.get(
                (

                    float(
                        lat.iloc[
                            position
                        ]
                    ),

                    float(
                        lon.iloc[
                            position
                        ]
                    )
                )
            )
        )


        if result is None:

            continue


        (
            frame.at[
                position,
                f"{prefix}_EXPECTED_NENA_CANON"
            ],

            frame.at[
                position,
                f"{prefix}_EXPECTED_NENA_ID_BOUNDARY"
            ],

            frame.at[
                position,
                f"{prefix}_EXPECTED_FCC_ID_BOUNDARY"
            ],

            frame.at[
                position,
                f"{prefix}_EXPECTED_AGENCY_BOUNDARY"
            ],

            frame.at[
                position,
                f"{prefix}_EXPECTED_PSAP_NAME_BOUNDARY"
            ],

            frame.at[
                position,
                f"{prefix}_EXPECTED_PSAP_NAME_ESRK_BOUNDARY"
            ],

            frame.at[
                position,
                f"{prefix}_EXPECTED_PSAP_CENTER_LAT"
            ],

            frame.at[
                position,
                f"{prefix}_EXPECTED_PSAP_CENTER_LON"
            ],

            frame.at[
                position,
                f"{prefix}_EXPECTED_SPATIAL_STATUS"
            ],

        ) = result


    return frame


# =====================================================================
# 9. PRECISE DISTANCE TO PSAP BOUNDARY
# =====================================================================
#
# Metric nearest-point selection:
#     local AEQD
#
# Final measurement:
#     WGS84 Geod
#
# =====================================================================

HAS_VECTOR_SHAPELY = all(

    hasattr(
        shapely,
        name
    )

    for name in [

        "points",
        "shortest_line",
        "get_point",
        "get_x",
        "get_y",
        "covers"
    ]
)


def add_boundary_distance(
    frame,
    prefix,
    lat_col,
    lon_col,
    id_col,
    target="ROUTED"
):

    frame = frame.reset_index(
        drop=True
    )


    lat = numeric_series(
        frame[
            lat_col
        ]
    ).to_numpy(
        dtype=float
    )


    lon = numeric_series(
        frame[
            lon_col
        ]
    ).to_numpy(
        dtype=float
    )


    ids = (
        frame[
            id_col
        ]
        .fillna("")
        .astype(str)
        .to_numpy()
    )


    distance_m = np.full(
        len(
            frame
        ),
        np.nan
    )


    relation = np.full(
        len(
            frame
        ),
        "INVALID_OR_MISSING",
        dtype=object
    )


    valid = (

        np.isfinite(
            lat
        )

        &

        np.isfinite(
            lon
        )

        &

        (lat >= -90)
        &
        (lat <= 90)

        &

        (lon >= -180)
        &
        (lon <= 180)

        &

        ~(
            np.isclose(
                lat,
                0
            )

            &

            np.isclose(
                lon,
                0
            )
        )
    )


    relation[
        valid
    ] = (
        "UNRESOLVED_BOUNDARY"
    )


    for nena in pd.unique(
        ids[
            valid
            &
            (ids != "")
        ]
    ):

        if "|" in nena:

            continue


        canonical_nena = canon_id(
            nena
        )


        model = get_metric_model(
            canonical_nena
        )


        if (
            model is None
            or
            model[
                "METRIC_GEOMETRY"
            ]
            is None
        ):

            continue


        wgs84_geometry = (
            model[
                "WGS84_GEOMETRY"
            ]
        )


        metric_geometry = (
            model[
                "METRIC_GEOMETRY"
            ]
        )


        forward = (
            model[
                "FORWARD"
            ]
        )


        inverse = (
            model[
                "INVERSE"
            ]
        )


        indices = np.flatnonzero(

            valid

            &

            (
                ids
                ==
                nena
            )
        )


        if len(
            indices
        ) == 0:

            continue


        # -------------------------------------------------------------
        # Transform all points for this PSAP to its local metric CRS.
        # -------------------------------------------------------------

        x, y = forward.transform(

            lon[
                indices
            ],

            lat[
                indices
            ]
        )


        x = np.asarray(
            x,
            dtype=float
        )


        y = np.asarray(
            y,
            dtype=float
        )


        if HAS_VECTOR_SHAPELY:

            metric_points = shapely.points(
                x,
                y
            )


            metric_lines = shapely.shortest_line(

                metric_points,

                metric_geometry.boundary
            )


            metric_nearest = shapely.get_point(
                metric_lines,
                1
            )


            nearest_x = np.asarray(
                shapely.get_x(
                    metric_nearest
                ),
                dtype=float
            )


            nearest_y = np.asarray(
                shapely.get_y(
                    metric_nearest
                ),
                dtype=float
            )


            # ---------------------------------------------------------
            # Convert nearest metric boundary point back to WGS84.
            # ---------------------------------------------------------

            nearest_lon, nearest_lat = inverse.transform(

                nearest_x,

                nearest_y
            )


            nearest_lon = np.asarray(
                nearest_lon,
                dtype=float
            )


            nearest_lat = np.asarray(
                nearest_lat,
                dtype=float
            )


            # ---------------------------------------------------------
            # FINAL distance is WGS84 Geod, not projected distance.
            # ---------------------------------------------------------

            _, _, geod_distance = GEOD.inv(

                lon[
                    indices
                ],

                lat[
                    indices
                ],

                nearest_lon,

                nearest_lat
            )


            geod_distance = np.abs(
                np.asarray(
                    geod_distance,
                    dtype=float
                )
            )


            distance_m[
                indices
            ] = geod_distance


            # ---------------------------------------------------------
            # INSIDE / OUTSIDE uses polygon topology.
            # ---------------------------------------------------------

            source_points = shapely.points(

                lon[
                    indices
                ],

                lat[
                    indices
                ]
            )


            inside = np.asarray(

                shapely.covers(
                    wgs84_geometry,
                    source_points
                ),

                dtype=bool
            )


            boundary_mask = (
                geod_distance
                <=
                0.05
            )


            relation[
                indices
            ] = np.where(

                boundary_mask,

                "BOUNDARY",

                np.where(

                    inside,

                    "INSIDE",

                    "OUTSIDE"
                )
            )


        else:

            # ---------------------------------------------------------
            # Compatibility fallback.
            # ---------------------------------------------------------

            for local_pos, row_pos in enumerate(
                indices
            ):

                metric_point = Point(

                    float(
                        x[
                            local_pos
                        ]
                    ),

                    float(
                        y[
                            local_pos
                        ]
                    )
                )


                try:

                    _, nearest = nearest_points(

                        metric_point,

                        metric_geometry.boundary
                    )


                    nearest_lon, nearest_lat = inverse.transform(

                        nearest.x,

                        nearest.y
                    )


                    _, _, meters = GEOD.inv(

                        float(
                            lon[
                                row_pos
                            ]
                        ),

                        float(
                            lat[
                                row_pos
                            ]
                        ),

                        float(
                            nearest_lon
                        ),

                        float(
                            nearest_lat
                        )
                    )


                    meters = abs(
                        float(
                            meters
                        )
                    )


                    distance_m[
                        row_pos
                    ] = meters


                    source_point = Point(

                        float(
                            lon[
                                row_pos
                            ]
                        ),

                        float(
                            lat[
                                row_pos
                            ]
                        )
                    )


                    if meters <= 0.05:

                        relation[
                            row_pos
                        ] = (
                            "BOUNDARY"
                        )


                    elif wgs84_geometry.covers(
                        source_point
                    ):

                        relation[
                            row_pos
                        ] = (
                            "INSIDE"
                        )


                    else:

                        relation[
                            row_pos
                        ] = (
                            "OUTSIDE"
                        )


                except Exception:

                    relation[
                        row_pos
                    ] = (
                        "DISTANCE_ERROR"
                    )


    frame[
        f"{prefix}_TO_{target}_BOUNDARY_M"
    ] = distance_m


    frame[
        f"{prefix}_{target}_RELATION"
    ] = relation


    return frame


# =====================================================================
# 10. DISTANCE BETWEEN LOCATION SOURCES
# =====================================================================

def geod_distance(
    lat1,
    lon1,
    lat2,
    lon2
):

    lat1 = numeric_series(
        lat1
    ).to_numpy(
        dtype=float
    )


    lon1 = numeric_series(
        lon1
    ).to_numpy(
        dtype=float
    )


    lat2 = numeric_series(
        lat2
    ).to_numpy(
        dtype=float
    )


    lon2 = numeric_series(
        lon2
    ).to_numpy(
        dtype=float
    )


    valid = (

        np.isfinite(
            lat1
        )

        &

        np.isfinite(
            lon1
        )

        &

        np.isfinite(
            lat2
        )

        &

        np.isfinite(
            lon2
        )

        &

        (lat1 >= -90)
        &
        (lat1 <= 90)

        &

        (lat2 >= -90)
        &
        (lat2 <= 90)

        &

        (lon1 >= -180)
        &
        (lon1 <= 180)

        &

        (lon2 >= -180)
        &
        (lon2 <= 180)

        &

        ~(
            np.isclose(
                lat1,
                0
            )

            &

            np.isclose(
                lon1,
                0
            )
        )

        &

        ~(
            np.isclose(
                lat2,
                0
            )

            &

            np.isclose(
                lon2,
                0
            )
        )
    )


    output = np.full(
        len(
            lat1
        ),
        np.nan
    )


    if valid.any():

        _, _, meters = GEOD.inv(

            lon1[
                valid
            ],

            lat1[
                valid
            ],

            lon2[
                valid
            ],

            lat2[
                valid
            ]
        )


        output[
            valid
        ] = np.abs(
            np.asarray(
                meters,
                dtype=float
            )
        )


    return output


