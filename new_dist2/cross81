def add_identity_status(
    frame,
    prefix
):

    routed_nena = (
        frame[
            "ROUTED_NENA_CANON"
        ]
        .fillna("")
        .astype(str)
        .map(
            canon_id
        )
    )


    routed_fcc = (
        frame[
            "ROUTED_FCC_ID_BOUNDARY"
        ]
        .fillna("")
        .astype(str)
        .map(
            single_joined_id
        )
    )


    expected_nena = (
        frame[
            f"{prefix}_EXPECTED_NENA_CANON"
        ]
        .fillna("")
        .astype(str)
    )


    expected_nena = expected_nena.map(

        lambda value:

            canon_id(
                value
            )

            if "|" not in value

            else ""
    )


    expected_fcc = (
        frame[
            f"{prefix}_EXPECTED_FCC_ID_BOUNDARY"
        ]
        .fillna("")
        .astype(str)
        .map(
            single_joined_id
        )
    )


    frame[
        f"{prefix}_NENA_VS_ROUTED"
    ] = np.where(

        routed_nena.ne("")
        &
        expected_nena.ne(""),

        np.where(

            routed_nena
            ==
            expected_nena,

            "SAME",

            "DIFFERENT"
        ),

        "UNRESOLVED"
    )


    frame[
        f"{prefix}_FCC_VS_ROUTED"
    ] = np.where(

        routed_fcc.ne("")
        &
        expected_fcc.ne(""),

        np.where(

            routed_fcc
            ==
            expected_fcc,

            "SAME",

            "DIFFERENT"
        ),

        "UNRESOLVED"
    )


    # -----------------------------------------------------------------
    # Overall expected-vs-routed PSAP identity.
    #
    # BOTH IDs same:
    #     SAME
    #
    # Either ID different:
    #     DIFFERENT
    #
    # Otherwise:
    #     UNRESOLVED
    # -----------------------------------------------------------------

    frame[
        f"{prefix}_EXPECTED_VS_ROUTED"
    ] = np.where(

        (
            frame[
                f"{prefix}_NENA_VS_ROUTED"
            ]
            ==
            "SAME"
        )

        &

        (
            frame[
                f"{prefix}_FCC_VS_ROUTED"
            ]
            ==
            "SAME"
        ),

        "SAME",

        np.where(

            (
                frame[
                    f"{prefix}_NENA_VS_ROUTED"
                ]
                ==
                "DIFFERENT"
            )

            |

            (
                frame[
                    f"{prefix}_FCC_VS_ROUTED"
                ]
                ==
                "DIFFERENT"
            ),

            "DIFFERENT",

            "UNRESOLVED"
        )
    )


    return frame


# =====================================================================
# 12. FILTER HELPERS
# =====================================================================

def distance_filter_enabled(
    minimum,
    maximum
):

    return (
        minimum is not None
        or
        maximum is not None
    )


def range_filter(
    frame,
    prefix,
    minimum,
    maximum
):

    if not distance_filter_enabled(
        minimum,
        maximum
    ):

        return None


    distance = numeric_series(

        frame[
            f"{prefix}_TO_ROUTED_BOUNDARY_M"
        ]
    )


    mask = (

        distance.notna()

        &

        frame[
            f"{prefix}_ROUTED_RELATION"
        ]
        .eq(
            "OUTSIDE"
        )
    )


    if minimum is not None:

        mask &= (
            distance
            >=
            float(
                minimum
            )
        )


    if maximum is not None:

        mask &= (
            distance
            <=
            float(
                maximum
            )
        )


    return mask


def candidate_mask(
    frame
):

    masks = []


    caller_mask = range_filter(

        frame,

        "CALLER",

        MIN_CALLER_OUTSIDE_M,

        MAX_CALLER_OUTSIDE_M
    )


    cell_mask = range_filter(

        frame,

        "CELL",

        MIN_CELL_OUTSIDE_M,

        MAX_CELL_OUTSIDE_M
    )


    esposreq_mask = range_filter(

        frame,

        "ESPOSREQ",

        MIN_ESPOSREQ_OUTSIDE_M,

        MAX_ESPOSREQ_OUTSIDE_M
    )


    for mask in [

        caller_mask,
        cell_mask,
        esposreq_mask
    ]:

        if mask is not None:

            masks.append(
                mask
            )


    if not masks:

        mask = pd.Series(
            True,
            index=frame.index
        )


    elif len(
        masks
    ) == 1:

        mask = masks[
            0
        ]


    elif FILTER_MODE.upper() == "AND":

        mask = masks[
            0
        ].copy()


        for additional_mask in masks[
            1:
        ]:

            mask &= (
                additional_mask
            )


    elif FILTER_MODE.upper() == "OR":

        mask = masks[
            0
        ].copy()


        for additional_mask in masks[
            1:
        ]:

            mask |= (
                additional_mask
            )


    else:

        raise ValueError(
            "FILTER_MODE must be OR or AND."
        )


    # -----------------------------------------------------------------
    # Duration
    # -----------------------------------------------------------------

    if "CALL_DURATION_SEC" in frame.columns:

        duration = numeric_series(

            frame[
                "CALL_DURATION_SEC"
            ]
        )


        if MIN_CALL_DURATION_SEC is not None:

            mask &= (
                duration
                >=
                float(
                    MIN_CALL_DURATION_SEC
                )
            )


        if MAX_CALL_DURATION_SEC is not None:

            mask &= (
                duration
                <=
                float(
                    MAX_CALL_DURATION_SEC
                )
            )


    # -----------------------------------------------------------------
    # Market
    # -----------------------------------------------------------------

    if (
        INCLUDE_MARKETS is not None
        and
        "MARKET" in frame.columns
    ):

        included = {

            str(
                market
            ).upper()

            for market
            in INCLUDE_MARKETS
        }


        mask &= (

            frame[
                "MARKET"
            ]
            .fillna("")
            .str.upper()
            .isin(
                included
            )
        )


    if (
        EXCLUDE_MARKETS
        and
        "MARKET" in frame.columns
    ):

        excluded = {

            str(
                market
            ).upper()

            for market
            in EXCLUDE_MARKETS
        }


        mask &= ~(

            frame[
                "MARKET"
            ]
            .fillna("")
            .str.upper()
            .isin(
                excluded
            )
        )


    return mask


