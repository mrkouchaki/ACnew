# =====================================================================
# 0. SETTINGS
# =====================================================================

DATA_DIR = Path(r"C:\temp\gmlc_v2")
OUTPUT_DIR = DATA_DIR / "outputs_psap_rca_v5"

INPUT_CSV = OUTPUT_DIR / "strong_misroute_evidence_from_gmlc_v2.csv"
BOUNDARY_PATH = DATA_DIR / "psap" / "Final_Join.tab"
