# Number of strongest cases to map.
MAX_CALLS = 100

# ---------------------------------------------------------------------
# Optional map filters
# ---------------------------------------------------------------------

MIN_CALLER_OUTSIDE_M = None
MAX_CALLER_OUTSIDE_M = None

MIN_CELL_OUTSIDE_M = None
MAX_CELL_OUTSIDE_M = None

MAX_CALLER_CELL_M = None

MIN_CALL_DURATION_SEC = None
MAX_CALL_DURATION_SEC = None

INCLUDE_MARKETS = None
EXCLUDE_MARKETS = set()

# Optional name-role filters.
INCLUDE_ROUTE_NAME_ROLE = None   # example {"EXPECTED_LIKE"}
INCLUDE_PSAP_NAME_ROLE = None    # example {"ROUTED_LIKE"}

# ---------------------------------------------------------------------
# Sort strongest candidates first.
