        "EXPECTED_SOURCE": context,
        "MISROUTE_ROWS_WITH_NAMES": total,
        "DISCRIMINATING_ROWS": discrim,

        "ROUTED_LIKE_ROWS": r["ROUTED_LIKE"],
        "ROUTED_LIKE_PCT":
            100 * r["ROUTED_LIKE"] / discrim if discrim else np.nan,

        "EXPECTED_LIKE_ROWS": r["EXPECTED_LIKE"],
