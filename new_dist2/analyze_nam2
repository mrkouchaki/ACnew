def summarize_distance(name, parts, interpretation):
    if not parts:
        return None

    d = pd.concat(parts, ignore_index=True)
    d["GMLC"] = numeric(d["GMLC"])
    d["OURS"] = numeric(d["OURS"])
    d = d.dropna()

    # 1,000,000 appears to behave like a sentinel in some GMLC rows.
    sentinel = np.isclose(d["GMLC"], 1_000_000, atol=0.5)
    sentinel_pct = 100 * sentinel.mean() if len(d) else np.nan

    clean = d.loc[~sentinel].copy()

    if clean.empty:
        return None

    diff = (clean["GMLC"] - clean["OURS"]).abs()

    return {
        "GMLC_DISTANCE": name,
        "INTERPRETATION": interpretation,
        "SAMPLED_VALID_ROWS": len(clean),
        "GMLC_1M_SENTINEL_PCT": sentinel_pct,
        "PEARSON_R": clean["GMLC"].corr(clean["OURS"], method="pearson"),
        "SPEARMAN_R": clean["GMLC"].corr(clean["OURS"], method="spearman"),
        "MEDIAN_GMLC_M": clean["GMLC"].median(),
        "MEDIAN_OURS_M": clean["OURS"].median(),
        "MEDIAN_ABS_DIFF_M": diff.median(),
        "P95_ABS_DIFF_M": diff.quantile(0.95)
    }

