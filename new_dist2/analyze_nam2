def name_id_summary(field, counter):
    by_name = defaultdict(Counter)
    by_pair = defaultdict(Counter)

    for (name, pair), count in counter.items():
        by_name[name][pair] += count
        by_pair[pair][name] += count

    rows = sum(counter.values())

    unique_to_one_pair = sum(
        1 for c in by_name.values() if len(c) == 1
    )

    modal_pair_rows = sum(
        max(c.values()) for c in by_name.values()
    )

    modal_name_rows = sum(
        max(c.values()) for c in by_pair.values()
    )

    ids_per_name = [len(c) for c in by_name.values()]
    names_per_id = [len(c) for c in by_pair.values()]

    return {
        "FIELD": field,
        "CONFIRMED_ROWS": rows,
        "UNIQUE_NORMALIZED_NAMES": len(by_name),
        "UNIQUE_ID_PAIRS": len(by_pair),

        "NAMES_MAPPING_TO_EXACTLY_ONE_ID_PAIR_PCT":
            100 * unique_to_one_pair / len(by_name) if by_name else np.nan,

        "ROW_WEIGHTED_MODAL_ID_PURITY_PCT":
            100 * modal_pair_rows / rows if rows else np.nan,

        "MEDIAN_ID_PAIRS_PER_NAME":
            np.median(ids_per_name) if ids_per_name else np.nan,

        "MAX_ID_PAIRS_PER_NAME":
            max(ids_per_name) if ids_per_name else np.nan,

        "ROW_WEIGHTED_MODAL_NAME_PER_ID_PURITY_PCT":
            100 * modal_name_rows / rows if rows else np.nan,

        "MEDIAN_NAMES_PER_ID_PAIR":
            np.median(names_per_id) if names_per_id else np.nan,
    }

