def summarize_roles(counter):
    result = Counter()
    discriminating = 0
    total = sum(counter.values())

    for (source, routed, expected), count in counter.items():
        # If routed and expected names themselves look the same,
        # this row cannot tell us which role the GMLC field represents.
        if is_match(compare_norm(routed, expected)):
            result["NON_DISCRIMINATING"] += count
            continue

        discriminating += count
        result[role(source, routed, expected)] += count

    return total, discriminating, result

