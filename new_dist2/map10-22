# =====================================================================
# 10. ADD LAYERS
# =====================================================================

for layer in [
    routed_layer,
    expected_layer,

    caller_routed_lines,
    cell_routed_lines,

    caller_expected_lines,
    cell_expected_lines,

    caller_cell_lines,

    caller_layer,
    cell_layer,
    espos_layer,
]:
    layer.add_to(m)

folium.LayerControl(
    collapsed=False
).add_to(m)


# =====================================================================
# 11. OPTIONAL AUTO FIT
# =====================================================================

if AUTO_FIT_CALLER_POINTS:

    points = [
        [
            float(lat),
            float(lon)
        ]

        for lat, lon
        in zip(
            map_df["CALLER_LATITUDE"],
            map_df["CALLER_LONGITUDE"]
        )

        if valid(
            lat,
            lon
        )
    ]

    if len(points) > 1:
        m.fit_bounds(
            points
        )


# =====================================================================
# 12. SAVE
# =====================================================================

m.save(
    OUTPUT_HTML
)

size_mb = (
    OUTPUT_HTML.stat().st_size
    / 1024
    / 1024
)

print("\nSaved map :", OUTPUT_HTML)
print("Mapped    :", len(map_df))
print("HTML size :", f"{size_mb:.2f} MB")

display(m)

