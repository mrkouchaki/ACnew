        if q is not None:

            folium.PolyLine(
                [
                    [
                        float(clat),
                        float(clon)
                    ],
                    q
                ],
                color="green",
                weight=2,
                dash_array="7,5"
            ).add_to(
                caller_expected_lines
            )


    # -------------------------------------------------------------
    # Cell -> Expected B
    # -------------------------------------------------------------

    if SHOW_CELL_TO_EXPECTED:

        q = nearest_boundary_point(
            cellat,
            cellon,
            expected_geom
        )

        if q is not None:

            folium.PolyLine(
                [
                    [
                        float(cellat),
                        float(cellon)
                    ],
                    q
                ],
                color="green",
                weight=2,
                dash_array="7,5"
            ).add_to(
                cell_expected_lines
            )


    # -------------------------------------------------------------
    # Caller <-> Cell
    # -------------------------------------------------------------

    if (
        SHOW_CALLER_TO_CELL
        and valid(clat, clon)
        and valid(cellat, cellon)
    ):

        folium.PolyLine(
            [
                [
                    float(clat),
                    float(clon)
                ],
                [
                    float(cellat),
                    float(cellon)
                ]
            ],
            color="blue",
            weight=2,
            opacity=0.6,
            dash_array="7,6",
            tooltip=(
                f"Caller ↔ Cell: "
                f"{fmt(r.get('CALLER_CELL_DISTANCE_M'))} m"
            )
        ).add_to(
            caller_cell_lines
