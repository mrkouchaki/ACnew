)


# =====================================================================
# 8. DRAW FULL PSAP POLYGONS
# =====================================================================

def draw_psaps(ids, layer, color, label):

    unique_ids = sorted({
        canon(x)
        for x in ids
        if canon(x)
    })

    for nena in unique_ids:

        geom = geom_by_id.get(
            nena
        )

        if geom is None:
            continue

        folium.GeoJson(
            mapping(geom),

            style_function=lambda feature, c=color: {
                "color": c,
                "weight": 2,
                "fillOpacity": 0.03,
            },

            tooltip=(
                f"{label} | "
                f"{safe(nena)} | "
                f"{safe(name_by_id.get(nena,''))}"
            )
        ).add_to(
            layer
        )


draw_psaps(
    map_df["ROUTED_NENA_ID_BOUNDARY"],
    routed_layer,
    "red",
    "PSAP A - Final/Routed"
)

draw_psaps(
    map_df["EXPECTED_PSAP_NENA_ID"],
    expected_layer,
    "green",
    "PSAP B - Expected"
)


# =====================================================================
