    allowed = {
        str(x).upper()
        for x in INCLUDE_MARKETS
    }

    map_df = map_df.loc[
        map_df["MARKET"]
        .fillna("")
        .str.upper()
        .isin(allowed)
    ]

if EXCLUDE_MARKETS:
    blocked = {
        str(x).upper()
        for x in EXCLUDE_MARKETS
    }

    map_df = map_df.loc[
        ~map_df["MARKET"]
        .fillna("")
        .str.upper()
        .isin(blocked)
    ]

if SORT_BY in map_df.columns:
    map_df = map_df.sort_values(
        SORT_BY,
        ascending=not SORT_DESCENDING,
        na_position="last"
    )

if MAX_CALLS is not None:
    map_df = map_df.head(
        int(MAX_CALLS)
    ).copy()

if map_df.empty:
    raise RuntimeError(
        "No rows remain after map filters."
    )

print("Input rows :", f"{len(df):,}")
print("Map calls  :", f"{len(map_df):,}")


# =====================================================================
# 4. LOAD FULL BOUNDARY GEOMETRY
# =====================================================================

try:
    b = gpd.read_file(
        BOUNDARY_PATH,
        engine="pyogrio"
    )
except Exception:
    b = gpd.read_file(
        BOUNDARY_PATH
    )

if b.crs is None:
    raise RuntimeError(
        "Boundary file has no CRS."
    )

if b.crs.to_epsg() != 4326:
    b = b.to_crs(4326)

lookup = {
    str(c).strip().upper(): c
    for c in b.columns
}

NENA_COL = lookup["NENA_ID"]

AGENCY_COL = lookup.get(
    "AGENCY",
    lookup.get("AGENCY_NAME")
)

b["_NENA"] = b[NENA_COL].map(
    canon
)

b["_NAME"] = (
    b[AGENCY_COL]
    .fillna("")
    .astype(str)
    .str.strip()

    if AGENCY_COL
    else ""
)

b["geometry"] = b.geometry.apply(
    lambda g:
        g.buffer(0)
        if g is not None
        and not g.is_empty
        and not g.is_valid
        else g
)

b = b.loc[
    b["_NENA"].ne("")
    & b.geometry.notna()
    & ~b.geometry.is_empty
].copy()

# FULL geometry, exactly like old working map.
bg = (
    b[
        [
            "_NENA",
            "_NAME",
            "geometry"
        ]
    ]
    .dissolve(
        by="_NENA",
        as_index=False,
        aggfunc={"_NAME": "first"}
    )
)

geom_by_id = dict(
    zip(
        bg["_NENA"],
        bg.geometry
    )
)

name_by_id = dict(
    zip(
        bg["_NENA"],
        bg["_NAME"]
    )
)


# =====================================================================
# 5. DEBUG ID COVERAGE
# =====================================================================

routed_ids = {
