                color="green",
                icon="signal"
            )
        ).add_to(
            cell_cluster
        )


    # -------------------------------------------------------------
    # ESPOSREQ MARKER
    # -------------------------------------------------------------

    if valid(elat, elon):

        folium.Marker(
            [
                float(elat),
                float(elon)
            ],

            tooltip=(
                f"ESPOSREQ | {call_id}"
            ),

            icon=folium.Icon(
                color="orange",
                icon="map-marker"
            )
        ).add_to(
            espos_cluster
        )


    # -------------------------------------------------------------
    # Caller -> Routed A
    # -------------------------------------------------------------

    q = nearest_boundary_point(
        clat,
        clon,
        routed_geom
    )

    if (
        SHOW_CALLER_TO_ROUTED
        and q is not None
    ):

        folium.PolyLine(
            [
                [
                    float(clat),
                    float(clon)
                ],
                q
            ],
            color="red",
            weight=2,
            opacity=0.8,
            tooltip=(
                f"Caller → A: "
                f"{fmt(r.get('CALLER_TO_ROUTED_BOUNDARY_M'))} m"
            )
        ).add_to(
            caller_routed_lines
        )


    # -------------------------------------------------------------
    # Cell -> Routed A
    # -------------------------------------------------------------

    q = nearest_boundary_point(
        cellat,
        cellon,
        routed_geom
    )

    if (
        SHOW_CELL_TO_ROUTED
        and q is not None
    ):

        folium.PolyLine(
            [
                [
                    float(cellat),
                    float(cellon)
                ],
                q
            ],
            color="red",
            weight=2,
            opacity=0.55,
            dash_array="6,5",
            tooltip=(
                f"Cell → A: "
                f"{fmt(r.get('CELL_TO_ROUTED_BOUNDARY_M'))} m"
            )
        ).add_to(
            cell_routed_lines
        )


    # -------------------------------------------------------------
    # Caller -> Expected B
