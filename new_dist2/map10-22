    <b>CALL</b><br>
    CID: {safe(call_id)}<br>
    Market: {safe(r.get('MARKET',''))}<br>
    Duration: {fmt(r.get('CALL_DURATION_SEC'))} sec<br>
    USID: {safe(r.get('USID',''))}<br><br>

    <b>PSAP A - FINAL / ROUTED</b><br>
    PSAP_ID: {safe(r.get('PSAP_ID',''))}<br>
    FCC_PSAP_ID: {safe(r.get('FCC_PSAP_ID',''))}<br>
    PSAP_NAME: {safe(r.get('PSAP_NAME',''))}<br>
    Boundary Agency:
    {safe(r.get('ROUTED_AGENCY_BOUNDARY',''))}<br><br>

    <b>PSAP B - EXPECTED</b><br>
    NENA: {safe(r.get('EXPECTED_PSAP_NENA_ID',''))}<br>
    FCC: {safe(r.get('EXPECTED_PSAP_FCC_ID',''))}<br>
    Agency: {safe(r.get('EXPECTED_PSAP_AGENCY',''))}<br><br>

    <b>ROUTE_PSAP_NAME</b><br>
    {safe(r.get('ROUTE_PSAP_NAME',''))}<br>
    Role:
    {safe(r.get('ROUTE_PSAP_NAME_ROLE',''))}<br><br>

    Caller → Routed:
    {fmt(r.get('CALLER_TO_ROUTED_BOUNDARY_M'))} m<br>

