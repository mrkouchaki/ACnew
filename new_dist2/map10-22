# =====================================================================
# 1. HELPERS
# =====================================================================

def canon(x):
    if x is None or pd.isna(x):
        return ""

    x = re.sub(
        r"\.0$",
        "",
        str(x).strip()
    )

    if not x or x.upper() in {"NAN", "NONE", "<NA>"}:
        return ""

    if x.isdigit():
        return str(int(x))

    return x.upper()


def valid(lat, lon):
    lat = pd.to_numeric(lat, errors="coerce")
    lon = pd.to_numeric(lon, errors="coerce")

    return (
        pd.notna(lat)
        and pd.notna(lon)
        and -90 <= float(lat) <= 90
        and -180 <= float(lon) <= 180
        and not (
            abs(float(lat)) < 1e-10
            and abs(float(lon)) < 1e-10
        )
    )


def fmt(x, d=1):
    x = pd.to_numeric(x, errors="coerce")

    return (
        "N/A"
        if pd.isna(x)
        else f"{float(x):,.{d}f}"
    )


def safe(x):
    if x is None or pd.isna(x):
        return ""

    return escape(str(x))


def nearest_boundary_point(lat, lon, geom):
    if geom is None or not valid(lat, lon):
        return None

    try:
        p = Point(
            float(lon),
            float(lat)
        )

        _, q = nearest_points(
            p,
            geom.boundary
        )

        return [
            float(q.y),
            float(q.x)
        ]

    except Exception:
        return None


# =====================================================================
