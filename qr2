3. Per-Class Detection Rate

Selected-range Recall

This should replace your static recall chart.

Again, it prefers trusted data on dates where trusted data exists and uses provisional data only for recent dates.

WITH bounds AS (
    SELECT
        $__timeFrom()::date AS start_date,
        $__timeTo()::date AS end_date
),
chosen_source AS (
    SELECT
        h.metric_date,
        CASE
            WHEN BOOL_OR(
                h.record_type = 'DAILY_CONFUSION_MATRIX'
            )
            THEN 'DAILY_CONFUSION_MATRIX'
            ELSE 'DAILY_CONFUSION_MATRIX_PROVISIONAL'
        END AS chosen_record_type
    FROM public.ewoc_ticket_prediction_health h
    CROSS JOIN bounds b
    WHERE h.record_type IN (
        'DAILY_CONFUSION_MATRIX',
        'DAILY_CONFUSION_MATRIX_PROVISIONAL'
    )
      AND h.metric_date BETWEEN b.start_date AND b.end_date
    GROUP BY h.metric_date
),
cm AS (
    SELECT
        h.actual_label,
        h.predicted_label,
        SUM(h.sample_count)::DOUBLE PRECISION AS n
    FROM public.ewoc_ticket_prediction_health h
    JOIN chosen_source s
      ON h.metric_date = s.metric_date
     AND h.record_type = s.chosen_record_type
    GROUP BY
        h.actual_label,
        h.predicted_label
),
actual_totals AS (
    SELECT
        actual_label AS class_label,
        SUM(n) AS class_support,
        SUM(
            CASE
                WHEN actual_label = predicted_label
                THEN n ELSE 0
            END
        ) AS true_positive
    FROM cm
    GROUP BY actual_label
),
predicted_totals AS (
    SELECT
        predicted_label AS class_label,
        SUM(n) AS prediction_count,
        SUM(
            CASE
                WHEN actual_label = predicted_label
                THEN n ELSE 0
            END
        ) AS true_positive
    FROM cm
    GROUP BY predicted_label
)
SELECT
    a.class_label,
    ROUND(
        100.0 * a.true_positive
        / NULLIF(a.class_support, 0),
        2
    ) AS class_recall_pct,
    ROUND(
        100.0 * COALESCE(p.true_positive, 0)
        / NULLIF(p.prediction_count, 0),
        2
    ) AS class_precision_pct,
    a.class_support
FROM actual_totals a
LEFT JOIN predicted_totals p
    USING (class_label)
WHERE a.class_support > 0
ORDER BY
    class_recall_pct ASC,
    class_support DESC;

