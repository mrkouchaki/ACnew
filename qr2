1. Dev Performance on New Data

Selected-range Accuracy + Weighted F1

This is the accurate version. It does not average daily F1. It reconstructs Accuracy and Weighted F1 from the confusion counts inside exactly the selected Grafana time range.

It also prefers trusted data for a date and uses provisional data only when trusted data for that date does not exist.

WITH bounds AS (
    SELECT
        $__timeFrom()::date AS start_date,
        $__timeTo()::date AS end_date
),
chosen_source AS (
    SELECT
        h.metric_date,
        CASE
            WHEN BOOL_OR(
                h.record_type = 'DAILY_CONFUSION_MATRIX'
            )
            THEN 'DAILY_CONFUSION_MATRIX'
            ELSE 'DAILY_CONFUSION_MATRIX_PROVISIONAL'
        END AS chosen_record_type
    FROM public.ewoc_ticket_prediction_health h
    CROSS JOIN bounds b
    WHERE h.record_type IN (
        'DAILY_CONFUSION_MATRIX',
        'DAILY_CONFUSION_MATRIX_PROVISIONAL'
    )
      AND h.metric_date BETWEEN b.start_date AND b.end_date
    GROUP BY h.metric_date
),
cm AS (
    SELECT
        h.actual_label,
        h.predicted_label,
        SUM(h.sample_count)::DOUBLE PRECISION AS n
    FROM public.ewoc_ticket_prediction_health h
    JOIN chosen_source s
      ON h.metric_date = s.metric_date
     AND h.record_type = s.chosen_record_type
    GROUP BY
        h.actual_label,
        h.predicted_label
),
labels AS (
    SELECT actual_label AS class_label FROM cm
    UNION
    SELECT predicted_label AS class_label FROM cm
),
per_class AS (
    SELECT
        l.class_label,
        SUM(
            CASE
                WHEN c.actual_label = l.class_label
                 AND c.predicted_label = l.class_label
                THEN c.n ELSE 0
            END
        ) AS tp,
        SUM(
            CASE
                WHEN c.actual_label <> l.class_label
                 AND c.predicted_label = l.class_label
                THEN c.n ELSE 0
            END
        ) AS fp,
        SUM(
            CASE
                WHEN c.actual_label = l.class_label
                 AND c.predicted_label <> l.class_label
                THEN c.n ELSE 0
            END
        ) AS fn,
        SUM(
            CASE
                WHEN c.actual_label = l.class_label
                THEN c.n ELSE 0
            END
        ) AS support
    FROM labels l
    CROSS JOIN cm c
    GROUP BY l.class_label
),
class_f1 AS (
    SELECT
        class_label,
        support,
        CASE
            WHEN (2 * tp + fp + fn) > 0
            THEN (2 * tp) / (2 * tp + fp + fn)
            ELSE 0
        END AS f1
    FROM per_class
),
overall AS (
    SELECT
        SUM(
            CASE
                WHEN actual_label = predicted_label
                THEN n ELSE 0
            END
        ) / NULLIF(SUM(n), 0) AS accuracy,
        SUM(n) AS sample_count
    FROM cm
),
weighted AS (
    SELECT
        SUM(f1 * support)
            / NULLIF(SUM(support), 0) AS weighted_f1
    FROM class_f1
)
SELECT
    'Accuracy' AS metric,
    o.accuracy AS value,
    o.sample_count
FROM overall o
UNION ALL
SELECT
    'Weighted F1' AS metric,
    w.weighted_f1 AS value,
    o.sample_count
FROM weighted w
CROSS JOIN overall o;

