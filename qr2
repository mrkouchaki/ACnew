4. Prediction Drift: Selected Range vs Previous Equal Range

For this panel, I recommend defining:

Current = whatever period the user selected
Reference = immediately preceding period of the same number of calendar days

Example:

Selected Aug 20–22 → Current = Aug 20,21,22
Reference          → Aug 17,18,19

That makes the panel genuinely zoom-responsive.

WITH bounds AS (
    SELECT
        $__timeFrom()::date AS start_date,
        $__timeTo()::date AS end_date,
        (
            $__timeTo()::date
            - $__timeFrom()::date
            + 1
        )::INTEGER AS day_count
),
current_counts AS (
    SELECT
        h.class_label,
        SUM(h.prediction_count)::DOUBLE PRECISION
            AS prediction_count
    FROM public.ewoc_ticket_prediction_health h
    CROSS JOIN bounds b
    WHERE h.record_type = 'DAILY_CLASS_METRIC'
      AND h.metric_date
          BETWEEN b.start_date AND b.end_date
    GROUP BY h.class_label
),
reference_counts AS (
    SELECT
        h.class_label,
        SUM(h.prediction_count)::DOUBLE PRECISION
            AS prediction_count
    FROM public.ewoc_ticket_prediction_health h
    CROSS JOIN bounds b
    WHERE h.record_type = 'DAILY_CLASS_METRIC'
      AND h.metric_date BETWEEN
          (b.start_date - b.day_count)
          AND
          (b.start_date - 1)
    GROUP BY h.class_label
),
classes AS (
    SELECT class_label FROM current_counts
    UNION
    SELECT class_label FROM reference_counts
),
totals AS (
    SELECT
        COALESCE(
            (SELECT SUM(prediction_count)
             FROM current_counts),
            0
        ) AS current_total,
        COALESCE(
            (SELECT SUM(prediction_count)
             FROM reference_counts),
            0
        ) AS reference_total
),
result AS (
    SELECT
        c.class_label,
        100.0
        * COALESCE(cur.prediction_count, 0)
        / NULLIF(t.current_total, 0)
            AS current_pct,
        100.0
        * COALESCE(ref.prediction_count, 0)
        / NULLIF(t.reference_total, 0)
            AS reference_pct
    FROM classes c
    LEFT JOIN current_counts cur
        USING (class_label)
    LEFT JOIN reference_counts ref
        USING (class_label)
    CROSS JOIN totals t
)
SELECT
    class_label,
    ROUND(current_pct::numeric, 2)
        AS current_pct,
    ROUND(reference_pct::numeric, 2)
        AS reference_pct,
    ROUND(
        (current_pct - reference_pct)::numeric,
        2
    ) AS drift_pct
FROM result
ORDER BY
    ABS(current_pct - reference_pct) DESC NULLS LAST;

