# 5. TEST VALUE OVERLAP WITH GMLC FCC_PSAP_ID AND PSAP_ID
# =====================================================================

gmlc_fcc_values = set(
    gmlc_key_profile[
        "FCC_PSAP_ID_NORM"
    ]
    .dropna()
    .astype(str)
    .str.strip()
)

gmlc_fcc_values.discard("")
gmlc_fcc_values.discard("<NA>")


gmlc_psap_values = set(
    gmlc_key_profile[
        "PSAP_ID_NORM"
    ]
    .dropna()
    .astype(str)
    .str.strip()
)

gmlc_psap_values.discard("")
gmlc_psap_values.discard("<NA>")


overlap_rows = []


for c in candidate_boundary_columns:

    try:

        vals = (
            boundaries[c]
            .astype("string")
            .str.strip()
            .str.replace(
                r"\.0$",
                "",
                regex=True
            )
            .dropna()
        )

        boundary_values = set(
            x
            for x in vals.astype(str)
            if x
            and x != "<NA>"
        )


        fcc_overlap = (
            gmlc_fcc_values
            &
            boundary_values
        )


        psap_overlap = (
            gmlc_psap_values
            &
            boundary_values
        )


        overlap_rows.append({
            "BOUNDARY_COLUMN":
                c,

            "BOUNDARY_UNIQUE_VALUES":
                len(
                    boundary_values
                ),

            "GMLC_FCC_PSAP_ID_OVERLAP":
