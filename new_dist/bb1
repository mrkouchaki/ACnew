                    100
                    * len(psap_overlap)
                    / max(
                        len(gmlc_psap_values),
                        1
                    )
                ),
        })


    except Exception as e:

        overlap_rows.append({
            "BOUNDARY_COLUMN":
                c,

            "ERROR":
                str(e),
        })


overlap_report = (
    pd.DataFrame(
