





# =====================================================================
# VALIDATE GMLC PSAP_ID -> FINAL_JOIN.NENA_ID AS ROUTED PSAP KEY
# =====================================================================
#
# PURPOSE
# -------
# Determine whether:
#
#       GMLC.PSAP_ID
#              ↓ exact
#       Final_Join.NENA_ID
#
# is a safe routed-PSAP boundary mapping.
#
# This DOES NOT change the geographic calculation yet.
#
# =====================================================================

import re
import pandas as pd
import numpy as np


# =====================================================================
# 1. NORMALIZATION
# =====================================================================

def key_norm(value):

    if value is None or pd.isna(value):
        return ""

    text = str(value).strip()

    if text.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:
        return ""

    return re.sub(
        r"\.0$",
        "",
        text
    )


def name_norm(value):

    if value is None or pd.isna(value):
        return ""

    text = str(value).upper().strip()

    # Remove punctuation for diagnostic comparison only.
    text = re.sub(
        r"[^A-Z0-9]+",
        " ",
        text
    )

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


# =====================================================================
# 2. PREPARE FINAL_JOIN BOUNDARY TABLE
# =====================================================================

b = boundaries.copy()


if "NENA_ID" not in b.columns:
    raise RuntimeError(
        "Final_Join.tab does not contain NENA_ID."
    )

if "FCC_ID" not in b.columns:
    raise RuntimeError(
        "Final_Join.tab does not contain FCC_ID."
    )

if "AGENCY" not in b.columns:
    raise RuntimeError(
        "Final_Join.tab does not contain AGENCY."
    )


b["NENA_ID_NORM"] = (
    b["NENA_ID"]
    .map(key_norm)
)

b["FCC_ID_NORM"] = (
    b["FCC_ID"]
    .map(key_norm)
)

b["AGENCY_CLEAN"] = (
    b["AGENCY"]
    .fillna("")
    .astype(str)
    .str.strip()
)

b["AGENCY_NORM"] = (
    b["AGENCY_CLEAN"]
    .map(name_norm)
)


if "STATE" not in b.columns:
    b["STATE"] = ""

if "CITY" not in b.columns:
    b["CITY"] = ""

if "COUNTY" not in b.columns:
    b["COUNTY"] = ""


# =====================================================================
# 3. PROFILE NENA_ID UNIQUENESS
#
# Multiple polygon pieces are okay.
#
# What matters is whether one NENA_ID points to multiple different:
#   - agencies
#   - FCC IDs
#   - states
# =====================================================================

nena_profile = (

    b.loc[
        b["NENA_ID_NORM"].ne("")
    ]

    .groupby(
        "NENA_ID_NORM",
        dropna=False
    )

    .agg(

        BOUNDARY_ROWS=(
            "NENA_ID_NORM",
            "size"
        ),

        DISTINCT_AGENCIES=(
            "AGENCY_NORM",
            "nunique"
        ),

        DISTINCT_FCC_IDS=(
            "FCC_ID_NORM",
            "nunique"
        ),

        DISTINCT_STATES=(
            "STATE",
            "nunique"
        ),

        AGENCIES=(
            "AGENCY_CLEAN",
            lambda x:
                " | ".join(
                    sorted(
                        {
                            str(v).strip()
                            for v in x
                            if str(v).strip()
                        }
                    )
                )[:1500]
        ),

        FCC_IDS=(
            "FCC_ID_NORM",
            lambda x:
                " | ".join(
                    sorted(
                        {
                            str(v).strip()
                            for v in x
                            if str(v).strip()
                        }
                    )
                )
        ),

        STATES=(
            "STATE",
            lambda x:
                " | ".join(
                    sorted(
                        {
                            str(v).strip()
                            for v in x
                            if str(v).strip()
                        }
                    )
                )
        ),

        CITIES=(
            "CITY",
            lambda x:
                " | ".join(
                    sorted(
                        {
                            str(v).strip()
                            for v in x
                            if str(v).strip()
                        }
                    )
                )[:1000]
        ),

