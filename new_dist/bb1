            lambda x:
                " | ".join(
                    sorted(
                        {
                            str(v).strip()
                            for v in x
                            if str(v).strip()
                        }
                    )
                )[:1000]
        ),
    )

    .reset_index()
)


nena_profile["UNIQUE_BOUNDARY_IDENTITY"] = (

    nena_profile["DISTINCT_AGENCIES"].eq(1)
    &
    nena_profile["DISTINCT_FCC_IDS"].eq(1)
)


