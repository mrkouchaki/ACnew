def same_unique_psap(
    a,
    b
):

    a = a.fillna(
        ""
    ).astype(str)

    b = b.fillna(
        ""
    ).astype(str)


    return (

        a.ne("")

        &

        b.ne("")

        &

        ~a.str.contains(
            r"\|",
            regex=True
        )

        &

        ~b.str.contains(
            r"\|",
            regex=True
        )

        &

        a.eq(
            b
        )
    )


