def repair_geometry(g):

    if (
        g is None
        or g.is_empty
    ):
        return None

    try:

        if not g.is_valid:
            g = g.buffer(0)

        if (
            g.is_empty
            or not g.is_valid
        ):
            return None

        return g

    except Exception:
        return None


