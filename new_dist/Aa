def tree_positions(
    geometry
):

    hits = tree.query(
        geometry
    )

    out = []

    for hit in hits:

        if isinstance(
            hit,
            (int, np.integer)
        ):

            out.append(
                int(hit)
            )

        else:

            pos = geom_position.get(
                id(hit)
            )

            if pos is not None:
                out.append(
                    pos
                )

    return out


def distance_to_boundary_m(
    lat,
    lon,
    geom
):

    if (
        geom is None
        or
        not valid_latlon(
            lat,
            lon
        )
    ):

        return np.nan


    point = Point(
        float(lon),
        float(lat)
    )


    try:

        _, near = nearest_points(
            point,
            geom.boundary
        )


        _, _, d = geod.inv(

            float(lon),
            float(lat),

            near.x,
            near.y
        )


        return abs(
            float(d)
        )

    except Exception:

        return np.nan


def analyze_point(
    lat_value,
    lon_value,
    routed_value,
):

    lat = pd.to_numeric(
        lat_value,
        errors="coerce"
    )

    lon = pd.to_numeric(
        lon_value,
        errors="coerce"
    )

    routed = norm_id(
        routed_value
    )


    if not valid_latlon(
        lat,
        lon
    ):

        return {

            "POINT_STATUS":
                "INVALID_OR_MISSING",

            "POINT_PSAP_ID":
                "",

            "POINT_PSAP_NAME":
                "",

            "POINT_PSAP_COUNT":
                0,

            "MATCHES_ROUTED_PSAP":
                False,

            "ROUTED_RELATION":
                "INVALID_OR_MISSING",

            "TO_ROUTED_BOUNDARY_M":
                np.nan,

            "SIGNED_TO_ROUTED_BOUNDARY_M":
                np.nan,

            "TO_OWN_PSAP_BOUNDARY_M":
                np.nan,
        }


    lat = float(lat)
    lon = float(lon)

    point = Point(
        lon,
        lat
    )


    inside = sorted(
        set(

            boundary_fcc[pos]

            for pos in tree_positions(
                point
            )

            if boundary_geometries[
                pos
            ].covers(
                point
            )
        )
    )


    if len(inside) == 1:

        point_status = (
            "UNIQUE_PSAP"
        )

        point_psap = (
            inside[0]
        )

        point_name = (
            boundary_names.get(
                point_psap,
                ""
            )
        )

    elif len(inside) == 0:

        point_status = (
            "NO_CONTAINING_PSAP"
        )

        point_psap = ""

        point_name = ""

    else:

        point_status = (
            "MULTIPLE_PSAP"
        )

        point_psap = "|".join(
            inside
        )

        point_name = ""


    routed_geom = (
        boundary_by_fcc.get(
            routed
        )
    )


    if routed_geom is None:

        relation = (
            "MISSING_ROUTED_BOUNDARY"
        )

        routed_distance = np.nan

        signed_distance = np.nan

    else:

        routed_distance = (
            distance_to_boundary_m(
                lat,
                lon,
                routed_geom
            )
        )


        if routed_geom.covers(
            point
        ):

            relation = "INSIDE"

            signed_distance = (
                -routed_distance
            )

        elif routed_geom.intersects(
            point
        ):

            relation = "BOUNDARY"

            signed_distance = 0.0

        else:

            relation = "OUTSIDE"

            signed_distance = (
                routed_distance
            )


    own_distance = np.nan


    if len(inside) == 1:

        own_geom = (
            boundary_by_fcc.get(
                inside[0]
            )
        )

        own_distance = (
            distance_to_boundary_m(
                lat,
                lon,
                own_geom
            )
        )


    return {

        "POINT_STATUS":
            point_status,

        "POINT_PSAP_ID":
            point_psap,

        "POINT_PSAP_NAME":
            point_name,

        "POINT_PSAP_COUNT":
            len(inside),

        "MATCHES_ROUTED_PSAP":
            (
                len(inside) == 1
                and
                inside[0] == routed
            ),

        "ROUTED_RELATION":
            relation,

        "TO_ROUTED_BOUNDARY_M":
            routed_distance,

        "SIGNED_TO_ROUTED_BOUNDARY_M":
            signed_distance,

        "TO_OWN_PSAP_BOUNDARY_M":
            own_distance,
    }


