def vector_geodesic_distance(
    lat1,
    lon1,
    lat2,
    lon2,
):

    lat1 = numeric(
        lat1
    ).to_numpy(
        dtype=float
    )

    lon1 = numeric(
        lon1
    ).to_numpy(
        dtype=float
    )

    lat2 = numeric(
        lat2
    ).to_numpy(
        dtype=float
    )

    lon2 = numeric(
        lon2
    ).to_numpy(
        dtype=float
    )


    valid = (

        np.isfinite(lat1)
        &
        np.isfinite(lon1)
        &
        np.isfinite(lat2)
        &
        np.isfinite(lon2)

        &
        (lat1 >= -90)
        &
        (lat1 <= 90)

        &
        (lat2 >= -90)
        &
        (lat2 <= 90)

        &
        (lon1 >= -180)
        &
        (lon1 <= 180)

        &
        (lon2 >= -180)
        &
        (lon2 <= 180)
    )


    out = np.full(
        len(lat1),
        np.nan
    )


    if valid.any():

        _, _, d = geod.inv(

            lon1[valid],
            lat1[valid],

            lon2[valid],
            lat2[valid]
        )


        out[
            valid
        ] = np.abs(
            d
        )


    return out


