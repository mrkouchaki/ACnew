def coordinate_pattern(
    row
):

    c = bool(
        row.CALLER_MATCHES_ROUTED_PSAP
    )

    s = bool(
        row.CELL_MATCHES_ROUTED_PSAP
    )

    e = bool(
        row.ESPOSREQ_MATCHES_ROUTED_PSAP
    )


    if c and s and e:

        return (
            "ALL_3_SUPPORT_ROUTED_PSAP"
        )


    if (
        not c
        and s
        and e
    ):

        return (
            "CALLER_DIFFERS_CELL_ESPOSREQ_SUPPORT_ROUTED"
        )


    if (
        c
        and s
        and not e
    ):

        return (
            "ESPOSREQ_DIFFERS_CALLER_CELL_SUPPORT_ROUTED"
        )


    if (
        c
        and not s
        and e
    ):

        return (
            "CELL_DIFFERS_CALLER_ESPOSREQ_SUPPORT_ROUTED"
        )


    if (
        not c
        and not s
        and not e
    ):

        return (
            "NONE_SUPPORT_ROUTED_PSAP"
        )


    return (
        "MIXED_COORDINATE_EVIDENCE"
    )


