    )
)


agency_ref[
    "AGENCY_TOKEN_KEY"
] = (
    agency_ref[
        "AGENCY_CLEAN"
    ]
    .map(
        token_signature
    )
)


agency_ref[
    "AGENCY_TOKEN_NO_CODE_KEY"
] = (
    agency_ref[
        "AGENCY_CLEAN"
    ]
    .map(
        token_signature_no_trailing_code
    )
)


# =====================================================================
# 3. CREATE ONLY UNIQUE NAME -> NENA LOOKUPS
# =====================================================================

def build_unique_lookup(
    frame,
    key_column
):

    valid = (
        frame.loc[
            frame[
                key_column
            ].ne("")
        ]
        .copy()
    )


    profile = (
        valid
        .groupby(
            key_column
        )
        .agg(

            NENA_COUNT=(
                "NENA_ID_NORM",
                "nunique"
            ),

            NENA_ID=(
                "NENA_ID_NORM",
                "first"
            ),

            FCC_ID=(
                "FCC_ID_NORM",
                "first"
            ),

            AGENCY=(
                "AGENCY_CLEAN",
                "first"
            ),
        )
        .reset_index()
    )


    # Critical safety condition:
    # accept only names identifying ONE NENA boundary.
    unique_profile = (
        profile.loc[
            profile[
                "NENA_COUNT"
            ].eq(1)
        ]
        .copy()
    )


    return {
        row[
            key_column
        ]: {
            "NENA_ID":
                row[
                    "NENA_ID"
                ],

            "FCC_ID":
                row[
                    "FCC_ID"
                ],

            "AGENCY":
                row[
                    "AGENCY"
                ],
        }

        for _, row
        in unique_profile.iterrows()
    }


exact_name_lookup = build_unique_lookup(
    agency_ref,
    "AGENCY_EXACT_NORM"
)


token_name_lookup = build_unique_lookup(
    agency_ref,
    "AGENCY_TOKEN_KEY"
)


token_no_code_lookup = build_unique_lookup(
    agency_ref,
    "AGENCY_TOKEN_NO_CODE_KEY"
)


print(
    "Unique exact agency names:",
    f"{len(exact_name_lookup):,}"
)

print(
    "Unique token signatures:",
    f"{len(token_name_lookup):,}"
)

print(
    "Unique token signatures without trailing code:",
    f"{len(token_no_code_lookup):,}"
)


