





# =====================================================================
# TIER 3 ROUTED-BOUNDARY RESOLUTION:
# GLOBAL ROUTED NAME -> UNIQUE FINAL_JOIN AGENCY/NENA_ID
# =====================================================================
#
# Run AFTER the previous routed-boundary resolution cell.
#
# Existing resolution:
#
#   1. EXACT_PSAP_ID_TO_NENA_ID
#   2. FCC_ID_PLUS_ROUTED_NAME
#
# New safe tiers:
#
#   3. GLOBAL_EXACT_ROUTED_NAME
#   4. GLOBAL_TOKEN_NAME
#   5. GLOBAL_TOKEN_NAME_NO_TRAILING_CODE
#
# IMPORTANT:
# A name-based resolution is accepted ONLY when that normalized name
# maps to exactly ONE NENA_ID in Final_Join.
#
# No fuzzy threshold is used in this cell.
#
# =====================================================================

import re
import pandas as pd
import numpy as np


# =====================================================================
# 1. NAME NORMALIZATION
# =====================================================================

def routed_name_norm(value):

    if value is None or pd.isna(value):
        return ""

    text = str(value).upper().strip()

    # Normalize 9-1-1 / 9 1 1 / 911
    text = re.sub(
        r"\b9[\s\-]*1[\s\-]*1\b",
        "911",
        text
    )

    text = text.replace(
        "&",
        " AND "
    )

    # Remove punctuation
    text = re.sub(
        r"[^A-Z0-9]+",
        " ",
        text
    )

    # Collapse spaces
    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()


def token_signature(value):

    normalized = routed_name_norm(
        value
    )

    if not normalized:
        return ""

    tokens = normalized.split()

    # Sorting handles:
    #
    # WASHINGTON DC 911 PSAP
    # vs
    # 911 WASHINGTON DC PSAP
    #
    return " ".join(
        sorted(
            tokens
        )
    )


def token_signature_no_trailing_code(value):

    normalized = routed_name_norm(
        value
    )

    if not normalized:
        return ""

    tokens = normalized.split()

    # Remove only a final long numeric facility/site code.
    #
    # Example:
    #   ALASKA STATE TROOPERS KETCHIKAN GATEWAY 9775
    #
    # becomes:
    #   ALASKA STATE TROOPERS KETCHIKAN GATEWAY
    #
    # This is safe only because we later require the resulting
    # boundary key to identify exactly ONE NENA_ID.
    if (
        tokens
        and
        tokens[-1].isdigit()
        and
        len(tokens[-1]) >= 3
    ):
        tokens = tokens[:-1]

    return " ".join(
        sorted(
            tokens
        )
    )


# =====================================================================
# 2. PREPARE FINAL_JOIN AGENCY IDENTITIES
# =====================================================================

agency_ref = boundary_identity.copy()


agency_ref[
    "AGENCY_EXACT_NORM"
] = (
    agency_ref[
        "AGENCY_CLEAN"
    ]
    .map(
