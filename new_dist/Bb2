# =====================================================================
# 5. APPLY GLOBAL UNIQUE-NAME RESOLUTION
# =====================================================================

new_resolution_count = {
    "GLOBAL_EXACT_ROUTED_NAME": 0,
    "GLOBAL_TOKEN_NAME": 0,
    "GLOBAL_TOKEN_NAME_NO_TRAILING_CODE": 0,
}


for idx in resolved_v2.index:

    # Do NOT replace stronger existing resolution.
    if (
        str(
            resolved_v2.at[
                idx,
                "ROUTED_BOUNDARY_RESOLUTION_METHOD"
            ]
        )
        !=
        "UNRESOLVED"
    ):
        continue


    result = None
    method = None


    # -------------------------------------------------------------
    # TIER 3:
    # Exact normalized routed name
    # -------------------------------------------------------------

    key = (
        resolved_v2.at[
            idx,
            "_ROUTE_NAME_EXACT"
        ]
    )


    if key:

        result = (
            exact_name_lookup.get(
                key
            )
        )


        if result is not None:

            method = (
                "GLOBAL_EXACT_ROUTED_NAME"
            )


    # -------------------------------------------------------------
    # TIER 4:
    # Same tokens but order-independent
    # -------------------------------------------------------------

    if result is None:

        key = (
            resolved_v2.at[
                idx,
                "_ROUTE_NAME_TOKEN"
            ]
        )


        if key:

            result = (
                token_name_lookup.get(
                    key
                )
            )


            if result is not None:

                method = (
                    "GLOBAL_TOKEN_NAME"
                )


    # -------------------------------------------------------------
    # TIER 5:
    # Token identity after dropping a final numeric site code.
    # -------------------------------------------------------------

    if result is None:

        key = (
            resolved_v2.at[
                idx,
                "_ROUTE_NAME_TOKEN_NO_CODE"
            ]
        )


        if key:

            result = (
                token_no_code_lookup.get(
                    key
                )
            )


            if result is not None:

                method = (
                    "GLOBAL_TOKEN_NAME_NO_TRAILING_CODE"
                )


    # -------------------------------------------------------------
    # Accept only uniquely identified boundary.
    # -------------------------------------------------------------

    if result is not None:

        resolved_v2.at[
            idx,
            "ROUTED_BOUNDARY_NENA_ID"
        ] = (
            result[
                "NENA_ID"
            ]
        )


        resolved_v2.at[
            idx,
            "ROUTED_BOUNDARY_FCC_ID"
        ] = (
            result[
                "FCC_ID"
            ]
        )


        resolved_v2.at[
            idx,
            "ROUTED_BOUNDARY_AGENCY"
        ] = (
            result[
                "AGENCY"
            ]
        )


        resolved_v2.at[
            idx,
            "ROUTED_BOUNDARY_RESOLUTION_METHOD"
        ] = method


        new_resolution_count[
            method
        ] += 1


