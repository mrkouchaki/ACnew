





# =====================================================================
# THREE-LOCATION PSAP / COORDINATE RECONCILIATION REPORT v2
# =====================================================================
#
# PURPOSE
# -------
# Diagnostic QA only. Does NOT overwrite v5 geographic labels.
#
# Compare three location families:
#
#   CALLER:
#       LATITUDE / LONGITUDE
#       primary/final caller XY stored in master GMLC
#
#   CELL:
#       CELL_LATITUDE / CELL_LONGITUDE
#       cell/network location
#
#   ESPOSREQ:
#       ESPOSREQ_LOC_LATITUDE / ESPOSREQ_LOC_LONGITUDE
#       ESPOSREQ emergency-location result
#
# Each location is independently checked against PSAP polygons.
#
#
# INPUTS
# ------
# 1. psap_routing_definite_misroutes_filtered_by_routed_distance.csv
#
# 2. C:\temp\gmlc_v2\e911_lte_master_gmlc.csv
#
# 3. C:\temp\gmlc_v2\psap\Final_Join.tab
#
#
# MAIN OUTPUTS
# ------------
# 1. psap_three_location_coordinate_crosscheck_v5.csv
#
#    One row per call with:
#      - explicitly named ROUTED PSAP
#      - CALLER-derived expected PSAP
#      - CELL-derived expected PSAP
#      - ESPOSREQ-derived expected PSAP
#      - distance of every location to ROUTED PSAP boundary
#      - distance of every location to its EXPECTED PSAP boundary
#      - signed routed-boundary distance
#      - caller<->cell, caller<->ESPOSREQ, cell<->ESPOSREQ distances
#      - per-call MIN / MEAN / MAX across all 3 location sources
#      - SAME / CLOSE / DIFFERENT routed-vs-expected classification
#      - original v5 label/results for comparison
#
# 2. psap_three_location_coordinate_summary_v5.csv
#
#    Call counts/rates by coordinate disagreement pattern.
#
# 3. psap_three_location_distance_summary_v5.csv
#
#    Dataset-level COUNT / MIN / MEAN / MAX for:
#      CALLER -> routed boundary
#      CELL -> routed boundary
#      ESPOSREQ -> routed boundary
#      CALLER -> expected boundary
#      CELL -> expected boundary
#      ESPOSREQ -> expected boundary
#      and the three coordinate-to-coordinate distances.
#
#
# IMPORTANT COLUMN NAMING
# -----------------------
# ROUTED_PSAP_*:
#     PSAP the original call record says was routed.
#
# CALLER_EXPECTED_PSAP_*:
#     PSAP polygon containing LATITUDE/LONGITUDE.
#
# CELL_EXPECTED_PSAP_*:
#     PSAP polygon containing CELL_LATITUDE/CELL_LONGITUDE.
#
# ESPOSREQ_EXPECTED_PSAP_*:
#     PSAP polygon containing ESPOSREQ_LOC_LATITUDE/LONGITUDE.
#
#
# SAME / CLOSE / DIFFERENT
# ------------------------
# SAME:
#     expected FCC PSAP == routed FCC PSAP
#
# CLOSE:
#     expected PSAP differs, but point is <= CLOSE_BOUNDARY_M from
#     routed PSAP boundary
#
# DIFFERENT:
#     expected PSAP differs and point is farther away
#
# =====================================================================

from pathlib import Path
from collections import defaultdict
import re
import numpy as np
import pandas as pd
import geopandas as gpd
from pyproj import Geod
from shapely.geometry import Point
from shapely.ops import nearest_points, unary_union
from shapely.strtree import STRtree
from IPython.display import display, Markdown

# =====================================================================
# 0. CONFIGURATION
# =====================================================================

DATA_DIR = globals().get("DATA_DIR", Path(r"C:\temp\gmlc_v2"))
OUTPUT_DIR = globals().get("OUTPUT_DIR", DATA_DIR / "outputs_psap_rca_v5")
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

GMLC_PATH = DATA_DIR / "e911_lte_master_gmlc.csv"
BOUNDARY_PATH = DATA_DIR / "psap" / "Final_Join.tab"
INPUT_FILE = "psap_routing_definite_misroutes_filtered_by_routed_distance.csv"

CSV_CHUNK_ROWS = 100_000

# Change if you want another definition of "CLOSE".
CLOSE_BOUNDARY_M = 5_000.0

input_candidates = [OUTPUT_DIR / INPUT_FILE, DATA_DIR / INPUT_FILE]
INPUT_PATH = next((p for p in input_candidates if p.exists()), None)

if INPUT_PATH is None:
    matches = list(DATA_DIR.rglob(INPUT_FILE))
    if matches:
        INPUT_PATH = matches[0]

if INPUT_PATH is None:
    raise FileNotFoundError(INPUT_FILE)
if not GMLC_PATH.exists():
    raise FileNotFoundError(GMLC_PATH)
if not BOUNDARY_PATH.exists():
    raise FileNotFoundError(BOUNDARY_PATH)

print("Filtered calls :", INPUT_PATH)
print("Raw GMLC       :", GMLC_PATH)
print("PSAP boundaries:", BOUNDARY_PATH)
print("CLOSE threshold:", CLOSE_BOUNDARY_M, "m")

# =====================================================================
# 1. HELPERS
# =====================================================================

def norm_id(value):
    if value is None or pd.isna(value):
        return ""
    return re.sub(r"\.0$", "", str(value).strip().strip('"').upper())

def clean_text(value):
    if value is None or pd.isna(value):
        return ""
    return str(value).strip()

def numeric(series):
    return pd.to_numeric(series, errors="coerce")

def valid_latlon(lat, lon):
    return (
        pd.notna(lat) and pd.notna(lon)
        and -90 <= float(lat) <= 90
        and -180 <= float(lon) <= 180
    )

geod = Geod(ellps="WGS84")

# =====================================================================
# 2. READ FILTERED V5 RESULTS
# =====================================================================

flt = pd.read_csv(INPUT_PATH, dtype="string", low_memory=False)
flt.columns = [str(c).strip().upper() for c in flt.columns]

if "UNIQ911_CID" not in flt.columns:
    raise RuntimeError("Filtered file must contain UNIQ911_CID.")

flt["CID_NORM"] = flt["UNIQ911_CID"].map(norm_id)

v5_fields = [
    "GMLC_ROW_ID", "UNIQ911_CID", "EXPECTED_FCC_PSAP_ID", "FCC_PSAP_ID",
    "PSAP_NAME", "ROUTE_INTEGRITY_STATUS", "DISTANCE_TO_ROUTED_BOUNDARY_M",
    "DISTANCE_TO_EXPECTED_BOUNDARY_M", "MISROUTE_LABEL",
]

keep = [c for c in v5_fields if c in flt.columns]
flt_keep = flt[keep + ["CID_NORM"]].copy()

rename_v5 = {
    c: "V5_" + c for c in keep
    if c not in {"GMLC_ROW_ID", "UNIQ911_CID"}
}
flt_keep = flt_keep.rename(columns=rename_v5)
flt_keep = flt_keep.rename(columns={"UNIQ911_CID": "INPUT_UNIQ911_CID"})

if "GMLC_ROW_ID" in flt_keep:
    flt_keep["GMLC_ROW_ID"] = pd.to_numeric(
        flt_keep["GMLC_ROW_ID"], errors="coerce"
    ).astype("Int64")

target_cids = set(
    flt_keep.loc[flt_keep["CID_NORM"].ne(""), "CID_NORM"]
)

target_row_ids = set()
if "GMLC_ROW_ID" in flt_keep:
    target_row_ids = set(flt_keep["GMLC_ROW_ID"].dropna().astype(int))

print(f"Filtered input calls: {len(flt_keep):,}")

# =====================================================================
# 3. READ REQUIRED ORIGINAL GMLC COLUMNS
# =====================================================================

raw_header = list(pd.read_csv(GMLC_PATH, nrows=0).columns)
header_map = {str(c).strip().upper(): c for c in raw_header}

wanted = [
    "UNIQ911_CID",
    "LATITUDE", "LONGITUDE",
    "CELL_LATITUDE", "CELL_LONGITUDE",
    "ESPOSREQ_LOC_LATITUDE", "ESPOSREQ_LOC_LONGITUDE",
    "UNCERT_METERS",
    "ESPOSREQ_LOC_HORIZONTAL_UNCERT", "ESPOSREQ_LOC_CONFIDENCE",
    "LOCATION_FIRST_HORIZONTAL_UNCERT", "LOCATION_FIRST_CONFIDENCE",
    "VERTICAL_UNCERT", "CONFIDENCE",
    "FCC_PSAP_ID", "PSAP_ID", "PSAP_NAME", "ROUTE_PSAP_NAME",
    "MARKET", "STATE", "COUNTY", "PHASE",
    "POS_METHOD_USED", "NW_METHOD_USED",
    "ESPOSREQ_INITIAL_LOCATION_SOURCE",
    "ESPOSREQ_LASTKNOWN_LOCATION_SOURCE",
    "ROUTE_LOCATION_POS_SOURCE",
    "ROUTE_STATUS_GMLC", "ROUTE_ESZ", "ROUTE_ESINET",
    "ROUTE_FALLBACK", "DEFAULT_ROUTED_CALL",
    "LBR_ATTEMPTED", "LBR_SUCCESS", "LBR_PSAP_DIFF",
    "DISTCELL2XY_M", "DISTCELL2PSAPXY_M", "DISTXY2PSAPXY_M",
    "CALL_DURATION_SEC", "CALL_BEGIN_TIME_UTC", "CALL_END_TIME_UTC",
    "CALL_ANOMALY", "COMPLETE_CALL",
    "CELL_FIPS_CODE", "PSAP_FIPS_CODE",
]

available_wanted = [c for c in wanted if c in header_map]
actual_usecols = [header_map[c] for c in available_wanted]
missing_raw_fields = [c for c in wanted if c not in header_map]

if missing_raw_fields:
    print("\nOptional raw fields not present:")
    for c in missing_raw_fields:
        print(" -", c)

# =====================================================================
# 4. STREAM ORIGINAL GMLC AND RETRIEVE TARGET CALLS
# =====================================================================

selected_chunks = []
row_offset = 0
gmlc_psap_name_map = {}

for chunk_no, chunk in enumerate(
    pd.read_csv(
        GMLC_PATH, dtype="string", chunksize=CSV_CHUNK_ROWS,
        usecols=actual_usecols, low_memory=False, encoding_errors="replace"
    ),
    start=1,
):
    chunk.columns = [str(c).strip().upper() for c in chunk.columns]

    chunk["RAW_GMLC_ROW_ID"] = np.arange(
        row_offset + 1, row_offset + len(chunk) + 1, dtype=np.int64
    )
    row_offset += len(chunk)

    if "UNIQ911_CID" in chunk:
        chunk["CID_NORM"] = chunk["UNIQ911_CID"].map(norm_id)
    else:
        chunk["CID_NORM"] = ""

    # Build FCC PSAP ID -> PSAP name lookup while the file is already scanned.
    if "FCC_PSAP_ID" in chunk and "PSAP_NAME" in chunk:
        pairs = chunk[["FCC_PSAP_ID", "PSAP_NAME"]].dropna().drop_duplicates()
        for fcc, name in pairs.itertuples(index=False, name=None):
            fcc_n, name_n = norm_id(fcc), clean_text(name)
            if fcc_n and name_n and fcc_n not in gmlc_psap_name_map:
                gmlc_psap_name_map[fcc_n] = name_n

    mask = chunk["CID_NORM"].isin(target_cids)
    if target_row_ids:
        mask |= chunk["RAW_GMLC_ROW_ID"].isin(target_row_ids)

    if mask.any():
        selected_chunks.append(chunk.loc[mask].copy())

    if chunk_no % 10 == 0:
        print(f"Scanned {row_offset:,} GMLC rows...")

if not selected_chunks:
    raise RuntimeError("No filtered calls were found in original GMLC CSV.")

raw = pd.concat(selected_chunks, ignore_index=True)
raw["RAW_ROWS_FOR_CID"] = raw.groupby("CID_NORM")["RAW_GMLC_ROW_ID"].transform("size")

print(f"\nMatched raw rows: {len(raw):,}")

# =====================================================================
# 5. EXACT MATCH BACK TO ORIGINAL GMLC ROW
# =====================================================================

if "GMLC_ROW_ID" in flt_keep and flt_keep["GMLC_ROW_ID"].notna().any():
    report = flt_keep.merge(
        raw,
        left_on=["GMLC_ROW_ID", "CID_NORM"],
        right_on=["RAW_GMLC_ROW_ID", "CID_NORM"],
        how="left",
        validate="many_to_one",
    )
    report["RAW_MATCH_METHOD"] = "GMLC_ROW_ID+UNIQ911_CID"
else:
    raw_first = raw.sort_values("RAW_GMLC_ROW_ID").drop_duplicates("CID_NORM")
    report = flt_keep.merge(
        raw_first, on="CID_NORM", how="left", validate="many_to_one"
    )
    report["RAW_MATCH_METHOD"] = "UNIQ911_CID_FIRST_ROW_FALLBACK"

report["RAW_EXACT_MATCH"] = report["RAW_GMLC_ROW_ID"].notna()

print(
    "Exact original GMLC matches:",
    int(report["RAW_EXACT_MATCH"].sum()), "/", len(report)
)

# =====================================================================
# 6. LOAD PSAP BOUNDARIES
# =====================================================================

try:
    geo = gpd.read_file(BOUNDARY_PATH, engine="pyogrio")
except Exception:
    geo = gpd.read_file(BOUNDARY_PATH)

if geo.empty:
    raise RuntimeError("No PSAP boundaries loaded.")

if geo.crs is not None:
    try:
        if geo.crs.to_epsg() != 4326:
            geo = geo.to_crs(epsg=4326)
    except Exception:
        geo = geo.to_crs(epsg=4326)

geo_upper = {str(c).strip().upper(): c for c in geo.columns}

fcc_column = next(
    (geo_upper[c] for c in ["FCC_ID", "FCC_PSAP_ID"] if c in geo_upper),
    None
)
if fcc_column is None:
    raise RuntimeError("PSAP boundary file has no FCC_ID/FCC_PSAP_ID.")

name_column = next(
    (
        geo_upper[c]
        for c in ["PSAP_NAME", "NAME", "AGENCY_NAME", "AGENCY", "PSAP"]
        if c in geo_upper
    ),
    None,
)

def repair_geometry(g):
    if g is None or g.is_empty:
        return None
    try:
        if not g.is_valid:
            g = g.buffer(0)
        return None if g.is_empty or not g.is_valid else g
    except Exception:
        return None

pieces = defaultdict(list)
boundary_names = {}

for _, row in geo.iterrows():
    fcc = norm_id(row[fcc_column])
    geom = repair_geometry(row.geometry)

    if not fcc or geom is None:
        continue

    pieces[fcc].append(geom)

    if name_column is not None and pd.notna(row[name_column]):
        boundary_names[fcc] = clean_text(row[name_column])

boundary_fcc, boundary_geometries = [], []

for fcc, geoms in pieces.items():
    merged = repair_geometry(unary_union(geoms))
    if merged is not None:
        boundary_fcc.append(fcc)
        boundary_geometries.append(merged)

boundary_by_fcc = dict(zip(boundary_fcc, boundary_geometries))
tree = STRtree(boundary_geometries)
geom_position = {id(g): i for i, g in enumerate(boundary_geometries)}

# Boundary name first; GMLC monthly name lookup is fallback.
psap_name_map = dict(gmlc_psap_name_map)
psap_name_map.update({k: v for k, v in boundary_names.items() if v})

print(f"Usable PSAP polygons: {len(boundary_fcc):,}")

# =====================================================================
# 7. PSAP / BOUNDARY FUNCTIONS
# =====================================================================

def tree_positions(geometry):
    hits = tree.query(geometry)
    out = []

    for hit in hits:
        if isinstance(hit, (int, np.integer)):
            out.append(int(hit))
        else:
            pos = geom_position.get(id(hit))
            if pos is not None:
                out.append(pos)

    return out

def distance_to_boundary_m(lat, lon, geom):
    if geom is None or not valid_latlon(lat, lon):
        return np.nan

    point = Point(float(lon), float(lat))

    try:
        _, near = nearest_points(point, geom.boundary)
        _, _, d = geod.inv(float(lon), float(lat), near.x, near.y)
        return abs(float(d))
    except Exception:
        return np.nan

def routed_expected_status(expected_id, routed_id, routed_boundary_distance):
    expected_id, routed_id = norm_id(expected_id), norm_id(routed_id)

    if expected_id and routed_id and expected_id == routed_id:
        return "SAME"

    d = pd.to_numeric(routed_boundary_distance, errors="coerce")

    if expected_id and routed_id and pd.notna(d) and d <= CLOSE_BOUNDARY_M:
        return "CLOSE"

    return "DIFFERENT"

def analyze_point(lat_value, lon_value, routed_value):
    lat = pd.to_numeric(lat_value, errors="coerce")
    lon = pd.to_numeric(lon_value, errors="coerce")
    routed = norm_id(routed_value)

    if not valid_latlon(lat, lon):
        return {
            "EXPECTED_PSAP_FCC_ID": "",
            "EXPECTED_PSAP_NAME": "",
            "POINT_STATUS": "INVALID_OR_MISSING",
            "MATCHES_ROUTED_PSAP": False,
            "ROUTED_RELATION": "INVALID_OR_MISSING",
            "TO_ROUTED_BOUNDARY_M": np.nan,
            "SIGNED_TO_ROUTED_BOUNDARY_M": np.nan,
            "TO_EXPECTED_BOUNDARY_M": np.nan,
            "ROUTED_VS_EXPECTED_STATUS": "DIFFERENT",
        }

    lat, lon = float(lat), float(lon)
    point = Point(lon, lat)

    inside = sorted(
        set(
            boundary_fcc[pos]
            for pos in tree_positions(point)
            if boundary_geometries[pos].covers(point)
        )
    )

    if len(inside) == 1:
        point_status = "UNIQUE_PSAP"
        expected = inside[0]
        expected_name = psap_name_map.get(expected, "")
    elif len(inside) == 0:
        point_status = "NO_CONTAINING_PSAP"
        expected = ""
        expected_name = ""
    else:
        point_status = "MULTIPLE_PSAP"
        expected = "|".join(inside)
        expected_name = ""

    routed_geom = boundary_by_fcc.get(routed)

    if routed_geom is None:
        relation = "MISSING_ROUTED_BOUNDARY"
        routed_distance = np.nan
        signed_distance = np.nan
    else:
        routed_distance = distance_to_boundary_m(lat, lon, routed_geom)

        if routed_geom.covers(point):
            relation = "INSIDE"
            signed_distance = -routed_distance
        elif routed_geom.intersects(point):
            relation = "BOUNDARY"
            signed_distance = 0.0
        else:
            relation = "OUTSIDE"
            signed_distance = routed_distance

    expected_distance = np.nan

    if len(inside) == 1:
        expected_geom = boundary_by_fcc.get(expected)
        expected_distance = distance_to_boundary_m(lat, lon, expected_geom)

    status = routed_expected_status(expected, routed, routed_distance)

    return {
        "EXPECTED_PSAP_FCC_ID": expected,
        "EXPECTED_PSAP_NAME": expected_name,
        "POINT_STATUS": point_status,
        "MATCHES_ROUTED_PSAP": len(inside) == 1 and expected == routed,
        "ROUTED_RELATION": relation,
        "TO_ROUTED_BOUNDARY_M": routed_distance,
        "SIGNED_TO_ROUTED_BOUNDARY_M": signed_distance,
        "TO_EXPECTED_BOUNDARY_M": expected_distance,
        "ROUTED_VS_EXPECTED_STATUS": status,
    }

# =====================================================================
# 8. EXPLICIT ROUTED PSAP COLUMN NAMES
# =====================================================================

for c in [
    "LATITUDE", "LONGITUDE",
    "CELL_LATITUDE", "CELL_LONGITUDE",
    "ESPOSREQ_LOC_LATITUDE", "ESPOSREQ_LOC_LONGITUDE",
]:
    if c not in report:
        report[c] = np.nan
    report[c] = numeric(report[c])

report["ROUTED_PSAP_FCC_ID"] = report["FCC_PSAP_ID"].map(norm_id)

if "PSAP_NAME" not in report:
    report["PSAP_NAME"] = ""
if "ROUTE_PSAP_NAME" not in report:
    report["ROUTE_PSAP_NAME"] = ""

report["ROUTED_PSAP_NAME_MASTER"] = report["PSAP_NAME"].fillna("").astype(str).str.strip()
report["ROUTED_PSAP_NAME_ROUTE"] = report["ROUTE_PSAP_NAME"].fillna("").astype(str).str.strip()

report["ROUTED_PSAP_NAME_RESOLVED"] = report["ROUTED_PSAP_NAME_ROUTE"].where(
    report["ROUTED_PSAP_NAME_ROUTE"].ne(""),
    report["ROUTED_PSAP_NAME_MASTER"]
)

missing_routed_name = report["ROUTED_PSAP_NAME_RESOLVED"].eq("")
report.loc[missing_routed_name, "ROUTED_PSAP_NAME_RESOLVED"] = (
    report.loc[missing_routed_name, "ROUTED_PSAP_FCC_ID"]
    .map(psap_name_map)
    .fillna("")
)

report["ROUTED_SOURCE_NAMES_AGREE"] = (
    report["ROUTED_PSAP_NAME_MASTER"].str.upper()
    ==
    report["ROUTED_PSAP_NAME_ROUTE"].str.upper()
)

report["CALLER_LATITUDE"] = report["LATITUDE"]
report["CALLER_LONGITUDE"] = report["LONGITUDE"]

report["ESPOSREQ_LATITUDE"] = report["ESPOSREQ_LOC_LATITUDE"]
report["ESPOSREQ_LONGITUDE"] = report["ESPOSREQ_LOC_LONGITUDE"]

# =====================================================================
# 9. ANALYZE CALLER / CELL / ESPOSREQ INDEPENDENTLY
# =====================================================================

coordinate_sets = {
    "CALLER": ("CALLER_LATITUDE", "CALLER_LONGITUDE"),
    "CELL": ("CELL_LATITUDE", "CELL_LONGITUDE"),
    "ESPOSREQ": ("ESPOSREQ_LATITUDE", "ESPOSREQ_LONGITUDE"),
}

for prefix, (lat_col, lon_col) in coordinate_sets.items():
    print("Analyzing", prefix, "coordinates...")

    result_df = pd.DataFrame([
        analyze_point(lat, lon, routed)
        for lat, lon, routed in zip(
            report[lat_col],
            report[lon_col],
            report["ROUTED_PSAP_FCC_ID"],
        )
    ])

    result_df = result_df.rename(
        columns={c: f"{prefix}_{c}" for c in result_df.columns}
    )

    report = pd.concat(
        [report.reset_index(drop=True), result_df.reset_index(drop=True)],
        axis=1,
    )

# =====================================================================
# 10. THREE PAIRWISE LOCATION DISTANCES
# =====================================================================

def vector_geodesic_distance(lat1, lon1, lat2, lon2):
    lat1 = numeric(lat1).to_numpy(dtype=float)
    lon1 = numeric(lon1).to_numpy(dtype=float)
    lat2 = numeric(lat2).to_numpy(dtype=float)
    lon2 = numeric(lon2).to_numpy(dtype=float)

    valid = (
        np.isfinite(lat1) & np.isfinite(lon1)
        & np.isfinite(lat2) & np.isfinite(lon2)
        & (lat1 >= -90) & (lat1 <= 90)
        & (lat2 >= -90) & (lat2 <= 90)
        & (lon1 >= -180) & (lon1 <= 180)
        & (lon2 >= -180) & (lon2 <= 180)
    )

    out = np.full(len(lat1), np.nan)

    if valid.any():
        _, _, d = geod.inv(
            lon1[valid], lat1[valid],
            lon2[valid], lat2[valid]
        )
        out[valid] = np.abs(d)

    return out

report["CALLER_TO_CELL_M"] = vector_geodesic_distance(
    report["CALLER_LATITUDE"], report["CALLER_LONGITUDE"],
    report["CELL_LATITUDE"], report["CELL_LONGITUDE"]
)

report["CALLER_TO_ESPOSREQ_M"] = vector_geodesic_distance(
    report["CALLER_LATITUDE"], report["CALLER_LONGITUDE"],
    report["ESPOSREQ_LATITUDE"], report["ESPOSREQ_LONGITUDE"]
)

report["CELL_TO_ESPOSREQ_M"] = vector_geodesic_distance(
    report["CELL_LATITUDE"], report["CELL_LONGITUDE"],
    report["ESPOSREQ_LATITUDE"], report["ESPOSREQ_LONGITUDE"]
)

for c in ["CALLER_TO_CELL_M", "CALLER_TO_ESPOSREQ_M", "CELL_TO_ESPOSREQ_M"]:
    report[c.replace("_M", "_KM")] = report[c] / 1000.0

pair_cols = [
    "CALLER_TO_CELL_KM",
    "CALLER_TO_ESPOSREQ_KM",
    "CELL_TO_ESPOSREQ_KM",
]

report["LOCATION_PAIR_DISTANCE_MIN_KM"] = report[pair_cols].min(axis=1, skipna=True)
report["LOCATION_PAIR_DISTANCE_MEAN_KM"] = report[pair_cols].mean(axis=1, skipna=True)
report["LOCATION_PAIR_DISTANCE_MAX_KM"] = report[pair_cols].max(axis=1, skipna=True)

# Backward-compatible name from prior version.
report["MAX_COORDINATE_SEPARATION_KM"] = report["LOCATION_PAIR_DISTANCE_MAX_KM"]

# =====================================================================
# 11. MIN / MEAN / MAX ACROSS THREE LOCATIONS TO ROUTED BOUNDARY
# =====================================================================

routed_distance_cols = [
    "CALLER_TO_ROUTED_BOUNDARY_M",
    "CELL_TO_ROUTED_BOUNDARY_M",
    "ESPOSREQ_TO_ROUTED_BOUNDARY_M",
]

expected_distance_cols = [
    "CALLER_TO_EXPECTED_BOUNDARY_M",
    "CELL_TO_EXPECTED_BOUNDARY_M",
    "ESPOSREQ_TO_EXPECTED_BOUNDARY_M",
]

report["ROUTED_BOUNDARY_3LOC_MIN_M"] = report[routed_distance_cols].min(axis=1, skipna=True)
report["ROUTED_BOUNDARY_3LOC_MEAN_M"] = report[routed_distance_cols].mean(axis=1, skipna=True)
report["ROUTED_BOUNDARY_3LOC_MAX_M"] = report[routed_distance_cols].max(axis=1, skipna=True)

report["EXPECTED_BOUNDARY_3LOC_MIN_M"] = report[expected_distance_cols].min(axis=1, skipna=True)
report["EXPECTED_BOUNDARY_3LOC_MEAN_M"] = report[expected_distance_cols].mean(axis=1, skipna=True)
report["EXPECTED_BOUNDARY_3LOC_MAX_M"] = report[expected_distance_cols].max(axis=1, skipna=True)

for c in [
    "ROUTED_BOUNDARY_3LOC_MIN_M",
    "ROUTED_BOUNDARY_3LOC_MEAN_M",
    "ROUTED_BOUNDARY_3LOC_MAX_M",
    "EXPECTED_BOUNDARY_3LOC_MIN_M",
    "EXPECTED_BOUNDARY_3LOC_MEAN_M",
    "EXPECTED_BOUNDARY_3LOC_MAX_M",
]:
    report[c.replace("_M", "_KM")] = report[c] / 1000.0

# =====================================================================
# 12. COMPARE SOURCE DISTCELL2XY WITH OUR CALLER<->CELL DISTANCE
# =====================================================================

if "DISTCELL2XY_M" in report:
    report["DISTCELL2XY_M"] = numeric(report["DISTCELL2XY_M"])
    report["DISTCELL2XY_VS_RECALC_ABS_DIFF_M"] = (
        report["DISTCELL2XY_M"] - report["CALLER_TO_CELL_M"]
    ).abs()

# =====================================================================
# 13. COORDINATE AGREEMENT PATTERN
# =====================================================================

def coordinate_pattern(row):
    c = row.CALLER_ROUTED_VS_EXPECTED_STATUS
    s = row.CELL_ROUTED_VS_EXPECTED_STATUS
    e = row.ESPOSREQ_ROUTED_VS_EXPECTED_STATUS

    if c == "SAME" and s == "SAME" and e == "SAME":
        return "ALL_3_SUPPORT_ROUTED_PSAP"

    if c == "DIFFERENT" and s == "SAME" and e == "SAME":
        return "CALLER_DIFFERS_CELL_ESPOSREQ_SUPPORT_ROUTED"

    if c == "SAME" and s == "SAME" and e == "DIFFERENT":
        return "ESPOSREQ_DIFFERS_CALLER_CELL_SUPPORT_ROUTED"

    if c == "SAME" and s == "DIFFERENT" and e == "SAME":
        return "CELL_DIFFERS_CALLER_ESPOSREQ_SUPPORT_ROUTED"

    if c == "DIFFERENT" and s == "DIFFERENT" and e == "DIFFERENT":
        return "NONE_SUPPORT_ROUTED_PSAP"

    if "CLOSE" in {c, s, e}:
        return "NEAR_BOUNDARY_OR_MIXED"

    return "MIXED_COORDINATE_EVIDENCE"

report["COORDINATE_PATTERN"] = report.apply(coordinate_pattern, axis=1)

