


# =====================================================================
# COMPARE Final_Join vs e911_psap_boundaries CSV
#
# Final_Join:
#   NENA_ID
#   FCC_ID
#   AGENCY
#
# CSV:
#   NENA_ID
#   FCC_PSAP_ID
#   PROPERTIES -> extract agency/name if present
# =====================================================================

from pathlib import Path
import json
import re
import pandas as pd
import geopandas as gpd
from IPython.display import display

DATA_DIR = Path(r"C:\temp\gmlc_v2")

FINAL_JOIN = DATA_DIR / "psap" / "Final_Join.tab"

# -------------------------------------------------------------
# Auto-find the CSV so filename spelling does not matter.
# -------------------------------------------------------------

csv_candidates = list(
    DATA_DIR.rglob("*psap*boundar*.csv")
)

print("Possible boundary CSV files:")
for p in csv_candidates:
    print(" -", p)

if not csv_candidates:
    raise FileNotFoundError(
        "No *psap*boundar*.csv file found under C:\\temp\\gmlc_v2"
    )

# If more than one is shown, change [0] to the correct one.
CSV_PATH = csv_candidates[0]

print("\nUsing CSV:", CSV_PATH)


# =====================================================================
# HELPERS
# =====================================================================

def canon_id(x):
    if x is None or pd.isna(x):
        return ""

    x = re.sub(
        r"\.0$",
        "",
        str(x).strip()
    )

    if not x:
        return ""

    if x.isdigit():
        return str(int(x))

    return x.upper()


def norm_name(x):
    if x is None or pd.isna(x):
        return ""

    return re.sub(
        r"\s+",
        " ",
        str(x).strip().upper()
    )


def get_col(df, choices, required=True):
    m = {
        str(c).strip().upper(): c
        for c in df.columns
    }

    for c in choices:
        if c.upper() in m:
            return m[c.upper()]

    if required:
        raise RuntimeError(
            f"Missing column. Tried {choices}. "
            f"Available: {list(df.columns)}"
        )

    return None


# =====================================================================
# EXTRACT AGENCY / PSAP NAME FROM PROPERTIES JSON
# =====================================================================

NAME_KEYS = [
    "AGENCY",
    "AGENCY_NAME",
    "PSAP_NAME",
    "NAME",
    "PSAP",
]


def find_name_recursive(obj):
    """
    Search JSON recursively for likely PSAP/agency name keys.
    """

    if isinstance(obj, dict):

        # First prefer exact useful keys.
        upper = {
            str(k).upper(): v
            for k, v in obj.items()
        }

        for key in NAME_KEYS:
            value = upper.get(key)

            if (
                value is not None
                and str(value).strip()
                and str(value).upper() not in {"NAN", "NONE"}
            ):
                return str(value).strip(), key

        # Then recurse.
        for value in obj.values():
            result = find_name_recursive(value)

            if result[0]:
                return result

    elif isinstance(obj, list):

        for value in obj:
            result = find_name_recursive(value)

            if result[0]:
                return result

    return "", ""


def parse_properties_name(value):
    if value is None or pd.isna(value):
        return "", ""

    text = str(value).strip()

    try:
        obj = json.loads(text)
        return find_name_recursive(obj)

    except Exception:
        return "", ""


# =====================================================================
# 1. LOAD Final_Join
# =====================================================================

final_raw = gpd.read_file(
    FINAL_JOIN
)

FINAL_NENA = get_col(
    final_raw,
    ["NENA_ID"]
)

FINAL_FCC = get_col(
    final_raw,
    ["FCC_ID", "FCC_PSAP_ID"]
)

FINAL_AGENCY = get_col(
    final_raw,
    ["AGENCY", "AGENCY_NAME", "PSAP_NAME"]
)


final = pd.DataFrame({
    "NENA_ID": final_raw[FINAL_NENA].map(canon_id),
    "FCC_ID_FINAL_JOIN": final_raw[FINAL_FCC].map(canon_id),
    "AGENCY_FINAL_JOIN": final_raw[FINAL_AGENCY].map(norm_name),
})


final = (
    final.loc[
        final["NENA_ID"].ne("")
    ]
    .drop_duplicates()
)


# =====================================================================
# 2. LOAD CSV
# =====================================================================

csv_raw = pd.read_csv(
    CSV_PATH,
    dtype="string",
    low_memory=False
)

csv_raw.columns = [
    str(c).strip()
    for c in csv_raw.columns
]


CSV_NENA = get_col(
    csv_raw,
    ["NENA_ID"]
)

CSV_FCC = get_col(
    csv_raw,
    ["FCC_PSAP_ID", "FCC_ID"]
)

CSV_PROPERTIES = get_col(
    csv_raw,
    ["PROPERTIES"]
)


parsed = (
    csv_raw[CSV_PROPERTIES]
    .map(parse_properties_name)
)


csv_psap = pd.DataFrame({
    "NENA_ID": csv_raw[CSV_NENA].map(canon_id),

    "FCC_ID_CSV":
        csv_raw[CSV_FCC].map(canon_id),

    "AGENCY_CSV":
        [
            norm_name(x[0])
            for x in parsed
        ],

    "AGENCY_SOURCE_IN_PROPERTIES":
        [
            x[1]
            for x in parsed
        ],
})


csv_psap = (
    csv_psap.loc[
        csv_psap["NENA_ID"].ne("")
    ]
    .drop_duplicates()
)


# =====================================================================
# 3. COLLAPSE EACH NENA TO ONE COMPARISON ROW
# =====================================================================

def collapse_final(df):

    return (
        df.groupby("NENA_ID")
        .agg(
            FCC_ID_FINAL_JOIN=(
                "FCC_ID_FINAL_JOIN",
                lambda s:
                    " | ".join(sorted(set(x for x in s if x)))
            ),

            AGENCY_FINAL_JOIN=(
                "AGENCY_FINAL_JOIN",
                lambda s:
                    " | ".join(sorted(set(x for x in s if x)))
            )
        )
        .reset_index()
    )


def collapse_csv(df):

    return (
        df.groupby("NENA_ID")
        .agg(
            FCC_ID_CSV=(
                "FCC_ID_CSV",
                lambda s:
                    " | ".join(sorted(set(x for x in s if x)))
            ),

            AGENCY_CSV=(
                "AGENCY_CSV",
                lambda s:
                    " | ".join(sorted(set(x for x in s if x)))
            ),

            CSV_NAME_SOURCE=(
                "AGENCY_SOURCE_IN_PROPERTIES",
                lambda s:
                    " | ".join(sorted(set(x for x in s if x)))
            )
        )
        .reset_index()
    )


a = collapse_final(final)
b = collapse_csv(csv_psap)


# =====================================================================
# 4. COMPARE
# =====================================================================

comparison = a.merge(
    b,
    on="NENA_ID",
    how="outer",
    indicator=True
)


comparison["FCC_MATCH"] = (
    comparison["FCC_ID_FINAL_JOIN"]
    ==
    comparison["FCC_ID_CSV"]
)


comparison["AGENCY_MATCH"] = (
    comparison["AGENCY_FINAL_JOIN"]
    ==
    comparison["AGENCY_CSV"]
)


comparison["STATUS"] = "MATCH"


comparison.loc[
    comparison["_merge"].eq("left_only"),
    "STATUS"
] = "ONLY_FINAL_JOIN"


comparison.loc[
    comparison["_merge"].eq("right_only"),
    "STATUS"
] = "ONLY_CSV"


comparison.loc[
    comparison["_merge"].eq("both")
    &
    ~comparison["FCC_MATCH"],
    "STATUS"
] = "FCC_MISMATCH"


comparison.loc[
    comparison["_merge"].eq("both")
    &
    comparison["FCC_MATCH"]
    &
    comparison["AGENCY_CSV"].fillna("").eq(""),
    "STATUS"
] = "FCC_MATCH_NO_NAME_IN_CSV_PROPERTIES"


comparison.loc[
    comparison["_merge"].eq("both")
    &
    comparison["FCC_MATCH"]
    &
    comparison["AGENCY_CSV"].fillna("").ne("")
    &
    ~comparison["AGENCY_MATCH"],
    "STATUS"
] = "FCC_MATCH_AGENCY_MISMATCH"


# =====================================================================
# 5. DISPLAY
# =====================================================================

print("\n============================")
print("STATUS SUMMARY")
print("============================")

display(
    comparison["STATUS"]
    .value_counts()
    .rename_axis("STATUS")
    .reset_index(name="ROWS")
)


print("\n============================")
print("MISMATCH / QA ROWS")
print("============================")

display(
    comparison.loc[
        comparison["STATUS"].ne("MATCH")
    ][
        [
            "NENA_ID",

            "FCC_ID_FINAL_JOIN",
            "FCC_ID_CSV",
            "FCC_MATCH",

            "AGENCY_FINAL_JOIN",
            "AGENCY_CSV",
            "CSV_NAME_SOURCE",

            "AGENCY_MATCH",
            "STATUS",
        ]
    ]
    .head(200)
)


print("\n============================")
print("SAMPLE MATCHED ROWS")
print("============================")

display(
    comparison.loc[
        comparison["STATUS"].eq("MATCH")
    ][
        [
            "NENA_ID",

            "FCC_ID_FINAL_JOIN",
            "FCC_ID_CSV",

            "AGENCY_FINAL_JOIN",
            "AGENCY_CSV",

            "CSV_NAME_SOURCE",
        ]
    ]
    .head(50)
)

