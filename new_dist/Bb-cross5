def assign_expected_nena_chunk(
    frame,
    prefix,
    lat_col,
    lon_col
):

    n = len(
        frame
    )


    id_output = np.full(
        n,
        "",
        dtype=object
    )

    raw_output = np.full(
        n,
        "",
        dtype=object
    )

    name_output = np.full(
        n,
        "",
        dtype=object
    )

    fcc_output = np.full(
        n,
        "",
        dtype=object
    )

    status_output = np.full(
        n,
        "INVALID_OR_MISSING_COORDINATE",
        dtype=object
    )


    lat = pd.to_numeric(
        frame[
            lat_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    lon = pd.to_numeric(
        frame[
            lon_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    valid = (

        np.isfinite(lat)
        &
        np.isfinite(lon)

        &

        (lat >= -90)
        &
        (lat <= 90)

        &

        (lon >= -180)
        &
        (lon <= 180)

        &

        ~(
            np.isclose(
                lat,
                0
            )
            &
            np.isclose(
                lon,
                0
            )
        )
    )


    valid_positions = np.flatnonzero(
        valid
    )


    if len(
        valid_positions
    ) == 0:

        frame[
            f"{prefix}_EXPECTED_NENA_ID"
        ] = id_output

        frame[
            f"{prefix}_EXPECTED_NENA_ID_RAW"
        ] = raw_output

        frame[
            f"{prefix}_EXPECTED_PSAP_NAME"
        ] = name_output

        frame[
            f"{prefix}_EXPECTED_FCC_ID"
        ] = fcc_output

        frame[
            f"{prefix}_EXPECTED_GEOMETRY_STATUS"
        ] = status_output

        return frame


    # -------------------------------------------------------------
    # Deduplicate coordinates before spatial join.
    # -------------------------------------------------------------

    unique_points = (
        pd.DataFrame(
            {
                "_LAT":
                    lat[
                        valid
                    ],

                "_LON":
                    lon[
                        valid
                    ],
            }
        )

        .drop_duplicates()

        .reset_index(
            drop=True
        )
    )


    unique_points[
        "_POINT_KEY"
    ] = np.arange(
        len(
            unique_points
        ),
        dtype=np.int64
    )


    point_gdf = gpd.GeoDataFrame(

        unique_points,

        geometry=gpd.points_from_xy(

            unique_points[
                "_LON"
            ],

            unique_points[
                "_LAT"
            ]
        ),

        crs="EPSG:4326"
    )


    joined = gpd.sjoin(

        point_gdf,

        psap[
            [
                "NENA_ID_CANON",
                "NENA_ID_RAW",

                "BOUNDARY_FCC_ID",
                "BOUNDARY_PSAP_NAME",

                "geometry"
            ]
        ],

        how="left",

        predicate="intersects"
    )


    point_lookup = {}


    for point_key, group in joined.groupby(
        "_POINT_KEY",
        sort=False
    ):

        ids = sorted(
            {
                canonical_nena_id(
                    value
                )

                for value
                in group[
                    "NENA_ID_CANON"
                ]

                if canonical_nena_id(
                    value
                )
            }
        )


        if len(
            ids
        ) == 1:

            nena = ids[0]


            item = {

                "ID":
                    nena,

                "RAW":
                    raw_nena_by_canon.get(
                        nena,
                        ""
                    ),

                "NAME":
                    name_by_nena.get(
                        nena,
                        ""
                    ),

                "FCC":
                    fcc_by_nena.get(
                        nena,
                        ""
                    ),

                "STATUS":
                    "UNIQUE_NENA_PSAP",
            }


        elif len(
            ids
        ) == 0:

            item = {

                "ID":
                    "",

                "RAW":
                    "",

                "NAME":
                    "",

                "FCC":
                    "",

                "STATUS":
                    "NO_CONTAINING_PSAP",
            }


        else:

            item = {

                "ID":
                    "|".join(
                        ids
                    ),

                "RAW":
                    "",

                "NAME":
                    "",

                "FCC":
                    "",

                "STATUS":
                    "MULTIPLE_CONTAINING_PSAP",
            }


        row = (
            unique_points.loc[
                int(
                    point_key
                )
            ]
        )


        point_lookup[
            (
                float(
                    row[
                        "_LAT"
                    ]
                ),

                float(
                    row[
                        "_LON"
                    ]
                )
            )
        ] = item


    for pos in valid_positions:

        item = (
            point_lookup.get(
                (
                    float(
                        lat[
                            pos
                        ]
                    ),

                    float(
                        lon[
                            pos
                        ]
                    )
                )
            )
        )


        if item is None:

            continue


        id_output[
            pos
        ] = item[
            "ID"
        ]

        raw_output[
            pos
        ] = item[
            "RAW"
        ]

        name_output[
            pos
        ] = item[
            "NAME"
        ]

        fcc_output[
            pos
        ] = item[
            "FCC"
        ]

        status_output[
            pos
        ] = item[
            "STATUS"
        ]


    frame[
        f"{prefix}_EXPECTED_NENA_ID"
    ] = id_output


    frame[
        f"{prefix}_EXPECTED_NENA_ID_RAW"
    ] = raw_output


    frame[
        f"{prefix}_EXPECTED_PSAP_NAME"
    ] = name_output


    frame[
        f"{prefix}_EXPECTED_FCC_ID"
    ] = fcc_output


    frame[
        f"{prefix}_EXPECTED_GEOMETRY_STATUS"
    ] = status_output


    return frame


