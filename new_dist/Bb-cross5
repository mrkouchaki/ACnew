def best_match_from_ids(
    source_name,
    candidate_ids,
    min_score,
    min_margin,
    method_prefix
):

    candidate_ids = list(
        dict.fromkeys(
            candidate_ids
        )
    )


    if not source_name or not candidate_ids:

        return None


    source_alias = (
        psap_name_alias(
            source_name
        )
    )


    source_core = (
        psap_name_core(
            source_name
        )
    )


    # -------------------------------------------------------------
    # Deterministic containment first
    # -------------------------------------------------------------

    containment = []


    for nena in candidate_ids:

        candidate_name = (
            name_by_nena.get(
                nena,
                ""
            )
        )


        candidate_alias = (
            psap_name_alias(
                candidate_name
            )
        )


        candidate_core = (
            psap_name_core(
                candidate_name
            )
        )


        matched = False


        if (
            source_alias
            and
            candidate_alias
            and
            min(
                len(
                    source_alias
                ),
                len(
                    candidate_alias
                )
            )
            >= 10
        ):

            if (
                source_alias
                in
                candidate_alias

                or

                candidate_alias
                in
                source_alias
            ):

                matched = True


        if (
            not matched
            and
            source_core
            and
            candidate_core
            and
            min(
                len(
                    source_core
                ),
                len(
                    candidate_core
                )
            )
            >= 8
        ):

            if (
                source_core
                in
                candidate_core

                or

                candidate_core
                in
                source_core
            ):

                matched = True


        if matched:

            containment.append(
                nena
            )


    containment = list(
        dict.fromkeys(
            containment
        )
    )


    if len(
        containment
    ) == 1:

        return {

            "NENA_ID":
                containment[0],

            "METHOD":
                f"{method_prefix}_NAME_CONTAINMENT",

            "SCORE":
                0.96,

            "SECOND_SCORE":
                0.0,

            "MARGIN":
                0.96,
        }


    # -------------------------------------------------------------
    # Conservative fuzzy
    # -------------------------------------------------------------

    scored = []


    for nena in candidate_ids:

        score = (
            name_similarity(

                source_name,

                name_by_nena.get(
                    nena,
                    ""
                )
            )
        )


        scored.append(
            (
                nena,
                score
            )
        )


    scored = sorted(
        scored,
        key=lambda x:
            x[1],
        reverse=True
    )


    if not scored:

        return None


    best_id = (
        scored[0][0]
    )

    best_score = float(
        scored[0][1]
    )


    second_score = (

        float(
            scored[1][1]
        )

        if len(
            scored
        )
        > 1

        else 0.0
    )


    margin = (
        best_score
        -
        second_score
    )


    if (
        best_score
        >=
        min_score

        and

        (
            len(
                scored
            )
            == 1

            or

            margin
            >=
            min_margin
        )
    ):

        return {

            "NENA_ID":
                best_id,

            "METHOD":
                f"{method_prefix}_HIGH_CONFIDENCE_NAME",

            "SCORE":
                best_score,

            "SECOND_SCORE":
                second_score,

            "MARGIN":
                margin,
        }


    return None


def resolve_name_globally(
    source_name
):

    source_name = clean_text(
        source_name
    )


    if not source_name:

        return None


    if source_name in global_name_cache:

        return global_name_cache[
            source_name
        ]


    basic = (
        psap_name_basic(
            source_name
        )
    )


    alias = (
        psap_name_alias(
            source_name
        )
    )


    core = (
        psap_name_core(
            source_name
        )
    )


    # -------------------------------------------------------------
    # Exact basic name
    # -------------------------------------------------------------

    if (
        basic
        and
        basic
        in global_basic_lookup
    ):

        result = {

            "NENA_ID":
                global_basic_lookup[
                    basic
                ],

            "METHOD":
                "GLOBAL_EXACT_ROUTED_NAME",

            "SCORE":
                1.0,

            "SECOND_SCORE":
                0.0,

            "MARGIN":
                1.0,
        }


        global_name_cache[
            source_name
        ] = result

        return result


    # -------------------------------------------------------------
    # Alias exact
    # -------------------------------------------------------------

    if (
        alias
        and
        alias
        in global_alias_lookup
    ):

        result = {

            "NENA_ID":
                global_alias_lookup[
                    alias
                ],

            "METHOD":
                "GLOBAL_ALIAS_ROUTED_NAME",

            "SCORE":
                1.0,

            "SECOND_SCORE":
                0.0,

            "MARGIN":
                1.0,
        }


        global_name_cache[
            source_name
        ] = result

        return result


    # -------------------------------------------------------------
    # Core exact
    # -------------------------------------------------------------

    if (
        core
        and
        core
        in global_core_lookup
    ):

        result = {

            "NENA_ID":
                global_core_lookup[
                    core
                ],

            "METHOD":
                "GLOBAL_CORE_ROUTED_NAME",

            "SCORE":
                0.98,

            "SECOND_SCORE":
                0.0,

            "MARGIN":
                0.98,
        }


        global_name_cache[
            source_name
        ] = result

        return result


    # -------------------------------------------------------------
    # Candidate pool based on meaningful tokens
    # -------------------------------------------------------------

    candidates = set()


    for token in meaningful_tokens(
        source_name
    ):

        candidates.update(
            token_to_nena.get(
                token,
                set()
            )
        )


    result = best_match_from_ids(

        source_name,

        candidates,

        GLOBAL_FUZZY_MIN_SCORE,

        GLOBAL_FUZZY_MIN_MARGIN,

        "GLOBAL"
    )


    global_name_cache[
        source_name
    ] = result


    return result


