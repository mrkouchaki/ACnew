def calculate_boundary_distances_chunk(
    frame,
    prefix,
    lat_col,
    lon_col
):

    n = len(
        frame
    )


    lat = pd.to_numeric(
        frame[
            lat_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    lon = pd.to_numeric(
        frame[
            lon_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    coord_valid = (

        np.isfinite(lat)
        &
        np.isfinite(lon)

        &

        (lat >= -90)
        &
        (lat <= 90)

        &

        (lon >= -180)
        &
        (lon <= 180)

        &

        ~(
            np.isclose(
                lat,
                0
            )
            &
            np.isclose(
                lon,
                0
            )
        )
    )


    routed_ids = (
        frame[
            "ROUTED_NENA_ID"
        ]
        .fillna("")
        .astype(str)
        .to_numpy()
    )


    expected_ids = (
        frame[
            f"{prefix}_EXPECTED_NENA_ID"
        ]
        .fillna("")
        .astype(str)
        .to_numpy()
    )


    expected_status = (
        frame[
            f"{prefix}_EXPECTED_GEOMETRY_STATUS"
        ]
        .fillna("")
        .astype(str)
        .to_numpy()
    )


    routed_distance = np.full(
        n,
        np.nan
    )

    signed_distance = np.full(
        n,
        np.nan
    )

    routed_relation = np.full(
        n,
        "INVALID_OR_MISSING_COORDINATE",
        dtype=object
    )


    nearest_routed_lat = np.full(
        n,
        np.nan
    )

    nearest_routed_lon = np.full(
        n,
        np.nan
    )


    expected_distance = np.full(
        n,
        np.nan
    )

    nearest_expected_lat = np.full(
        n,
        np.nan
    )

    nearest_expected_lon = np.full(
        n,
        np.nan
    )


    # =================================================================
    # ROUTED DISTANCE
    # =================================================================

    routed_relation[
        coord_valid
    ] = (
        "UNRESOLVED_ROUTED_BOUNDARY"
    )


    unique_routed_ids = pd.unique(
        routed_ids[
            coord_valid
            &
            (routed_ids != "")
        ]
    )


    for routed_id in unique_routed_ids:

        geom = (
            boundary_by_nena.get(
                routed_id
            )
        )


        if geom is None:

            continue


        idx = np.flatnonzero(

            coord_valid

            &

            (
                routed_ids
                ==
                routed_id
            )
        )


        if len(
            idx
        ) == 0:

            continue


        if HAS_VECTOR_SHAPELY:

            points = shapely.points(

                lon[
                    idx
                ],

                lat[
                    idx
                ]
            )


            lines = shapely.shortest_line(

                points,

                geom.boundary
            )


            nearest = shapely.get_point(
                lines,
                1
            )


            near_lon = np.asarray(
                shapely.get_x(
                    nearest
                ),
                dtype=float
            )


            near_lat = np.asarray(
                shapely.get_y(
                    nearest
                ),
                dtype=float
            )


            _, _, meters = GEOD.inv(

                lon[
                    idx
                ],

                lat[
                    idx
                ],

                near_lon,

                near_lat
            )


            distance = (
                np.abs(
                    np.asarray(
                        meters,
                        dtype=float
                    )
                )
                / 1000.0
            )


            inside = np.asarray(

                shapely.covers(
                    geom,
                    points
                ),

                dtype=bool
            )


            routed_distance[
                idx
            ] = distance


            nearest_routed_lon[
                idx
            ] = near_lon


            nearest_routed_lat[
                idx
            ] = near_lat


            signed = np.where(

                inside,

                -distance,

                distance
            )


            boundary_mask = (
                distance
                <=
                1e-6
            )


            signed[
                boundary_mask
            ] = 0.0


            signed_distance[
                idx
            ] = signed


            routed_relation[
                idx
            ] = np.where(

                boundary_mask,

                "BOUNDARY",

                np.where(

                    inside,

                    "INSIDE",

                    "OUTSIDE"
                )
            )


        else:

            # -----------------------------------------------------
            # Compatibility fallback
            # -----------------------------------------------------

            for pos in idx:

                point = Point(
                    lon[
                        pos
                    ],
                    lat[
                        pos
                    ]
                )


                try:

                    _, near = nearest_points(

                        point,

                        geom.boundary
                    )


                    _, _, meters = GEOD.inv(

                        lon[
                            pos
                        ],

                        lat[
                            pos
                        ],

                        near.x,

                        near.y
                    )


                    distance = (
                        abs(
                            float(
                                meters
                            )
                        )
                        / 1000.0
                    )


                    routed_distance[
                        pos
                    ] = distance


                    nearest_routed_lon[
                        pos
                    ] = near.x


                    nearest_routed_lat[
                        pos
                    ] = near.y


                    if (
                        distance
                        <=
                        1e-6
                    ):

                        signed_distance[
                            pos
                        ] = 0.0

                        routed_relation[
                            pos
                        ] = "BOUNDARY"


                    elif geom.covers(
                        point
                    ):

                        signed_distance[
                            pos
                        ] = (
                            -distance
                        )

                        routed_relation[
                            pos
                        ] = "INSIDE"


                    else:

                        signed_distance[
                            pos
                        ] = distance

                        routed_relation[
                            pos
                        ] = "OUTSIDE"


                except Exception:

                    routed_relation[
                        pos
                    ] = (
                        "ROUTED_DISTANCE_ERROR"
                    )


    # =================================================================
    # EXPECTED DISTANCE
    # =================================================================

    unique_expected_ids = pd.unique(

        expected_ids[
            coord_valid
            &
            (expected_ids != "")
        ]
    )


    for expected_id in unique_expected_ids:

        if "|" in expected_id:

            continue


        geom = (
            boundary_by_nena.get(
                canonical_nena_id(
                    expected_id
                )
            )
        )


        if geom is None:

            continue


        idx = np.flatnonzero(

            coord_valid

            &

            (
                expected_ids
                ==
                expected_id
            )
        )


        if len(
            idx
        ) == 0:

            continue


        if HAS_VECTOR_SHAPELY:

            points = shapely.points(

                lon[
                    idx
                ],

                lat[
                    idx
                ]
            )


            lines = shapely.shortest_line(

                points,

                geom.boundary
            )


            nearest = shapely.get_point(
                lines,
                1
            )


            near_lon = np.asarray(
                shapely.get_x(
                    nearest
                ),
                dtype=float
            )


            near_lat = np.asarray(
                shapely.get_y(
                    nearest
                ),
                dtype=float
            )


            _, _, meters = GEOD.inv(

                lon[
                    idx
                ],

                lat[
                    idx
                ],

                near_lon,

                near_lat
            )


            expected_distance[
                idx
            ] = (

                np.abs(
                    np.asarray(
                        meters,
                        dtype=float
                    )
                )
                / 1000.0
            )


            nearest_expected_lon[
                idx
            ] = near_lon


            nearest_expected_lat[
                idx
            ] = near_lat


        else:

            for pos in idx:

                point = Point(
                    lon[
                        pos
                    ],
                    lat[
                        pos
                    ]
                )


                try:

                    _, near = nearest_points(

                        point,

                        geom.boundary
                    )


                    _, _, meters = GEOD.inv(

                        lon[
                            pos
                        ],

                        lat[
                            pos
                        ],

                        near.x,

                        near.y
                    )


                    expected_distance[
                        pos
                    ] = (

                        abs(
                            float(
                                meters
                            )
                        )
                        / 1000.0
                    )


                    nearest_expected_lon[
                        pos
                    ] = near.x


                    nearest_expected_lat[
                        pos
                    ] = near.y


                except Exception:

                    pass


    # =================================================================
    # SAME / CLOSE / DIFFERENT
    # =================================================================

    comparison = np.full(
        n,
        "INVALID_COORDINATE",
        dtype=object
    )


    valid_idx = np.flatnonzero(
        coord_valid
    )


    for pos in valid_idx:

        routed = (
            routed_ids[
                pos
            ]
        )

        expected = (
            expected_ids[
                pos
            ]
        )

        exp_status = (
            expected_status[
                pos
            ]
        )


        if not routed:

            comparison[
                pos
            ] = (
                "UNRESOLVED_ROUTED_BOUNDARY"
            )


        elif (
            exp_status
            ==
            "NO_CONTAINING_PSAP"
        ):

            comparison[
                pos
            ] = (
                "UNRESOLVED_EXPECTED_PSAP"
            )


        elif (
            exp_status
            ==
            "MULTIPLE_CONTAINING_PSAP"
        ):

            comparison[
                pos
            ] = (
                "AMBIGUOUS_EXPECTED_PSAP"
            )


        elif not expected:

            comparison[
                pos
            ] = (
                "UNRESOLVED_EXPECTED_PSAP"
            )


        elif (
            canonical_nena_id(
                expected
            )
            ==
            canonical_nena_id(
                routed
            )
        ):

            comparison[
                pos
            ] = "SAME"


        elif (
            np.isfinite(
                routed_distance[
                    pos
                ]
            )
            and
            routed_distance[
                pos
            ]
            <=
            CLOSE_BOUNDARY_KM
        ):

            comparison[
                pos
            ] = "CLOSE"


        else:

            comparison[
                pos
            ] = "DIFFERENT"


    frame[
        f"{prefix}_TO_ROUTED_BOUNDARY_KM"
    ] = routed_distance


    frame[
        f"{prefix}_SIGNED_TO_ROUTED_BOUNDARY_KM"
    ] = signed_distance


    frame[
        f"{prefix}_RELATION_TO_ROUTED_PSAP"
    ] = routed_relation


    frame[
        f"{prefix}_TO_EXPECTED_BOUNDARY_KM"
    ] = expected_distance


    frame[
        f"{prefix}_NEAREST_ROUTED_BOUNDARY_LAT"
    ] = nearest_routed_lat


    frame[
        f"{prefix}_NEAREST_ROUTED_BOUNDARY_LON"
    ] = nearest_routed_lon


    frame[
        f"{prefix}_NEAREST_EXPECTED_BOUNDARY_LAT"
    ] = nearest_expected_lat


    frame[
        f"{prefix}_NEAREST_EXPECTED_BOUNDARY_LON"
    ] = nearest_expected_lon


    frame[
        f"{prefix}_EXPECTED_VS_ROUTED"
    ] = comparison


    return frame


