                0
            )


        final_chunk.to_csv(

            part_path,

            mode=(
                "w"
                if write_header
                else "a"
            ),

            header=write_header,

            index=False,

            float_format="%.6f"
        )


        part_rows += len(
            final_chunk
        )


    print(
        f"Final pass {stage_number:03d}/{len(staging_paths):03d} | "
        f"{staging_path.name}"
    )


