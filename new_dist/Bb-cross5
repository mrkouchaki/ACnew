def update_statistics(
    frame
):

    resolved = (
        frame.loc[
            frame[
                "ROUTED_NENA_ID"
            ].ne("")
        ]
    )


    if resolved.empty:

        return


    # -------------------------------------------------------------
    # Total calls
    # -------------------------------------------------------------

    calls = (
        resolved

        .groupby(
            "ROUTED_NENA_ID"
        )

        .size()
    )


    for nena, count in calls.items():

        stats_accumulator[
            nena
        ][
            "CALLS"
        ] += int(
            count
        )


    # -------------------------------------------------------------
    # Routed boundary distances
    # -------------------------------------------------------------

    for prefix in [

        "CALLER",
        "CELL",
        "ESPOSREQ",
    ]:

        if (
            prefix
            ==
            "ESPOSREQ"
            and
            not PROCESS_ESPOSREQ
        ):

            continue


        column = (
            f"{prefix}_TO_ROUTED_BOUNDARY_KM"
        )


        grouped = (

            resolved

            .groupby(
                "ROUTED_NENA_ID"
            )[
                column
            ]

            .agg(
                [
                    "count",
                    "sum",
                    "min",
                    "max"
                ]
            )
        )


        for nena, row in grouped.iterrows():

            acc = (
                stats_accumulator[
                    nena
                ]
            )


            count = int(
                row[
                    "count"
                ]
            )


            if count == 0:

                continue


            acc[
                f"{prefix}_COUNT"
            ] += count


            acc[
                f"{prefix}_SUM"
            ] += float(
                row[
                    "sum"
                ]
            )


            acc[
                f"{prefix}_MIN"
            ] = min(

                acc[
                    f"{prefix}_MIN"
                ],

                float(
                    row[
                        "min"
                    ]
                )
            )


            acc[
                f"{prefix}_MAX"
            ] = max(

                acc[
                    f"{prefix}_MAX"
                ],

                float(
                    row[
                        "max"
                    ]
                )
            )


    # -------------------------------------------------------------
    # Caller <-> Cell
    # -------------------------------------------------------------

    grouped = (

        resolved

        .groupby(
            "ROUTED_NENA_ID"
        )[
            "CALLER_TO_CELL_KM"
        ]

        .agg(
            [
                "count",
                "sum",
                "max"
            ]
        )
    )


    for nena, row in grouped.iterrows():

        acc = (
            stats_accumulator[
                nena
            ]
        )


        count = int(
            row[
                "count"
            ]
        )


        if count == 0:

            continue


        acc[
            "CALLER_CELL_COUNT"
        ] += count


        acc[
            "CALLER_CELL_SUM"
        ] += float(
            row[
                "sum"
            ]
        )


        acc[
            "CALLER_CELL_MAX"
        ] = max(

            acc[
                "CALLER_CELL_MAX"
            ],

            float(
                row[
                    "max"
                ]
            )
        )


