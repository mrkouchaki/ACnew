def norm_id(value):

    if value is None or pd.isna(value):
        return ""

    text = (
        str(value)
        .strip()
        .strip('"')
    )

    if text.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:
        return ""

    return re.sub(
        r"\.0$",
        "",
        text
    )


def canonical_nena_id(value):

    text = norm_id(
        value
    )

    if not text:
        return ""

    if re.fullmatch(
        r"\d+",
        text
    ):

        try:

            return str(
                int(text)
            )

        except Exception:

            pass

    return text.upper()


def clean_text(value):

    if value is None or pd.isna(value):
        return ""

    text = str(
        value
    ).strip()

    if text.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:
        return ""

    return text


def numeric(value):

    value = pd.to_numeric(
        value,
        errors="coerce"
    )

    try:

        value = float(
            value
        )

    except Exception:

        return np.nan

    if not math.isfinite(
        value
    ):

        return np.nan

    return value


def valid_coordinate(
    lat,
    lon
):

    lat = numeric(
        lat
    )

    lon = numeric(
        lon
    )

    if (
        not np.isfinite(lat)
        or
        not np.isfinite(lon)
    ):

        return False

    if not (
        -90 <= lat <= 90
        and
        -180 <= lon <= 180
    ):

        return False

    if (
        abs(lat) < 1e-10
        and
        abs(lon) < 1e-10
    ):

        return False

    return True


def repair_geometry(
    geometry
):

    if (
        geometry is None
        or
        geometry.is_empty
    ):

        return None

    try:

        if not geometry.is_valid:

            geometry = (
                geometry.buffer(0)
            )

        if (
            geometry is None
            or
            geometry.is_empty
            or
            not geometry.is_valid
        ):

            return None

        return geometry

    except Exception:

        return None


def vector_geodesic_distance_km(
    lat1,
    lon1,
    lat2,
    lon2
):

    lat1 = pd.to_numeric(
        lat1,
        errors="coerce"
    ).to_numpy(
        dtype=float
    )

    lon1 = pd.to_numeric(
        lon1,
        errors="coerce"
    ).to_numpy(
        dtype=float
    )

    lat2 = pd.to_numeric(
        lat2,
        errors="coerce"
    ).to_numpy(
        dtype=float
    )

    lon2 = pd.to_numeric(
        lon2,
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    valid = (

        np.isfinite(lat1)
        &
        np.isfinite(lon1)
        &
        np.isfinite(lat2)
        &
        np.isfinite(lon2)

        &

        (lat1 >= -90)
        &
        (lat1 <= 90)

        &

        (lat2 >= -90)
        &
        (lat2 <= 90)

        &

        (lon1 >= -180)
        &
        (lon1 <= 180)

        &

        (lon2 >= -180)
        &
        (lon2 <= 180)

        &

        ~(
            np.isclose(
                lat1,
                0
            )
            &
            np.isclose(
                lon1,
                0
            )
        )

        &

        ~(
            np.isclose(
                lat2,
                0
            )
            &
            np.isclose(
                lon2,
                0
            )
        )
    )


    output = np.full(
        len(lat1),
        np.nan,
        dtype=float
    )


    if valid.any():

        _, _, meters = GEOD.inv(

            lon1[
                valid
            ],

            lat1[
                valid
            ],

            lon2[
                valid
            ],

            lat2[
                valid
            ]
        )


        output[
            valid
        ] = (
            np.abs(
                np.asarray(
                    meters,
                    dtype=float
                )
            )
            / 1000.0
        )


    return output


