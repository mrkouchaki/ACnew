def psap_name_basic(value):

    text = clean_text(
        value
    ).upper()


    if not text:

        return ""


    text = re.sub(
        r"\b9[\s\-]*1[\s\-]*1\b",
        "911",
        text
    )


    text = text.replace(
        "&",
        " AND "
    )


    text = re.sub(
        r"[^A-Z0-9]+",
        " ",
        text
    )


    return re.sub(
        r"\s+",
        " ",
        text
    ).strip()


def psap_name_alias(value):

    text = psap_name_basic(
        value
    )


    if not text:

        return ""


    replacements = [

        (
            r"\bCOMMUNICATIONS\b",
            "COMM"
        ),

        (
            r"\bCOMMUNICATION\b",
            "COMM"
        ),

        (
            r"\bCOMMUNIC\b",
            "COMM"
        ),

        (
            r"\bCOMMUN\b",
            "COMM"
        ),

        (
            r"\bCENTRE\b",
            "CENTER"
        ),

        (
            r"\bCTR\b",
            "CENTER"
        ),

        (
            r"\bDEPARTMENT\b",
            "DEPT"
        ),

        (
            r"\bSHERIFFS\b",
            "SHERIFF"
        ),

        (
            r"\bSHERIFF S\b",
            "SHERIFF"
        ),
    ]


    for pattern, replacement in replacements:

        text = re.sub(
            pattern,
            replacement,
            text
        )


    # Remove terminal site / operational code.
    text = re.sub(
        r"\s+\d{3,6}$",
        "",
        text
    )


    return re.sub(
        r"\s+",
        " ",
        text
    ).strip()


def psap_name_core(value):

    text = psap_name_alias(
        value
    )


    if not text:

        return ""


    generic_tokens = {

        "COMM",
        "CENTER",
        "DEPT",
        "OFFICE",
        "PSAP",
        "911",
        "DISPATCH",
    }


    tokens = [

        token

        for token
        in text.split()

        if token
        not in generic_tokens
    ]


    return " ".join(
        tokens
    )


def token_jaccard(
    a,
    b
):

    a = set(
        psap_name_alias(
            a
        ).split()
    )

    b = set(
        psap_name_alias(
            b
        ).split()
    )


    if not a or not b:

        return 0.0


    return (
        len(
            a & b
        )
        /
        len(
            a | b
        )
    )


def name_similarity(
    a,
    b
):

    a_norm = (
        psap_name_alias(
            a
        )
    )

    b_norm = (
        psap_name_alias(
            b
        )
    )


    if not a_norm or not b_norm:

        return 0.0


    if a_norm == b_norm:

        return 1.0


    sequence_score = (
        SequenceMatcher(
            None,
            a_norm,
            b_norm
        )
        .ratio()
    )


    jaccard_score = (
        token_jaccard(
            a_norm,
            b_norm
        )
    )


    return (
        0.65
        * sequence_score

        +

        0.35
        * jaccard_score
    )


