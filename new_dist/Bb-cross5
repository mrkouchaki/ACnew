def assign_coordinate_pattern(
    frame
):

    caller = (
        frame[
            "CALLER_EXPECTED_VS_ROUTED"
        ]
        .fillna("")
        .to_numpy()
    )


    cell = (
        frame[
            "CELL_EXPECTED_VS_ROUTED"
        ]
        .fillna("")
        .to_numpy()
    )


    if PROCESS_ESPOSREQ:

        espos = (
            frame[
                "ESPOSREQ_EXPECTED_VS_ROUTED"
            ]
            .fillna("")
            .to_numpy()
        )

    else:

        espos = np.full(
            len(frame),
            "NOT_PROCESSED",
            dtype=object
        )


    pattern = np.full(
        len(frame),
        "MIXED_COORDINATE_EVIDENCE",
        dtype=object
    )


    unresolved_routed = (
        frame[
            "ROUTED_BOUNDARY_STATUS"
        ]
        .eq(
            "UNRESOLVED_ROUTED_BOUNDARY"
        )
        .to_numpy()
    )


    pattern[
        unresolved_routed
    ] = (
        "UNRESOLVED_ROUTED_BOUNDARY"
    )


    if PROCESS_ESPOSREQ:

        mask = (

            ~unresolved_routed

            &

            (caller == "SAME")

            &

            (cell == "SAME")

            &

            (espos == "SAME")
        )


        pattern[
            mask
        ] = (
            "ALL_3_SUPPORT_ROUTED_PSAP"
        )


        mask = (

            ~unresolved_routed

            &

            (caller == "DIFFERENT")

            &

            (cell == "SAME")

            &

            (espos == "SAME")
        )


        pattern[
            mask
        ] = (
            "CALLER_DIFFERS_CELL_ESPOSREQ_SUPPORT_ROUTED"
        )


        mask = (

            ~unresolved_routed

            &

            (caller == "SAME")

            &

            (cell == "DIFFERENT")

            &

            (espos == "SAME")
        )


        pattern[
            mask
        ] = (
            "CELL_DIFFERS_CALLER_ESPOSREQ_SUPPORT_ROUTED"
        )


        mask = (

            ~unresolved_routed

            &

            (caller == "SAME")

            &

            (cell == "SAME")

            &

            (espos == "DIFFERENT")
        )


        pattern[
            mask
        ] = (
            "ESPOSREQ_DIFFERS_CALLER_CELL_SUPPORT_ROUTED"
        )


        mask = (

            ~unresolved_routed

            &

            (caller == "DIFFERENT")

            &

            (cell == "DIFFERENT")

            &

            (espos == "DIFFERENT")
        )


        pattern[
            mask
        ] = (
            "NONE_SUPPORT_ROUTED_PSAP"
        )


    else:

        mask = (

            ~unresolved_routed

            &

            (caller == "SAME")

            &

            (cell == "SAME")
        )


        pattern[
            mask
        ] = (
            "CALLER_CELL_SUPPORT_ROUTED_PSAP"
        )


        mask = (

            ~unresolved_routed

            &

            (caller == "DIFFERENT")

            &

            (cell == "SAME")
        )


        pattern[
            mask
        ] = (
            "CALLER_DIFFERS_CELL_SUPPORT_ROUTED"
        )


    close_mask = (

        ~unresolved_routed

        &

        (
            (caller == "CLOSE")
            |
            (cell == "CLOSE")
            |
            (
                PROCESS_ESPOSREQ
                and
                (espos == "CLOSE")
            )
        )
    )


    pattern[
        close_mask
    ] = (
        "NEAR_BOUNDARY_OR_MIXED"
    )


    frame[
        "COORDINATE_PATTERN"
    ] = pattern


    return frame


