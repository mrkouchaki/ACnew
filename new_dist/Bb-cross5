def build_unique_lookup(
    dataframe,
    key_column
):

    lookup = {}


    for key, group in (
        dataframe.loc[
            dataframe[
                key_column
            ].ne("")
        ]
        .groupby(
            key_column
        )
    ):

        ids = sorted(
            set(
                group[
                    "NENA_ID_CANON"
                ]
            )
        )


        if len(ids) == 1:

            lookup[
                key
            ] = ids[0]


    return lookup


