    def safe_mean(
        prefix
    ):

        count = acc[
            f"{prefix}_COUNT"
        ]


        if count == 0:

            return np.nan


        return (
            acc[
                f"{prefix}_SUM"
            ]
            /
            count
        )


    def safe_min(
        prefix
    ):

        if (
            acc[
                f"{prefix}_COUNT"
            ]
            == 0
        ):

            return np.nan


        return acc[
            f"{prefix}_MIN"
        ]


    def safe_max(
        prefix
    ):

        if (
            acc[
                f"{prefix}_COUNT"
            ]
            == 0
        ):

            return np.nan


        return acc[
            f"{prefix}_MAX"
        ]


    caller_cell_mean = (

        acc[
