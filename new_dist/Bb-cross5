route_resolution_cache = {}


def resolve_routed_psap(
    psap_id,
    fcc_id,
    route_psap_name,
    psap_name
):

    cache_key = (

        norm_id(
            psap_id
        ),

        norm_id(
            fcc_id
        ),

        clean_text(
            route_psap_name
        ),

        clean_text(
            psap_name
        ),
    )


    if cache_key in route_resolution_cache:

        return route_resolution_cache[
            cache_key
        ]


    psap_id_canon = (
        canonical_nena_id(
            psap_id
        )
    )


    fcc_key = (
        norm_id(
            fcc_id
        )
    )


    route_name = (
        clean_text(
            route_psap_name
        )
    )


    fallback_name = (
        clean_text(
            psap_name
        )
    )


    source_names = []


    if route_name:

        source_names.append(
            route_name
        )


    if (
        fallback_name
        and
        fallback_name
        not in source_names
    ):

        source_names.append(
            fallback_name
        )


    # -------------------------------------------------------------
    # Numeric PSAP_ID candidate
    # -------------------------------------------------------------

    if (
        psap_id_canon
        and
        psap_id_canon
        in boundary_by_nena
    ):

        id_candidate = (
            psap_id_canon
        )

        id_candidate_name = (
            name_by_nena.get(
                id_candidate,
                ""
            )
        )

    else:

        id_candidate = ""

        id_candidate_name = ""


    # -------------------------------------------------------------
    # 1. GLOBAL routed-name resolution
    #
    # ROUTE_PSAP_NAME is attempted first.
    # -------------------------------------------------------------

    chosen = None


    for source_name in source_names:

        name_result = (
            resolve_name_globally(
                source_name
            )
        )


        if name_result is not None:

            chosen = (
                name_result.copy()
            )

            break


    # -------------------------------------------------------------
    # 2. If global resolution failed, search same FCC
    # -------------------------------------------------------------

    candidate_ids = (
        fcc_to_nena.get(
            fcc_key,
            []
        )
    )


    if chosen is None:

        for source_name in source_names:

            fcc_result = (
                best_match_from_ids(

                    source_name,

                    candidate_ids,

                    FCC_FUZZY_MIN_SCORE,

                    FCC_FUZZY_MIN_MARGIN,

                    "FCC"
                )
            )


            if fcc_result is not None:

                chosen = (
                    fcc_result.copy()
                )

                break


    # -------------------------------------------------------------
    # 3. Validate PSAP_ID candidate by name
    # -------------------------------------------------------------

    if (
        chosen is None
        and
        id_candidate
        and
        source_names
    ):

        id_score = max(

            name_similarity(

                source_name,

                id_candidate_name
            )

            for source_name
            in source_names
        )


        alias_agreement = any(

            (
                psap_name_alias(
                    source_name
                )
                ==
                psap_name_alias(
                    id_candidate_name
                )
            )

            or

            (
                psap_name_core(
                    source_name
                )
                and

                psap_name_core(
                    source_name
                )
                ==
                psap_name_core(
                    id_candidate_name
                )
            )

            for source_name
            in source_names
        )


        if (
            alias_agreement
            or
            id_score
            >=
            ID_NAME_VALIDATION_SCORE
        ):

            chosen = {

                "NENA_ID":
                    id_candidate,

                "METHOD":
                    "PSAP_ID_NAME_VALIDATED",

                "SCORE":
                    id_score,

                "SECOND_SCORE":
                    0.0,

                "MARGIN":
                    id_score,
            }


    # -------------------------------------------------------------
    # 4. ID-only when there is no routed name at all
    # -------------------------------------------------------------

    if (
        chosen is None
        and
        id_candidate
        and
        not source_names
    ):

        chosen = {

            "NENA_ID":
                id_candidate,

            "METHOD":
                "PSAP_ID_ONLY_NO_NAME",

            "SCORE":
                np.nan,

            "SECOND_SCORE":
                np.nan,

            "MARGIN":
                np.nan,
        }


    # -------------------------------------------------------------
    # 5. Unresolved
    # -------------------------------------------------------------

    if chosen is None:

        chosen_nena = ""

        if id_candidate:

            method = (
                "ID_NAME_CONFLICT_UNRESOLVED"
            )

        else:

            method = (
                "UNRESOLVED_ROUTED_BOUNDARY"
            )


        result = {

            "ROUTED_NENA_ID":
                "",

            "ROUTED_NENA_ID_RAW":
                "",

            "ROUTED_BOUNDARY_PSAP_NAME":
                "",

            "ROUTED_BOUNDARY_FCC_ID":
                "",

            "ROUTED_BOUNDARY_STATUS":
                "UNRESOLVED_ROUTED_BOUNDARY",

            "ROUTED_RESOLUTION_METHOD":
                method,

            "ROUTED_RESOLUTION_CONFIDENCE":
                "UNRESOLVED",

            "ROUTED_NAME_MATCH_SCORE":
                np.nan,

            "ROUTED_NAME_SECOND_SCORE":
                np.nan,

            "ROUTED_NAME_SCORE_MARGIN":
                np.nan,

            "ROUTED_FCC_CANDIDATE_COUNT":
                len(
                    candidate_ids
                ),

            "ROUTED_ID_CANDIDATE_NENA_ID":
                id_candidate,

            "ROUTED_ID_CANDIDATE_PSAP_NAME":
                id_candidate_name,

            "ROUTED_ID_NAME_CONFLICT":
                bool(
                    id_candidate
                    and
                    source_names
                ),
        }


        route_resolution_cache[
            cache_key
        ] = result


        return result


    # -------------------------------------------------------------
    # Successful name / ID resolution
    # -------------------------------------------------------------

    chosen_nena = (
        canonical_nena_id(
            chosen[
                "NENA_ID"
            ]
        )
    )


    conflict = bool(

        id_candidate
        and
        chosen_nena
        and
        id_candidate
        !=
        chosen_nena
    )


    method = (
        chosen[
            "METHOD"
        ]
    )


    if conflict:

        method = (
            method
            +
            "_OVERRIDES_ID"
        )


    if (
        "HIGH_CONFIDENCE"
        in method
    ):

        confidence = (
            "MEDIUM_HIGH"
        )

    elif (
        "ONLY_NO_NAME"
        in method
    ):

        confidence = (
            "MEDIUM"
        )

    else:

        confidence = (
            "HIGH"
        )


    result = {

        "ROUTED_NENA_ID":
            chosen_nena,

        "ROUTED_NENA_ID_RAW":
            raw_nena_by_canon.get(
                chosen_nena,
                ""
            ),

        "ROUTED_BOUNDARY_PSAP_NAME":
            name_by_nena.get(
                chosen_nena,
                ""
            ),

        "ROUTED_BOUNDARY_FCC_ID":
            fcc_by_nena.get(
                chosen_nena,
                ""
            ),

        "ROUTED_BOUNDARY_STATUS":
            "RESOLVED",

        "ROUTED_RESOLUTION_METHOD":
            method,

        "ROUTED_RESOLUTION_CONFIDENCE":
            confidence,

        "ROUTED_NAME_MATCH_SCORE":
            chosen.get(
                "SCORE",
                np.nan
            ),

        "ROUTED_NAME_SECOND_SCORE":
            chosen.get(
                "SECOND_SCORE",
                np.nan
            ),

        "ROUTED_NAME_SCORE_MARGIN":
            chosen.get(
                "MARGIN",
                np.nan
            ),

        "ROUTED_FCC_CANDIDATE_COUNT":
            len(
                candidate_ids
            ),

        "ROUTED_ID_CANDIDATE_NENA_ID":
            id_candidate,

        "ROUTED_ID_CANDIDATE_PSAP_NAME":
            id_candidate_name,

        "ROUTED_ID_NAME_CONFLICT":
            conflict,
    }


    route_resolution_cache[
        cache_key
    ] = result


    return result


