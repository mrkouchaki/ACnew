        print(" -", c)


# =====================================================================
# 4. STREAM ORIGINAL GMLC AND RETRIEVE TARGET CALLS
# =====================================================================

selected_chunks = []
row_offset = 0
gmlc_psap_name_map = {}

for chunk_no, chunk in enumerate(
    pd.read_csv(
        GMLC_PATH,
        dtype="string",
        chunksize=CSV_CHUNK_ROWS,
        usecols=actual_usecols,
        low_memory=False,
        encoding_errors="replace",
    ),
    start=1,
):
    chunk.columns = [
        str(c).strip().upper()
        for c in chunk.columns
    ]

    chunk["RAW_GMLC_ROW_ID"] = np.arange(
        row_offset + 1,
        row_offset + len(chunk) + 1,
        dtype=np.int64
    )

    row_offset += len(chunk)

    if "UNIQ911_CID" in chunk.columns:
        chunk["CID_NORM"] = (
            chunk["UNIQ911_CID"]
            .map(norm_id)
        )
    else:
        chunk["CID_NORM"] = ""

    # Build FCC PSAP ID -> name lookup while scanning GMLC.
    if (
        "FCC_PSAP_ID" in chunk.columns
        and
        "PSAP_NAME" in chunk.columns
    ):
        pairs = (
            chunk[
                ["FCC_PSAP_ID", "PSAP_NAME"]
            ]
            .dropna()
            .drop_duplicates()
        )

        for fcc, name in pairs.itertuples(
            index=False,
            name=None
        ):
            fcc_n = norm_id(fcc)
            name_n = clean_text(name)

            if (
                fcc_n
                and name_n
                and fcc_n not in gmlc_psap_name_map
            ):
                gmlc_psap_name_map[
                    fcc_n
                ] = name_n

    mask = (
        chunk["CID_NORM"]
        .isin(target_cids)
    )

    if target_row_ids:
        mask |= (
            chunk["RAW_GMLC_ROW_ID"]
            .isin(target_row_ids)
        )

    if mask.any():
        selected_chunks.append(
            chunk.loc[
                mask
            ].copy()
        )

    if chunk_no % 10 == 0:
        print(
            f"Scanned {row_offset:,} "
            f"GMLC rows..."
        )

if not selected_chunks:
    raise RuntimeError(
        "No filtered calls were found "
        "in original GMLC CSV."
    )

raw = pd.concat(
    selected_chunks,
    ignore_index=True
)

raw["RAW_ROWS_FOR_CID"] = (
    raw.groupby(
        "CID_NORM"
    )[
        "RAW_GMLC_ROW_ID"
    ]
    .transform("size")
)

print(
    f"\nMatched raw rows: {len(raw):,}"
)


# =====================================================================
# 5. EXACT MATCH BACK TO ORIGINAL GMLC ROW
# =====================================================================

if (
    "GMLC_ROW_ID" in flt_keep.columns
    and
    flt_keep["GMLC_ROW_ID"]
    .notna()
    .any()
):
    report = flt_keep.merge(
        raw,
        left_on=[
            "GMLC_ROW_ID",
            "CID_NORM"
        ],
        right_on=[
            "RAW_GMLC_ROW_ID",
            "CID_NORM"
        ],
        how="left",
        validate="many_to_one"
    )

    report[
        "RAW_MATCH_METHOD"
    ] = "GMLC_ROW_ID+UNIQ911_CID"

else:
    raw_first = (
        raw.sort_values(
            "RAW_GMLC_ROW_ID"
        )
        .drop_duplicates(
            "CID_NORM"
        )
    )

    report = flt_keep.merge(
        raw_first,
        on="CID_NORM",
        how="left",
        validate="many_to_one"
    )

    report[
        "RAW_MATCH_METHOD"
    ] = "UNIQ911_CID_FIRST_ROW_FALLBACK"


report["RAW_EXACT_MATCH"] = (
    report["RAW_GMLC_ROW_ID"]
    .notna()
)

print(
    "Exact original GMLC matches:",
    int(
        report[
            "RAW_EXACT_MATCH"
        ].sum()
    ),
    "/",
    len(report)
)


# =====================================================================
# 6. LOAD PSAP BOUNDARIES
# =====================================================================

try:
    geo = gpd.read_file(
        BOUNDARY_PATH,
        engine="pyogrio"
    )
except Exception:
    geo = gpd.read_file(
        BOUNDARY_PATH
    )

if geo.empty:
    raise RuntimeError(
        "No PSAP boundaries loaded."
    )

if geo.crs is not None:
    try:
        if geo.crs.to_epsg() != 4326:
            geo = geo.to_crs(
                epsg=4326
            )
    except Exception:
        geo = geo.to_crs(
            epsg=4326
        )

geo_upper = {
    str(c).strip().upper(): c
    for c in geo.columns
}

fcc_column = next(
    (
        geo_upper[c]
        for c in [
            "FCC_ID",
            "FCC_PSAP_ID"
        ]
        if c in geo_upper
    ),
    None
)

if fcc_column is None:
    raise RuntimeError(
        "PSAP boundary file has no "
        "FCC_ID/FCC_PSAP_ID."
    )

name_column = next(
    (
        geo_upper[c]
        for c in [
            "PSAP_NAME",
            "NAME",
            "AGENCY_NAME",
            "AGENCY",
            "PSAP",
        ]
        if c in geo_upper
    ),
    None
)


def repair_geometry(g):
    if g is None or g.is_empty:
        return None

    try:
        if not g.is_valid:
            g = g.buffer(0)

        if g.is_empty or not g.is_valid:
            return None

        return g

    except Exception:
        return None


pieces = defaultdict(list)
boundary_names = {}

for _, row in geo.iterrows():
    fcc = norm_id(
        row[fcc_column]
    )

    geom = repair_geometry(
        row.geometry
    )

    if not fcc or geom is None:
        continue

    pieces[fcc].append(
        geom
    )

    if (
        name_column is not None
        and
        pd.notna(
            row[name_column]
        )
    ):
        boundary_names[fcc] = clean_text(
            row[name_column]
        )


boundary_fcc = []
boundary_geometries = []

for fcc, geoms in pieces.items():
    merged = repair_geometry(
        unary_union(
            geoms
        )
    )

    if merged is not None:
        boundary_fcc.append(
            fcc
        )

        boundary_geometries.append(
            merged
        )


boundary_by_fcc = dict(
    zip(
        boundary_fcc,
        boundary_geometries
    )
)

tree = STRtree(
    boundary_geometries
)

geom_position = {
    id(g): i
    for i, g in enumerate(
        boundary_geometries
    )
}


# Boundary names override GMLC fallback when present.
psap_name_map = dict(
    gmlc_psap_name_map
)

psap_name_map.update({
    k: v
    for k, v in boundary_names.items()
    if v
})

print(
    f"Usable PSAP polygons: "
    f"{len(boundary_fcc):,}"
)


# =====================================================================
# 7. PSAP / BOUNDARY FUNCTIONS
# =====================================================================

def tree_positions(geometry):
    hits = tree.query(
        geometry
    )

    positions = []

    for hit in hits:
        if isinstance(
            hit,
            (int, np.integer)
        ):
            positions.append(
                int(hit)
            )
        else:
            pos = geom_position.get(
                id(hit)
            )

            if pos is not None:
                positions.append(
                    pos
                )

    return positions


def distance_to_boundary_m(
    lat,
    lon,
    geom
):
    if (
        geom is None
        or
        not valid_latlon(
            lat,
            lon
        )
    ):
        return np.nan

    point = Point(
        float(lon),
        float(lat)
    )

    try:
        _, nearest = nearest_points(
            point,
            geom.boundary
        )

        _, _, distance = geod.inv(
            float(lon),
            float(lat),
            nearest.x,
            nearest.y
        )

        return abs(
            float(distance)
        )

    except Exception:
        return np.nan


def routed_expected_status(
    expected_id,
    routed_id,
    routed_boundary_distance
):
    expected_id = norm_id(
        expected_id
    )

    routed_id = norm_id(
        routed_id
    )

    if (
        expected_id
        and routed_id
        and expected_id == routed_id
    ):
        return "SAME"

    distance = pd.to_numeric(
        routed_boundary_distance,
        errors="coerce"
    )

    if (
        expected_id
        and routed_id
        and pd.notna(distance)
        and distance <= CLOSE_BOUNDARY_M
    ):
        return "CLOSE"

    return "DIFFERENT"


def analyze_point(
    lat_value,
    lon_value,
    routed_value
):
    lat = pd.to_numeric(
        lat_value,
        errors="coerce"
    )

    lon = pd.to_numeric(
        lon_value,
        errors="coerce"
    )

    routed = norm_id(
        routed_value
    )

    if not valid_latlon(
        lat,
        lon
    ):
        return {
            "EXPECTED_PSAP_ID": "",
            "EXPECTED_PSAP_NAME": "",
            "POINT_STATUS": "INVALID_OR_MISSING",
            "MATCHES_ROUTED_PSAP": False,
            "ROUTED_RELATION": "INVALID_OR_MISSING",
            "TO_ROUTED_PSAP_BOUNDARY_M": np.nan,
            "SIGNED_TO_ROUTED_PSAP_BOUNDARY_M": np.nan,
            "TO_EXPECTED_PSAP_BOUNDARY_M": np.nan,
            "VS_ROUTED_PSAP": "DIFFERENT",
        }

    lat = float(lat)
    lon = float(lon)

    point = Point(
        lon,
        lat
    )

    inside = sorted(
        set(
            boundary_fcc[pos]
            for pos in tree_positions(
                point
            )
            if boundary_geometries[
                pos
            ].covers(
                point
            )
        )
    )


    # -------------------------------------------------------------
    # Expected PSAP from this location point
    # -------------------------------------------------------------

    if len(inside) == 1:
        point_status = "UNIQUE_PSAP"
        expected_id = inside[0]
        expected_name = (
            psap_name_map.get(
                expected_id,
                ""
            )
        )

    elif len(inside) == 0:
        point_status = "NO_CONTAINING_PSAP"
        expected_id = ""
        expected_name = ""

    else:
        point_status = "MULTIPLE_PSAP"
        expected_id = "|".join(
            inside
        )
        expected_name = ""


    # -------------------------------------------------------------
    # Distance / relation to routed PSAP
    # -------------------------------------------------------------

    routed_geom = (
        boundary_by_fcc.get(
            routed
        )
    )

    if routed_geom is None:
        relation = "MISSING_ROUTED_BOUNDARY"
        routed_distance = np.nan
        signed_distance = np.nan

    else:
        routed_distance = (
            distance_to_boundary_m(
                lat,
                lon,
                routed_geom
            )
        )

        if routed_geom.covers(
            point
        ):
            relation = "INSIDE"
            signed_distance = (
                -routed_distance
            )

        elif routed_geom.intersects(
            point
        ):
            relation = "BOUNDARY"
            signed_distance = 0.0

        else:
            relation = "OUTSIDE"
            signed_distance = (
                routed_distance
            )


    # -------------------------------------------------------------
    # Distance to expected PSAP boundary
    # -------------------------------------------------------------

    expected_distance = np.nan

    if len(inside) == 1:
        expected_geom = (
            boundary_by_fcc.get(
                expected_id
            )
        )

        expected_distance = (
            distance_to_boundary_m(
                lat,
                lon,
                expected_geom
            )
        )


    status = routed_expected_status(
        expected_id,
        routed,
        routed_distance
    )

    return {
        "EXPECTED_PSAP_ID":
            expected_id,

        "EXPECTED_PSAP_NAME":
            expected_name,

        "POINT_STATUS":
            point_status,

        "MATCHES_ROUTED_PSAP":
            (
                len(inside) == 1
                and
                expected_id == routed
            ),

        "ROUTED_RELATION":
            relation,

        "TO_ROUTED_PSAP_BOUNDARY_M":
            routed_distance,

        "SIGNED_TO_ROUTED_PSAP_BOUNDARY_M":
            signed_distance,

        "TO_EXPECTED_PSAP_BOUNDARY_M":
            expected_distance,

        "VS_ROUTED_PSAP":
            status,
    }


# =====================================================================
# 8. EXPLICIT ROUTED PSAP + LOCATION NAMES
# =====================================================================

for c in [
    "LATITUDE",
    "LONGITUDE",
    "CELL_LATITUDE",
    "CELL_LONGITUDE",
    "ESPOSREQ_LOC_LATITUDE",
    "ESPOSREQ_LOC_LONGITUDE",
]:
    if c not in report.columns:
        report[c] = np.nan

    report[c] = numeric(
        report[c]
    )


# Routed PSAP from original GMLC record.
report["ROUTED_PSAP_ID"] = (
    report["FCC_PSAP_ID"]
    .map(norm_id)
)


if "PSAP_NAME" not in report.columns:
    report["PSAP_NAME"] = ""

if "ROUTE_PSAP_NAME" not in report.columns:
    report["ROUTE_PSAP_NAME"] = ""


report["ROUTED_PSAP_NAME_MASTER"] = (
    report["PSAP_NAME"]
    .fillna("")
    .astype(str)
    .str.strip()
)

report["ROUTED_PSAP_NAME_ROUTE"] = (
    report["ROUTE_PSAP_NAME"]
    .fillna("")
    .astype(str)
    .str.strip()
)


# Prefer ROUTE_PSAP_NAME, then PSAP_NAME, then ID lookup.
