




# =====================================================================
# THREE-LOCATION PSAP / COORDINATE RECONCILIATION REPORT v3
# =====================================================================
#
# PURPOSE
# -------
# Diagnostic QA only. This cell DOES NOT overwrite the original v5 labels.
#
# It compares three location families independently:
#
#   1. CALLER:
#      LATITUDE / LONGITUDE
#
#   2. CELL:
#      CELL_LATITUDE / CELL_LONGITUDE
#
#   3. ESPOSREQ:
#      ESPOSREQ_LOC_LATITUDE / ESPOSREQ_LOC_LONGITUDE
#
# Each location is checked against:
#   - the ROUTED PSAP polygon
#   - the PSAP polygon containing that location (EXPECTED PSAP)
#
#
# INPUTS
# ------
# 1. psap_routing_definite_misroutes_filtered_by_routed_distance.csv
#
# 2. C:\temp\gmlc_v2\e911_lte_master_gmlc.csv
#
# 3. C:\temp\gmlc_v2\psap\Final_Join.tab
#
#
# MAIN OUTPUT
# -----------
# psap_three_location_coordinate_crosscheck_v5.csv
#
# One row per filtered call containing:
#
#   ROUTED PSAP:
#       ROUTED_PSAP_ID
#       ROUTED_PSAP_NAME
#
#   CALLER:
#       caller coordinates
#       caller-derived expected PSAP
#       SAME / CLOSE / DIFFERENT
#       caller -> routed PSAP boundary distance
#       caller -> expected PSAP boundary distance
#       CALLER -> ROUTED MIN / MEAN / MAX across ALL calls
#
#   CELL:
#       cell coordinates
#       cell-derived expected PSAP
#       SAME / CLOSE / DIFFERENT
#       cell -> routed PSAP boundary distance
#       cell -> expected PSAP boundary distance
#       CELL -> ROUTED MIN / MEAN / MAX across ALL calls
#
#   ESPOSREQ:
#       ESPOSREQ coordinates
#       ESPOSREQ-derived expected PSAP
#       SAME / CLOSE / DIFFERENT
#       ESPOSREQ -> routed PSAP boundary distance
#       ESPOSREQ -> expected PSAP boundary distance
#       ESPOSREQ -> ROUTED MIN / MEAN / MAX across ALL calls
#
#   LOCATION-TO-LOCATION:
#       caller <-> cell
#       caller <-> ESPOSREQ
#       cell <-> ESPOSREQ
#
#   CONTEXT:
#       location quality/source
#       route context
#       call duration
#       original v5 results, renamed ORIGINAL_V5_* for clarity
#
#
# IMPORTANT
# ---------
# The MIN / MEAN / MAX columns are DATASET-LEVEL statistics:
#
#   CALLER -> ROUTED PSAP boundary across all calls
#   CELL -> ROUTED PSAP boundary across all calls
#   ESPOSREQ -> ROUTED PSAP boundary across all calls
#
# Therefore those values repeat on every row in the main CSV so they are
# directly visible beside the corresponding call-level distance in Excel.
#
#
# SAME / CLOSE / DIFFERENT
# ------------------------
# SAME:
#     expected FCC PSAP ID == routed FCC PSAP ID
#
# CLOSE:
#     expected PSAP differs, but location is <= CLOSE_BOUNDARY_M
#     from the routed PSAP boundary
#
# DIFFERENT:
#     expected PSAP differs and location is farther away
#
#
# SIGNED DISTANCE
# ---------------
# Negative = point is inside routed PSAP
# Positive = point is outside routed PSAP
#
# MIN / MEAN / MAX use absolute boundary distance, not signed distance.
# =====================================================================

from pathlib import Path
from collections import defaultdict
import re

import numpy as np
import pandas as pd
import geopandas as gpd

from pyproj import Geod
from shapely.geometry import Point
from shapely.ops import nearest_points, unary_union
from shapely.strtree import STRtree
from IPython.display import display, Markdown


# =====================================================================
# 0. CONFIGURATION
# =====================================================================

DATA_DIR = globals().get("DATA_DIR", Path(r"C:\temp\gmlc_v2"))
OUTPUT_DIR = globals().get("OUTPUT_DIR", DATA_DIR / "outputs_psap_rca_v5")
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

GMLC_PATH = DATA_DIR / "e911_lte_master_gmlc.csv"
BOUNDARY_PATH = DATA_DIR / "psap" / "Final_Join.tab"

INPUT_FILE = "psap_routing_definite_misroutes_filtered_by_routed_distance.csv"

CSV_CHUNK_ROWS = 100_000

# Definition of CLOSE.
CLOSE_BOUNDARY_M = 5_000.0

input_candidates = [
    OUTPUT_DIR / INPUT_FILE,
    DATA_DIR / INPUT_FILE,
]

INPUT_PATH = next(
    (p for p in input_candidates if p.exists()),
    None
)

if INPUT_PATH is None:
    matches = list(DATA_DIR.rglob(INPUT_FILE))
    if matches:
        INPUT_PATH = matches[0]

if INPUT_PATH is None:
    raise FileNotFoundError(INPUT_FILE)

if not GMLC_PATH.exists():
    raise FileNotFoundError(GMLC_PATH)

if not BOUNDARY_PATH.exists():
    raise FileNotFoundError(BOUNDARY_PATH)

print("Filtered calls :", INPUT_PATH)
print("Raw GMLC       :", GMLC_PATH)
print("PSAP boundaries:", BOUNDARY_PATH)
print("CLOSE threshold:", CLOSE_BOUNDARY_M / 1000.0, "km")


# =====================================================================
# 1. HELPERS
# =====================================================================

def norm_id(value):
    if value is None or pd.isna(value):
        return ""

    text = str(value).strip().strip('"').upper()
    return re.sub(r"\.0$", "", text)


def clean_text(value):
    if value is None or pd.isna(value):
        return ""

    return str(value).strip()


def numeric(series):
    return pd.to_numeric(
        series,
        errors="coerce"
    )


def valid_latlon(lat, lon):
    return (
        pd.notna(lat)
        and pd.notna(lon)
        and -90 <= float(lat) <= 90
        and -180 <= float(lon) <= 180
    )


geod = Geod(ellps="WGS84")


# =====================================================================
# 2. READ FILTERED V5 RESULT
# =====================================================================

flt = pd.read_csv(
    INPUT_PATH,
    dtype="string",
    low_memory=False
)

flt.columns = [
    str(c).strip().upper()
    for c in flt.columns
]

if "UNIQ911_CID" not in flt.columns:
    raise RuntimeError(
        "Filtered file must contain UNIQ911_CID."
    )

flt["CID_NORM"] = (
    flt["UNIQ911_CID"]
    .map(norm_id)
)

v5_fields = [
    "GMLC_ROW_ID",
    "UNIQ911_CID",
    "EXPECTED_FCC_PSAP_ID",
    "FCC_PSAP_ID",
    "PSAP_NAME",
    "ROUTE_INTEGRITY_STATUS",
    "DISTANCE_TO_ROUTED_BOUNDARY_M",
    "DISTANCE_TO_EXPECTED_BOUNDARY_M",
    "MISROUTE_LABEL",
]

keep = [
    c
    for c in v5_fields
    if c in flt.columns
]

flt_keep = flt[
    keep + ["CID_NORM"]
].copy()

rename_v5 = {
    c: "ORIGINAL_V5_" + c
    for c in keep
    if c not in {
        "GMLC_ROW_ID",
        "UNIQ911_CID",
    }
}

flt_keep = flt_keep.rename(
    columns=rename_v5
)

flt_keep = flt_keep.rename(
    columns={
        "UNIQ911_CID":
            "INPUT_UNIQ911_CID"
    }
)

if "GMLC_ROW_ID" in flt_keep.columns:
    flt_keep["GMLC_ROW_ID"] = pd.to_numeric(
        flt_keep["GMLC_ROW_ID"],
        errors="coerce"
    ).astype("Int64")

target_cids = set(
    flt_keep.loc[
        flt_keep["CID_NORM"].ne(""),
        "CID_NORM"
    ]
)

target_row_ids = set()

if "GMLC_ROW_ID" in flt_keep.columns:
    target_row_ids = set(
        flt_keep["GMLC_ROW_ID"]
        .dropna()
        .astype(int)
    )

print(
    f"Filtered input calls: {len(flt_keep):,}"
)


# =====================================================================
# 3. READ REQUIRED FIELDS FROM ORIGINAL GMLC
# =====================================================================

raw_header = list(
    pd.read_csv(
        GMLC_PATH,
        nrows=0
    ).columns
)

header_map = {
    str(c).strip().upper(): c
    for c in raw_header
}

wanted = [
    # identifiers
    "UNIQ911_CID",

    # three coordinate families
    "LATITUDE",
    "LONGITUDE",

    "CELL_LATITUDE",
    "CELL_LONGITUDE",

    "ESPOSREQ_LOC_LATITUDE",
    "ESPOSREQ_LOC_LONGITUDE",

    # location quality
    "UNCERT_METERS",

    "ESPOSREQ_LOC_HORIZONTAL_UNCERT",
    "ESPOSREQ_LOC_CONFIDENCE",

    "LOCATION_FIRST_HORIZONTAL_UNCERT",
    "LOCATION_FIRST_CONFIDENCE",

    "VERTICAL_UNCERT",
    "CONFIDENCE",

    # routed PSAP
    "FCC_PSAP_ID",
    "PSAP_ID",
    "PSAP_NAME",
    "ROUTE_PSAP_NAME",

    # context
    "MARKET",
    "STATE",
    "COUNTY",
    "PHASE",

    "POS_METHOD_USED",
    "NW_METHOD_USED",

    "ESPOSREQ_INITIAL_LOCATION_SOURCE",
    "ESPOSREQ_LASTKNOWN_LOCATION_SOURCE",

    "ROUTE_LOCATION_POS_SOURCE",

    # route information
    "ROUTE_STATUS_GMLC",
