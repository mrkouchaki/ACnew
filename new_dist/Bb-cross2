def assign_expected_psap(
    frame,
    prefix,
    lat_col,
    lon_col
):

    valid_mask = [

        valid_coordinate(
            lat,
            lon
        )

        for lat, lon
        in zip(
            frame[
                lat_col
            ],
            frame[
                lon_col
            ]
        )
    ]


    point_source = (
        frame.loc[
            valid_mask,
            [
                "_REPORT_ROW_ID",
                lat_col,
                lon_col
            ]
        ]
        .copy()
    )


    points = gpd.GeoDataFrame(

        point_source,

        geometry=gpd.points_from_xy(

            point_source[
                lon_col
            ],

            point_source[
                lat_col
            ]
        ),

        crs="EPSG:4326"
    )


    joined = gpd.sjoin(

        points,

        psap[
            [
                "PSAP_ID_GEO",
                "PSAP_NAME_GEO",
                "geometry"
            ]
        ],

        how="left",

        predicate="intersects"
    )


    result_lookup = {}


    for row_id, group in joined.groupby(
        "_REPORT_ROW_ID",
        sort=False
    ):

        pairs = []


        for psap_id, psap_name in zip(

            group[
                "PSAP_ID_GEO"
            ],

            group[
                "PSAP_NAME_GEO"
            ]
        ):

            pid = norm_id(
                psap_id
            )

            if not pid:
                continue


            pair = (
                pid,
                clean_text(
                    psap_name
                )
            )


            if pair not in pairs:

                pairs.append(
                    pair
                )


        pairs = sorted(
            pairs,
            key=lambda x: x[0]
        )


        if len(pairs) == 1:

            result_lookup[
                int(row_id)
            ] = (

                pairs[0][0],

                pairs[0][1],

                "UNIQUE_PSAP"
            )


        elif len(pairs) == 0:

            result_lookup[
                int(row_id)
            ] = (

                "",
                "",

                "NO_CONTAINING_PSAP"
            )


        else:

            result_lookup[
                int(row_id)
            ] = (

                "|".join(
                    p[0]
                    for p in pairs
                ),

                "|".join(
                    p[1]
                    for p in pairs
                ),

                "MULTIPLE_PSAP"
            )


    id_col = (
        f"{prefix}_EXPECTED_PSAP_ID"
    )

    name_col = (
        f"{prefix}_EXPECTED_PSAP_NAME"
    )

    status_col = (
        f"{prefix}_EXPECTED_GEOMETRY_STATUS"
    )


