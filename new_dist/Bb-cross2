    ] = ""


    frame[
        name_col
    ] = ""


    frame[
        status_col
    ] = (
        "INVALID_OR_MISSING_COORDINATE"
    )


    for idx in frame.index:

        row_id = int(
            frame.at[
                idx,
                "_REPORT_ROW_ID"
            ]
        )


        result = (
            result_lookup.get(
                row_id
            )
        )


        if result is None:
