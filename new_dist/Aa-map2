def norm_id(value):

    if value is None or pd.isna(value):
        return ""

    text = str(value).strip().strip('"')

    if text.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:
        return ""

    return re.sub(
        r"\.0$",
        "",
        text
    )


def safe(value):

    if value is None or pd.isna(value):
        return ""

    return html.escape(
        str(value)
    )


def num(value):

    return pd.to_numeric(
        value,
        errors="coerce"
    )


def fmt(value, digits=2):

    value = num(value)

    if pd.isna(value):
        return "N/A"

    return f"{float(value):,.{digits}f}"


def valid_coord(lat, lon):

    lat = num(lat)
    lon = num(lon)

    if (
        pd.isna(lat)
        or
        pd.isna(lon)
    ):
        return False

    lat = float(lat)
    lon = float(lon)

    if not (
        -90 <= lat <= 90
        and
        -180 <= lon <= 180
    ):
        return False

    # reject obvious missing placeholder
    if (
        abs(lat) < 1e-10
        and
        abs(lon) < 1e-10
    ):
        return False

    return True


def first_existing(
    dataframe,
    candidates,
    required=False
):

    for c in candidates:

        if c in dataframe.columns:
            return c

    if required:

        raise RuntimeError(
            "Missing required column. Tried:\n"
            + "\n".join(candidates)
        )

    return None


def get_distance_km(
    dataframe,
    km_candidates,
    meter_candidates
):

    km_col = first_existing(
        dataframe,
        km_candidates
    )

    if km_col:

        return pd.to_numeric(
            dataframe[km_col],
            errors="coerce"
        )


    meter_col = first_existing(
        dataframe,
        meter_candidates
    )

    if meter_col:

        return (
            pd.to_numeric(
                dataframe[meter_col],
                errors="coerce"
            )
            / 1000.0
        )


    return pd.Series(
        np.nan,
        index=dataframe.index
    )


def repair_geometry(g):

    if (
        g is None
        or g.is_empty
    ):
        return None

    try:

        if not g.is_valid:
            g = g.buffer(0)

        if (
            g.is_empty
            or not g.is_valid
        ):
            return None

        return g

    except Exception:

        return None


def nearest_boundary(
    lat,
    lon,
    geom
):
    """
    Returns:
        nearest_lat
        nearest_lon
        geodesic_distance_km
    """

    if (
        geom is None
        or not valid_coord(lat, lon)
    ):

        return (
            np.nan,
            np.nan,
            np.nan
        )


    lat = float(lat)
    lon = float(lon)

    point = Point(
        lon,
        lat
    )


    try:

        _, near = nearest_points(
            point,
            geom.boundary
        )


        _, _, distance_m = geod.inv(
            lon,
            lat,
            near.x,
            near.y
        )


        return (
            float(near.y),
            float(near.x),
            abs(float(distance_m)) / 1000.0
        )


    except Exception:

        return (
            np.nan,
            np.nan,
            np.nan
        )


