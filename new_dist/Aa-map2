# =====================================================================
# 17. DRAW CALLS
# =====================================================================

for _, row in map_df.iterrows():

    caller_lat = row["_CALLER_LAT"]
    caller_lon = row["_CALLER_LON"]

    cell_lat = row["_CELL_LAT"]
    cell_lon = row["_CELL_LON"]

    espos_lat = row["_ESPOSREQ_LAT"]
    espos_lon = row["_ESPOSREQ_LON"]


    routed_id = row["_ROUTED_ID"]
    expected_id = row["_EXPECTED_ID"]


    # -------------------------------------------------------------
    # Names
    # -------------------------------------------------------------

    if (
        ROUTED_NAME
        and
        pd.notna(
            row.get(
                ROUTED_NAME
            )
        )
    ):

        routed_name = safe(
            row.get(
                ROUTED_NAME
            )
        )

    else:

        routed_name = safe(
            boundary_name_by_fcc.get(
                routed_id,
                ""
            )
        )


    if (
        EXPECTED_NAME
        and
        pd.notna(
            row.get(
                EXPECTED_NAME
            )
        )
    ):

        expected_name = safe(
            row.get(
                EXPECTED_NAME
            )
        )

    else:

        expected_name = safe(
            boundary_name_by_fcc.get(
                expected_id,
                ""
            )
        )


    # -------------------------------------------------------------
    # Call ID
    # -------------------------------------------------------------

    call_id = (
        safe(
            row.get(
                CALL_ID,
                ""
            )
        )
        if CALL_ID
        else ""
    )


    # -------------------------------------------------------------
    # Duration
    # -------------------------------------------------------------

    duration_value = (
        num(
            row.get(
                DURATION,
                np.nan
            )
        )
        if DURATION
        else np.nan
    )


    duration_text = (
        f"{float(duration_value):,.1f}"
        if pd.notna(duration_value)
        else "N/A"
    )


    # -------------------------------------------------------------
    # SAME / CLOSE / DIFFERENT
    # -------------------------------------------------------------

    if EXPECTED_STATUS:

        expected_status = safe(
            row.get(
                EXPECTED_STATUS,
                ""
            )
        )

    else:

        expected_status = (
            "SAME"
            if (
                routed_id
                and
                routed_id == expected_id
            )
            else "DIFFERENT"
        )


    # -------------------------------------------------------------
    # Per-PSAP statistics
    # -------------------------------------------------------------

    stats = stats_lookup.get(
        routed_id,
        {}
    )


    # -------------------------------------------------------------
    # Caller popup
    # -------------------------------------------------------------

    caller_popup = f"""
    <b>CALL</b><br>
    Call ID: {call_id}<br>
    Duration:
    <b>{duration_text} sec</b><br><br>

    <b>ROUTED PSAP</b><br>
    ID: {safe(routed_id)}<br>
    Name:
    <b>{routed_name}</b><br><br>

    <b>{EXPECTED_SOURCE} EXPECTED PSAP</b><br>
    ID: {safe(expected_id)}<br>
    Name:
    <b>{expected_name}</b><br>

    Expected vs Routed:
    <b>{expected_status}</b><br><br>

    <b>THIS CALL</b><br>

    Caller → Routed boundary:
    <b>{fmt(row["_CALLER_ROUTED_KM"])} km</b><br>

    Caller → Expected boundary:
    <b>{fmt(row["_CALLER_EXPECTED_KM"])} km</b><br>

    Cell → Routed boundary:
    <b>{fmt(row["_CELL_ROUTED_KM"])} km</b><br>

    ESPOSREQ → Routed boundary:
    <b>{fmt(row["_ESPOSREQ_ROUTED_KM"])} km</b><br>

    Caller ↔ Cell:
    <b>{fmt(row["_CALLER_CELL_KM"])} km</b><br><br>

    <b>SAME ROUTED PSAP</b><br>

    Caller Min / Mean / Max:
    {fmt(stats.get("CALLER_MIN_KM"))} /
    {fmt(stats.get("CALLER_MEAN_KM"))} /
    {fmt(stats.get("CALLER_MAX_KM"))} km<br>

    Cell Min / Mean / Max:
    {fmt(stats.get("CELL_MIN_KM"))} /
    {fmt(stats.get("CELL_MEAN_KM"))} /
    {fmt(stats.get("CELL_MAX_KM"))} km<br>

    ESPOSREQ Min / Mean / Max:
    {fmt(stats.get("ESPOSREQ_MIN_KM"))} /
    {fmt(stats.get("ESPOSREQ_MEAN_KM"))} /
    {fmt(stats.get("ESPOSREQ_MAX_KM"))} km
    """


    # =============================================================
    # CALLER MARKER
    # =============================================================

    if valid_coord(
        caller_lat,
        caller_lon
    ):

        folium.Marker(

            location=[
                float(caller_lat),
                float(caller_lon)
            ],

            popup=folium.Popup(
                caller_popup,
                max_width=500
            ),

            tooltip=(
                f"CALLER | "
                f"{call_id} | "
                f"{fmt(row['_CALLER_ROUTED_KM'])} km"
            ),

            icon=folium.Icon(
                color="blue",
                icon="phone"
            )

        ).add_to(
            caller_cluster
        )


        # ---------------------------------------------------------
        # Uncertainty
        # ---------------------------------------------------------

        if UNCERTAINTY:

            uncertainty = num(
                row.get(
                    UNCERTAINTY,
                    np.nan
                )
            )


            if (
                pd.notna(uncertainty)
                and
                0 < float(uncertainty) <= 100000
            ):

                folium.Circle(

                    location=[
                        float(caller_lat),
                        float(caller_lon)
                    ],

                    radius=float(
                        uncertainty
                    ),

                    weight=1,

                    fill=True,

                    fill_opacity=0.04,

                    tooltip=(
                        f"Caller uncertainty: "
                        f"{fmt(uncertainty, 1)} m"
                    )

                ).add_to(
                    uncertainty_layer
                )


    # =============================================================
    # CELL MARKER
    # =============================================================

    if valid_coord(
        cell_lat,
        cell_lon
    ):

        cell_popup = f"""
        <b>CELL LOCATION</b><br>
        Call ID: {call_id}<br>
        Duration:
        <b>{duration_text} sec</b><br><br>

        Latitude:
        {fmt(cell_lat, 6)}<br>

        Longitude:
        {fmt(cell_lon, 6)}<br><br>

        Cell → Routed boundary:
        <b>{fmt(row["_CELL_ROUTED_KM"])} km</b><br>

        Caller ↔ Cell:
        <b>{fmt(row["_CALLER_CELL_KM"])} km</b>
        """


        folium.Marker(

            location=[
                float(cell_lat),
                float(cell_lon)
            ],

            popup=folium.Popup(
                cell_popup,
                max_width=400
            ),

            tooltip=(
                f"CELL | {call_id}"
            ),

            icon=folium.Icon(
                color="green",
                icon="signal"
            )

        ).add_to(
            cell_cluster
        )


    # =============================================================
    # ESPOSREQ MARKER
    # =============================================================

    if valid_coord(
        espos_lat,
        espos_lon
    ):

        espos_popup = f"""
        <b>ESPOSREQ LOCATION</b><br>
        Call ID: {call_id}<br>
        Duration:
        <b>{duration_text} sec</b><br><br>

        Latitude:
        {fmt(espos_lat, 6)}<br>

        Longitude:
        {fmt(espos_lon, 6)}<br><br>

        ESPOSREQ → Routed boundary:
        <b>{fmt(row["_ESPOSREQ_ROUTED_KM"])} km</b>
        """


        folium.Marker(

            location=[
                float(espos_lat),
                float(espos_lon)
            ],

            popup=folium.Popup(
                espos_popup,
                max_width=400
            ),

            tooltip=(
                f"ESPOSREQ | {call_id}"
            ),

            icon=folium.Icon(
                color="orange",
                icon="map-marker"
            )

        ).add_to(
            esposreq_cluster
        )


    # =============================================================
    # ROUTED GEOMETRY
    # =============================================================

    routed_geom = (
        boundary_by_fcc.get(
            routed_id
        )
    )


    # =============================================================
    # CALLER -> ROUTED BOUNDARY
    # =============================================================

    if (
        routed_geom is not None
        and
        valid_coord(
            caller_lat,
            caller_lon
        )
    ):

        near_lat, near_lon, recalc_km = (
            nearest_boundary(
                caller_lat,
                caller_lon,
                routed_geom
            )
        )


        if valid_coord(
            near_lat,
            near_lon
        ):

            folium.PolyLine(

                [
                    [
                        float(caller_lat),
                        float(caller_lon)
                    ],

                    [
                        float(near_lat),
                        float(near_lon)
                    ]
                ],

                color="red",

                weight=2,

                tooltip=(
                    "Caller → Routed boundary | "
                    f"{fmt(row['_CALLER_ROUTED_KM'])} km"
                )

            ).add_to(
                caller_routed_line_layer
            )


    # =============================================================
    # CELL -> ROUTED BOUNDARY
    # =============================================================

    if (
        routed_geom is not None
        and
        valid_coord(
            cell_lat,
            cell_lon
        )
    ):

        near_lat, near_lon, recalc_km = (
            nearest_boundary(
                cell_lat,
                cell_lon,
                routed_geom
            )
        )


        if valid_coord(
            near_lat,
            near_lon
        ):

            folium.PolyLine(

                [
                    [
                        float(cell_lat),
                        float(cell_lon)
                    ],

                    [
                        float(near_lat),
                        float(near_lon)
                    ]
                ],

                color="green",

                weight=2,

                dash_array="6,5",

                tooltip=(
                    "Cell → Routed boundary | "
                    f"{fmt(row['_CELL_ROUTED_KM'])} km"
                )

            ).add_to(
                cell_routed_line_layer
            )


    # =============================================================
    # ESPOSREQ -> ROUTED BOUNDARY
    # =============================================================

    if (
        routed_geom is not None
        and
        valid_coord(
            espos_lat,
            espos_lon
        )
    ):

        near_lat, near_lon, recalc_km = (
            nearest_boundary(
                espos_lat,
                espos_lon,
                routed_geom
            )
        )


        if valid_coord(
            near_lat,
            near_lon
        ):

            folium.PolyLine(

                [
                    [
                        float(espos_lat),
                        float(espos_lon)
                    ],

                    [
                        float(near_lat),
                        float(near_lon)
                    ]
                ],

                color="orange",

                weight=2,

                dash_array="6,5",

                tooltip=(
                    "ESPOSREQ → Routed boundary | "
                    f"{fmt(row['_ESPOSREQ_ROUTED_KM'])} km"
                )

            ).add_to(
                esposreq_routed_line_layer
            )


    # =============================================================
    # EXPECTED SOURCE -> EXPECTED BOUNDARY
    # =============================================================

    if (
        expected_id
        and
        "|" not in expected_id
    ):

        expected_geom = (
            boundary_by_fcc.get(
                expected_id
            )
        )

    else:

        expected_geom = None


    exp_lat = row["_EXP_LAT"]
    exp_lon = row["_EXP_LON"]


    if (
        expected_geom is not None
        and
        valid_coord(
            exp_lat,
            exp_lon
        )
    ):

        near_lat, near_lon, recalc_km = (
            nearest_boundary(
                exp_lat,
                exp_lon,
                expected_geom
            )
        )


        if valid_coord(
            near_lat,
            near_lon
        ):

            folium.PolyLine(

                [
                    [
                        float(exp_lat),
                        float(exp_lon)
                    ],

                    [
                        float(near_lat),
                        float(near_lon)
                    ]
                ],

                color="darkgreen",

                weight=2,

                dash_array="6,6",

                tooltip=(
                    f"{EXPECTED_SOURCE} → Expected boundary | "
                    f"{fmt(row['_EXP_BOUNDARY_KM'])} km"
                )

            ).add_to(
                caller_expected_line_layer
            )


    # =============================================================
    # CALLER -> CELL
    # =============================================================

    if (
        valid_coord(
            caller_lat,
            caller_lon
        )
        and
        valid_coord(
            cell_lat,
            cell_lon
        )
    ):

        folium.PolyLine(

            [
                [
                    float(caller_lat),
                    float(caller_lon)
                ],

                [
                    float(cell_lat),
                    float(cell_lon)
                ]
            ],

            color="blue",

            weight=2,

            opacity=0.65,

            dash_array="8,6",

            tooltip=(
                f"Caller ↔ Cell | "
                f"{fmt(row['_CALLER_CELL_KM'])} km"
            )

        ).add_to(
            caller_cell_line_layer
        )


