def canonical_nena_id(value):
    """
    Canonical numeric identity.

    Examples:
        040500006 -> 40500006
        020200005 -> 20200005
        20200005  -> 20200005
    """

    if value is None or pd.isna(value):
        return ""

    text = (
        str(value)
        .strip()
        .strip('"')
    )

    if text.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:
        return ""

    text = re.sub(
        r"\.0$",
        "",
        text
    )

    if re.fullmatch(
        r"\d+",
        text
    ):
        return str(
            int(text)
        )

    return text.upper()


def clean_text(value):

    if value is None or pd.isna(value):
        return ""

    return str(value).strip()


def numeric(value):

    value = pd.to_numeric(
        value,
        errors="coerce"
    )

    try:
        value = float(value)
    except Exception:
        return np.nan

    if not math.isfinite(value):
        return np.nan

    return value


def valid_coordinate(
    lat,
    lon
):

    lat = numeric(lat)
    lon = numeric(lon)

    if (
        not np.isfinite(lat)
        or
        not np.isfinite(lon)
    ):
        return False

    if not (
        -90 <= lat <= 90
        and
        -180 <= lon <= 180
    ):
        return False

    if (
        abs(lat) < 1e-10
        and
        abs(lon) < 1e-10
    ):
        return False

    return True


def repair_geometry(g):

    if (
        g is None
        or g.is_empty
    ):
        return None

    try:

        if not g.is_valid:
            g = g.buffer(0)

        if (
            g is None
            or g.is_empty
            or not g.is_valid
        ):
            return None

        return g

    except Exception:
        return None


def geodesic_km(
    lat1,
    lon1,
    lat2,
    lon2
):

    if not (
        valid_coordinate(lat1, lon1)
        and
        valid_coordinate(lat2, lon2)
    ):
        return np.nan

    _, _, meters = GEOD.inv(

        float(lon1),
        float(lat1),

        float(lon2),
        float(lat2)
    )

    return (
        abs(float(meters))
        / 1000.0
    )


