def calculate_nena_distances(
    frame,
    prefix
):

    lat_col = (
        f"{prefix}_LATITUDE"
    )

    lon_col = (
        f"{prefix}_LONGITUDE"
    )

    expected_col = (
        f"{prefix}_EXPECTED_NENA_ID"
    )


    routed_distances = []
    signed_routed_distances = []
    routed_relations = []

    expected_distances = []

    expected_vs_routed = []


    for _, row in frame.iterrows():

        lat = numeric(
            row[
                lat_col
            ]
        )

        lon = numeric(
            row[
                lon_col
            ]
        )


        if not valid_coordinate(
            lat,
            lon
        ):

            routed_distances.append(
                np.nan
            )

            signed_routed_distances.append(
                np.nan
            )

            routed_relations.append(
                "INVALID_OR_MISSING_COORDINATE"
            )

            expected_distances.append(
                np.nan
            )

            expected_vs_routed.append(
                "INVALID_COORDINATE"
            )

            continue


        point = Point(
            lon,
            lat
        )


        routed_nena = clean_text(
            row[
                "ROUTED_NENA_ID"
            ]
        )


        expected_nena = clean_text(
            row[
                expected_col
            ]
        )


        # =========================================================
        # ROUTED DISTANCE
        # =========================================================

        if not routed_nena:

            routed_km = np.nan

            signed_km = np.nan

            relation = (
                "UNRESOLVED_ROUTED_BOUNDARY"
            )


        else:

            routed_geom = (
                boundary_by_nena.get(
                    routed_nena
                )
            )


            if routed_geom is None:

                routed_km = np.nan

                signed_km = np.nan

                relation = (
                    "UNRESOLVED_ROUTED_BOUNDARY"
                )


            else:

                try:

                    _, nearest = nearest_points(

                        point,

                        routed_geom.boundary
                    )


                    routed_km = geodesic_km(

                        lat,
                        lon,

                        nearest.y,
                        nearest.x
                    )


                    if (
                        routed_geom
                        .boundary
                        .intersects(
                            point
                        )
                    ):

                        relation = (
                            "BOUNDARY"
                        )

                        signed_km = 0.0


                    elif routed_geom.covers(
                        point
                    ):

                        relation = (
                            "INSIDE"
                        )

                        signed_km = (
                            -routed_km
                        )


                    else:

                        relation = (
                            "OUTSIDE"
                        )

                        signed_km = (
                            routed_km
                        )


                except Exception:

                    routed_km = np.nan

                    signed_km = np.nan

                    relation = (
                        "ROUTED_DISTANCE_ERROR"
                    )


        routed_distances.append(
            routed_km
        )

        signed_routed_distances.append(
            signed_km
        )

        routed_relations.append(
            relation
        )


        # =========================================================
        # EXPECTED DISTANCE
        # =========================================================

        if (
            expected_nena
            and
            "|" not in expected_nena
        ):

            expected_geom = (
                boundary_by_nena.get(
                    expected_nena
                )
            )

        else:

            expected_geom = None


        if expected_geom is None:

            expected_km = np.nan


        else:

            try:

                _, nearest = nearest_points(

                    point,

                    expected_geom.boundary
                )


                expected_km = geodesic_km(

                    lat,
                    lon,

                    nearest.y,
                    nearest.x
                )


            except Exception:

                expected_km = np.nan


        expected_distances.append(
            expected_km
        )


        # =========================================================
        # SAME / CLOSE / DIFFERENT / UNRESOLVED
        # =========================================================

        if not routed_nena:

            comparison = (
                "UNRESOLVED_ROUTED_BOUNDARY"
            )


        elif not expected_nena:

            comparison = (
                "UNRESOLVED_EXPECTED_PSAP"
            )


        elif "|" in expected_nena:

            comparison = (
                "AMBIGUOUS_EXPECTED_PSAP"
            )


        elif (
            expected_nena
            ==
            routed_nena
        ):

            comparison = (
                "SAME"
            )


        elif (
            np.isfinite(
                routed_km
            )
            and
            routed_km
            <= CLOSE_BOUNDARY_KM
        ):

            comparison = (
                "CLOSE"
            )


        else:

            comparison = (
                "DIFFERENT"
            )


        expected_vs_routed.append(
            comparison
        )


    frame[
        f"{prefix}_TO_ROUTED_BOUNDARY_KM"
    ] = routed_distances


    frame[
        f"{prefix}_SIGNED_TO_ROUTED_BOUNDARY_KM"
    ] = signed_routed_distances


    frame[
        f"{prefix}_RELATION_TO_ROUTED_PSAP"
    ] = routed_relations


    frame[
        f"{prefix}_TO_EXPECTED_BOUNDARY_KM"
    ] = expected_distances


    frame[
        f"{prefix}_EXPECTED_VS_ROUTED"
    ] = expected_vs_routed


    return frame


for prefix in [
    "CALLER",
    "CELL",
    "ESPOSREQ"
