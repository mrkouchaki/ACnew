def assign_expected_nena(
    frame,
    prefix
):

    lat_col = (
        f"{prefix}_LATITUDE"
    )

    lon_col = (
        f"{prefix}_LONGITUDE"
    )


    valid = [

        valid_coordinate(
            lat,
            lon
        )

        for lat, lon
        in zip(
            frame[
                lat_col
            ],
            frame[
                lon_col
            ]
        )
    ]


    point_data = (
        frame.loc[
            valid,
            [
                "_ROW_ID_NENA",
                lat_col,
                lon_col
            ]
        ]
        .copy()
    )


    points = gpd.GeoDataFrame(

        point_data,

        geometry=gpd.points_from_xy(

            point_data[
                lon_col
            ],

            point_data[
                lat_col
            ]
        ),

        crs="EPSG:4326"
    )


    joined = gpd.sjoin(

        points,

        psap_nena[
            [
                "NENA_ID_CANON",
                "NENA_ID_RAW",
                "FCC_ID_META",
                "PSAP_AGENCY",
                "geometry"
            ]
        ],

        how="left",

        predicate="intersects"
    )


    lookup = {}


    for row_id, group in joined.groupby(
        "_ROW_ID_NENA",
        sort=False
    ):

        ids = sorted(
            {
                canonical_nena_id(x)

                for x
                in group[
                    "NENA_ID_CANON"
                ]

                if canonical_nena_id(x)
            }
        )


        if len(ids) == 1:

            nena = ids[0]

            lookup[
                int(row_id)
            ] = {

                "ID":
                    nena,

                "NAME":
                    agency_by_nena.get(
                        nena,
                        ""
                    ),

                "FCC":
                    fcc_by_nena.get(
                        nena,
                        ""
                    ),

                "STATUS":
                    "UNIQUE_NENA_PSAP",
            }


        elif len(ids) == 0:

            lookup[
                int(row_id)
            ] = {

                "ID":
                    "",

                "NAME":
                    "",

                "FCC":
                    "",

                "STATUS":
                    "NO_CONTAINING_PSAP",
            }


        else:

            lookup[
                int(row_id)
            ] = {

                "ID":
                    "|".join(
                        ids
                    ),

                "NAME":
                    "",

                "FCC":
                    "",

                "STATUS":
                    "MULTIPLE_CONTAINING_PSAP",
            }


    frame[
        f"{prefix}_EXPECTED_NENA_ID"
    ] = ""


    frame[
        f"{prefix}_EXPECTED_PSAP_NAME"
    ] = ""


    frame[
        f"{prefix}_EXPECTED_FCC_ID"
    ] = ""


    frame[
        f"{prefix}_EXPECTED_GEOMETRY_STATUS"
    ] = (
        "INVALID_OR_MISSING_COORDINATE"
    )


    for idx in frame.index:

        row_id = int(
            frame.at[
                idx,
                "_ROW_ID_NENA"
            ]
        )


        item = lookup.get(
            row_id
        )


        if item is None:
            continue


        frame.at[
            idx,
            f"{prefix}_EXPECTED_NENA_ID"
        ] = item[
            "ID"
        ]


        frame.at[
            idx,
            f"{prefix}_EXPECTED_PSAP_NAME"
        ] = item[
            "NAME"
        ]


        frame.at[
            idx,
            f"{prefix}_EXPECTED_FCC_ID"
        ] = item[
            "FCC"
        ]


        frame.at[
            idx,
            f"{prefix}_EXPECTED_GEOMETRY_STATUS"
        ] = item[
            "STATUS"
        ]


    return frame


