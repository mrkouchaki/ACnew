

# =====================================================================
# THREE-LOCATION PSAP / COORDINATE RECONCILIATION REPORT v3
# =====================================================================
#
# PURPOSE
# -------
# Diagnostic QA only. Does NOT overwrite v5 geographic labels.
#
# Compare three location families:
#
#   CALLER:
#       LATITUDE / LONGITUDE
#
#   CELL:
#       CELL_LATITUDE / CELL_LONGITUDE
#
#   ESPOSREQ:
#       ESPOSREQ_LOC_LATITUDE / ESPOSREQ_LOC_LONGITUDE
#
# Each location is independently checked against PSAP polygons.
#
#
# INPUTS
# ------
# 1. psap_routing_definite_misroutes_filtered_by_routed_distance.csv
#
# 2. C:\temp\gmlc_v2\e911_lte_master_gmlc.csv
#
# 3. C:\temp\gmlc_v2\psap\Final_Join.tab
#
#
# MAIN OUTPUTS
# ------------
# 1. psap_three_location_coordinate_crosscheck_v5.csv
#
#    One row per call:
#      - ROUTED PSAP
#      - CALLER-derived expected PSAP
#      - CELL-derived expected PSAP
#      - ESPOSREQ-derived expected PSAP
#      - each location -> routed PSAP boundary distance
#      - each location -> expected PSAP boundary distance
#      - signed routed-boundary distance
#      - caller <-> cell
#      - caller <-> ESPOSREQ
#      - cell <-> ESPOSREQ
#      - SAME / CLOSE / DIFFERENT
#      - source/context fields
#      - original v5 results for comparison
#
# 2. psap_three_location_coordinate_summary_v5.csv
#
#    Call counts/rates by coordinate-pattern category.
#
# 3. psap_three_location_to_routed_min_mean_max_v5.csv
#
#    THREE rows:
#       CALLER   -> ROUTED PSAP boundary: MIN / MEAN / MAX
#       CELL     -> ROUTED PSAP boundary: MIN / MEAN / MAX
#       ESPOSREQ -> ROUTED PSAP boundary: MIN / MEAN / MAX
#
# 4. psap_three_location_to_routed_min_mean_max_horizontal_v5.csv
#
#    Same statistics in ONE ROW with nine columns so they are beside
#    each other in Excel.
#
#
# IMPORTANT COLUMN NAMING
# -----------------------
# ROUTED_PSAP_*:
#     PSAP actually routed according to original GMLC record.
#
# CALLER_EXPECTED_PSAP_*:
#     PSAP polygon containing LATITUDE/LONGITUDE.
#
# CELL_EXPECTED_PSAP_*:
#     PSAP polygon containing CELL_LATITUDE/CELL_LONGITUDE.
#
# ESPOSREQ_EXPECTED_PSAP_*:
#     PSAP polygon containing ESPOSREQ_LOC_LATITUDE/LONGITUDE.
#
#
# SAME / CLOSE / DIFFERENT
# ------------------------
# SAME:
#     expected FCC PSAP == routed FCC PSAP
#
# CLOSE:
#     expected PSAP differs but point is <= CLOSE_BOUNDARY_M from
#     routed PSAP boundary
#
# DIFFERENT:
#     expected PSAP differs and point is farther away
#
# =====================================================================

from pathlib import Path
from collections import defaultdict
import re

import numpy as np
import pandas as pd
import geopandas as gpd

from pyproj import Geod
from shapely.geometry import Point
from shapely.ops import nearest_points, unary_union
from shapely.strtree import STRtree
from IPython.display import display, Markdown


# =====================================================================
# 0. CONFIGURATION
# =====================================================================

DATA_DIR = globals().get("DATA_DIR", Path(r"C:\temp\gmlc_v2"))
