gmlc_psap_name_map = {}

for chunk_no, chunk in enumerate(
    pd.read_csv(
        GMLC_PATH,
        dtype="string",
        chunksize=CSV_CHUNK_ROWS,
        usecols=actual_usecols,
        low_memory=False,
        encoding_errors="replace"
    ),
    start=1,
):
    chunk.columns = [
        str(c).strip().upper()
        for c in chunk.columns
    ]

    chunk["RAW_GMLC_ROW_ID"] = np.arange(
        row_offset + 1,
        row_offset + len(chunk) + 1,
        dtype=np.int64
    )

    row_offset += len(chunk)

    if "UNIQ911_CID" in chunk:
        chunk["CID_NORM"] = (
            chunk["UNIQ911_CID"]
            .map(norm_id)
        )
    else:
        chunk["CID_NORM"] = ""

    # Build FCC PSAP -> PSAP name lookup.
    if (
        "FCC_PSAP_ID" in chunk
        and
        "PSAP_NAME" in chunk
    ):
        pairs = (
            chunk[
                ["FCC_PSAP_ID", "PSAP_NAME"]
            ]
            .dropna()
            .drop_duplicates()
        )

        for fcc, name in pairs.itertuples(
            index=False,
            name=None
        ):
            fcc_n = norm_id(fcc)
            name_n = clean_text(name)

            if (
                fcc_n
                and name_n
                and fcc_n not in gmlc_psap_name_map
            ):
                gmlc_psap_name_map[
                    fcc_n
                ] = name_n

    mask = (
        chunk["CID_NORM"]
        .isin(target_cids)
    )

    if target_row_ids:
        mask |= (
            chunk["RAW_GMLC_ROW_ID"]
            .isin(target_row_ids)
        )

    if mask.any():
        selected_chunks.append(
            chunk.loc[
                mask
            ].copy()
        )

    if chunk_no % 10 == 0:
        print(
            f"Scanned {row_offset:,} "
            f"GMLC rows..."
        )

