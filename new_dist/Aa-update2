def coordinate_pattern(row):

    c = (
        row[
            "CALLER_ROUTED_VS_EXPECTED_STATUS"
        ]
    )

    s = (
        row[
            "CELL_ROUTED_VS_EXPECTED_STATUS"
        ]
    )

    e = (
        row[
            "ESPOSREQ_ROUTED_VS_EXPECTED_STATUS"
        ]
    )

    if (
        c == "SAME"
        and s == "SAME"
        and e == "SAME"
    ):
        return (
            "ALL_3_SUPPORT_ROUTED_PSAP"
        )

    if (
        c == "DIFFERENT"
        and s == "SAME"
        and e == "SAME"
    ):
        return (
            "CALLER_DIFFERS_CELL_ESPOSREQ_SUPPORT_ROUTED"
        )

    if (
        c == "SAME"
        and s == "SAME"
        and e == "DIFFERENT"
    ):
        return (
            "ESPOSREQ_DIFFERS_CALLER_CELL_SUPPORT_ROUTED"
        )

    if (
        c == "SAME"
        and s == "DIFFERENT"
        and e == "SAME"
    ):
        return (
            "CELL_DIFFERS_CALLER_ESPOSREQ_SUPPORT_ROUTED"
        )

    if (
        c == "DIFFERENT"
        and s == "DIFFERENT"
        and e == "DIFFERENT"
    ):
        return (
            "NONE_SUPPORT_ROUTED_PSAP"
        )

    if "CLOSE" in {
        c,
        s,
        e
    }:
        return (
            "NEAR_BOUNDARY_OR_MIXED"
        )

    return (
        "MIXED_COORDINATE_EVIDENCE"
    )


