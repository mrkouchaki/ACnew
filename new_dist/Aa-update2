# =====================================================================
# 1. HELPERS
# =====================================================================

def norm_id(value):
    if value is None or pd.isna(value):
        return ""
    return re.sub(
        r"\.0$",
        "",
        str(value).strip().strip('"').upper()
    )


def clean_text(value):
    if value is None or pd.isna(value):
        return ""
    return str(value).strip()


def numeric(series):
    return pd.to_numeric(
        series,
        errors="coerce"
    )


def valid_latlon(lat, lon):
    return (
        pd.notna(lat)
        and pd.notna(lon)
        and -90 <= float(lat) <= 90
        and -180 <= float(lon) <= 180
    )


geod = Geod(
    ellps="WGS84"
)


# =====================================================================
# 2. READ FILTERED V5 RESULTS
# =====================================================================

flt = pd.read_csv(
    INPUT_PATH,
    dtype="string",
    low_memory=False
)

flt.columns = [
    str(c).strip().upper()
    for c in flt.columns
]

if "UNIQ911_CID" not in flt.columns:
    raise RuntimeError(
        "Filtered file must contain UNIQ911_CID."
    )

flt["CID_NORM"] = (
    flt["UNIQ911_CID"]
