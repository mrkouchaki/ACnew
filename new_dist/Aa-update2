}

fcc_column = next(
    (
        geo_upper[c]
        for c in [
            "FCC_ID",
            "FCC_PSAP_ID",
        ]
        if c in geo_upper
    ),
    None
)

if fcc_column is None:
    raise RuntimeError(
        "PSAP boundary file has no "
        "FCC_ID/FCC_PSAP_ID."
    )

name_column = next(
    (
        geo_upper[c]
        for c in [
            "PSAP_NAME",
            "NAME",
            "AGENCY_NAME",
            "AGENCY",
            "PSAP",
        ]
        if c in geo_upper
    ),
    None
)


def repair_geometry(g):
    if g is None or g.is_empty:
        return None

    try:
        if not g.is_valid:
            g = g.buffer(0)

        return (
            None
            if g.is_empty or not g.is_valid
            else g
        )

    except Exception:
        return None


pieces = defaultdict(list)
boundary_names = {}

for _, row in geo.iterrows():
    fcc = norm_id(
        row[fcc_column]
    )

    geom = repair_geometry(
        row.geometry
    )

    if not fcc or geom is None:
        continue

    pieces[fcc].append(
        geom
    )

    if (
        name_column is not None
        and
        pd.notna(
            row[name_column]
        )
    ):
        boundary_names[fcc] = clean_text(
            row[name_column]
        )

boundary_fcc = []
boundary_geometries = []

for fcc, geoms in pieces.items():
    merged = repair_geometry(
        unary_union(geoms)
    )

    if merged is not None:
        boundary_fcc.append(
            fcc
        )

        boundary_geometries.append(
            merged
        )

boundary_by_fcc = dict(
    zip(
        boundary_fcc,
        boundary_geometries
    )
)

tree = STRtree(
    boundary_geometries
)

geom_position = {
    id(g): i
    for i, g in enumerate(
        boundary_geometries
    )
}

psap_name_map = dict(
    gmlc_psap_name_map
)

psap_name_map.update({
    k: v
    for k, v in boundary_names.items()
    if v
})

print(
    f"Usable PSAP polygons: "
    f"{len(boundary_fcc):,}"
)


# =====================================================================
# 7. PSAP / BOUNDARY FUNCTIONS
# =====================================================================

def tree_positions(geometry):
    hits = tree.query(
        geometry
    )

    out = []

    for hit in hits:
        if isinstance(
            hit,
            (int, np.integer)
        ):
            out.append(
                int(hit)
            )
        else:
            pos = geom_position.get(
                id(hit)
            )

            if pos is not None:
                out.append(
                    pos
                )

    return out


def distance_to_boundary_m(
    lat,
    lon,
    geom
):
    if (
        geom is None
        or
        not valid_latlon(
            lat,
            lon
        )
    ):
        return np.nan

    point = Point(
        float(lon),
        float(lat)
    )

    try:
        _, near = nearest_points(
            point,
            geom.boundary
        )

        _, _, d = geod.inv(
            float(lon),
            float(lat),
            near.x,
            near.y
        )

        return abs(
            float(d)
        )

    except Exception:
        return np.nan


def routed_expected_status(
    expected_id,
    routed_id,
    routed_boundary_distance
):
    expected_id = norm_id(
        expected_id
    )

    routed_id = norm_id(
        routed_id
    )

    if (
        expected_id
        and routed_id
        and expected_id == routed_id
    ):
        return "SAME"

    d = pd.to_numeric(
        routed_boundary_distance,
        errors="coerce"
    )

    if (
        expected_id
        and routed_id
        and pd.notna(d)
        and d <= CLOSE_BOUNDARY_M
    ):
        return "CLOSE"

    return "DIFFERENT"


def analyze_point(
    lat_value,
    lon_value,
    routed_value
):
    lat = pd.to_numeric(
        lat_value,
        errors="coerce"
    )

    lon = pd.to_numeric(
        lon_value,
        errors="coerce"
    )

    routed = norm_id(
        routed_value
    )

    if not valid_latlon(
        lat,
        lon
    ):
        return {
            "EXPECTED_PSAP_FCC_ID": "",
            "EXPECTED_PSAP_NAME": "",
            "POINT_STATUS": "INVALID_OR_MISSING",
            "MATCHES_ROUTED_PSAP": False,
            "ROUTED_RELATION": "INVALID_OR_MISSING",
            "TO_ROUTED_BOUNDARY_M": np.nan,
            "SIGNED_TO_ROUTED_BOUNDARY_M": np.nan,
            "TO_EXPECTED_BOUNDARY_M": np.nan,
            "ROUTED_VS_EXPECTED_STATUS": "DIFFERENT",
        }

    lat = float(lat)
    lon = float(lon)

    point = Point(
        lon,
        lat
    )

    inside = sorted(
        set(
            boundary_fcc[pos]
            for pos in tree_positions(
                point
            )
            if boundary_geometries[
                pos
            ].covers(
                point
            )
        )
    )

    if len(inside) == 1:
        point_status = "UNIQUE_PSAP"
        expected = inside[0]
        expected_name = (
            psap_name_map.get(
                expected,
                ""
            )
        )

    elif len(inside) == 0:
        point_status = "NO_CONTAINING_PSAP"
        expected = ""
        expected_name = ""

    else:
        point_status = "MULTIPLE_PSAP"
        expected = "|".join(
            inside
        )
        expected_name = ""

    routed_geom = (
        boundary_by_fcc.get(
            routed
        )
    )

    if routed_geom is None:
        relation = "MISSING_ROUTED_BOUNDARY"
        routed_distance = np.nan
        signed_distance = np.nan

    else:
        routed_distance = (
            distance_to_boundary_m(
                lat,
                lon,
                routed_geom
            )
        )

        if routed_geom.covers(
            point
        ):
            relation = "INSIDE"
            signed_distance = (
                -routed_distance
            )

        elif routed_geom.intersects(
            point
        ):
            relation = "BOUNDARY"
            signed_distance = 0.0

        else:
            relation = "OUTSIDE"
            signed_distance = (
                routed_distance
            )

    expected_distance = np.nan

    if len(inside) == 1:
        expected_geom = (
            boundary_by_fcc.get(
                expected
            )
        )

        expected_distance = (
            distance_to_boundary_m(
                lat,
                lon,
                expected_geom
            )
        )

    status = routed_expected_status(
        expected,
        routed,
        routed_distance
    )

    return {
        "EXPECTED_PSAP_FCC_ID": expected,
        "EXPECTED_PSAP_NAME": expected_name,
        "POINT_STATUS": point_status,
        "MATCHES_ROUTED_PSAP": (
            len(inside) == 1
            and expected == routed
        ),
        "ROUTED_RELATION": relation,
        "TO_ROUTED_BOUNDARY_M": routed_distance,
        "SIGNED_TO_ROUTED_BOUNDARY_M": signed_distance,
        "TO_EXPECTED_BOUNDARY_M": expected_distance,
        "ROUTED_VS_EXPECTED_STATUS": status,
    }


# =====================================================================
# 8. EXPLICIT ROUTED PSAP COLUMN NAMES
# =====================================================================

for c in [
    "LATITUDE",
    "LONGITUDE",
    "CELL_LATITUDE",
    "CELL_LONGITUDE",
    "ESPOSREQ_LOC_LATITUDE",
    "ESPOSREQ_LOC_LONGITUDE",
]:
    if c not in report:
        report[c] = np.nan

    report[c] = numeric(
        report[c]
    )

report["ROUTED_PSAP_FCC_ID"] = (
    report["FCC_PSAP_ID"]
    .map(norm_id)
)

if "PSAP_NAME" not in report:
    report["PSAP_NAME"] = ""

if "ROUTE_PSAP_NAME" not in report:
    report["ROUTE_PSAP_NAME"] = ""

report["ROUTED_PSAP_NAME_MASTER"] = (
    report["PSAP_NAME"]
    .fillna("")
    .astype(str)
    .str.strip()
)

report["ROUTED_PSAP_NAME_ROUTE"] = (
    report["ROUTE_PSAP_NAME"]
    .fillna("")
    .astype(str)
    .str.strip()
)

report["ROUTED_PSAP_NAME_RESOLVED"] = (
    report["ROUTED_PSAP_NAME_ROUTE"]
    .where(
        report[
            "ROUTED_PSAP_NAME_ROUTE"
        ].ne(""),
        report[
            "ROUTED_PSAP_NAME_MASTER"
        ]
    )
)

missing_routed_name = (
    report[
        "ROUTED_PSAP_NAME_RESOLVED"
    ].eq("")
)

report.loc[
    missing_routed_name,
    "ROUTED_PSAP_NAME_RESOLVED"
] = (
    report.loc[
        missing_routed_name,
        "ROUTED_PSAP_FCC_ID"
    ]
    .map(psap_name_map)
    .fillna("")
)

report[
    "ROUTED_SOURCE_NAMES_AGREE"
] = (
    report[
        "ROUTED_PSAP_NAME_MASTER"
    ].str.upper()
    ==
    report[
        "ROUTED_PSAP_NAME_ROUTE"
    ].str.upper()
