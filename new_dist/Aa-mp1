def norm_id(value):

    if value is None or pd.isna(value):
        return ""

    value = (
        str(value)
        .strip()
        .strip('"')
    )

    if value.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:
        return ""

    return re.sub(
        r"\.0$",
        "",
        value
    )


def safe_text(value):

    if value is None or pd.isna(value):
        return ""

    return html.escape(
        str(value).strip()
    )


def fmt_num(
    value,
    digits=2
):

    value = pd.to_numeric(
        value,
        errors="coerce"
    )

    if pd.isna(value):
        return "N/A"

    return f"{float(value):,.{digits}f}"


def pick_col(
    df,
    candidates,
    required=False
):

    for column in candidates:

        if column in df.columns:
            return column

    if required:

        raise RuntimeError(
            "None of these columns exist:\n"
            + "\n".join(candidates)
        )

    return None


def numeric_series(
    df,
    column
):

    if column is None:

        return pd.Series(
            np.nan,
            index=df.index,
            dtype=float
        )

    return pd.to_numeric(
        df[column],
        errors="coerce"
    )


def distance_km(
    df,
    km_candidates,
    m_candidates
):

    km_col = pick_col(
        df,
        km_candidates
    )

    if km_col is not None:

        return pd.to_numeric(
            df[km_col],
            errors="coerce"
        )


    m_col = pick_col(
        df,
        m_candidates
    )

    if m_col is not None:

        return (
            pd.to_numeric(
                df[m_col],
                errors="coerce"
            )
            / 1000.0
        )


    return pd.Series(
        np.nan,
        index=df.index,
        dtype=float
    )


def valid_point(
    lat,
    lon
):

    lat = pd.to_numeric(
        lat,
        errors="coerce"
    )

    lon = pd.to_numeric(
        lon,
        errors="coerce"
    )

    return (
        pd.notna(lat)
        and pd.notna(lon)
        and -90 <= float(lat) <= 90
        and -180 <= float(lon) <= 180
    )


def repair_geometry(
    geometry
):

    if (
        geometry is None
        or geometry.is_empty
    ):
        return None

    try:

        if not geometry.is_valid:
            geometry = geometry.buffer(0)

        if (
            geometry.is_empty
            or not geometry.is_valid
        ):
            return None

        return geometry

    except Exception:

        return None


def nearest_boundary_location(
    lat,
    lon,
    geometry
):
    """
    Return:
       boundary_lat,
       boundary_lon,
       geodesic_distance_km
    """

    if (
        geometry is None
        or
        not valid_point(
            lat,
            lon
        )
    ):
        return (
            np.nan,
            np.nan,
            np.nan
        )


    lat = float(lat)
    lon = float(lon)

    point = Point(
        lon,
        lat
    )


    try:

        _, near = nearest_points(
            point,
            geometry.boundary
        )


        _, _, distance_m = geod.inv(
            lon,
            lat,
            near.x,
            near.y
        )


        return (
            float(near.y),
            float(near.x),
            abs(float(distance_m)) / 1000.0
        )


    except Exception:

        return (
            np.nan,
            np.nan,
            np.nan
        )


