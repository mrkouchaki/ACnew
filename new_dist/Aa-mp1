                    color="#2ca02c",

                    fill=True,

                    fill_opacity=1,

                    tooltip=(
                        "Nearest point on EXPECTED "
                        "PSAP boundary"
                    )

                ).add_to(
                    nearest_point_layer
                )


    # =============================================================
    # CALLER -> CELL
    # =============================================================

    if (
        SHOW_CALLER_TO_CELL_LINE
        and
        valid_point(
            caller_lat,
            caller_lon
        )
        and
        valid_point(
            cell_lat,
            cell_lon
        )
    ):

        folium.PolyLine(

            locations=[
                [
                    float(caller_lat),
                    float(caller_lon)
                ],

                [
                    float(cell_lat),
                    float(cell_lon)
                ],
            ],

            color="#3366cc",

            weight=2,

            opacity=0.65,

            dash_array="7,6",

            tooltip=(
                "Caller ↔ Cell: "
                f"{fmt_num(row['_CALLER_CELL_KM'])} km"
            )

        ).add_to(
            caller_cell_line_layer
        )


