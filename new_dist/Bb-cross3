def calculate_boundary_distances(
    frame,
    prefix,
    lat_col,
    lon_col
):

    expected_id_col = (
        f"{prefix}_EXPECTED_NENA_ID"
    )


    routed_distance = []
    routed_signed_distance = []
    routed_relation = []

    expected_distance = []

    nearest_routed_lat = []
    nearest_routed_lon = []

    nearest_expected_lat = []
    nearest_expected_lon = []

    expected_vs_routed = []


    for _, row in frame.iterrows():

        lat = numeric(
            row[
                lat_col
            ]
        )

        lon = numeric(
            row[
                lon_col
            ]
        )


        routed_id = canonical_nena_id(
            row[
                "ROUTED_NENA_ID"
            ]
        )


        expected_id = clean_text(
            row[
                expected_id_col
            ]
        )


        # ---------------------------------------------------------
        # INVALID COORDINATE
        # ---------------------------------------------------------

        if not valid_coordinate(
            lat,
            lon
        ):

            routed_distance.append(
                np.nan
            )

            routed_signed_distance.append(
                np.nan
            )

            routed_relation.append(
                "INVALID_OR_MISSING_COORDINATE"
            )

            expected_distance.append(
                np.nan
            )

            nearest_routed_lat.append(
                np.nan
            )

            nearest_routed_lon.append(
                np.nan
            )

            nearest_expected_lat.append(
                np.nan
            )

            nearest_expected_lon.append(
                np.nan
            )

            expected_vs_routed.append(
                "INVALID_COORDINATE"
            )

            continue


        point = Point(
            lon,
            lat
        )


        # =========================================================
        # ROUTED NENA BOUNDARY
        # =========================================================

        if not routed_id:

            route_km = np.nan

            signed_km = np.nan

            relation = (
                "UNRESOLVED_ROUTED_BOUNDARY"
            )

            rlat = np.nan
            rlon = np.nan


        else:

            routed_geom = (
                boundary_by_nena.get(
                    routed_id
                )
            )


            if routed_geom is None:

                route_km = np.nan

                signed_km = np.nan

                relation = (
                    "UNRESOLVED_ROUTED_BOUNDARY"
                )

                rlat = np.nan
                rlon = np.nan


            else:

                try:

                    _, nearest = nearest_points(

                        point,

                        routed_geom.boundary
                    )


                    rlat = float(
                        nearest.y
                    )

                    rlon = float(
                        nearest.x
                    )


                    route_km = (
                        geodesic_distance_km(

                            lat,
                            lon,

                            rlat,
                            rlon
                        )
                    )


                    if (
                        routed_geom
                        .boundary
                        .intersects(
                            point
                        )
                    ):

                        relation = (
                            "BOUNDARY"
                        )

                        signed_km = 0.0


                    elif routed_geom.covers(
                        point
                    ):

                        relation = (
                            "INSIDE"
                        )

                        signed_km = (
                            -route_km
                        )


                    else:

                        relation = (
                            "OUTSIDE"
                        )

                        signed_km = (
                            route_km
                        )


                except Exception:

                    route_km = np.nan

                    signed_km = np.nan

                    relation = (
                        "ROUTED_DISTANCE_ERROR"
                    )

                    rlat = np.nan
                    rlon = np.nan


        routed_distance.append(
            route_km
        )

        routed_signed_distance.append(
            signed_km
        )

        routed_relation.append(
            relation
        )

        nearest_routed_lat.append(
            rlat
        )

        nearest_routed_lon.append(
            rlon
        )


        # =========================================================
        # EXPECTED NENA BOUNDARY
        # =========================================================

        if (
            expected_id
            and
            "|" not in expected_id
        ):

            expected_geom = (
                boundary_by_nena.get(
                    canonical_nena_id(
                        expected_id
                    )
                )
            )

        else:

            expected_geom = None


        if expected_geom is None:

            expected_km = np.nan

            elat = np.nan
            elon = np.nan


        else:

            try:

                _, nearest = nearest_points(

                    point,

                    expected_geom.boundary
                )


                elat = float(
                    nearest.y
                )

                elon = float(
                    nearest.x
                )


                expected_km = (
                    geodesic_distance_km(

                        lat,
                        lon,

                        elat,
                        elon
                    )
                )


            except Exception:

                expected_km = np.nan

                elat = np.nan
                elon = np.nan


        expected_distance.append(
            expected_km
        )

        nearest_expected_lat.append(
            elat
        )

        nearest_expected_lon.append(
            elon
        )


        # =========================================================
        # SAME / CLOSE / DIFFERENT / UNRESOLVED
        # =========================================================

        if not routed_id:

            comparison = (
                "UNRESOLVED_ROUTED_BOUNDARY"
            )


        elif not expected_id:

            comparison = (
                "UNRESOLVED_EXPECTED_PSAP"
            )


        elif "|" in expected_id:

            comparison = (
                "AMBIGUOUS_EXPECTED_PSAP"
            )


        elif (
            canonical_nena_id(
                expected_id
            )
            ==
            routed_id
        ):

            comparison = (
                "SAME"
            )


        elif (
            np.isfinite(
                route_km
            )
            and
            route_km
            <= CLOSE_BOUNDARY_KM
        ):

            comparison = (
                "CLOSE"
            )


        else:

            comparison = (
                "DIFFERENT"
            )


        expected_vs_routed.append(
            comparison
        )


    frame[
        f"{prefix}_TO_ROUTED_BOUNDARY_KM"
    ] = routed_distance


    frame[
        f"{prefix}_SIGNED_TO_ROUTED_BOUNDARY_KM"
    ] = routed_signed_distance


    frame[
        f"{prefix}_RELATION_TO_ROUTED_PSAP"
    ] = routed_relation


    frame[
        f"{prefix}_TO_EXPECTED_BOUNDARY_KM"
    ] = expected_distance


    frame[
        f"{prefix}_NEAREST_ROUTED_BOUNDARY_LAT"
    ] = nearest_routed_lat


    frame[
        f"{prefix}_NEAREST_ROUTED_BOUNDARY_LON"
    ] = nearest_routed_lon


    frame[
        f"{prefix}_NEAREST_EXPECTED_BOUNDARY_LAT"
    ] = nearest_expected_lat


    frame[
        f"{prefix}_NEAREST_EXPECTED_BOUNDARY_LON"
    ] = nearest_expected_lon


    frame[
        f"{prefix}_EXPECTED_VS_ROUTED"
    ] = expected_vs_routed


    return frame


