GEOD = Geod(
    ellps="WGS84"
)


def norm_id(value):
    """
    Generic identifier normalization.
    Keeps leading zeros.
    """

    if value is None or pd.isna(value):
        return ""

    text = (
        str(value)
        .strip()
        .strip('"')
    )

    if text.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:
        return ""

    return re.sub(
        r"\.0$",
        "",
        text
    )


def canonical_nena_id(value):
    """
    Canonical PSAP/NENA identity.

    Numeric IDs are normalized numerically so leading-zero differences
    do not prevent exact identity matching.

    Examples:
        040500006 -> 40500006
        020200005 -> 20200005
        20200005  -> 20200005
    """

    text = norm_id(
        value
    )

    if not text:
        return ""

    if re.fullmatch(
        r"\d+",
        text
    ):

        try:

            return str(
                int(text)
            )

        except Exception:

            pass

    return text.upper()


def clean_text(value):

    if value is None or pd.isna(value):
        return ""

    return str(value).strip()


def numeric(value):

    value = pd.to_numeric(
        value,
        errors="coerce"
    )

    try:

        value = float(value)

    except Exception:

        return np.nan


    if not math.isfinite(
        value
    ):

        return np.nan


    return value


def valid_coordinate(
    lat,
    lon
):

    lat = numeric(
        lat
    )

    lon = numeric(
        lon
    )


    if (
        not np.isfinite(lat)
        or
        not np.isfinite(lon)
    ):

        return False


    if not (
        -90 <= lat <= 90
        and
        -180 <= lon <= 180
    ):

        return False


    # common missing placeholder
    if (
        abs(lat) < 1e-10
        and
        abs(lon) < 1e-10
    ):

        return False


    return True


def repair_geometry(
    geometry
):

    if (
        geometry is None
        or
        geometry.is_empty
    ):

        return None


    try:

        if not geometry.is_valid:

            geometry = (
                geometry.buffer(0)
            )


        if (
            geometry is None
            or
            geometry.is_empty
            or
            not geometry.is_valid
        ):

            return None


        return geometry


    except Exception:

        return None


def geodesic_distance_km(
    lat1,
    lon1,
    lat2,
    lon2
):

    if not (
        valid_coordinate(
            lat1,
            lon1
        )
        and
        valid_coordinate(
            lat2,
            lon2
        )
    ):

        return np.nan


    _, _, distance_m = GEOD.inv(

        float(lon1),
        float(lat1),

        float(lon2),
        float(lat2)
    )


    return (
        abs(
            float(distance_m)
        )
        / 1000.0
    )


