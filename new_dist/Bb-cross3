# =====================================================================
# INDEPENDENT GEOPANDAS PSAP COORDINATE CROSSCHECK v2.0
# CORRECTED NENA-IDENTITY VERSION
# =====================================================================
#
# DOES NOT USE:
#   psap_three_location_coordinate_crosscheck_v5.csv
#
# INPUTS
# ------
# 1. psap_routing_definite_misroutes_filtered_by_routed_distance.csv
# 2. e911_lte_master_gmlc.csv
# 3. psap\Final_Join.tab
#
#
# CORRECT GEOGRAPHIC IDENTITY
# ---------------------------
#
# ROUTED PSAP:
#
#   GMLC.PSAP_ID
#        ↓ canonical numeric ID
#   Final_Join.NENA_ID
#        ↓
#   routed PSAP polygon
#
#
# EXPECTED PSAP:
#
#   CALLER / CELL / ESPOSREQ coordinate
#        ↓
#   GeoPandas sjoin()
#        ↓
#   Final_Join.NENA_ID
#
#
# Therefore:
#
#   ROUTED NENA_ID  <->  EXPECTED NENA_ID
#
#
# IMPORTANT
# ---------
# FCC_PSAP_ID / FCC_ID are retained only as metadata.
#
# They are NOT used as the PSAP boundary identity because one FCC ID
# may correspond to multiple distinct NENA PSAP identities.
#
#
# UNRESOLVED ROUTED PSAP
# ----------------------
# If GMLC.PSAP_ID cannot be exactly resolved to Final_Join.NENA_ID:
#
#   ROUTED_BOUNDARY_STATUS = UNRESOLVED_ROUTED_BOUNDARY
#
# and routed-boundary distances remain NaN.
#
# No unsafe FCC fallback is performed.
#
#
# PIPELINE
# --------
#
# filtered cohort
#       ↓
# exact original GMLC row
#       ↓
# canonical GMLC PSAP_ID
#       ↓
# exact canonical Final_Join.NENA_ID
#       ↓
# routed NENA polygon
#
# CALLER / CELL / ESPOSREQ
#       ↓
# GeoPandas sjoin()
#       ↓
# expected NENA PSAP
#
# routed + expected polygons
#       ↓
# Shapely nearest_points()
#       ↓
# PyProj.Geod
#       ↓
# boundary distance
#
# Pandas groupby()
#       ↓
# MIN / MEAN / MAX by routed NENA PSAP
#
#
# OUTPUTS
# -------
# psap_geopandas_nena_crosscheck_v2.csv
# psap_geopandas_nena_routed_summary_v2.csv
# psap_geopandas_nena_pattern_summary_v2.csv
#
# =====================================================================


