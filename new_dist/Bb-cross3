def coordinate_pattern(
    row
):

    # Routed identity missing affects all coordinate comparisons.
    if (
        row[
            "ROUTED_BOUNDARY_STATUS"
        ]
        ==
        "UNRESOLVED_ROUTED_BOUNDARY"
    ):

        return (
            "UNRESOLVED_ROUTED_BOUNDARY"
        )


    caller = row[
        "CALLER_EXPECTED_VS_ROUTED"
    ]

    cell = row[
        "CELL_EXPECTED_VS_ROUTED"
    ]

    espos = row[
        "ESPOSREQ_EXPECTED_VS_ROUTED"
    ]


    if (
        caller == "SAME"
        and
        cell == "SAME"
        and
        espos == "SAME"
    ):

        return (
            "ALL_3_SUPPORT_ROUTED_PSAP"
        )


    if (
        caller == "DIFFERENT"
        and
        cell == "SAME"
        and
        espos == "SAME"
    ):

        return (
            "CALLER_DIFFERS_CELL_ESPOSREQ_SUPPORT_ROUTED"
        )


    if (
        caller == "SAME"
        and
        cell == "DIFFERENT"
        and
        espos == "SAME"
    ):

        return (
            "CELL_DIFFERS_CALLER_ESPOSREQ_SUPPORT_ROUTED"
        )


    if (
        caller == "SAME"
        and
        cell == "SAME"
        and
        espos == "DIFFERENT"
    ):

        return (
            "ESPOSREQ_DIFFERS_CALLER_CELL_SUPPORT_ROUTED"
        )


    if (
        caller == "DIFFERENT"
        and
        cell == "DIFFERENT"
        and
        espos == "DIFFERENT"
    ):

        return (
            "NONE_SUPPORT_ROUTED_PSAP"
        )


    if "CLOSE" in {
        caller,
        cell,
        espos
    }:

        return (
            "NEAR_BOUNDARY_OR_MIXED"
        )


    if any(
        x in {
            "INVALID_COORDINATE",
            "UNRESOLVED_EXPECTED_PSAP",
            "AMBIGUOUS_EXPECTED_PSAP"
        }

        for x in [
            caller,
            cell,
            espos
        ]
    ):

        return (
            "INVALID_OR_UNRESOLVED_COORDINATE"
        )


    return (
        "MIXED_COORDINATE_EVIDENCE"
    )


report[
