def assign_expected_nena(
    frame,
    prefix,
    lat_col,
    lon_col
):

    id_col = (
        f"{prefix}_EXPECTED_NENA_ID"
    )

    raw_id_col = (
        f"{prefix}_EXPECTED_NENA_ID_RAW"
    )

    name_col = (
        f"{prefix}_EXPECTED_PSAP_NAME"
    )

    fcc_col = (
        f"{prefix}_EXPECTED_FCC_ID"
    )

    status_col = (
        f"{prefix}_EXPECTED_GEOMETRY_STATUS"
    )


    frame[
        id_col
    ] = ""

    frame[
        raw_id_col
    ] = ""

    frame[
        name_col
    ] = ""

    frame[
        fcc_col
    ] = ""

    frame[
        status_col
    ] = (
        "INVALID_OR_MISSING_COORDINATE"
    )


    valid_mask = [

        valid_coordinate(
            lat,
            lon
        )

        for lat, lon
        in zip(
            frame[
                lat_col
            ],
            frame[
                lon_col
            ]
        )
    ]


    point_source = (
        frame.loc[
            valid_mask,
            [
                "_REPORT_ROW_ID",
                lat_col,
                lon_col
            ]
        ]
        .copy()
    )


    if point_source.empty:

        return frame


    points = gpd.GeoDataFrame(

        point_source,

        geometry=gpd.points_from_xy(

            point_source[
                lon_col
            ],

            point_source[
                lat_col
            ]
        ),

        crs="EPSG:4326"
    )


    joined = gpd.sjoin(

        points,

        psap[
            [
                "NENA_ID_CANON",
                "NENA_ID_RAW",

                "BOUNDARY_FCC_ID",
                "BOUNDARY_PSAP_NAME",

                "geometry"
            ]
        ],

        how="left",

        predicate="intersects"
    )


    result_lookup = {}


    for row_id, group in joined.groupby(
        "_REPORT_ROW_ID",
        sort=False
    ):

        ids = sorted(
            {
                canonical_nena_id(x)

                for x
                in group[
                    "NENA_ID_CANON"
                ]

                if canonical_nena_id(x)
            }
        )


        if len(ids) == 1:

            nena = ids[0]


            result_lookup[
                int(row_id)
            ] = {

                "ID":
                    nena,

                "RAW_ID":
                    raw_nena_by_canon.get(
                        nena,
                        ""
                    ),

                "NAME":
                    name_by_nena.get(
                        nena,
                        ""
                    ),

                "FCC":
                    fcc_by_nena.get(
                        nena,
                        ""
                    ),

                "STATUS":
                    "UNIQUE_NENA_PSAP",
            }


        elif len(ids) == 0:

            result_lookup[
                int(row_id)
            ] = {

                "ID":
                    "",

                "RAW_ID":
                    "",

                "NAME":
                    "",

                "FCC":
                    "",

                "STATUS":
                    "NO_CONTAINING_PSAP",
            }


        else:

            result_lookup[
                int(row_id)
            ] = {

                "ID":
                    "|".join(
                        ids
                    ),

                "RAW_ID":
                    "",

                "NAME":
                    "",

                "FCC":
                    "",

                "STATUS":
                    "MULTIPLE_CONTAINING_PSAP",
            }


    for idx in frame.index:

        row_id = int(
            frame.at[
                idx,
                "_REPORT_ROW_ID"
            ]
        )


        resolved = (
            result_lookup.get(
                row_id
            )
        )


        if resolved is None:

            continue


        frame.at[
            idx,
            id_col
        ] = resolved[
            "ID"
        ]


        frame.at[
            idx,
            raw_id_col
        ] = resolved[
            "RAW_ID"
        ]


        frame.at[
            idx,
            name_col
        ] = resolved[
            "NAME"
        ]


        frame.at[
            idx,
            fcc_col
        ] = resolved[
            "FCC"
        ]


        frame.at[
            idx,
            status_col
        ] = resolved[
            "STATUS"
        ]


    print(
        f"\n{prefix} GeoPandas sjoin:"
    )


    print(
        frame[
            status_col
        ]
        .value_counts(
            dropna=False
        )
    )


    return frame


