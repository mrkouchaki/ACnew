    required=True
)


# ---------------------------------------------------------------------
# Useful GMLC columns only.
# ---------------------------------------------------------------------

wanted_columns = [

    "UNIQ911_CID",

    "CALL_BEGIN_TIME_UTC",

    "CALL_DURATION_SEC",

    "MARKET",
    "STATE",
    "COUNTY",

    "PSAP_ID",

    "FCC_PSAP_ID",

    "ROUTE_PSAP_NAME",

    "PSAP_NAME",

    "PSAP_NAME_ESRK",

    "LATITUDE",
    "LONGITUDE",

    "CELL_LATITUDE",
    "CELL_LONGITUDE",
]


header_lookup = {

    str(column)
    .strip()
    .upper():
        column

    for column
    in gmlc_header
}


usecols = [

    header_lookup[
        column
    ]

    for column
    in wanted_columns

    if column in header_lookup
]


# =====================================================================
# 17. PREPARE OUTPUT
# =====================================================================

if OUTPUT_CSV.exists():

    try:

        OUTPUT_CSV.unlink()

    except PermissionError:

        raise PermissionError(
            f"\nClose this file in Excel first:\n{OUTPUT_CSV}"
        )


header_written = False


processed_rows = 0

saved_rows = 0


status_counter = Counter()


# =====================================================================
# 18. PROCESS WHOLE GMLC
# =====================================================================

for chunk_number, chunk in enumerate(

    pd.read_csv(

        GMLC_PATH,

        dtype="string",

        usecols=usecols,

        chunksize=CSV_CHUNK_ROWS,

        low_memory=False,

        encoding_errors="replace"
    ),

    start=1
):

    chunk.columns = [

        str(column)
        .strip()
        .upper()

        for column
        in chunk.columns
    ]


    chunk = chunk.reset_index(
        drop=True
    )


    # -------------------------------------------------------------
    # Source row
    # -------------------------------------------------------------

    chunk[
        "SOURCE_GMLC_ROW_ID"
    ] = np.arange(

        processed_rows + 1,

        processed_rows
        + len(chunk)
        + 1,

        dtype=np.int64
    )


    processed_rows += len(
        chunk
    )


    # =============================================================
    # GMLC IDs
    # =============================================================

    chunk[
        "GMLC_PSAP_ID"
    ] = (
        chunk[
            "PSAP_ID"
        ]
        .map(
            canonical_id
        )
    )


    chunk[
        "GMLC_FCC_PSAP_ID"
    ] = (
        chunk[
            "FCC_PSAP_ID"
        ]
        .map(
            canonical_id
        )
    )


    # =============================================================
    # GMLC routed name
    # =============================================================

    chunk[
        "GMLC_ROUTED_NAME"
    ] = ""


    if "ROUTE_PSAP_NAME" in chunk.columns:

        chunk[
            "GMLC_ROUTED_NAME"
        ] = (
            chunk[
                "ROUTE_PSAP_NAME"
            ]
            .fillna("")
            .astype(str)
            .str.strip()
        )


    if "PSAP_NAME" in chunk.columns:

        missing = (
            chunk[
                "GMLC_ROUTED_NAME"
            ].eq("")
        )


        chunk.loc[
            missing,
            "GMLC_ROUTED_NAME"
        ] = (

            chunk.loc[
                missing,
                "PSAP_NAME"
            ]

            .fillna("")
            .astype(str)
            .str.strip()
        )


    # =============================================================
    # Resolve routed polygon BY IDs ONLY
    # =============================================================

    route_results = [

        resolve_routed_psap(
            psap_id,
            fcc_id
        )

        for psap_id, fcc_id
        in zip(

            chunk[
                "GMLC_PSAP_ID"
            ],

            chunk[
                "GMLC_FCC_PSAP_ID"
            ]
        )
    ]


    route_df = pd.DataFrame(
        route_results,
        index=chunk.index
    )


    chunk = pd.concat(
        [
            chunk,
            route_df
        ],
        axis=1
    )


    # =============================================================
    # Routed GMLC name vs resolved boundary names
    #
    # QA ONLY.
    # =============================================================

    routed_gmlc_vs_boundary = []

    routed_name_match_source = []


    for _, row in chunk.iterrows():

        gmlc_names = (
            gmlc_name_dictionary(
                row
            )
        )


        routed_psap = canonical_id(
            row[
                "ROUTED_PSAP_ID_DERIVED"
            ]
        )


        metadata = meta_by_nena.get(
            routed_psap,
            {}
        )


        boundary_names = (
            boundary_name_dictionary(
                metadata
            )
        )


        status, source = compare_name_sets(

            boundary_names,

            gmlc_names
        )


        routed_gmlc_vs_boundary.append(
            status
        )


        routed_name_match_source.append(
            source
        )


    chunk[
        "ROUTED_GMLC_VS_BOUNDARY_NAME"
    ] = (
        routed_gmlc_vs_boundary
    )


    chunk[
        "ROUTED_NAME_MATCH_SOURCE"
    ] = (
        routed_name_match_source
    )


    # =============================================================
    # Coordinates
    # =============================================================

    chunk[
        "CALLER_LATITUDE"
    ] = pd.to_numeric(

        chunk[
            "LATITUDE"
        ],

        errors="coerce"
    )


    chunk[
        "CALLER_LONGITUDE"
    ] = pd.to_numeric(

        chunk[
            "LONGITUDE"
        ],

        errors="coerce"
    )


    chunk[
        "CELL_LATITUDE_USED"
    ] = pd.to_numeric(

        chunk[
            "CELL_LATITUDE"
        ],

        errors="coerce"
    )


    chunk[
        "CELL_LONGITUDE_USED"
    ] = pd.to_numeric(

        chunk[
            "CELL_LONGITUDE"
        ],

        errors="coerce"
    )


    # =============================================================
    # Caller -> routed
    # =============================================================

    chunk = add_boundary_distance(

        chunk,

        "CALLER_LATITUDE",

        "CALLER_LONGITUDE",

        "ROUTED_PSAP_ID_DERIVED",

        "CALLER_TO_ROUTED_BOUNDARY_M",

        "CALLER_ROUTED_RELATION"
    )


    # =============================================================
    # Cell -> routed
    # =============================================================

    chunk = add_boundary_distance(

        chunk,

        "CELL_LATITUDE_USED",

        "CELL_LONGITUDE_USED",

        "ROUTED_PSAP_ID_DERIVED",

        "CELL_TO_ROUTED_BOUNDARY_M",

        "CELL_ROUTED_RELATION"
    )


    # =============================================================
    # Caller <-> Cell
    # =============================================================

    chunk = add_caller_cell_distance(
        chunk
    )


    # =============================================================
    # EARLY FILTER
    # =============================================================

    keep = apply_distance_filter(
        chunk
    )


    candidate = (

        chunk.loc[
            keep
        ]

        .copy()

        .reset_index(
            drop=True
        )
    )


    if candidate.empty:

        print(
            f"Chunk {chunk_number:03d} | "
            f"processed {processed_rows:,} | "
            f"saved {saved_rows:,}"
        )

        continue


    # =============================================================
    # CALLER EXPECTED PSAP
    # =============================================================

    candidate = assign_expected_psap(

        candidate,

        "CALLER",

        "CALLER_LATITUDE",

        "CALLER_LONGITUDE"
    )


    # =============================================================
    # CELL EXPECTED PSAP
    # =============================================================

    candidate = assign_expected_psap(

        candidate,

        "CELL",

        "CELL_LATITUDE_USED",

        "CELL_LONGITUDE_USED"
    )


    # =============================================================
    # Caller -> expected boundary
    # =============================================================

    candidate = add_boundary_distance(

        candidate,

        "CALLER_LATITUDE",

        "CALLER_LONGITUDE",

        "CALLER_EXPECTED_PSAP_ID",

        "CALLER_TO_EXPECTED_BOUNDARY_M",

        "CALLER_EXPECTED_RELATION"
    )


    # =============================================================
    # Cell -> expected boundary
    # =============================================================

    candidate = add_boundary_distance(

        candidate,

        "CELL_LATITUDE_USED",

        "CELL_LONGITUDE_USED",

        "CELL_EXPECTED_PSAP_ID",

        "CELL_TO_EXPECTED_BOUNDARY_M",

        "CELL_EXPECTED_RELATION"
    )


    # =============================================================
    # Caller expected vs routed
    # =============================================================

    candidate = add_expected_comparison(

        candidate,

        "CALLER"
    )


    # =============================================================
    # Cell expected vs routed
    # =============================================================

    candidate = add_expected_comparison(

        candidate,

        "CELL"
    )


    # =============================================================
    # Optional final expected-ID filter
    # =============================================================

    if ONLY_CALLER_EXPECTED_DIFFERENT:

        candidate = candidate.loc[
            candidate[
                "CALLER_EXPECTED_VS_ROUTED_ID"
            ]
            .eq(
                "DIFFERENT"
            )
        ].copy()


    if candidate.empty:

        continue


    # =================================================================
    # CLEAN REPORT
    # =================================================================

    clean_columns = [

        # ---------------------------------------------------------
        # CALL
        # ---------------------------------------------------------

        "SOURCE_GMLC_ROW_ID",

        "UNIQ911_CID",

        "CALL_BEGIN_TIME_UTC",

        "CALL_DURATION_SEC",

        "MARKET",
        "STATE",
        "COUNTY",


        # ---------------------------------------------------------
        # ROUTED
        # ---------------------------------------------------------

        "GMLC_PSAP_ID",

        "GMLC_FCC_PSAP_ID",

        "GMLC_ROUTED_NAME",

        "ROUTED_NENA_ID_RAW",

        "ROUTED_PSAP_ID_DERIVED",

        "ROUTED_FCC_ID",

        "ROUTED_BOUNDARY_NAME",

        "ROUTED_BOUNDARY_NAME_SOURCE",

        "ROUTED_BOUNDARY_NAME_SOURCES",

        "ROUTED_BOUNDARY_NAME_SOURCE_CHECK",

        "ROUTED_ID_STATUS",

        "ROUTED_ID_CONFIDENCE",

        "ROUTED_GMLC_VS_BOUNDARY_NAME",

        "ROUTED_NAME_MATCH_SOURCE",


        # ---------------------------------------------------------
        # CALLER
        # ---------------------------------------------------------

        "CALLER_LATITUDE",

        "CALLER_LONGITUDE",

        "CALLER_ROUTED_RELATION",

        "CALLER_TO_ROUTED_BOUNDARY_M",


        # Caller expected
        "CALLER_EXPECTED_NENA_ID_RAW",

        "CALLER_EXPECTED_PSAP_ID",

        "CALLER_EXPECTED_FCC_ID",

        "CALLER_EXPECTED_NAME",

        "CALLER_EXPECTED_NAME_SOURCE",

        "CALLER_EXPECTED_NAME_SOURCES",

        "CALLER_EXPECTED_NAME_SOURCE_CHECK",

        "CALLER_EXPECTED_SPATIAL_STATUS",

        "CALLER_TO_EXPECTED_BOUNDARY_M",

        "CALLER_EXPECTED_RELATION",

        "CALLER_EXPECTED_VS_ROUTED_ID",

        "CALLER_EXPECTED_VS_ROUTED_BOUNDARY_NAME",

        "CALLER_EXPECTED_VS_GMLC_ROUTED_NAME",

        "CALLER_EXPECTED_VS_ROUTED_NAME",

        "CALLER_NAME_MATCH_SOURCE",

        "CALLER_EXPECTED_VS_ROUTED_STATUS",


        # ---------------------------------------------------------
        # CELL
        # ---------------------------------------------------------

        "CELL_LATITUDE_USED",

        "CELL_LONGITUDE_USED",

        "CELL_ROUTED_RELATION",

        "CELL_TO_ROUTED_BOUNDARY_M",


        # Cell expected
        "CELL_EXPECTED_NENA_ID_RAW",

        "CELL_EXPECTED_PSAP_ID",

        "CELL_EXPECTED_FCC_ID",

        "CELL_EXPECTED_NAME",

        "CELL_EXPECTED_NAME_SOURCE",

        "CELL_EXPECTED_NAME_SOURCES",

        "CELL_EXPECTED_NAME_SOURCE_CHECK",

        "CELL_EXPECTED_SPATIAL_STATUS",

        "CELL_TO_EXPECTED_BOUNDARY_M",

        "CELL_EXPECTED_RELATION",

        "CELL_EXPECTED_VS_ROUTED_ID",

        "CELL_EXPECTED_VS_ROUTED_BOUNDARY_NAME",

        "CELL_EXPECTED_VS_GMLC_ROUTED_NAME",

        "CELL_EXPECTED_VS_ROUTED_NAME",

        "CELL_NAME_MATCH_SOURCE",

        "CELL_EXPECTED_VS_ROUTED_STATUS",


        # ---------------------------------------------------------
        # CALLER <-> CELL
        # ---------------------------------------------------------

        "CALLER_TO_CELL_M",
    ]


    clean_columns = [

        column

        for column
        in clean_columns

        if column
        in candidate.columns
    ]


    output = (
        candidate[
            clean_columns
        ]
        .copy()
    )


    # =============================================================
    # Numeric dtypes
    # =============================================================

    for column in output.columns:

        if (
            column.endswith(
                "_M"
            )
            or
            column.endswith(
                "_LATITUDE"
            )
            or
            column.endswith(
                "_LONGITUDE"
            )
        ):

            output[
                column
            ] = pd.to_numeric(
                output[
                    column
                ],
                errors="coerce"
            )


    # =============================================================
    # Summary count
    # =============================================================

    status_counter.update(

        output[
            "CALLER_EXPECTED_VS_ROUTED_STATUS"
        ]

        .value_counts(
            dropna=False
        )

        .to_dict()
    )


    # =============================================================
    # SAVE
    # =============================================================

    output.to_csv(

        OUTPUT_CSV,

        mode=(
            "a"
            if header_written
            else "w"
        ),

        header=(
            not header_written
        ),

        index=False,

        float_format="%.3f"
    )


    header_written = True


    saved_rows += len(
        output
    )


    print(
        f"Chunk {chunk_number:03d} | "
        f"processed {processed_rows:,} | "
        f"saved {saved_rows:,}"
    )


# =====================================================================
# 19. SMALL SUMMARY
# =====================================================================

summary = pd.DataFrame(

    [

        {

            "CALLER_EXPECTED_VS_ROUTED_STATUS":
                status,

            "CALLS":
                count
        }

        for status, count
        in status_counter.items()
    ]
)


if not summary.empty:

    summary[
        "PCT"
    ] = (

        100.0

        * summary[
            "CALLS"
        ]

        / max(
            saved_rows,
            1
        )
    )


    summary = summary.sort_values(
        "CALLS",
        ascending=False
    )


summary.to_csv(
    SUMMARY_CSV,
    index=False
)


