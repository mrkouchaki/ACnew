# GMLC.PSAP_ID -> Boundary.NENA_ID
# GMLC.FCC_PSAP_ID -> Boundary.FCC_ID
#
# NO NAME MATCHING.
# =====================================================================

route_cache = {}


def resolve_routed_psap(
    gmlc_psap_id,
    gmlc_fcc_psap_id
):

    psap_id = canonical_id(
        gmlc_psap_id
    )


    fcc_id = canonical_id(
        gmlc_fcc_psap_id
    )


    cache_key = (
        psap_id,
        fcc_id
    )


    if cache_key in route_cache:

        return route_cache[
            cache_key
        ]


    chosen_nena = ""

    status = (
        "UNRESOLVED"
    )

    confidence = (
        "UNRESOLVED"
    )


    # -------------------------------------------------------------
    # PRIMARY:
    #
    # PSAP_ID canonical must exist as Boundary NENA_ID canonical.
    # -------------------------------------------------------------

    psap_nena_match = (

        psap_id

        if (
            psap_id
            and
            psap_id
            in boundary_by_nena
        )

        else ""
    )


    fcc_candidates = set(

        fcc_to_nena.get(
            fcc_id,
            set()
        )
    )


    # =============================================================
    # PSAP_ID -> NENA works
    # =============================================================

    if psap_nena_match:

        # ---------------------------------------------------------
        # FCC supplied and confirms same polygon
        # ---------------------------------------------------------

        if (
            fcc_id
            and
            psap_nena_match
            in fcc_candidates
        ):

            chosen_nena = (
                psap_nena_match
            )

            status = (
                "PSAP_NENA_AND_FCC_CONFIRMED"
            )

            confidence = (
                "HIGH"
            )


        # ---------------------------------------------------------
        # FCC value provided but does not exist in boundary
        #
        # Keep exact PSAP->NENA match but flag FCC missing.
        # ---------------------------------------------------------

        elif (
            fcc_id
            and
            not fcc_candidates
        ):

            chosen_nena = (
                psap_nena_match
            )

            status = (
                "PSAP_NENA_MATCH_FCC_NOT_FOUND"
            )

            confidence = (
                "MEDIUM"
            )


        # ---------------------------------------------------------
        # No GMLC FCC ID
        # ---------------------------------------------------------

        elif not fcc_id:

            chosen_nena = (
                psap_nena_match
            )

            status = (
                "PSAP_NENA_MATCH_NO_FCC"
            )

            confidence = (
                "MEDIUM"
            )


        # ---------------------------------------------------------
        # FCC points somewhere ELSE.
        #
        # Do not choose the polygon.
        # ---------------------------------------------------------

        else:

            chosen_nena = ""

            status = (
                "PSAP_NENA_VS_FCC_CONFLICT"
            )

            confidence = (
                "UNRESOLVED"
            )


    # =============================================================
    # PSAP_ID does NOT resolve to NENA
    # =============================================================

    else:

        if (
            ALLOW_FCC_ONLY_FALLBACK
            and
            len(
                fcc_candidates
            ) == 1
        ):

            chosen_nena = next(
                iter(
                    fcc_candidates
                )
            )

            status = (
                "FCC_UNIQUE_FALLBACK"
            )

            confidence = (
                "LOWER"
            )


        elif len(
            fcc_candidates
        ) > 1:

            status = (
                "PSAP_NENA_NOT_FOUND_FCC_AMBIGUOUS"
            )


        elif len(
            fcc_candidates
        ) == 1:

            status = (
                "PSAP_NENA_NOT_FOUND_FCC_AVAILABLE_NOT_USED"
            )


        else:

            status = (
                "PSAP_NENA_NOT_FOUND"
            )


    metadata = (

        meta_by_nena.get(
            chosen_nena,
            {}
        )

        if chosen_nena

        else {}
    )


    routed_name, routed_name_source = (
        primary_boundary_name(
            metadata
        )
    )


    name_check = name_source_agreement(
        {

            "BOUNDARY.AGENCY":
                metadata.get(
                    "AGENCY",
                    ""
                ),

            "BOUNDARY.PSAP_NAME":
                metadata.get(
                    "PSAP_NAME",
                    ""
                ),

