route_cache = {}


def resolve_routed_psap(
    gmlc_psap_id,
    gmlc_fcc_id
):

    psap = canonical_id(
        gmlc_psap_id
    )


    fcc = canonical_id(
        gmlc_fcc_id
    )


    key = (
        psap,
        fcc
    )


    if key in route_cache:

        return route_cache[
            key
        ]


    # -------------------------------------------------------------
    # Signal 1:
    # GMLC PSAP_ID == canonical Boundary NENA_ID
    # -------------------------------------------------------------

    nena_direct = (

        {
            psap
        }

        if (
            psap
            and
            psap
            in nena_ids
        )

        else set()
    )


    # -------------------------------------------------------------
    # Signal 2:
    # GMLC PSAP_ID == Boundary.PSAP_ID
    # -------------------------------------------------------------

    psap_candidates = set(

        psap_to_nena.get(
            psap,
            set()
        )
    )


    # -------------------------------------------------------------
    # Signal 3:
    # GMLC FCC_PSAP_ID == Boundary FCC ID
    # -------------------------------------------------------------

    fcc_candidates = set(

        fcc_to_nena.get(
            fcc,
            set()
        )
    )


    # Combine the two PSAP-derived identity signals.
    psap_identity_candidates = (

        nena_direct

        |

        psap_candidates
    )


    chosen = ""

    status = "UNRESOLVED"

    confidence = "UNRESOLVED"


    # =============================================================
    # Strongest:
    # PSAP-derived identity + FCC all point to same NENA.
    # =============================================================

    if (
        psap_identity_candidates
        and
        fcc_candidates
    ):

        both = (

            psap_identity_candidates

            &

            fcc_candidates
        )


        if len(
            both
        ) == 1:

            chosen = next(
                iter(
                    both
                )
            )

            status = (
                "PSAP_AND_FCC_CONFIRMED"
            )

            confidence = (
                "HIGH"
            )


        elif len(
            both
        ) > 1:

            status = (
                "MULTIPLE_ID_MATCHES"
            )


        else:

            status = (
                "PSAP_FCC_CONFLICT"
            )


    # =============================================================
    # No FCC match available, but both PSAP representations agree.
    # =============================================================

    elif len(
        psap_identity_candidates
    ) == 1:

        chosen = next(
            iter(
                psap_identity_candidates
            )
        )

        status = (
            "PSAP_ID_ONLY_UNIQUE"
        )

        confidence = (
            "MEDIUM"
        )


    # =============================================================
    # FCC fallback only when it maps to one NENA.
    # =============================================================

    elif len(
        fcc_candidates
    ) == 1:

        chosen = next(
            iter(
                fcc_candidates
            )
        )

        status = (
            "FCC_ONLY_UNIQUE"
        )

        confidence = (
            "LOWER"
        )


    metadata = (

        meta_by_nena.get(
            chosen,
            {}
        )

        if chosen

        else {}
    )


    selected_name, selected_source = (
        choose_boundary_name(

            metadata.get(
                "_NAME_PSAP",
                ""
            ),

            metadata.get(
                "_NAME_ESRK",
                ""
            ),

            metadata.get(
                "_NAME_AGENCY",
                ""
            )
        )
    )


    result = {

        "ROUTED_NENA_ID":
            chosen,

        "ROUTED_BOUNDARY_PSAP_ID":
            metadata.get(
                "_PSAP",
                ""
            ),

        "ROUTED_BOUNDARY_FCC_PSAP_ID":
            metadata.get(
                "_FCC",
                ""
            ),

        "ROUTED_BOUNDARY_NAME":
            selected_name,

        "ROUTED_BOUNDARY_NAME_SOURCE":
            selected_source,

        "ROUTED_BOUNDARY_NAME_PSAP_NAME":
            metadata.get(
                "_NAME_PSAP",
                ""
            ),

        "ROUTED_BOUNDARY_NAME_PSAP_NAME_ESRK":
            metadata.get(
                "_NAME_ESRK",
                ""
            ),

        "ROUTED_BOUNDARY_NAME_AGENCY":
            metadata.get(
                "_NAME_AGENCY",
                ""
            ),

        "ROUTED_BOUNDARY_NAME_SOURCE_CHECK":
            boundary_name_agreement(

                metadata.get(
                    "_NAME_PSAP",
                    ""
                ),

                metadata.get(
                    "_NAME_ESRK",
                    ""
                ),

                metadata.get(
                    "_NAME_AGENCY",
                    ""
                )
            ),

        "ROUTED_ID_STATUS":
            status,

        "ROUTED_ID_CONFIDENCE":
            confidence,
    }


    route_cache[
        key
    ] = result


    return result


