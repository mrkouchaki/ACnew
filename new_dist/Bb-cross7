def add_expected_comparison(
    frame,
    prefix
):

    # -------------------------------------------------------------
    # ID comparison
    # -------------------------------------------------------------

    routed = (
        frame[
            "ROUTED_PSAP_ID_DERIVED"
        ]
        .fillna("")
        .astype(str)
        .map(
            canonical_id
        )
    )


    expected = (
        frame[
            f"{prefix}_EXPECTED_PSAP_ID"
        ]
        .fillna("")
        .astype(str)
    )


    expected_canon = expected.map(
        lambda x:

            canonical_id(
                x
            )

            if "|" not in x

            else ""
    )


    frame[
        f"{prefix}_EXPECTED_VS_ROUTED_ID"
    ] = np.where(

        (
            routed.ne("")
            &
            expected_canon.ne("")
        ),

        np.where(

            routed
            ==
            expected_canon,

            "SAME",

            "DIFFERENT"
        ),

        "UNRESOLVED"
    )


    # -------------------------------------------------------------
    # Expected boundary metadata
    # -------------------------------------------------------------

    expected_boundary_names = []


    for expected_id in expected:

        expected_id = clean_text(
            expected_id
        )


        if (
            not expected_id
            or
            "|" in expected_id
        ):

            expected_boundary_names.append(
                {}
            )

            continue


        metadata = meta_by_nena.get(
            canonical_id(
                expected_id
            ),
            {}
        )


        expected_boundary_names.append(

            boundary_name_dictionary(
                metadata
            )
        )


    # -------------------------------------------------------------
    # Routed boundary names and GMLC routed names
    # -------------------------------------------------------------

    expected_vs_boundary = []

    expected_vs_gmlc = []

    match_sources = []


    for row_position, (
        _,
        row
    ) in enumerate(
        frame.iterrows()
    ):

        expected_names = (
            expected_boundary_names[
                row_position
            ]
        )


        routed_id = canonical_id(
            row[
                "ROUTED_PSAP_ID_DERIVED"
            ]
        )


        routed_metadata = (
            meta_by_nena.get(
                routed_id,
                {}
            )
        )


        routed_boundary_names = (
            boundary_name_dictionary(
                routed_metadata
            )
        )


        gmlc_names = (
            gmlc_name_dictionary(
                row
            )
        )


        (
            boundary_status,
            boundary_match_source
        ) = compare_name_sets(

            expected_names,

            routed_boundary_names
        )


        (
            gmlc_status,
            gmlc_match_source
        ) = compare_name_sets(

            expected_names,

            gmlc_names
        )


        expected_vs_boundary.append(
            boundary_status
        )


        expected_vs_gmlc.append(
            gmlc_status
        )


        if gmlc_match_source:

            match_sources.append(
                gmlc_match_source
            )

        elif boundary_match_source:

            match_sources.append(
                boundary_match_source
            )

        else:

            match_sources.append(
                ""
            )


    frame[
        f"{prefix}_EXPECTED_VS_ROUTED_BOUNDARY_NAME"
    ] = expected_vs_boundary


    frame[
        f"{prefix}_EXPECTED_VS_GMLC_ROUTED_NAME"
    ] = expected_vs_gmlc


    frame[
        f"{prefix}_NAME_MATCH_SOURCE"
    ] = match_sources


    # -------------------------------------------------------------
    # Combined NAME status
    #
    # SAME if either:
    #   expected boundary name == GMLC routed name
    #
    # or
    #   expected boundary name == resolved routed boundary name
    # -------------------------------------------------------------

    combined_name_status = []


    for boundary_status, gmlc_status in zip(

        expected_vs_boundary,

        expected_vs_gmlc
    ):

        if (
            boundary_status == "SAME"
            or
            gmlc_status == "SAME"
        ):

            combined_name_status.append(
                "SAME"
            )


        elif (
            boundary_status == "DIFFERENT"
            or
            gmlc_status == "DIFFERENT"
        ):

            combined_name_status.append(
                "DIFFERENT"
            )


        else:

            combined_name_status.append(
                "UNRESOLVED"
            )


    frame[
        f"{prefix}_EXPECTED_VS_ROUTED_NAME"
    ] = combined_name_status


    # -------------------------------------------------------------
    # FINAL status
    # -------------------------------------------------------------

    final_status = []


    for id_status, name_status in zip(

        frame[
            f"{prefix}_EXPECTED_VS_ROUTED_ID"
        ],

        frame[
            f"{prefix}_EXPECTED_VS_ROUTED_NAME"
        ]
    ):

        if (
            id_status == "SAME"
            and
            name_status == "SAME"
        ):

            final_status.append(
                "SAME_ID_SAME_NAME"
            )


        elif (
            id_status == "SAME"
            and
            name_status == "DIFFERENT"
        ):

            final_status.append(
                "SAME_ID_NAME_CONFLICT"
            )


        elif (
            id_status == "DIFFERENT"
            and
            name_status == "SAME"
        ):

            final_status.append(
                "DIFFERENT_ID_SAME_NAME"
            )


        elif (
            id_status == "DIFFERENT"
            and
            name_status == "DIFFERENT"
        ):

            final_status.append(
                "DIFFERENT_ID_DIFFERENT_NAME"
            )


        elif (
            id_status == "DIFFERENT"
        ):

            final_status.append(
                "DIFFERENT_ID_NAME_UNRESOLVED"
            )


        else:

            final_status.append(
                "UNRESOLVED"
            )


    frame[
        f"{prefix}_EXPECTED_VS_ROUTED_STATUS"
    ] = final_status


    return frame


