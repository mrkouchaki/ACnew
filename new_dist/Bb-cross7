# 11. BOUNDARY DISTANCE
# =====================================================================

HAS_VECTOR_SHAPELY = all(

    hasattr(
        shapely,
        x
    )

    for x in [

        "points",
        "shortest_line",
        "get_point",
        "get_x",
        "get_y",
        "covers"
    ]
)


def add_boundary_distance(
    frame,
    lat_col,
    lon_col,
    nena_col,
    output_prefix
):

    frame = frame.reset_index(
        drop=True
    )


    n = len(
        frame
    )


    lat = pd.to_numeric(
        frame[
            lat_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    lon = pd.to_numeric(
        frame[
            lon_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    ids = (
        frame[
            nena_col
        ]
        .fillna("")
        .astype(str)
        .to_numpy()
    )


    distance = np.full(
        n,
        np.nan
    )


    relation = np.full(
        n,
        "INVALID_OR_MISSING_COORDINATE",
        dtype=object
    )


    valid = (

        np.isfinite(lat)
        &
        np.isfinite(lon)

        &

        (lat >= -90)
        &
        (lat <= 90)

        &

        (lon >= -180)
        &
        (lon <= 180)
    )


    relation[
        valid
    ] = "UNRESOLVED_BOUNDARY"


    for nena in pd.unique(
        ids[
            valid
            &
            (ids != "")
        ]
    ):

        if "|" in nena:
            continue


        geometry = (
            boundary_by_nena.get(
                canonical_id(
                    nena
                )
            )
        )


        if geometry is None:
            continue


        idx = np.flatnonzero(

            valid

            &

            (
                ids
                ==
                nena
            )
        )


        if len(
            idx
        ) == 0:
            continue


        if HAS_VECTOR_SHAPELY:

            points = shapely.points(

                lon[
                    idx
                ],

                lat[
                    idx
                ]
            )


            lines = shapely.shortest_line(

                points,

                geometry.boundary
            )


            near = shapely.get_point(
                lines,
                1
            )


            near_lon = np.asarray(
                shapely.get_x(
                    near
                ),
                dtype=float
            )


            near_lat = np.asarray(
                shapely.get_y(
                    near
                ),
                dtype=float
            )


            _, _, meters = GEOD.inv(

                lon[
                    idx
                ],

                lat[
                    idx
                ],

                near_lon,

                near_lat
            )


            meters = np.abs(
                np.asarray(
                    meters,
                    dtype=float
                )
            )


            inside = np.asarray(
                shapely.covers(
                    geometry,
                    points
                ),
                dtype=bool
            )


            distance[
                idx
            ] = meters


            relation[
                idx
            ] = np.where(

                meters <= 0.01,

                "BOUNDARY",

                np.where(

                    inside,

                    "INSIDE",

                    "OUTSIDE"
                )
            )


        else:

            for pos in idx:

                point = Point(
                    lon[pos],
                    lat[pos]
                )


                try:

                    _, near = nearest_points(
                        point,
                        geometry.boundary
                    )


                    _, _, meters = GEOD.inv(

                        lon[pos],
                        lat[pos],

                        near.x,
                        near.y
                    )


                    meters = abs(
                        float(
                            meters
                        )
                    )


                    distance[
                        pos
                    ] = meters


                    if meters <= 0.01:

                        relation[
                            pos
                        ] = "BOUNDARY"


                    elif geometry.covers(
                        point
                    ):

                        relation[
                            pos
                        ] = "INSIDE"


                    else:

                        relation[
                            pos
                        ] = "OUTSIDE"


                except Exception:

                    relation[
                        pos
                    ] = (
                        "DISTANCE_ERROR"
                    )


    frame[
        f"{output_prefix}_M"
    ] = distance


    frame[
        f"{output_prefix}_RELATION"
    ] = relation


    return frame


