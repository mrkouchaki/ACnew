def distance_filter(
    frame
):

    masks = []


    # CALLER
    if (
        MIN_CALLER_OUTSIDE_ROUTED_M is not None
        or
        MAX_CALLER_OUTSIDE_ROUTED_M is not None
    ):

        values = pd.to_numeric(

            frame[
                "CALLER_TO_ROUTED_BOUNDARY_M"
            ],

            errors="coerce"
        )


        mask = (

            values.notna()

            &

            frame[
                "CALLER_TO_ROUTED_RELATION"
            ].eq(
                "OUTSIDE"
            )
        )


        if MIN_CALLER_OUTSIDE_ROUTED_M is not None:

            mask &= (
                values
                >=
                MIN_CALLER_OUTSIDE_ROUTED_M
            )


        if MAX_CALLER_OUTSIDE_ROUTED_M is not None:

            mask &= (
                values
                <=
                MAX_CALLER_OUTSIDE_ROUTED_M
            )


        masks.append(
            mask
        )


    # CELL
    if (
        MIN_CELL_OUTSIDE_ROUTED_M is not None
        or
        MAX_CELL_OUTSIDE_ROUTED_M is not None
    ):

        values = pd.to_numeric(

            frame[
                "CELL_TO_ROUTED_BOUNDARY_M"
            ],

            errors="coerce"
        )


        mask = (

            values.notna()

            &

            frame[
                "CELL_TO_ROUTED_RELATION"
            ].eq(
                "OUTSIDE"
            )
        )


        if MIN_CELL_OUTSIDE_ROUTED_M is not None:

            mask &= (
                values
                >=
                MIN_CELL_OUTSIDE_ROUTED_M
            )


        if MAX_CELL_OUTSIDE_ROUTED_M is not None:

            mask &= (
                values
                <=
                MAX_CELL_OUTSIDE_ROUTED_M
            )


        masks.append(
            mask
        )


    if not masks:

        return pd.Series(
            True,
            index=frame.index
        )


    if len(
        masks
    ) == 1:

        return masks[0]


    if FILTER_MODE.upper() == "AND":

        return (
            masks[0]
            &
            masks[1]
        )


    return (
        masks[0]
        |
        masks[1]
    )


