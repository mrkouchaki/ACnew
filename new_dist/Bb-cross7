def add_comparison(
    frame,
    prefix
):

    routed_ids = (
        frame[
            "ROUTED_NENA_ID"
        ]
        .fillna("")
        .astype(str)
    )


    expected_ids = (
        frame[
            f"{prefix}_EXPECTED_NENA_ID"
        ]
        .fillna("")
        .astype(str)
    )


    id_status = np.where(

        (
            routed_ids.ne("")
            &
            expected_ids.ne("")
            &
            ~expected_ids.str.contains(
                r"\|",
                regex=True
            )
        ),

        np.where(

            routed_ids.map(
                canonical_id
            )
            ==
            expected_ids.map(
                canonical_id
            ),

            "SAME",

            "DIFFERENT"
        ),

        "UNRESOLVED"
    )


    frame[
        f"{prefix}_EXPECTED_VS_ROUTED_ID"
    ] = id_status


    # -------------------------------------------------------------
    # Expected NAME vs GMLC routed NAME
    # -------------------------------------------------------------

    name_status = []

    matched_source = []


    for _, row in frame.iterrows():

        expected_name = clean_text(

            row[
                f"{prefix}_EXPECTED_NAME"
            ]
        )


        gmlc_sources = [

            (
                "GMLC.ROUTE_PSAP_NAME",

                clean_text(
                    row.get(
                        "ROUTE_PSAP_NAME",
                        ""
                    )
                )
            ),

            (
                "GMLC.PSAP_NAME",

                clean_text(
                    row.get(
                        "PSAP_NAME",
                        ""
                    )
                )
            ),

            (
                "GMLC.PSAP_NAME_ESRK",

                clean_text(
                    row.get(
                        "PSAP_NAME_ESRK",
                        ""
                    )
                )
            ),
        ]


        same_source = ""


        for source, value in gmlc_sources:

            if names_same(
                expected_name,
                value
            ):

                same_source = source

                break


        if not expected_name:

            name_status.append(
                "EXPECTED_NAME_MISSING"
            )

            matched_source.append(
                ""
            )


        elif same_source:

            name_status.append(
                "SAME"
            )

            matched_source.append(
                same_source
            )


        elif any(
            value
            for _, value
            in gmlc_sources
        ):

            name_status.append(
                "DIFFERENT"
            )

            matched_source.append(
                ""
            )


        else:

            name_status.append(
                "GMLC_ROUTED_NAME_MISSING"
            )

            matched_source.append(
                ""
            )


    frame[
        f"{prefix}_EXPECTED_VS_ROUTED_NAME"
    ] = name_status


    frame[
        f"{prefix}_ROUTED_NAME_MATCHED_SOURCE"
    ] = matched_source


    # -------------------------------------------------------------
    # Combined useful status
    # -------------------------------------------------------------

    combined = []


    for id_value, name_value in zip(

        frame[
            f"{prefix}_EXPECTED_VS_ROUTED_ID"
        ],

        frame[
            f"{prefix}_EXPECTED_VS_ROUTED_NAME"
        ]
    ):

        if (
            id_value == "SAME"
            and
            name_value == "SAME"
        ):

            combined.append(
                "SAME_ID_SAME_NAME"
            )


        elif (
            id_value == "SAME"
            and
            name_value == "DIFFERENT"
        ):

            combined.append(
                "SAME_ID_NAME_CONFLICT"
            )


        elif (
            id_value == "DIFFERENT"
            and
            name_value == "SAME"
        ):

            combined.append(
                "DIFFERENT_ID_SAME_NAME"
            )


        elif (
            id_value == "DIFFERENT"
            and
            name_value == "DIFFERENT"
        ):

            combined.append(
                "DIFFERENT_ID_DIFFERENT_NAME"
            )


        else:

            combined.append(
                "UNRESOLVED"
            )


    frame[
        f"{prefix}_EXPECTED_VS_ROUTED_STATUS"
    ] = combined


    return frame


