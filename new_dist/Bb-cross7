def normalize_name(value):

    value = clean_text(
        value
    ).upper()

    if not value:
        return ""

    value = re.sub(
        r"\b9[\s\-]*1[\s\-]*1\b",
        "911",
        value
    )

    value = value.replace(
        "&",
        " AND "
    )

    value = re.sub(
        r"[^A-Z0-9]+",
        " ",
        value
    )

    value = re.sub(
        r"\s+",
        " ",
        value
    ).strip()

    # Remove terminal operational/site code only.
    value = re.sub(
        r"\s+\d{3,6}$",
        "",
        value
    ).strip()

    return value


def names_same(
    a,
    b
):

    a = normalize_name(a)
    b = normalize_name(b)

    return (
        bool(a)
        and
        bool(b)
        and
        a == b
    )


def boundary_name_agreement(
    name_psap,
    name_esrk,
    agency
):

    available = [
        clean_text(x)
        for x in [
            name_psap,
            name_esrk,
            agency
        ]
        if clean_text(x)
    ]


    if len(available) == 0:

        return "NO_NAME"


    if len(available) == 1:

        return "ONE_SOURCE_ONLY"


    normalized = {
        normalize_name(x)
        for x in available
        if normalize_name(x)
    }


    if len(normalized) == 1:

        return "ALL_AVAILABLE_SOURCES_AGREE"


    return "SOURCE_CONFLICT"


