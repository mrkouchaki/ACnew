def add_boundary_distance(
    frame,
    lat_col,
    lon_col,
    psap_id_col,
    distance_col,
    relation_col
):

    frame = frame.reset_index(
        drop=True
    )


    n = len(
        frame
    )


    lat = pd.to_numeric(
        frame[
            lat_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    lon = pd.to_numeric(
        frame[
            lon_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    ids = (
        frame[
            psap_id_col
        ]
        .fillna("")
        .astype(str)
        .to_numpy()
    )


    distance = np.full(
        n,
        np.nan
    )


    relation = np.full(
        n,
        "INVALID_OR_MISSING_COORDINATE",
        dtype=object
    )


    valid = (

        np.isfinite(lat)
        &
        np.isfinite(lon)

        &

        (lat >= -90)
        &
        (lat <= 90)

        &

        (lon >= -180)
        &
        (lon <= 180)

        &

        ~(
            np.isclose(
                lat,
                0
            )
            &
            np.isclose(
                lon,
                0
            )
        )
    )


    relation[
        valid
    ] = (
        "UNRESOLVED_BOUNDARY"
    )


    unique_ids = pd.unique(
        ids[
            valid
            &
            (ids != "")
        ]
    )


    for psap_id in unique_ids:

        if "|" in psap_id:

            continue


        geometry = boundary_by_nena.get(
            canonical_id(
                psap_id
            )
        )


        if geometry is None:

            continue


        idx = np.flatnonzero(

            valid

            &

            (
                ids
                ==
                psap_id
            )
        )


        if len(
            idx
        ) == 0:

            continue


        if HAS_VECTOR_SHAPELY:

            points = shapely.points(

                lon[
                    idx
                ],

                lat[
                    idx
                ]
            )


            lines = shapely.shortest_line(

                points,

                geometry.boundary
            )


            nearest = shapely.get_point(
                lines,
                1
            )


            nearest_lon = np.asarray(
                shapely.get_x(
                    nearest
                ),
                dtype=float
            )


            nearest_lat = np.asarray(
                shapely.get_y(
                    nearest
                ),
                dtype=float
            )


            _, _, meters = GEOD.inv(

                lon[
                    idx
                ],

                lat[
                    idx
                ],

                nearest_lon,

                nearest_lat
            )


            meters = np.abs(
                np.asarray(
                    meters,
                    dtype=float
                )
            )


            inside = np.asarray(

                shapely.covers(
                    geometry,
                    points
                ),

                dtype=bool
            )


            distance[
                idx
            ] = meters


            boundary_mask = (
                meters
                <=
                0.01
            )


            relation[
                idx
            ] = np.where(

                boundary_mask,

                "BOUNDARY",

                np.where(

                    inside,

                    "INSIDE",

                    "OUTSIDE"
                )
            )


        else:

            for position in idx:

                point = Point(

                    lon[
                        position
                    ],

                    lat[
                        position
                    ]
                )


                try:

                    _, nearest = nearest_points(

                        point,

                        geometry.boundary
                    )


                    _, _, meters = GEOD.inv(

                        lon[
                            position
                        ],

                        lat[
                            position
                        ],

                        nearest.x,

                        nearest.y
                    )


                    meters = abs(
                        float(
                            meters
                        )
                    )


                    distance[
                        position
                    ] = meters


                    if meters <= 0.01:

                        relation[
                            position
                        ] = "BOUNDARY"


                    elif geometry.covers(
                        point
                    ):

                        relation[
                            position
                        ] = "INSIDE"


                    else:

                        relation[
                            position
                        ] = "OUTSIDE"


                except Exception:

                    relation[
                        position
                    ] = (
                        "DISTANCE_ERROR"
                    )


    frame[
        distance_col
    ] = distance


    frame[
        relation_col
    ] = relation


    return frame


