def assign_expected_psap(
    frame,
    prefix,
    lat_col,
    lon_col
):

    frame = frame.reset_index(
        drop=True
    )


    n = len(
        frame
    )


    expected_nena = np.full(
        n,
        "",
        dtype=object
    )


    expected_psap = np.full(
        n,
        "",
        dtype=object
    )


    expected_fcc = np.full(
        n,
        "",
        dtype=object
    )


    selected_name = np.full(
        n,
        "",
        dtype=object
    )


    selected_source = np.full(
        n,
        "",
        dtype=object
    )


    name_psap = np.full(
        n,
        "",
        dtype=object
    )


    name_esrk = np.full(
        n,
        "",
        dtype=object
    )


    name_agency = np.full(
        n,
        "",
        dtype=object
    )


    name_check = np.full(
        n,
        "",
        dtype=object
    )


    spatial_status = np.full(
        n,
        "INVALID_OR_MISSING_COORDINATE",
        dtype=object
    )


    lat = pd.to_numeric(
        frame[
            lat_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    lon = pd.to_numeric(
        frame[
            lon_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    valid = (

        np.isfinite(
            lat
        )

        &

        np.isfinite(
            lon
        )

        &

        (lat >= -90)
        &
        (lat <= 90)

        &

        (lon >= -180)
        &
        (lon <= 180)

        &

        ~(
            np.isclose(
                lat,
                0
            )
            &
            np.isclose(
                lon,
                0
            )
        )
    )


    positions = np.flatnonzero(
        valid
    )


    if len(
        positions
    ) > 0:

        point_df = pd.DataFrame(
            {

                "_POS":
                    positions,

                "_LAT":
                    lat[
                        positions
                    ],

                "_LON":
                    lon[
                        positions
                    ],
            }
        )


        points = gpd.GeoDataFrame(

            point_df,

            geometry=gpd.points_from_xy(

                point_df[
                    "_LON"
                ],

                point_df[
                    "_LAT"
                ]
            ),

            crs="EPSG:4326"
        )


        joined = gpd.sjoin(

            points,

            boundary_geo[
                [
                    "_NENA",
                    "geometry"
                ]
            ],

            how="left",

            predicate="intersects"
        )


        for pos, group in joined.groupby(
            "_POS",
            sort=False
        ):

            ids = sorted(
                {

                    clean_text(x)

                    for x
                    in group[
                        "_NENA"
                    ]

                    if clean_text(x)
                }
            )


            if len(
                ids
            ) == 1:

                nena = ids[0]

                metadata = (
                    meta_by_nena.get(
                        nena,
                        {}
                    )
                )


                selected, source = (
                    choose_boundary_name(

                        metadata.get(
                            "_NAME_PSAP",
                            ""
                        ),

                        metadata.get(
                            "_NAME_ESRK",
                            ""
                        ),

                        metadata.get(
                            "_NAME_AGENCY",
                            ""
                        )
                    )
                )


                expected_nena[
                    pos
                ] = nena


                expected_psap[
                    pos
                ] = metadata.get(
                    "_PSAP",
                    ""
                )


                expected_fcc[
                    pos
                ] = metadata.get(
                    "_FCC",
                    ""
                )


                selected_name[
                    pos
                ] = selected


                selected_source[
                    pos
                ] = source


                name_psap[
                    pos
                ] = metadata.get(
                    "_NAME_PSAP",
                    ""
                )


                name_esrk[
                    pos
                ] = metadata.get(
                    "_NAME_ESRK",
                    ""
                )


                name_agency[
                    pos
                ] = metadata.get(
                    "_NAME_AGENCY",
                    ""
                )


                name_check[
                    pos
                ] = boundary_name_agreement(

                    metadata.get(
                        "_NAME_PSAP",
                        ""
                    ),

                    metadata.get(
                        "_NAME_ESRK",
                        ""
                    ),

                    metadata.get(
                        "_NAME_AGENCY",
                        ""
                    )
                )


                spatial_status[
                    pos
                ] = (
                    "UNIQUE_PSAP"
                )


            elif len(
                ids
            ) == 0:

                spatial_status[
                    pos
                ] = (
                    "NO_CONTAINING_PSAP"
                )


            else:

                expected_nena[
                    pos
                ] = "|".join(
                    ids
                )

                spatial_status[
                    pos
                ] = (
                    "MULTIPLE_PSAP"
                )


    frame[
        f"{prefix}_EXPECTED_NENA_ID"
    ] = expected_nena


    frame[
        f"{prefix}_EXPECTED_PSAP_ID"
    ] = expected_psap


    frame[
        f"{prefix}_EXPECTED_FCC_PSAP_ID"
    ] = expected_fcc


    frame[
        f"{prefix}_EXPECTED_NAME"
    ] = selected_name


    frame[
        f"{prefix}_EXPECTED_NAME_SOURCE"
    ] = selected_source


    frame[
        f"{prefix}_EXPECTED_NAME_FROM_PSAP_NAME"
    ] = name_psap


    frame[
