        "CELL_EXPECTED_NAME",

        "CELL_EXPECTED_NAME_SOURCE",

        "CELL_EXPECTED_NAME_FROM_PSAP_NAME",

        "CELL_EXPECTED_NAME_FROM_PSAP_NAME_ESRK",

        "CELL_EXPECTED_NAME_FROM_AGENCY",

        "CELL_EXPECTED_NAME_SOURCE_CHECK",

        "CELL_EXPECTED_VS_ROUTED_ID",

        "CELL_EXPECTED_VS_ROUTED_NAME",

        "CELL_EXPECTED_VS_ROUTED_STATUS",

        "CELL_TO_EXPECTED_BOUNDARY_M",


        # ---------------------------------------------------------
        # CALLER <-> CELL
        # ---------------------------------------------------------

        "CALLER_TO_CELL_M",
    ]


    clean_columns = [
        c
        for c in clean_columns
        if c in candidate.columns
    ]


    output = (
        candidate[
            clean_columns
        ]
        .copy()
    )


    # Numeric fields exported as actual numbers.
    for column in output.columns:

        if (
            column.endswith(
                "_M"
            )
            or
            column.endswith(
                "_LATITUDE"
            )
            or
            column.endswith(
                "_LONGITUDE"
            )
        ):

            output[
                column
            ] = pd.to_numeric(
                output[
                    column
                ],
                errors="coerce"
            )


    output.to_csv(

        OUTPUT_CSV,

        mode=(
            "a"
            if header_written
            else "w"
        ),

        header=(
            not header_written
        ),

        index=False,

        float_format="%.3f"
    )


    header_written = True

    saved += len(
        output
    )


    print(
        f"Chunk {chunk_no:03d} | "
        f"processed {processed:,} | "
        f"total saved {saved:,}"
    )


