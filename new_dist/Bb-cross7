def clean_text(value):

    if value is None or pd.isna(value):
        return ""

    value = str(value).strip()

    if value.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:
        return ""

    return value


def norm_id(value):
    """
    String ID normalization.
    Keeps leading zero.
    """

    value = clean_text(
        value
    )

    if not value:
        return ""

    return re.sub(
        r"\.0$",
        "",
        value
    )


def canonical_id(value):
    """
    Used only for ID COMPARISON.

    Example:
        040500006 -> 40500006
        40500006  -> 40500006

    Therefore PSAP_ID can be compared safely with zero-padded NENA_ID.
    """

    value = norm_id(
        value
    )

    if not value:
        return ""

    if re.fullmatch(
        r"\d+",
        value
    ):

        try:
            return str(
                int(value)
            )

        except Exception:
            pass

    return value.upper()


def numeric(value):

    value = pd.to_numeric(
        value,
        errors="coerce"
    )

    try:
        value = float(value)

    except Exception:
        return np.nan

    return (
        value
        if math.isfinite(value)
        else np.nan
    )


def valid_coordinate(
    lat,
    lon
):

    lat = numeric(lat)
    lon = numeric(lon)

    if (
        not np.isfinite(lat)
        or
        not np.isfinite(lon)
    ):
        return False

    if not (
        -90 <= lat <= 90
        and
        -180 <= lon <= 180
    ):
        return False

    if (
        abs(lat) < 1e-10
        and
        abs(lon) < 1e-10
    ):
        return False

    return True


def repair_geometry(g):

    if (
        g is None
        or
        g.is_empty
    ):
        return None

    try:

        if not g.is_valid:
            g = g.buffer(0)

        if (
            g is None
            or
            g.is_empty
            or
            not g.is_valid
        ):
            return None

        return g

    except Exception:

        return None


def first_existing(
    columns,
    candidates,
    required=False
):

    lookup = {
        str(c).strip().upper():
            c
        for c in columns
    }

    for candidate in candidates:

        if candidate.upper() in lookup:

            return lookup[
                candidate.upper()
            ]

    if required:

        raise RuntimeError(
            "Missing required column. Tried: "
            + ", ".join(candidates)
        )

    return None


