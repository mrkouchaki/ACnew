def compare_name_sets(
    left_names,
    right_names
):
    """
    Returns:
        status
        matched source description
    """

    if not left_names:

        return (
            "LEFT_NAME_MISSING",
            ""
        )


    if not right_names:

        return (
            "RIGHT_NAME_MISSING",
            ""
        )


    for left_source, left_value in left_names.items():

        left_normalized = (
            normalize_name(
                left_value
            )
        )


        if not left_normalized:

            continue


        for right_source, right_value in right_names.items():

            right_normalized = (
                normalize_name(
                    right_value
                )
            )


            if (
                right_normalized
                and
                left_normalized
                ==
                right_normalized
            ):

                return (

                    "SAME",

                    (
                        f"{left_source} "
                        f"<-> "
                        f"{right_source}"
                    )
                )


    return (
        "DIFFERENT",
        ""
    )


