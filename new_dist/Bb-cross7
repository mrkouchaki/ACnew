def clean_text(value):

    if value is None or pd.isna(value):
        return ""

    text = str(
        value
    ).strip()


    if text.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:

        return ""


    return text


def raw_id(value):
    """
    Preserve leading zeros for reporting.
    """

    text = clean_text(
        value
    )

    if not text:
        return ""

    return re.sub(
        r"\.0$",
        "",
        text
    )


def canonical_id(value):
    """
    Numeric identity comparison.

    040500006 -> 40500006
    40500006  -> 40500006

    Therefore GMLC.PSAP_ID can be safely compared against
    Boundary.NENA_ID despite zero padding.
    """

    text = raw_id(
        value
    )


    if not text:
        return ""


    if re.fullmatch(
        r"\d+",
        text
    ):

        try:

            return str(
                int(text)
            )

        except Exception:

            pass


    return text.upper()


def numeric(value):

    value = pd.to_numeric(
        value,
        errors="coerce"
    )


    try:

        value = float(
            value
        )

    except Exception:

        return np.nan


    if not math.isfinite(
        value
    ):

        return np.nan


    return value


def valid_coordinate(
    lat,
    lon
):

    lat = numeric(
        lat
    )

    lon = numeric(
        lon
    )


    if (
        not np.isfinite(lat)
        or
        not np.isfinite(lon)
    ):

        return False


    if not (
        -90 <= lat <= 90
        and
        -180 <= lon <= 180
    ):

        return False


    if (
        abs(lat) < 1e-10
        and
        abs(lon) < 1e-10
    ):

        return False


    return True


def repair_geometry(
    geometry
):

    if (
        geometry is None
        or
        geometry.is_empty
    ):

        return None


    try:

        if not geometry.is_valid:

            geometry = (
                geometry.buffer(0)
            )


        if (
            geometry is None
            or
            geometry.is_empty
            or
            not geometry.is_valid
        ):

            return None


        return geometry


    except Exception:

        return None


def find_column(
    columns,
    candidates,
    required=False
):

    lookup = {

        str(column)
        .strip()
        .upper():
            column

        for column
        in columns
    }


    for candidate in candidates:

        if candidate.upper() in lookup:

            return lookup[
                candidate.upper()
            ]


    if required:

        raise RuntimeError(
            "Missing required column. Tried: "
            + ", ".join(
                candidates
            )
        )


    return None


