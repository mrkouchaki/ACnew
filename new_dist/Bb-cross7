        dtype=object
    )


    source_check = np.full(
        n,
        "",
        dtype=object
    )


    spatial_status = np.full(
        n,
        "INVALID_OR_MISSING_COORDINATE",
        dtype=object
    )


    lat = pd.to_numeric(
        frame[
            lat_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    lon = pd.to_numeric(
        frame[
            lon_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    valid = (

        np.isfinite(lat)
        &
        np.isfinite(lon)

        &

        (lat >= -90)
        &
        (lat <= 90)

        &

        (lon >= -180)
        &
        (lon <= 180)

        &

        ~(
            np.isclose(
                lat,
                0
            )
            &
            np.isclose(
                lon,
                0
            )
        )
    )


    positions = np.flatnonzero(
        valid
    )


    if len(
        positions
    ) > 0:

        # ---------------------------------------------------------
        # Deduplicate coordinates before spatial join.
        # ---------------------------------------------------------

        unique = (

            pd.DataFrame(
                {

                    "_LAT":
                        lat[
                            positions
                        ],

                    "_LON":
                        lon[
                            positions
                        ],
                }
            )

            .drop_duplicates()

            .reset_index(
                drop=True
            )
        )


        unique[
            "_POINT_ID"
        ] = np.arange(
            len(
                unique
            )
        )


        points = gpd.GeoDataFrame(

            unique,

            geometry=gpd.points_from_xy(

                unique[
                    "_LON"
                ],

                unique[
                    "_LAT"
                ]
            ),

            crs="EPSG:4326"
        )


        joined = gpd.sjoin(

            points,

            boundary_geo[
                [
                    "_NENA_CANON",
                    "geometry"
                ]
            ],

            how="left",

            predicate="intersects"
        )


        point_lookup = {}


        for point_id, group in joined.groupby(
            "_POINT_ID",
            sort=False
        ):

            ids = sorted(
                {

                    clean_text(
                        value
                    )

                    for value
                    in group[
                        "_NENA_CANON"
                    ]

                    if clean_text(
                        value
                    )
                }
            )


            point_row = unique.loc[
                int(
                    point_id
                )
            ]


            point_key = (

                float(
                    point_row[
                        "_LAT"
                    ]
                ),

                float(
                    point_row[
                        "_LON"
                    ]
                )
            )


            if len(
                ids
            ) == 1:

                nena = ids[0]


                metadata = (
                    meta_by_nena.get(
                        nena,
                        {}
                    )
                )


                name, name_source = (
                    primary_boundary_name(
                        metadata
                    )
                )


                point_lookup[
                    point_key
                ] = {

                    "NENA_RAW":
                        metadata.get(
                            "NENA_ID_RAW",
                            ""
                        ),

                    "PSAP":
                        nena,

                    "FCC":
                        metadata.get(
                            "FCC_ID",
                            ""
                        ),

                    "NAME":
                        name,

                    "NAME_SOURCE":
                        name_source,

                    "NAME_SOURCES":
                        name_sources_string(
                            metadata
                        ),

                    "SOURCE_CHECK":
                        name_source_agreement(
                            {

                                "BOUNDARY.AGENCY":
                                    metadata.get(
                                        "AGENCY",
                                        ""
                                    ),

                                "BOUNDARY.PSAP_NAME":
                                    metadata.get(
                                        "PSAP_NAME",
                                        ""
                                    ),

                                "BOUNDARY.PSAP_NAME_ESRK":
                                    metadata.get(
                                        "PSAP_NAME_ESRK",
                                        ""
                                    ),
                            }
                        ),

                    "STATUS":
                        "UNIQUE_PSAP",
                }


            elif len(
                ids
            ) == 0:

                point_lookup[
                    point_key
                ] = {

                    "NENA_RAW":
                        "",

                    "PSAP":
                        "",

                    "FCC":
                        "",

                    "NAME":
                        "",

                    "NAME_SOURCE":
                        "",

                    "NAME_SOURCES":
                        "",

                    "SOURCE_CHECK":
                        "NO_NAME_SOURCE",

                    "STATUS":
                        "NO_CONTAINING_PSAP",
                }


            else:

                point_lookup[
                    point_key
                ] = {

                    "NENA_RAW":
                        "",

                    "PSAP":
                        "|".join(
                            ids
                        ),

                    "FCC":
                        "",

                    "NAME":
                        "",

                    "NAME_SOURCE":
                        "",

                    "NAME_SOURCES":
                        "",

                    "SOURCE_CHECK":
                        "AMBIGUOUS",

                    "STATUS":
                        "MULTIPLE_PSAP",
                }


        # ---------------------------------------------------------
        # Map result back
        # ---------------------------------------------------------

        for position in positions:

            result = point_lookup.get(
                (
                    float(
                        lat[
                            position
                        ]
                    ),

                    float(
                        lon[
                            position
                        ]
                    )
                )
            )


            if result is None:

                continue


            nena_raw[
                position
            ] = result[
                "NENA_RAW"
            ]


            psap_derived[
                position
            ] = result[
                "PSAP"
            ]


            fcc_id[
                position
            ] = result[
                "FCC"
            ]


            primary_name[
                position
            ] = result[
                "NAME"
            ]


            primary_source[
                position
            ] = result[
                "NAME_SOURCE"
            ]


            all_name_sources[
                position
            ] = result[
                "NAME_SOURCES"
            ]


            source_check[
                position
            ] = result[
                "SOURCE_CHECK"
            ]


            spatial_status[
                position
            ] = result[
                "STATUS"
            ]


    frame[
        f"{prefix}_EXPECTED_NENA_ID_RAW"
    ] = nena_raw


    frame[
        f"{prefix}_EXPECTED_PSAP_ID"
    ] = psap_derived


    frame[
        f"{prefix}_EXPECTED_FCC_ID"
    ] = fcc_id


    frame[
        f"{prefix}_EXPECTED_NAME"
    ] = primary_name


    frame[
        f"{prefix}_EXPECTED_NAME_SOURCE"
    ] = primary_source


    frame[
        f"{prefix}_EXPECTED_NAME_SOURCES"
    ] = all_name_sources


    frame[
        f"{prefix}_EXPECTED_NAME_SOURCE_CHECK"
    ] = source_check


    frame[
        f"{prefix}_EXPECTED_SPATIAL_STATUS"
    ] = spatial_status


    return frame


