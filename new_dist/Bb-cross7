def name_sources_string(
    metadata
):

    pieces = []


    for source, key in [

        (
            "AGENCY",
            "AGENCY"
        ),

        (
            "PSAP_NAME",
            "PSAP_NAME"
        ),

        (
            "PSAP_NAME_ESRK",
            "PSAP_NAME_ESRK"
        ),
    ]:

        value = clean_text(
            metadata.get(
                key,
                ""
            )
        )


        if value:

            pieces.append(
                f"{source}={value}"
            )


    return " | ".join(
        pieces
    )


def gmlc_name_dictionary(
    row
):

    output = {}


    for column in [

        "ROUTE_PSAP_NAME",
        "PSAP_NAME",
        "PSAP_NAME_ESRK",
