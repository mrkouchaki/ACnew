def normalize_name(value):

    text = clean_text(
        value
    ).upper()


    if not text:

        return ""


    # 9-1-1 / 9 1 1 -> 911
    text = re.sub(
        r"\b9[\s\-]*1[\s\-]*1\b",
        "911",
        text
    )


    text = text.replace(
        "&",
        " AND "
    )


    text = re.sub(
        r"[^A-Z0-9]+",
        " ",
        text
    )


    text = re.sub(
        r"\s+",
        " ",
        text
    ).strip()


    # Remove terminal operational/site number only.
    #
    # Example:
    # Alaska State Troopers - Ketchikan Gateway - 9775

    text = re.sub(
        r"\s+\d{3,6}$",
        "",
        text
    ).strip()


    return text


def first_nonempty(series):

    for value in series:

        value = clean_text(
            value
        )

        if value:

            return value


    return ""


def join_unique_names(series):

    values = []


    for value in series:

        value = clean_text(
            value
        )


        if (
            value
            and
            value not in values
        ):

            values.append(
                value
            )


    return " | ".join(
        values
    )


def name_source_agreement(
    values
):
    """
    values = dict:
        {
          "BOUNDARY.AGENCY": "...",
          "BOUNDARY.PSAP_NAME": "...",
          ...
        }
    """

    present = {

        source:
            clean_text(
                value
            )

        for source, value
        in values.items()

        if clean_text(
            value
        )
    }


    if not present:

        return "NO_NAME_SOURCE"


    if len(
        present
    ) == 1:

        return "ONE_NAME_SOURCE"


    normalized = {

        normalize_name(
            value
        )

        for value
        in present.values()

        if normalize_name(
            value
        )
    }


    if len(
        normalized
    ) == 1:

        return (
            "ALL_AVAILABLE_NAME_SOURCES_AGREE"
        )


    return (
        "NAME_SOURCE_CONFLICT"
    )


