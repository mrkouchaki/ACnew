        ),

        popup=folium.Popup(
            mean_popup,
            max_width=400
        ),

        icon=folium.Icon(
            color="orange"
        )

    ).add_to(
        mean_layer
    )


    # -------------------------------------------------------------
    # MAX
    # -------------------------------------------------------------

    max_popup = f"""
    <b>MAX — SAME ROUTED PSAP</b><br>

    PSAP:
    {escape(str(name))}<br>

    FCC ID:
    {escape(str(fcc))}<br>

    Calls:
    {fmt(stats.get("CALLS"), 0)}<br><br>

    Caller → Routed:
    <b>{fmt(stats.get("CALLER_MAX_KM"))} km</b><br>

    Cell → Routed:
    <b>{fmt(stats.get("CELL_MAX_KM"))} km</b>
    """


    folium.Marker(

        location=location,

        tooltip=(
            f"MAX | {escape(str(name))}"
        ),

        popup=folium.Popup(
            max_popup,
            max_width=400
        ),

        icon=folium.Icon(
            color="red"
        )

    ).add_to(
        max_layer
    )


# =====================================================================
# 14. DRAW CALLS
# =====================================================================

for _, row in map_calls.iterrows():

    caller_lat = (
        row["_CALLER_LAT"]
    )

    caller_lon = (
        row["_CALLER_LON"]
    )

    cell_lat = (
        row["_CELL_LAT"]
    )

    cell_lon = (
        row["_CELL_LON"]
    )


    routed_id = (
        row["_ROUTED_ID"]
    )

    expected_id = (
        row["_EXPECTED_ID"]
    )


    # -------------------------------------------------------------
    # Call ID
    # -------------------------------------------------------------

    call_id = (
        clean_text(
            row.get(
                CALL_ID_COL,
                ""
            )
        )
        if CALL_ID_COL
        else ""
    )


    # -------------------------------------------------------------
    # Duration
    # -------------------------------------------------------------

    if DURATION_COL:

        duration = numeric(
            row.get(
                DURATION_COL,
                np.nan
            )
        )

    else:

        duration = np.nan


    duration_text = (
        f"{float(duration):,.1f}"
        if pd.notna(duration)
        else "N/A"
    )


    # -------------------------------------------------------------
    # Routed name
    # -------------------------------------------------------------

    if ROUTED_NAME_COL:

        routed_name = clean_text(
            row.get(
                ROUTED_NAME_COL,
                ""
            )
        )

    else:

        routed_name = (
            boundary_name_by_fcc.get(
                routed_id,
                ""
            )
        )


    # -------------------------------------------------------------
    # Expected name
    # -------------------------------------------------------------

    if CALLER_EXPECTED_NAME_COL:

        expected_name = clean_text(
            row.get(
                CALLER_EXPECTED_NAME_COL,
                ""
            )
        )

    else:

        expected_name = (
            boundary_name_by_fcc.get(
                expected_id,
                ""
            )
        )


    # -------------------------------------------------------------
    # SAME / CLOSE / DIFFERENT
    # -------------------------------------------------------------

    if CALLER_STATUS_COL:

        expected_status = clean_text(
            row.get(
                CALLER_STATUS_COL,
                ""
            )
        )

    else:

        expected_status = (
            "SAME"
            if (
                routed_id
                and
                routed_id == expected_id
            )
            else "DIFFERENT"
        )


    stats = (
        stats_lookup.get(
            routed_id,
            {}
        )
    )


    # =============================================================
    # CALLER MARKER
    # =============================================================

    if valid_point(
        caller_lat,
        caller_lon
    ):

        popup_html = f"""
        <b>CALL</b><br>

        Call ID:
        {escape(str(call_id))}<br>

        Call duration:
        <b>{duration_text} sec</b><br><br>


        <b>ROUTED PSAP</b><br>

        ID:
        {escape(str(routed_id))}<br>

        Name:
        <b>{escape(str(routed_name))}</b><br><br>


        <b>CALLER EXPECTED PSAP</b><br>

        ID:
        {escape(str(expected_id))}<br>

        Name:
        <b>{escape(str(expected_name))}</b><br>

        Caller expected vs routed:
        <b>{escape(str(expected_status))}</b><br><br>


        <b>THIS CALL</b><br>

        Caller → Routed boundary:
        <b>{fmt(row["_CALLER_ROUTED_KM"])} km</b><br>

        Caller → Expected boundary:
        <b>{fmt(row["_CALLER_EXPECTED_KM"])} km</b><br>

        Cell → Routed boundary:
        <b>{fmt(row["_CELL_ROUTED_KM"])} km</b><br>

        Caller ↔ Cell:
        <b>{fmt(row["_CALLER_CELL_KM"])} km</b><br><br>


        <b>SAME ROUTED PSAP STATISTICS</b><br>

        Caller Min / Mean / Max:
        {fmt(stats.get("CALLER_MIN_KM"))} /
        {fmt(stats.get("CALLER_MEAN_KM"))} /
        {fmt(stats.get("CALLER_MAX_KM"))} km<br>

        Cell Min / Mean / Max:
        {fmt(stats.get("CELL_MIN_KM"))} /
        {fmt(stats.get("CELL_MEAN_KM"))} /
        {fmt(stats.get("CELL_MAX_KM"))} km
        """


        folium.Marker(

            [
                float(caller_lat),
                float(caller_lon)
            ],

            popup=folium.Popup(
                popup_html,
                max_width=500
            ),

            tooltip=(
                f"Caller | "
                f"{escape(str(call_id))} | "
                f"{fmt(row['_CALLER_ROUTED_KM'])} km"
            ),

            icon=folium.Icon(
                color="blue"
            )

        ).add_to(
            caller_cluster
        )


        # ---------------------------------------------------------
        # Uncertainty
        # ---------------------------------------------------------

        if UNCERTAINTY_COL:

            uncertainty = numeric(
                row.get(
                    UNCERTAINTY_COL,
                    np.nan
                )
            )


            if (
                pd.notna(uncertainty)
                and
                0 < float(uncertainty) <= 100000
            ):

                folium.Circle(

                    [
                        float(caller_lat),
                        float(caller_lon)
                    ],

                    radius=float(
                        uncertainty
                    ),

                    weight=1,

                    fill=True,

                    fill_opacity=0.04,

                    tooltip=(
                        f"Caller uncertainty: "
                        f"{fmt(uncertainty, 1)} m"
                    )

                ).add_to(
                    uncertainty_layer
                )


    # =============================================================
    # CELL MARKER
    # =============================================================

    if valid_point(
        cell_lat,
        cell_lon
    ):

        cell_popup = f"""
        <b>CELL LOCATION</b><br>

        Call ID:
        {escape(str(call_id))}<br>

        Call duration:
        <b>{duration_text} sec</b><br><br>

        Cell latitude:
        {fmt(cell_lat, 6)}<br>

        Cell longitude:
        {fmt(cell_lon, 6)}<br><br>

        Cell → Routed boundary:
        <b>{fmt(row["_CELL_ROUTED_KM"])} km</b><br>

        Caller ↔ Cell:
        <b>{fmt(row["_CALLER_CELL_KM"])} km</b>
        """


        folium.Marker(

            [
                float(cell_lat),
                float(cell_lon)
            ],

            popup=folium.Popup(
                cell_popup,
                max_width=400
            ),

            tooltip=(
                f"Cell | "
                f"{escape(str(call_id))}"
            ),

            icon=folium.Icon(
                color="green"
            )

        ).add_to(
            cell_cluster
        )


    # =============================================================
    # ROUTED GEOMETRY
    # =============================================================

    routed_geom = (
        boundary_by_fcc.get(
            routed_id
        )
    )


    # =============================================================
    # CALLER -> ROUTED PSAP BOUNDARY
    # =============================================================

    if (
        routed_geom is not None
        and
        valid_point(
            caller_lat,
            caller_lon
        )
    ):

        near_lat, near_lon, recalc_km = (
            nearest_boundary(
                caller_lat,
                caller_lon,
                routed_geom
            )
        )


        if valid_point(
            near_lat,
            near_lon
        ):

            folium.PolyLine(

                [
                    [
                        float(caller_lat),
                        float(caller_lon)
                    ],

                    [
                        float(near_lat),
                        float(near_lon)
                    ]
                ],

                weight=2,

                color="#b22222",

                tooltip=(
                    "Caller → Routed PSAP boundary | "
                    f"{fmt(row['_CALLER_ROUTED_KM'])} km"
                )

            ).add_to(
                caller_routed_layer
            )


    # =============================================================
    # CALLER -> EXPECTED PSAP BOUNDARY
    # =============================================================

    if (
        expected_id
        and
        "|" not in expected_id
    ):

        expected_geom = (
            boundary_by_fcc.get(
                expected_id
            )
        )

    else:

        expected_geom = None


    if (
        expected_geom is not None
        and
        valid_point(
            caller_lat,
            caller_lon
        )
    ):

        near_lat, near_lon, recalc_km = (
            nearest_boundary(
                caller_lat,
                caller_lon,
                expected_geom
            )
        )


        if valid_point(
            near_lat,
            near_lon
        ):

            folium.PolyLine(

                [
                    [
                        float(caller_lat),
                        float(caller_lon)
                    ],

                    [
                        float(near_lat),
                        float(near_lon)
                    ]
                ],

                weight=2,

                color="#228b22",

                dash_array="6,6",

                tooltip=(
                    "Caller → Expected PSAP boundary | "
                    f"{fmt(row['_CALLER_EXPECTED_KM'])} km"
                )

            ).add_to(
                caller_expected_layer
            )


    # =============================================================
    # CELL -> ROUTED PSAP BOUNDARY
    # =============================================================

    if (
        routed_geom is not None
        and
        valid_point(
            cell_lat,
            cell_lon
        )
    ):

        near_lat, near_lon, recalc_km = (
            nearest_boundary(
                cell_lat,
                cell_lon,
                routed_geom
            )
        )


        if valid_point(
            near_lat,
            near_lon
        ):

            folium.PolyLine(

                [
                    [
                        float(cell_lat),
                        float(cell_lon)
                    ],

                    [
                        float(near_lat),
                        float(near_lon)
                    ]
                ],

                weight=2,

                color="#228b22",

                dash_array="5,5",

                tooltip=(
                    "Cell → Routed PSAP boundary | "
                    f"{fmt(row['_CELL_ROUTED_KM'])} km"
                )

            ).add_to(
                cell_routed_layer
            )


    # =============================================================
    # CALLER <-> CELL
    # =============================================================

    if (
        valid_point(
            caller_lat,
            caller_lon
        )
        and
        valid_point(
            cell_lat,
            cell_lon
        )
    ):

        folium.PolyLine(

            [
                [
                    float(caller_lat),
                    float(caller_lon)
                ],

                [
                    float(cell_lat),
                    float(cell_lon)
                ]
            ],

            weight=2,

            color="#3366cc",

            opacity=0.65,

            dash_array="8,6",

            tooltip=(
                "Caller ↔ Cell | "
                f"{fmt(row['_CALLER_CELL_KM'])} km"
            )

        ).add_to(
            caller_cell_layer
        )


# =====================================================================
# 15. ADD LAYERS
# =====================================================================

for layer in [

    routed_layer,
    expected_layer,

    uncertainty_layer,

    caller_routed_layer,
    caller_expected_layer,
    cell_routed_layer,
    caller_cell_layer,

    caller_layer,
    cell_layer,

    min_layer,
    mean_layer,
    max_layer,
]:

    layer.add_to(
        psap_map
    )


folium.LayerControl(
    collapsed=False
).add_to(
    psap_map
)


# =====================================================================
# 16. FIT TO CALLER LOCATIONS ONLY
# =====================================================================

fit_points = [

    [
        float(lat),
        float(lon)
    ]

    for lat, lon in zip(
        map_calls[
            "_CALLER_LAT"
        ],
        map_calls[
            "_CALLER_LON"
        ]
    )

    if valid_point(
        lat,
        lon
    )
]


if len(fit_points) > 1:

    psap_map.fit_bounds(
        fit_points
    )


# =====================================================================
# 17. SAVE + DISPLAY
# =====================================================================

psap_map.save(
    OUTPUT_HTML
)


print(
    "\nMap calls:",
    len(map_calls)
)

print(
    "Saved:",
    OUTPUT_HTML
)

print(
    "\nESPOSREQ is NOT included in this map."
)

print(
    "MIN / MEAN / MAX are grouped by the same routed PSAP."
)


display(
    Markdown(
        "### Caller + Cell PSAP cross-check map"
    )
)

display(
    psap_map
)







