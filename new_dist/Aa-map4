def norm_id(value):

    if value is None or pd.isna(value):
        return ""

    text = str(value).strip().strip('"')

    if text.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:
        return ""

    return re.sub(
        r"\.0$",
        "",
        text
    )


def clean_text(value):

    if value is None or pd.isna(value):
        return ""

    return str(value).strip()


def numeric(value):

    return pd.to_numeric(
        value,
        errors="coerce"
    )


def fmt(value, digits=2):

    value = numeric(value)

    if pd.isna(value):
        return "N/A"

    return f"{float(value):,.{digits}f}"


def valid_point(lat, lon):

    lat = numeric(lat)
    lon = numeric(lon)

    if (
        pd.isna(lat)
        or
        pd.isna(lon)
    ):
        return False

    lat = float(lat)
    lon = float(lon)

    if not (
        -90 <= lat <= 90
        and
        -180 <= lon <= 180
    ):
        return False

    # Ignore common missing-location placeholder.
    if (
        abs(lat) < 1e-10
        and
        abs(lon) < 1e-10
    ):
        return False

    return True


def find_col(
    dataframe,
    candidates,
    required=False
):

    for col in candidates:

        if col in dataframe.columns:
            return col

    if required:

        raise RuntimeError(
            "Required column not found.\nTried:\n"
            + "\n".join(candidates)
        )

    return None


def read_distance_km(
    dataframe,
    km_columns,
    meter_columns
):

    km_col = find_col(
        dataframe,
        km_columns
    )

    if km_col is not None:

        return pd.to_numeric(
            dataframe[km_col],
            errors="coerce"
        )


    meter_col = find_col(
        dataframe,
        meter_columns
    )

    if meter_col is not None:

        return (
            pd.to_numeric(
                dataframe[meter_col],
                errors="coerce"
            )
            / 1000.0
        )


    return pd.Series(
        np.nan,
        index=dataframe.index,
        dtype=float
    )


def repair_geometry(geom):

    if (
        geom is None
        or geom.is_empty
    ):
        return None

    try:

        if not geom.is_valid:
            geom = geom.buffer(0)

        if (
            geom.is_empty
            or not geom.is_valid
        ):
            return None

        return geom

    except Exception:

        return None


def nearest_boundary(
    lat,
    lon,
    geom
):

    if (
        geom is None
        or
        not valid_point(lat, lon)
    ):
        return (
            np.nan,
            np.nan,
            np.nan
        )


    lat = float(lat)
    lon = float(lon)

    point = Point(
        lon,
        lat
    )


    try:

        _, near = nearest_points(
            point,
            geom.boundary
        )

        _, _, distance_m = GEOD.inv(
            lon,
            lat,
            near.x,
            near.y
        )

        return (
            float(near.y),
            float(near.x),
            abs(float(distance_m)) / 1000.0
        )

    except Exception:

        return (
            np.nan,
            np.nan,
            np.nan
        )


