import re
import pandas as pd
import numpy as np


# =====================================================================
# 1. CANONICAL ID NORMALIZATION
# =====================================================================

def canonical_psap_id(value):
    """
    Normalize PSAP/NENA identifiers without corrupting nonnumeric IDs.

    Examples:
        020200005   -> 20200005
        20200005    -> 20200005
        021980004   -> 21980004
        21980004    -> 21980004
        720000015   -> 720000015
    """

    if value is None or pd.isna(value):
        return ""

    text = str(value).strip().strip('"')

    if text.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:
        return ""

    # Remove Excel / pandas numeric artifact.
    text = re.sub(
        r"\.0$",
        "",
        text
    )

    # IMPORTANT:
    # For digit-only IDs, remove leading zero padding by integer
    # normalization.
    if re.fullmatch(
        r"\d+",
        text
    ):

        try:
            return str(
                int(text)
            )
        except Exception:
            pass

    # Keep nonnumeric identifiers unchanged.
    return text.upper()


