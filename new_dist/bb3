    boundary_key_test.loc[
        boundary_key_test[
            "NENA_ID_CANON"
        ].ne("")
    ]

    .groupby(
        "NENA_ID_CANON",
        dropna=False
    )

    .agg(

        RAW_NENA_COUNT=(
            "NENA_ID_RAW",
            "nunique"
        ),

        AGENCY_COUNT=(
            "AGENCY_CLEAN",
            "nunique"
        ),

        FCC_COUNT=(
            "FCC_ID_CANON",
            "nunique"
        ),

        RAW_NENA_IDS=(
            "NENA_ID_RAW",
            lambda s:
                " | ".join(
                    sorted(
                        {
                            str(x)
                            for x in s
                            if pd.notna(x)
                        }
                    )
                )
        ),

        AGENCIES=(
            "AGENCY_CLEAN",
            lambda s:
                " | ".join(
                    sorted(
                        {
                            str(x).strip()
                            for x in s
                            if str(x).strip()
                        }
                    )
                )[:1500]
        ),

        FCC_IDS=(
            "FCC_ID_CANON",
            lambda s:
                " | ".join(
                    sorted(
                        {
