




# =============================================================
# ECGI -> CSSNG CELL LOCATION
# SAFE NA-HANDLING VERSION
# =============================================================

chunk[
    "SETUP_ECGI_USED"
] = (
    chunk[
        str(
            G_ECGI
        ).upper()
    ]
)


chunk[
    "_ECGI_KEY"
] = (
    chunk[
        "SETUP_ECGI_USED"
    ]
    .map(
        canonical_ecgi
    )
)


chunk = chunk.merge(

    cssng_lookup,

    on="_ECGI_KEY",

    how="left",

    validate="many_to_one"
)


# =============================================================
# CSSNG COORDINATES
# =============================================================

cssng_lat = pd.to_numeric(

    chunk[
        "CSSNG_TOWER_LATITUDE"
    ],

    errors="coerce"
)


cssng_lon = pd.to_numeric(

    chunk[
        "CSSNG_TOWER_LONGITUDE"
    ],

    errors="coerce"
)


cssng_valid = (

    cssng_lat.notna()

    &

    cssng_lon.notna()

    &

    cssng_lat.between(
        -90,
        90
    )

    &

    cssng_lon.between(
        -180,
        180
    )

    &

    ~(
        cssng_lat.abs().lt(
            1e-10
        )

        &

        cssng_lon.abs().lt(
            1e-10
        )
    )
)


# Critical fix:
# guarantee pure True / False; never pd.NA
cssng_valid = (

    cssng_valid

    .fillna(
        False
    )

    .astype(
        bool
    )
)


# =============================================================
# FALLBACK GMLC CELL COORDINATES
# =============================================================

if (
    G_CELL_LAT is not None
    and
    G_CELL_LON is not None
):

    fallback_lat = pd.to_numeric(

        chunk[
            str(
                G_CELL_LAT
            ).upper()
        ],

        errors="coerce"
    )


    fallback_lon = pd.to_numeric(

        chunk[
            str(
                G_CELL_LON
            ).upper()
        ],

        errors="coerce"
    )


    fallback_valid = (

        fallback_lat.notna()

        &

        fallback_lon.notna()

        &

        fallback_lat.between(
            -90,
            90
        )

        &

        fallback_lon.between(
            -180,
            180
        )

        &

        ~(
            fallback_lat.abs().lt(
                1e-10
            )

            &

            fallback_lon.abs().lt(
                1e-10
            )
        )
    )


    fallback_valid = (

        fallback_valid

        .fillna(
            False
        )

        .astype(
            bool
        )
    )


else:

    fallback_lat = pd.Series(

        np.nan,

        index=chunk.index,

        dtype=float
    )


    fallback_lon = pd.Series(

        np.nan,

        index=chunk.index,

        dtype=float
    )


    fallback_valid = pd.Series(

        False,

        index=chunk.index,

        dtype=bool
    )


# =============================================================
# CHOOSE CELL LOCATION
#
# Priority:
#   1. CSSNG_DATA_ADDITION
#   2. GMLC cell-coordinate fallback
#   3. Missing
# =============================================================

cssng_mask = cssng_valid.to_numpy(
    dtype=bool
)


fallback_mask = fallback_valid.to_numpy(
    dtype=bool
)


chunk[
    "CELL_LATITUDE_USED"
] = np.where(

    cssng_mask,

    cssng_lat.to_numpy(
        dtype=float,
        na_value=np.nan
    ),

    fallback_lat.to_numpy(
        dtype=float,
        na_value=np.nan
    )
)


chunk[
    "CELL_LONGITUDE_USED"
] = np.where(

    cssng_mask,

    cssng_lon.to_numpy(
        dtype=float,
        na_value=np.nan
    ),

    fallback_lon.to_numpy(
        dtype=float,
        na_value=np.nan
    )
)


chunk[
    "CELL_LOCATION_SOURCE"
] = np.select(

    [
        cssng_mask,

        ~cssng_mask
        &
        fallback_mask
    ],

    [
        "CSSNG_DATA_ADDITION",

        "GMLC_CELL_FALLBACK"
    ],

    default=
        "MISSING"
)




































