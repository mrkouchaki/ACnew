    data=expected_geojson,

    style_function=lambda feature: {

        "color":
            "#228b22",

        "weight":
            2,

        "fillColor":
            "#228b22",

        "fillOpacity":
            0.03
    },

    tooltip=folium.GeoJsonTooltip(

        fields=[
            "_FCC",
            "_NAME"
        ],

        aliases=[
            "Expected PSAP ID:",
            "Expected PSAP:"
        ],

        sticky=False
    )

).add_to(
    expected_layer
)


# =====================================================================
# 13. MIN / MEAN / MAX
# =====================================================================

for fcc in routed_ids:

    geom = boundary_by_fcc.get(
        fcc
    )

    stat = stats_lookup.get(
        fcc
    )


    if (
        geom is None
        or
        stat is None
    ):
        continue


    try:

        p = (
            geom
            .representative_point()
        )

        lat = float(
            p.y
        )

        lon = float(
            p.x
        )

    except Exception:

        continue


    if not valid_point(
        lat,
        lon
    ):
        continue


    name = boundary_name_by_fcc.get(
        fcc,
        ""
    )


    # MIN
    popup = f"""
    <b>MIN — SAME ROUTED PSAP</b><br>
    PSAP: {escape(str(name))}<br>
    ID: {escape(str(fcc))}<br>
    Calls: {fmt(stat.get("CALLS"),0)}<br><br>
    Caller → Routed:
    <b>{fmt(stat.get("CALLER_MIN_KM"))} km</b><br>
    Cell → Routed:
    <b>{fmt(stat.get("CELL_MIN_KM"))} km</b>
    """


    folium.CircleMarker(

        [
            lat,
            lon
        ],

        radius=6,

        color="green",

        fill=True,

        fill_opacity=0.9,

        popup=popup,

        tooltip="MIN"

    ).add_to(
        min_layer
    )


    # MEAN
    popup = f"""
    <b>MEAN — SAME ROUTED PSAP</b><br>
    PSAP: {escape(str(name))}<br>
    ID: {escape(str(fcc))}<br>
    Calls: {fmt(stat.get("CALLS"),0)}<br><br>
    Caller → Routed:
    <b>{fmt(stat.get("CALLER_MEAN_KM"))} km</b><br>
    Cell → Routed:
    <b>{fmt(stat.get("CELL_MEAN_KM"))} km</b>
    """


    folium.CircleMarker(

        [
            lat,
            lon
        ],

        radius=6,

        color="orange",

        fill=True,

        fill_opacity=0.9,

        popup=popup,

        tooltip="MEAN"

    ).add_to(
        mean_layer
    )


    # MAX
    popup = f"""
    <b>MAX — SAME ROUTED PSAP</b><br>
    PSAP: {escape(str(name))}<br>
    ID: {escape(str(fcc))}<br>
    Calls: {fmt(stat.get("CALLS"),0)}<br><br>
    Caller → Routed:
    <b>{fmt(stat.get("CALLER_MAX_KM"))} km</b><br>
    Cell → Routed:
    <b>{fmt(stat.get("CELL_MAX_KM"))} km</b>
    """


    folium.CircleMarker(

        [
            lat,
            lon
        ],

        radius=6,

        color="red",

        fill=True,

        fill_opacity=0.9,

        popup=popup,

        tooltip="MAX"

    ).add_to(
        max_layer
    )


# =====================================================================
# 14. DRAW CALLS
# =====================================================================

skipped_cell_points = 0
skipped_lines = 0


for _, row in map_calls.iterrows():

    caller_lat = number(
        row[
            "_CALLER_LAT"
        ]
    )

    caller_lon = number(
        row[
            "_CALLER_LON"
        ]
    )

    cell_lat = number(
        row[
            "_CELL_LAT"
        ]
    )

    cell_lon = number(
        row[
            "_CELL_LON"
        ]
    )


    routed_id = norm_id(
        row[
            "_ROUTED_ID"
        ]
    )

    expected_id = norm_id(
        row[
            "_EXPECTED_ID"
        ]
    )


    call_id = (
        txt(
            row.get(
                CALL_ID_COL,
                ""
            )
        )
        if CALL_ID_COL
        else ""
    )


    duration = (
        number(
            row.get(
                DURATION_COL,
                np.nan
            )
        )
        if DURATION_COL
        else np.nan
    )


    routed_name = (

        txt(
            row.get(
                ROUTED_NAME_COL,
                ""
            )
        )

        if ROUTED_NAME_COL

        else boundary_name_by_fcc.get(
            routed_id,
            ""
        )
    )


    expected_name = (

        txt(
            row.get(
                EXPECTED_NAME_COL,
                ""
            )
        )

        if EXPECTED_NAME_COL

        else boundary_name_by_fcc.get(
            expected_id,
            ""
        )
    )


    status = (

        txt(
            row.get(
                EXPECTED_STATUS_COL,
                ""
            )
        )

        if EXPECTED_STATUS_COL

        else (
            "SAME"
            if (
                expected_id
                and
                expected_id == routed_id
            )
            else "DIFFERENT"
        )
    )


    stats = stats_lookup.get(
        routed_id,
        {}
    )


    # -------------------------------------------------------------
    # CALLER POINT
    # -------------------------------------------------------------

    if valid_point(
        caller_lat,
        caller_lon
    ):

        popup = f"""
        <b>CALL</b><br>
        Call ID:
        {escape(str(call_id))}<br>

        Duration:
        <b>{fmt(duration,1)} sec</b><br><br>

        <b>ROUTED PSAP</b><br>
        ID:
        {escape(str(routed_id))}<br>

        Name:
        <b>{escape(str(routed_name))}</b><br><br>

        <b>CALLER EXPECTED PSAP</b><br>
        ID:
        {escape(str(expected_id))}<br>

        Name:
        <b>{escape(str(expected_name))}</b><br>

        Expected vs Routed:
        <b>{escape(str(status))}</b><br><br>

        <b>DISTANCES</b><br>

        Caller → Routed:
        <b>{fmt(row["_CALLER_ROUTED_KM"])} km</b><br>

        Caller → Expected:
        <b>{fmt(row["_CALLER_EXPECTED_KM"])} km</b><br>

        Cell → Routed:
        <b>{fmt(row["_CELL_ROUTED_KM"])} km</b><br>

        Caller ↔ Cell:
        <b>{fmt(row["_CALLER_CELL_KM"])} km</b><br><br>

        <b>SAME ROUTED PSAP STATS</b><br>

        Caller Min / Mean / Max:
        {fmt(stats.get("CALLER_MIN_KM"))} /
        {fmt(stats.get("CALLER_MEAN_KM"))} /
        {fmt(stats.get("CALLER_MAX_KM"))} km<br>

        Cell Min / Mean / Max:
        {fmt(stats.get("CELL_MIN_KM"))} /
        {fmt(stats.get("CELL_MEAN_KM"))} /
        {fmt(stats.get("CELL_MAX_KM"))} km
        """


        folium.CircleMarker(

            [
                caller_lat,
                caller_lon
            ],

            radius=5,

            color="blue",

            fill=True,

            fill_color="blue",

            fill_opacity=0.9,

            tooltip=(
                f"Caller | "
                f"{escape(str(call_id))}"
            ),

            popup=folium.Popup(
                popup,
                max_width=500
            )

        ).add_to(
            caller_layer
        )


        # Uncertainty
        if UNCERTAINTY_COL:

            uncertainty = number(
                row.get(
                    UNCERTAINTY_COL,
                    np.nan
                )
            )


            if (
                np.isfinite(
                    uncertainty
                )
                and
                0 <
                uncertainty
                <= 100000
            ):

                folium.Circle(

                    [
                        caller_lat,
                        caller_lon
                    ],

                    radius=uncertainty,

                    weight=1,

                    fill=True,

                    fill_opacity=0.04,

                    tooltip=(
                        f"Uncertainty "
                        f"{fmt(uncertainty,1)} m"
                    )

                ).add_to(
                    uncertainty_layer
                )


    # -------------------------------------------------------------
    # CELL POINT
    # -------------------------------------------------------------

    if valid_point(
        cell_lat,
        cell_lon
    ):

        cell_popup = f"""
        <b>CELL LOCATION</b><br>
        Call ID:
        {escape(str(call_id))}<br>

        Duration:
        {fmt(duration,1)} sec<br><br>

        Lat:
        {fmt(cell_lat,6)}<br>

        Lon:
        {fmt(cell_lon,6)}<br><br>

        Cell → Routed:
        <b>{fmt(row["_CELL_ROUTED_KM"])} km</b><br>

        Caller ↔ Cell:
        <b>{fmt(row["_CALLER_CELL_KM"])} km</b>
        """


        folium.CircleMarker(

            [
                cell_lat,
                cell_lon
            ],

            radius=5,

            color="green",

            fill=True,

            fill_color="green",

            fill_opacity=0.9,

            tooltip=(
                f"Cell | "
                f"{escape(str(call_id))}"
            ),

            popup=folium.Popup(
                cell_popup,
                max_width=400
            )

        ).add_to(
            cell_layer
        )


    else:

        skipped_cell_points += 1


    # -------------------------------------------------------------
    # CALLER -> ROUTED
    # -------------------------------------------------------------

    routed_geom = boundary_by_fcc.get(
        routed_id
    )


    if (
        routed_geom is not None
        and
        valid_point(
            caller_lat,
            caller_lon
        )
    ):

        near_lat, near_lon, d = (
            nearest_boundary(
                caller_lat,
                caller_lon,
                routed_geom
            )
        )


        if valid_point(
            near_lat,
            near_lon
        ):

            folium.PolyLine(

                [
                    [
                        caller_lat,
                        caller_lon
                    ],

                    [
                        near_lat,
                        near_lon
                    ]
                ],

                color="red",

                weight=2,

                tooltip=(
                    "Caller → Routed | "
                    f"{fmt(d)} km"
                )

            ).add_to(
                caller_routed_layer
            )


        else:

            skipped_lines += 1


    # -------------------------------------------------------------
    # CALLER -> EXPECTED
    # -------------------------------------------------------------

    expected_geom = (
        boundary_by_fcc.get(
            expected_id
        )
        if (
            expected_id
            and
            "|" not in expected_id
        )
        else None
    )


    if (
        expected_geom is not None
        and
        valid_point(
            caller_lat,
            caller_lon
        )
    ):

        near_lat, near_lon, d = (
            nearest_boundary(
                caller_lat,
                caller_lon,
                expected_geom
            )
        )


        if valid_point(
            near_lat,
            near_lon
        ):

            folium.PolyLine(

                [
                    [
                        caller_lat,
                        caller_lon
                    ],

                    [
                        near_lat,
                        near_lon
                    ]
                ],

                color="darkgreen",

                weight=2,

                dash_array="6,6",

                tooltip=(
                    "Caller → Expected | "
                    f"{fmt(d)} km"
                )

            ).add_to(
                caller_expected_layer
            )


    # -------------------------------------------------------------
    # CELL -> ROUTED
    # -------------------------------------------------------------

    if (
        routed_geom is not None
        and
        valid_point(
            cell_lat,
            cell_lon
        )
    ):

        near_lat, near_lon, d = (
            nearest_boundary(
                cell_lat,
                cell_lon,
                routed_geom
            )
        )


        if valid_point(
            near_lat,
            near_lon
        ):

            folium.PolyLine(

                [
                    [
                        cell_lat,
                        cell_lon
                    ],

                    [
                        near_lat,
                        near_lon
                    ]
                ],

                color="green",

                weight=2,

                dash_array="5,5",

                tooltip=(
                    "Cell → Routed | "
                    f"{fmt(d)} km"
                )

            ).add_to(
                cell_routed_layer
            )


    # -------------------------------------------------------------
    # CALLER <-> CELL
    # -------------------------------------------------------------

    if (
        valid_point(
            caller_lat,
            caller_lon
        )
        and
        valid_point(
            cell_lat,
            cell_lon
        )
    ):

        folium.PolyLine(

            [
                [
                    caller_lat,
                    caller_lon
                ],

                [
                    cell_lat,
                    cell_lon
                ]
            ],

            color="blue",

            weight=2,

            opacity=0.6,

            dash_array="8,6",

            tooltip=(
                "Caller ↔ Cell | "
                f"{fmt(row['_CALLER_CELL_KM'])} km"
            )

        ).add_to(
            caller_cell_layer
        )


# =====================================================================
# 15. ADD LAYERS
# =====================================================================

for layer in [

    routed_layer,
    expected_layer,

    uncertainty_layer,

    caller_routed_layer,
    caller_expected_layer,
    cell_routed_layer,
    caller_cell_layer,

    caller_layer,
    cell_layer,

    min_layer,
    mean_layer,
    max_layer
]:

    layer.add_to(
        psap_map
    )


folium.LayerControl(
    collapsed=False
).add_to(
    psap_map
)


# =====================================================================
# 16. FIT CALLER POINTS ONLY
# =====================================================================

caller_fit = [

    [
        float(lat),
        float(lon)
    ]

    for lat, lon
    in zip(
        map_calls[
            "_CALLER_LAT"
        ],
        map_calls[
            "_CALLER_LON"
        ]
    )

    if valid_point(
        lat,
        lon
    )
]


if len(
    caller_fit
) > 1:

    psap_map.fit_bounds(
        caller_fit
    )


# =====================================================================
# 17. RENDER / VALIDATE HTML
# =====================================================================

html_text = (
    psap_map
    .get_root()
    .render()
)


OUTPUT_HTML.write_text(
    html_text,
    encoding="utf-8"
)


print(
    "\nSaved:",
    OUTPUT_HTML
)

print(
    "HTML size:",
    f"{len(html_text) / 1_000_000:.2f} MB"
)

print(
    "Map children:",
    len(
        psap_map._children
    )
)

print(
    "Skipped invalid cell points:",
    skipped_cell_points
)

print(
    "Skipped invalid boundary lines:",
    skipped_lines
)

print(
    "Contains Leaflet map creation:",
    "L.map(" in html_text
)

print(
    "Contains NaN token:",
    "NaN" in html_text
)

print(
    "Contains Infinity token:",
    "Infinity" in html_text
)


# =====================================================================
# 18. DISPLAY
# =====================================================================

display(
    Markdown(
        "### Caller + Cell PSAP cross-check"
    )
)


display(
    psap_map
)