GEOD = Geod(ellps="WGS84")


def norm_id(v):

    if v is None or pd.isna(v):
        return ""

    s = str(v).strip().strip('"')

    if s.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:
        return ""

    return re.sub(
        r"\.0$",
        "",
        s
    )


def txt(v):

    if v is None or pd.isna(v):
        return ""

    return str(v).strip()


def number(v):

    x = pd.to_numeric(
        v,
        errors="coerce"
    )

    if pd.isna(x):
        return np.nan

    try:
        x = float(x)
    except Exception:
        return np.nan

    if not math.isfinite(x):
        return np.nan

    return x


def fmt(v, digits=2):

    x = number(v)

    if not np.isfinite(x):
        return "N/A"

    return f"{x:,.{digits}f}"


def valid_point(lat, lon):

    lat = number(lat)
    lon = number(lon)

    if (
        not np.isfinite(lat)
        or
        not np.isfinite(lon)
    ):
        return False

    if not (
        -90 <= lat <= 90
        and
        -180 <= lon <= 180
    ):
        return False

    # reject missing placeholder
    if (
        abs(lat) < 1e-10
        and
        abs(lon) < 1e-10
    ):
        return False

    return True


def find_col(
    frame,
    candidates,
    required=False
):

    for c in candidates:

        if c in frame.columns:
            return c

    if required:
        raise RuntimeError(
            "Missing required column.\nTried:\n"
            + "\n".join(candidates)
        )

    return None


def distance_series_km(
    frame,
    km_candidates,
    m_candidates
):

    km_col = find_col(
        frame,
        km_candidates
    )

    if km_col:

        x = pd.to_numeric(
            frame[km_col],
            errors="coerce"
        )

        return x.replace(
            [np.inf, -np.inf],
            np.nan
        )


    m_col = find_col(
        frame,
        m_candidates
    )

    if m_col:

        x = (
            pd.to_numeric(
                frame[m_col],
                errors="coerce"
            )
            / 1000.0
        )

        return x.replace(
            [np.inf, -np.inf],
            np.nan
        )


    return pd.Series(
        np.nan,
        index=frame.index,
        dtype=float
    )


def clean_geometry(g):

    if (
        g is None
        or g.is_empty
    ):
        return None

    try:

        if not g.is_valid:
            g = g.buffer(0)

        if (
            g is None
            or g.is_empty
            or not g.is_valid
        ):
            return None


        b = g.bounds

        if (
            len(b) != 4
            or
            not all(
                math.isfinite(float(x))
                for x in b
            )
        ):
            return None


        # geographic sanity
        minx, miny, maxx, maxy = b

        if (
            minx < -180
            or maxx > 180
            or miny < -90
            or maxy > 90
        ):
            return None


        return g

    except Exception:

        return None


def nearest_boundary(
    lat,
    lon,
    geom
):

    if (
        geom is None
        or
        not valid_point(lat, lon)
    ):
        return (
            np.nan,
            np.nan,
            np.nan
        )


    lat = float(lat)
    lon = float(lon)

    p = Point(
        lon,
        lat
    )


    try:

        _, near = nearest_points(
            p,
            geom.boundary
        )


        near_lat = float(
            near.y
        )

        near_lon = float(
            near.x
        )


        if not valid_point(
            near_lat,
            near_lon
        ):
            return (
                np.nan,
                np.nan,
                np.nan
            )


        _, _, d_m = GEOD.inv(
            lon,
            lat,
            near_lon,
            near_lat
        )


        d_km = abs(
            float(d_m)
        ) / 1000.0


        if not math.isfinite(
            d_km
        ):
            return (
                np.nan,
                np.nan,
                np.nan
            )


        return (
            near_lat,
            near_lon,
            d_km
        )


    except Exception:

        return (
            np.nan,
            np.nan,
            np.nan
        )


