def norm_id(value):

    if value is None or pd.isna(value):
        return ""

    value = (
        str(value)
        .strip()
        .strip('"')
        .upper()
    )

    return re.sub(
        r"\.0$",
        "",
        value
    )


def clean_text(value):

    if value is None or pd.isna(value):
        return ""

    return str(value).strip()


def numeric(series):

    return pd.to_numeric(
        series,
        errors="coerce"
    )


def valid_latlon(
    lat,
    lon
):

    return (
        pd.notna(lat)
        and pd.notna(lon)
        and -90 <= float(lat) <= 90
        and -180 <= float(lon) <= 180
    )


