def tree_positions(
    geometry
):

    hits = tree.query(
        geometry
    )

    output = []


    for hit in hits:

        if isinstance(
            hit,
            (int, np.integer)
        ):

            output.append(
                int(hit)
            )

        else:

            position = (
                geom_position.get(
                    id(hit)
                )
            )


            if position is not None:

                output.append(
                    position
                )


    return output


def distance_to_boundary_m(
    lat,
    lon,
    geometry
):

    if (
        geometry is None
        or
        not valid_latlon(
            lat,
            lon
        )
    ):

        return np.nan


    point = Point(
        float(lon),
        float(lat)
    )


    try:

        _, nearest = nearest_points(
            point,
            geometry.boundary
        )


        _, _, distance = geod.inv(

            float(lon),
            float(lat),

            nearest.x,
            nearest.y
        )


        return abs(
            float(distance)
        )


    except Exception:

        return np.nan


def expected_vs_routed_status(
    expected_id,
    routed_id,
    routed_boundary_distance
):

    expected_id = norm_id(
        expected_id
    )

    routed_id = norm_id(
        routed_id
    )


    if (
        expected_id
        and routed_id
        and
        expected_id == routed_id
    ):

        return "SAME"


    distance = pd.to_numeric(
        routed_boundary_distance,
        errors="coerce"
    )


    if (
        expected_id
        and routed_id
        and
        pd.notna(distance)
        and
        distance <= CLOSE_BOUNDARY_M
    ):

        return "CLOSE"


    return "DIFFERENT"


def analyze_point(
    lat_value,
    lon_value,
    routed_value
):

    lat = pd.to_numeric(
        lat_value,
        errors="coerce"
    )

    lon = pd.to_numeric(
        lon_value,
        errors="coerce"
    )

    routed_id = norm_id(
        routed_value
    )


    if not valid_latlon(
        lat,
        lon
    ):

        return {

            "EXPECTED_PSAP_ID":
                "",

            "EXPECTED_PSAP_NAME":
                "",

            "EXPECTED_PSAP_GEOMETRY_STATUS":
                "INVALID_OR_MISSING",

            "EXPECTED_VS_ROUTED_PSAP":
                "DIFFERENT",

            "RELATION_TO_ROUTED_PSAP":
                "INVALID_OR_MISSING",

            "DISTANCE_TO_ROUTED_PSAP_BOUNDARY_M":
                np.nan,

            "SIGNED_DISTANCE_TO_ROUTED_PSAP_BOUNDARY_M":
                np.nan,

            "DISTANCE_TO_EXPECTED_PSAP_BOUNDARY_M":
                np.nan,
        }


    lat = float(
        lat
    )

    lon = float(
        lon
    )


    point = Point(
        lon,
        lat
    )


    # -------------------------------------------------------------
    # Determine polygon(s) containing this coordinate.
    # -------------------------------------------------------------

    inside_ids = sorted(
        set(
            boundary_fcc[
                position
            ]

            for position
            in tree_positions(
                point
            )

            if boundary_geometries[
                position
            ].covers(
                point
            )
        )
    )


    if len(
        inside_ids
    ) == 1:

        expected_geometry_status = (
            "UNIQUE_PSAP"
        )

        expected_id = (
            inside_ids[0]
        )

        expected_name = (
            psap_name_map.get(
                expected_id,
                ""
            )
        )


    elif len(
        inside_ids
    ) == 0:

        expected_geometry_status = (
            "NO_CONTAINING_PSAP"
        )

        expected_id = ""

        expected_name = ""


    else:

        expected_geometry_status = (
            "MULTIPLE_PSAP"
        )

        expected_id = "|".join(
            inside_ids
        )

        expected_name = "|".join(
            [
                psap_name_map.get(
                    x,
                    ""
                )
                for x in inside_ids
            ]
        )


    # -------------------------------------------------------------
    # Routed PSAP geometry.
    # -------------------------------------------------------------

    routed_geometry = (
        boundary_by_fcc.get(
            routed_id
        )
    )


    if routed_geometry is None:

        relation = (
            "MISSING_ROUTED_BOUNDARY"
        )

        routed_distance = np.nan

        signed_distance = np.nan


    else:

        routed_distance = (
            distance_to_boundary_m(
                lat,
                lon,
                routed_geometry
            )
        )


        # Exact boundary check first.
        try:

            on_boundary = (
                routed_geometry
                .boundary
                .distance(
                    point
                )
                <= 1e-12
            )

        except Exception:

            on_boundary = False


        if on_boundary:

            relation = "BOUNDARY"

            signed_distance = 0.0


        elif routed_geometry.covers(
            point
        ):

            relation = "INSIDE"

            signed_distance = (
                -routed_distance
            )


        else:

            relation = "OUTSIDE"

            signed_distance = (
                routed_distance
            )


    # -------------------------------------------------------------
    # Distance to coordinate-derived expected PSAP boundary.
    # Only meaningful when exactly one expected PSAP exists.
    # -------------------------------------------------------------

    expected_distance = np.nan


    if len(
        inside_ids
    ) == 1:

        expected_geometry = (
            boundary_by_fcc.get(
                expected_id
            )
        )


        expected_distance = (
            distance_to_boundary_m(
                lat,
                lon,
                expected_geometry
            )
        )


    status = (
        expected_vs_routed_status(
            expected_id,
            routed_id,
            routed_distance
        )
    )


    return {

        "EXPECTED_PSAP_ID":
            expected_id,

        "EXPECTED_PSAP_NAME":
            expected_name,

        "EXPECTED_PSAP_GEOMETRY_STATUS":
            expected_geometry_status,

