def coordinate_pattern(
    row
):

    caller_status = (
        row[
            "CALLER_EXPECTED_VS_ROUTED_PSAP"
        ]
    )

    cell_status = (
        row[
            "CELL_EXPECTED_VS_ROUTED_PSAP"
        ]
    )

    esposreq_status = (
        row[
            "ESPOSREQ_EXPECTED_VS_ROUTED_PSAP"
        ]
    )


    if (
        caller_status == "SAME"
        and
        cell_status == "SAME"
        and
        esposreq_status == "SAME"
    ):

        return (
            "ALL_3_SUPPORT_ROUTED_PSAP"
        )


    if (
        caller_status == "DIFFERENT"
        and
        cell_status == "SAME"
        and
        esposreq_status == "SAME"
    ):

        return (
            "CALLER_DIFFERS_CELL_ESPOSREQ_SUPPORT_ROUTED"
        )


    if (
        caller_status == "SAME"
        and
        cell_status == "DIFFERENT"
        and
        esposreq_status == "SAME"
    ):

        return (
            "CELL_DIFFERS_CALLER_ESPOSREQ_SUPPORT_ROUTED"
        )


    if (
        caller_status == "SAME"
        and
        cell_status == "SAME"
        and
        esposreq_status == "DIFFERENT"
    ):

        return (
            "ESPOSREQ_DIFFERS_CALLER_CELL_SUPPORT_ROUTED"
        )


    if (
        caller_status == "DIFFERENT"
        and
        cell_status == "DIFFERENT"
        and
        esposreq_status == "DIFFERENT"
    ):

        return (
            "NONE_SUPPORT_ROUTED_PSAP"
        )


    if "CLOSE" in {
        caller_status,
        cell_status,
        esposreq_status
    }:

        return (
            "NEAR_BOUNDARY_OR_MIXED"
        )


    return (
        "MIXED_COORDINATE_EVIDENCE"
    )


