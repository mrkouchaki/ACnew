def repair_geometry(
    geometry
):

    if (
        geometry is None
        or geometry.is_empty
    ):
        return None


    try:

        if not geometry.is_valid:

            geometry = (
                geometry.buffer(0)
            )


        if (
            geometry.is_empty
            or
            not geometry.is_valid
        ):
            return None


        return geometry


    except Exception:

        return None


