        """


        folium.CircleMarker(

            [
                float(
                    esposreq_lat
                ),
                float(
                    esposreq_lon
                )
            ],

            radius=5,

            color="orange",

            fill=True,

            fill_opacity=0.9,

            tooltip=(
                f"ESPOSREQ | "
                f"{call_id}"
            ),

            popup=folium.Popup(
                esposreq_popup,
                max_width=400
            )

        ).add_to(
            esposreq_cluster
        )


    # =============================================================
    # ROUTED PSAP GEOMETRY
    # =============================================================

    routed_geom = psap_geometry.get(
        routed_id
    )


    # =============================================================
    # CALLER -> ROUTED BOUNDARY
    # =============================================================

    if (
        routed_geom is not None
        and
        map_valid_point(
            caller_lat,
            caller_lon
        )
    ):

        (
            near_lat,
            near_lon,
            recalculated_km
        ) = nearest_boundary_location(

            caller_lat,
            caller_lon,
            routed_geom
        )


        if map_valid_point(
            near_lat,
            near_lon,
            allow_zero_zero=True
        ):

            folium.PolyLine(

                [
                    [
                        float(
                            caller_lat
                        ),
                        float(
                            caller_lon
                        )
                    ],

                    [
                        float(
                            near_lat
                        ),
                        float(
                            near_lon
                        )
                    ]
                ],

                weight=2,

                color="red",

                tooltip=(
                    "Caller → Routed boundary | "
                    f"CSV "
                    f"{fmt_num(row['_CALLER_ROUTED_KM'])} km | "
                    f"recalc "
                    f"{fmt_num(recalculated_km)} km"
                )

            ).add_to(
                caller_routed_layer
            )


            folium.CircleMarker(

                [
                    float(
                        near_lat
                    ),
                    float(
                        near_lon
                    )
                ],

                radius=2,

                color="red",

                fill=True,

                tooltip=(
                    "Nearest routed boundary point"
                )

            ).add_to(
                nearest_boundary_layer
            )


    # =============================================================
    # CELL -> ROUTED BOUNDARY
    # =============================================================

    if (
        routed_geom is not None
        and
        map_valid_point(
            cell_lat,
            cell_lon
        )
    ):

        (
            near_lat,
            near_lon,
            recalculated_km
        ) = nearest_boundary_location(

            cell_lat,
            cell_lon,
            routed_geom
        )


        if map_valid_point(
            near_lat,
            near_lon,
            allow_zero_zero=True
        ):

            folium.PolyLine(

                [
                    [
                        float(
                            cell_lat
                        ),
                        float(
                            cell_lon
                        )
                    ],

                    [
                        float(
                            near_lat
                        ),
                        float(
                            near_lon
                        )
                    ]
                ],

                weight=2,

                color="green",

                dash_array="5,5",

                tooltip=(
                    "Cell → Routed boundary | "
                    f"{fmt_num(row['_CELL_ROUTED_KM'])} km"
                )

            ).add_to(
                cell_routed_layer
            )


    # =============================================================
    # ESPOSREQ -> ROUTED BOUNDARY
    # =============================================================

    if (
        routed_geom is not None
        and
        map_valid_point(
            esposreq_lat,
            esposreq_lon
        )
    ):

        (
            near_lat,
            near_lon,
            recalculated_km
        ) = nearest_boundary_location(

            esposreq_lat,
            esposreq_lon,
            routed_geom
        )


        if map_valid_point(
            near_lat,
            near_lon,
            allow_zero_zero=True
        ):

            folium.PolyLine(

                [
                    [
                        float(
                            esposreq_lat
                        ),
                        float(
                            esposreq_lon
                        )
                    ],

                    [
                        float(
                            near_lat
                        ),
                        float(
                            near_lon
                        )
                    ]
                ],

                weight=2,

                color="orange",

                dash_array="5,5",

                tooltip=(
                    "ESPOSREQ → Routed boundary | "
                    f"{fmt_num(row['_ESPOSREQ_ROUTED_KM'])} km"
                )

            ).add_to(
                esposreq_routed_layer
            )


    # =============================================================
    # SELECTED EXPECTED SOURCE -> EXPECTED BOUNDARY
    # =============================================================

    expected_geom = (

        psap_geometry.get(
            expected_id
        )

        if (
            expected_id
            and
            "|" not in expected_id
        )

        else None
    )


    expected_lat = row[
        "_EXPECTED_SOURCE_LAT"
    ]

    expected_lon = row[
        "_EXPECTED_SOURCE_LON"
    ]


    if (
        expected_geom is not None
        and
        map_valid_point(
            expected_lat,
            expected_lon
        )
    ):

        (
            near_lat,
            near_lon,
            recalculated_km
        ) = nearest_boundary_location(

            expected_lat,
            expected_lon,
            expected_geom
        )


        if map_valid_point(
            near_lat,
            near_lon,
            allow_zero_zero=True
        ):

            folium.PolyLine(

                [
                    [
                        float(
                            expected_lat
                        ),
                        float(
                            expected_lon
                        )
                    ],

                    [
                        float(
                            near_lat
                        ),
                        float(
                            near_lon
                        )
                    ]
                ],

                weight=2,

                color="darkgreen",

                dash_array="7,5",

                tooltip=(
                    f"{EXPECTED_SOURCE} → Expected boundary | "
                    f"CSV "
                    f"{fmt_num(row['_EXPECTED_BOUNDARY_KM'])} km | "
                    f"recalc "
                    f"{fmt_num(recalculated_km)} km"
                )

            ).add_to(
                expected_distance_layer
            )


    # =============================================================
    # CALLER -> CELL
    # =============================================================

    if (
        map_valid_point(
            caller_lat,
            caller_lon
        )
        and
        map_valid_point(
            cell_lat,
            cell_lon
        )
    ):

        folium.PolyLine(

            [
                [
                    float(
                        caller_lat
                    ),
                    float(
                        caller_lon
                    )
                ],

                [
                    float(
                        cell_lat
                    ),
                    float(
                        cell_lon
                    )
                ]
            ],

            weight=2,

            color="blue",

            opacity=0.65,

            dash_array="7,6",

            tooltip=(
                f"Caller ↔ Cell: "
                f"{fmt_num(row['_CALLER_CELL_KM'])} km"
            )

        ).add_to(
            caller_cell_layer
        )


# =====================================================================
# 18. ADD ALL LAYERS
# =====================================================================

for layer in [

    routed_layer,
    expected_layer,

    uncertainty_layer,

    caller_routed_layer,
    cell_routed_layer,
    esposreq_routed_layer,

    expected_distance_layer,
    caller_cell_layer,

    nearest_boundary_layer,

    caller_layer,
    cell_layer,
    esposreq_layer,

    min_layer,
    mean_layer,
    max_layer,
]:

    layer.add_to(
        psap_map
    )


folium.LayerControl(
    collapsed=False
).add_to(
    psap_map
)


# =====================================================================
# 19. FIT BOUNDS
# =====================================================================

fit_points = []


if MAP_FIT_MODE.upper() == "CALLER":

    for lat, lon in zip(

        map_df[
            "_CALLER_LAT"
        ],

        map_df[
            "_CALLER_LON"
        ]
    ):

        if map_valid_point(
            lat,
            lon
        ):

            fit_points.append(
                [
                    float(lat),
                    float(lon)
                ]
            )


elif MAP_FIT_MODE.upper() == "ALL":

    for lat_col, lon_col in [

        (
            "_CALLER_LAT",
            "_CALLER_LON"
        ),

        (
            "_CELL_LAT",
            "_CELL_LON"
        ),

        (
            "_ESPOSREQ_LAT",
            "_ESPOSREQ_LON"
        ),
    ]:

        for lat, lon in zip(

            map_df[
                lat_col
            ],

            map_df[
                lon_col
            ]
        ):

            if map_valid_point(
                lat,
                lon
            ):

                fit_points.append(
                    [
                        float(lat),
                        float(lon)
                    ]
                )


else:

    raise ValueError(
        "MAP_FIT_MODE must be 'CALLER' or 'ALL'."
    )


if fit_points:

    if len(fit_points) == 1:

        psap_map.location = (
            fit_points[0]
        )

    else:

        psap_map.fit_bounds(
            fit_points
        )


