# =====================================================================
# 12.2 ROBUST POINT CHECK
# =====================================================================

def map_valid_point(
    lat,
    lon,
    allow_zero_zero=False
):

    lat = pd.to_numeric(
        lat,
        errors="coerce"
    )

    lon = pd.to_numeric(
        lon,
        errors="coerce"
    )

    if (
        pd.isna(lat)
        or
        pd.isna(lon)
    ):
        return False

    lat = float(lat)
    lon = float(lon)

    if not (
        -90 <= lat <= 90
        and
        -180 <= lon <= 180
    ):
        return False

    # 0,0 is very commonly a missing-location placeholder.
    if (
        not allow_zero_zero
        and
        abs(lat) < 1e-10
        and
        abs(lon) < 1e-10
    ):
        return False

    return True


