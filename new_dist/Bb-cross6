        )


# =====================================================================
# 14. OUTPUT INITIALIZATION
# =====================================================================

if OUTPUT_CSV.exists():

    OUTPUT_CSV.unlink()


header_written = False


processed_rows = 0
output_rows = 0


resolution_counter = Counter()
anomaly_counter = Counter()


route_qa_counter = Counter()


# =====================================================================
# 15. PROCESS ENTIRE GMLC
# =====================================================================

for chunk_number, chunk in enumerate(

    pd.read_csv(

        GMLC_PATH,

        dtype="string",

        usecols=usecols,

        chunksize=CSV_CHUNK_ROWS,

        low_memory=False,

        encoding_errors="replace"
    ),

    start=1
):

    chunk.columns = [
        str(c).strip().upper()
        for c in chunk.columns
    ]


    chunk[
        "SOURCE_GMLC_ROW_ID"
    ] = np.arange(

        processed_rows + 1,

        processed_rows
        + len(chunk)
        + 1,

        dtype=np.int64
    )


    processed_rows += len(
        chunk
    )


    # =============================================================
    # GMLC ID VALUES
    # =============================================================

    chunk[
        "GMLC_NENA_ID"
    ] = (

        chunk[
            str(
                G_NENA
            ).upper()
        ]
        .map(
            canonical_id
        )

        if G_NENA

        else ""
    )


    chunk[
        "GMLC_PSAP_ID"
    ] = (

        chunk[
            str(
                G_PSAP
            ).upper()
        ]
        .map(
            canonical_id
        )

        if G_PSAP

        else ""
    )


    chunk[
        "GMLC_FCC_PSAP_ID"
    ] = (
        chunk[
            str(
                G_FCC
            ).upper()
        ]
        .map(
            canonical_id
        )
    )


    # =============================================================
    # GMLC NAME
    # =============================================================

    if "ROUTE_PSAP_NAME" in chunk.columns:

        chunk[
            "GMLC_ROUTED_PSAP_NAME"
        ] = (
            chunk[
                "ROUTE_PSAP_NAME"
            ]
            .fillna("")
            .astype(str)
            .str.strip()
        )

    else:

        chunk[
            "GMLC_ROUTED_PSAP_NAME"
        ] = ""


    if "PSAP_NAME" in chunk.columns:

        missing = (
            chunk[
                "GMLC_ROUTED_PSAP_NAME"
            ].eq("")
        )


        chunk.loc[
            missing,
            "GMLC_ROUTED_PSAP_NAME"
        ] = (

            chunk.loc[
                missing,
                "PSAP_NAME"
            ]

            .fillna("")
            .astype(str)
            .str.strip()
        )


    # =============================================================
    # RESOLVE ROUTED BOUNDARY BY IDs
    # =============================================================

    route_keys = list(
        zip(

            chunk[
                "GMLC_NENA_ID"
            ],

            chunk[
                "GMLC_PSAP_ID"
            ],

            chunk[
                "GMLC_FCC_PSAP_ID"
            ]
        )
    )


    route_results = [

        resolve_routed_boundary(
            *key
        )

        for key
        in route_keys
    ]


    route_df = pd.DataFrame(
        route_results,
        index=chunk.index
    )


    chunk = pd.concat(
        [
            chunk,
            route_df
        ],
        axis=1
    )


    resolution_counter.update(

        chunk[
            "ROUTED_ID_RESOLUTION_METHOD"
        ]
        .value_counts(
            dropna=False
        )
        .to_dict()
    )


    # =============================================================
    # NAME QA — NOT USED TO PICK GEOMETRY
    # =============================================================

    chunk[
        "GMLC_ROUTED_NAME_VS_BOUNDARY_NAME"
    ] = [

        name_qa(
            gmlc_name,
            boundary_name
        )

        for gmlc_name, boundary_name
        in zip(

            chunk[
                "GMLC_ROUTED_PSAP_NAME"
            ],

            chunk[
                "ROUTED_BOUNDARY_PSAP_NAME"
            ]
        )
    ]


    # =============================================================
    # ECGI -> CSSNG CELL LOCATION
    # =============================================================

    chunk[
        "SETUP_ECGI_USED"
    ] = (
        chunk[
            str(
                G_ECGI
            ).upper()
        ]
    )


    chunk[
        "_ECGI_KEY"
    ] = (
        chunk[
            "SETUP_ECGI_USED"
        ]
        .map(
            canonical_ecgi
        )
    )


    chunk = chunk.merge(

        cssng_lookup,

        on="_ECGI_KEY",

        how="left",

        validate="many_to_one"
    )


    cssng_valid = (

        pd.to_numeric(
            chunk[
                "CSSNG_TOWER_LATITUDE"
            ],
            errors="coerce"
        )
        .between(
            -90,
            90
        )

        &

        pd.to_numeric(
            chunk[
                "CSSNG_TOWER_LONGITUDE"
            ],
            errors="coerce"
        )
        .between(
            -180,
            180
        )
    )


    if (
        G_CELL_LAT
        and
        G_CELL_LON
    ):

        fallback_lat = pd.to_numeric(
            chunk[
                str(
                    G_CELL_LAT
                ).upper()
            ],
            errors="coerce"
        )


        fallback_lon = pd.to_numeric(
            chunk[
                str(
                    G_CELL_LON
                ).upper()
            ],
            errors="coerce"
        )


        fallback_valid = (

            fallback_lat.between(
                -90,
                90
            )

            &

            fallback_lon.between(
                -180,
                180
            )
        )


    else:

        fallback_lat = pd.Series(
            np.nan,
            index=chunk.index
        )


        fallback_lon = pd.Series(
            np.nan,
            index=chunk.index
        )


        fallback_valid = pd.Series(
            False,
            index=chunk.index
        )


    chunk[
        "CELL_LATITUDE_USED"
    ] = np.where(

        cssng_valid,

        pd.to_numeric(
            chunk[
                "CSSNG_TOWER_LATITUDE"
            ],
            errors="coerce"
        ),

        fallback_lat
    )


    chunk[
        "CELL_LONGITUDE_USED"
    ] = np.where(

        cssng_valid,

        pd.to_numeric(
            chunk[
                "CSSNG_TOWER_LONGITUDE"
            ],
            errors="coerce"
        ),

        fallback_lon
    )


    chunk[
        "CELL_LOCATION_SOURCE"
    ] = np.select(

        [
            cssng_valid,
            fallback_valid
        ],

        [
            "CSSNG_DATA_ADDITION",
            "GMLC_CELL_FALLBACK"
        ],

        default=
            "MISSING"
    )


    # =============================================================
    # CALLER COORDINATES
    # =============================================================

    chunk[
        "CALLER_LATITUDE"
    ] = pd.to_numeric(
        chunk[
            str(
                G_CALLER_LAT
            ).upper()
        ],
        errors="coerce"
    )


    chunk[
        "CALLER_LONGITUDE"
    ] = pd.to_numeric(
        chunk[
            str(
                G_CALLER_LON
            ).upper()
        ],
        errors="coerce"
    )


    # =============================================================
    # CALLER -> ROUTED BOUNDARY
    # =============================================================

    chunk = add_boundary_distance(

        chunk,

        "CALLER_LATITUDE",

        "CALLER_LONGITUDE",

        "ROUTED_NENA_ID_RESOLVED",

        "CALLER_TO_ROUTED"
    )


    chunk = chunk.rename(
        columns={

            "CALLER_TO_ROUTED_BOUNDARY_M":
                "CALLER_TO_ROUTED_BOUNDARY_M",

            "CALLER_TO_ROUTED_SIGNED_BOUNDARY_M":
                "CALLER_SIGNED_TO_ROUTED_BOUNDARY_M",

            "CALLER_TO_ROUTED_RELATION":
                "CALLER_ROUTED_RELATION",
        }
    )


    # =============================================================
    # CELL -> ROUTED BOUNDARY
    # =============================================================

    chunk = add_boundary_distance(

        chunk,

        "CELL_LATITUDE_USED",

        "CELL_LONGITUDE_USED",

        "ROUTED_NENA_ID_RESOLVED",

        "CELL_TO_ROUTED"
    )


    chunk = chunk.rename(
        columns={

            "CELL_TO_ROUTED_BOUNDARY_M":
                "CELL_TO_ROUTED_BOUNDARY_M",

            "CELL_TO_ROUTED_SIGNED_BOUNDARY_M":
                "CELL_SIGNED_TO_ROUTED_BOUNDARY_M",

            "CELL_TO_ROUTED_RELATION":
                "CELL_ROUTED_RELATION",
        }
    )


    # =============================================================
    # CALLER <-> CELL
    # =============================================================

    chunk[
        "CALLER_TO_CELL_M"
    ] = caller_cell_distance_m(
        chunk
    )


    # =============================================================
    # EARLY DISTANCE FILTER
    #
    # Major performance improvement:
    #
    # expected-PSAP spatial joins run only for retained rows.
    # =============================================================

    keep = apply_candidate_filter(
        chunk
    )


    candidate = (
        chunk.loc[
            keep
        ]
        .copy()
    )


    # Nothing from this chunk passed threshold.
    if candidate.empty:

        print(
            f"Chunk {chunk_number:03d} | "
            f"processed {processed_rows:,} | "
            "candidates 0"
        )

        continue


    # =============================================================
    # EXPECTED PSAP FROM CALLER
    # =============================================================

    candidate = assign_expected_psap(

        candidate,

        "CALLER",

        "CALLER_LATITUDE",

        "CALLER_LONGITUDE"
    )


    # =============================================================
    # EXPECTED PSAP FROM CELL
    # =============================================================

    candidate = assign_expected_psap(

        candidate,

        "CELL",

        "CELL_LATITUDE_USED",

        "CELL_LONGITUDE_USED"
    )


    # =============================================================
    # CALLER -> EXPECTED BOUNDARY
    # =============================================================

    candidate = add_boundary_distance(

        candidate,

        "CALLER_LATITUDE",

        "CALLER_LONGITUDE",

        "CALLER_EXPECTED_NENA_ID",

        "CALLER_TO_EXPECTED"
    )


    candidate = candidate.rename(
        columns={

            "CALLER_TO_EXPECTED_BOUNDARY_M":
                "CALLER_TO_EXPECTED_BOUNDARY_M",

            "CALLER_TO_EXPECTED_SIGNED_BOUNDARY_M":
                "CALLER_SIGNED_TO_EXPECTED_BOUNDARY_M",

            "CALLER_TO_EXPECTED_RELATION":
                "CALLER_EXPECTED_RELATION",
        }
    )


    # =============================================================
    # CELL -> EXPECTED BOUNDARY
    # =============================================================

    candidate = add_boundary_distance(

        candidate,

        "CELL_LATITUDE_USED",

        "CELL_LONGITUDE_USED",

        "CELL_EXPECTED_NENA_ID",

        "CELL_TO_EXPECTED"
    )


    candidate = candidate.rename(
        columns={

            "CELL_TO_EXPECTED_BOUNDARY_M":
                "CELL_TO_EXPECTED_BOUNDARY_M",

            "CELL_TO_EXPECTED_SIGNED_BOUNDARY_M":
                "CELL_SIGNED_TO_EXPECTED_BOUNDARY_M",

            "CELL_TO_EXPECTED_RELATION":
                "CELL_EXPECTED_RELATION",
        }
    )


    # =============================================================
    # EXPECTED VS ROUTED ID COMPARISON
    # =============================================================

    candidate[
        "CALLER_EXPECTED_VS_ROUTED"
    ] = np.where(

        candidate[
            "CALLER_EXPECTED_STATUS"
        ].eq(
            "UNIQUE_PSAP"
        ),

        np.where(

            candidate[
                "CALLER_EXPECTED_NENA_ID"
            ]
            ==
            candidate[
                "ROUTED_NENA_ID_RESOLVED"
            ],

            "SAME",

            "DIFFERENT"
        ),

        candidate[
            "CALLER_EXPECTED_STATUS"
        ]
    )


    candidate[
        "CELL_EXPECTED_VS_ROUTED"
    ] = np.where(

        candidate[
            "CELL_EXPECTED_STATUS"
        ].eq(
            "UNIQUE_PSAP"
        ),

        np.where(

            candidate[
                "CELL_EXPECTED_NENA_ID"
            ]
            ==
            candidate[
                "ROUTED_NENA_ID_RESOLVED"
            ],

            "SAME",

            "DIFFERENT"
        ),

        candidate[
            "CELL_EXPECTED_STATUS"
        ]
    )


    # =============================================================
    # ABNORMAL ROUTING CLASSIFICATION
    # =============================================================

    candidate = add_anomaly_classification(
        candidate
    )


    if ONLY_CALLER_EXPECTED_DIFFERS_ROUTED:

        candidate = candidate.loc[
            candidate[
                "CALLER_EXPECTED_VS_ROUTED"
            ]
            .eq(
                "DIFFERENT"
            )
        ].copy()


    if candidate.empty:

        continue


    anomaly_counter.update(

        candidate[
            "ROUTING_ANALYSIS_CLASS"
        ]
        .value_counts(
            dropna=False
        )
        .to_dict()
    )


    # =============================================================
    # FINAL COLUMN ORDER
    # =============================================================

    important_columns = [

        # ---------------------------------------------------------
        # CALL
        # ---------------------------------------------------------

        "SOURCE_GMLC_ROW_ID",
        "UNIQ911_CID",

        "CALL_BEGIN_TIME_UTC",
        "CALL_END_TIME_UTC",
        "CALL_DURATION_SEC",

        "MARKET",
        "STATE",
        "COUNTY",


        # ---------------------------------------------------------
        # ROUTED GMLC IDENTITY
        # ---------------------------------------------------------

        "GMLC_NENA_ID",
        "GMLC_PSAP_ID",
        "GMLC_FCC_PSAP_ID",

        "GMLC_ROUTED_PSAP_NAME",

        "PSAP_NAME_ESRK",


        # ---------------------------------------------------------
        # RESOLVED ROUTED BOUNDARY
        # ---------------------------------------------------------

        "ROUTED_NENA_ID_RESOLVED",

        "ROUTED_BOUNDARY_PSAP_ID",

        "ROUTED_BOUNDARY_FCC_PSAP_ID",

        "ROUTED_BOUNDARY_PSAP_NAME",

        "ROUTED_BOUNDARY_PSAP_NAME_ESRK",

        "ROUTED_ID_RESOLUTION_METHOD",

        "ROUTED_ID_CONSISTENCY",

        "ROUTED_ID_CONFIDENCE",

        "GMLC_ROUTED_NAME_VS_BOUNDARY_NAME",


        # ---------------------------------------------------------
        # CALLER
        # ---------------------------------------------------------

        "CALLER_LATITUDE",
        "CALLER_LONGITUDE",

        "CALLER_ROUTED_RELATION",

        "CALLER_TO_ROUTED_BOUNDARY_M",

        "CALLER_SIGNED_TO_ROUTED_BOUNDARY_M",


        # ---------------------------------------------------------
        # EXPECTED PSAP FROM CALLER
        # ---------------------------------------------------------

        "CALLER_EXPECTED_STATUS",

        "CALLER_EXPECTED_NENA_ID",

        "CALLER_EXPECTED_PSAP_ID",

        "CALLER_EXPECTED_FCC_PSAP_ID",

        "CALLER_EXPECTED_PSAP_NAME",

        "CALLER_EXPECTED_PSAP_NAME_ESRK",

        "CALLER_EXPECTED_VS_ROUTED",

        "CALLER_TO_EXPECTED_BOUNDARY_M",

        "CALLER_EXPECTED_RELATION",


        # ---------------------------------------------------------
        # ECGI / CELL ENRICHMENT
        # ---------------------------------------------------------

        "SETUP_ECGI_USED",

        "CSSNG_ECGI",

        "CSSNG_ENB_ID",

        "CSSNG_CELL_NUMBER",

        "CSSNG_ONAIR_DATE",

        "CELL_LOCATION_SOURCE",

        "CELL_LATITUDE_USED",

        "CELL_LONGITUDE_USED",


        # ---------------------------------------------------------
        # CELL GEOGRAPHY
        # ---------------------------------------------------------

        "CELL_ROUTED_RELATION",

        "CELL_TO_ROUTED_BOUNDARY_M",

        "CELL_SIGNED_TO_ROUTED_BOUNDARY_M",

        "CALLER_TO_CELL_M",


        # ---------------------------------------------------------
        # EXPECTED PSAP FROM CELL
        # ---------------------------------------------------------

        "CELL_EXPECTED_STATUS",

        "CELL_EXPECTED_NENA_ID",

        "CELL_EXPECTED_PSAP_ID",

        "CELL_EXPECTED_FCC_PSAP_ID",

        "CELL_EXPECTED_PSAP_NAME",

        "CELL_EXPECTED_PSAP_NAME_ESRK",

        "CELL_EXPECTED_VS_ROUTED",

        "CELL_TO_EXPECTED_BOUNDARY_M",

        "CELL_EXPECTED_RELATION",


        # ---------------------------------------------------------
        # FINAL ANOMALY DECISION
        # ---------------------------------------------------------

        "ABNORMAL_ROUTING_FLAG",

        "HIGH_CONFIDENCE_ABNORMAL_FLAG",

        "ROUTING_ANALYSIS_CLASS",


        # ---------------------------------------------------------
        # ROUTING CONTEXT
        # ---------------------------------------------------------

        "ROUTE_STATUS_GMLC",

        "ROUTE_ESZ",

        "ROUTE_ESINET",

        "ROUTE_FALLBACK",

        "DEFAULT_ROUTED_CALL",

        "LBR_ATTEMPTED",

        "LBR_SUCCESS",

        "LBR_PSAP_DIFF",

        "CALL_ANOMALY",

        "COMPLETE_CALL",
    ]


    important_columns = [

        c

        for c
        in important_columns

        if c
        in candidate.columns
    ]


    remaining_columns = [

        c

        for c
        in candidate.columns

        if c
        not in important_columns
        and
        not c.startswith(
            "_"
        )
    ]


    candidate = candidate[
        important_columns
        +
        remaining_columns
    ]


    # =============================================================
    # NUMERIC EXPORT
    # =============================================================

    numeric_suffixes = (

        "_M",
        "_LATITUDE",
        "_LONGITUDE",
    )


    for column in candidate.columns:

        if (
            column.endswith(
                numeric_suffixes
            )
            and
            "_ID" not in column
        ):

            candidate[
                column
            ] = pd.to_numeric(
                candidate[
                    column
                ],
                errors="coerce"
            )


    # =============================================================
    # SAVE
    # =============================================================

    candidate.to_csv(

        OUTPUT_CSV,

        mode=(
            "a"
            if header_written
            else "w"
        ),

        header=(
            not header_written
        ),

        index=False,

        float_format="%.3f"
    )


    header_written = True


    output_rows += len(
        candidate
    )


    print(
        f"Chunk {chunk_number:03d} | "
        f"processed {processed_rows:,} | "
        f"saved candidates {output_rows:,}"
    )


# =====================================================================
# 16. SUMMARIES
# =====================================================================

anomaly_summary = pd.DataFrame(
    [

