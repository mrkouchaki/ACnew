def clean_text(value):

    if value is None or pd.isna(value):
        return ""

    value = str(
        value
    ).strip()

    if value.upper() in {
        "",
        "NAN",
        "NONE",
        "<NA>"
    }:

        return ""

    return value


def norm_id(value):
    """
    Preserve leading zeros.
    """

    value = clean_text(
        value
    )

    if not value:
        return ""

    return re.sub(
        r"\.0$",
        "",
        value
    )


def canonical_id(value):
    """
    Exact numeric identity normalization.

    Examples:

       040500006 -> 40500006
       40500006  -> 40500006

    Non-numeric identifiers remain strings.
    """

    value = norm_id(
        value
    )

    if not value:
        return ""

    if re.fullmatch(
        r"\d+",
        value
    ):

        try:

            return str(
                int(value)
            )

        except Exception:

            pass

    return value.upper()


def canonical_ecgi(value):

    return canonical_id(
        value
    )


def numeric(value):

    value = pd.to_numeric(
        value,
        errors="coerce"
    )

    try:

        value = float(
            value
        )

    except Exception:

        return np.nan

    return (
        value

        if math.isfinite(
            value
        )

        else np.nan
    )


def valid_coordinate(
    lat,
    lon
):

    lat = numeric(
        lat
    )

    lon = numeric(
        lon
    )

    if (
        not np.isfinite(lat)
        or
        not np.isfinite(lon)
    ):

        return False

    if not (
        -90 <= lat <= 90
        and
        -180 <= lon <= 180
    ):

        return False

    # Reject common missing-value coordinate.
    if (
        abs(lat) < 1e-10
        and
        abs(lon) < 1e-10
    ):

        return False

    return True


def repair_geometry(
    geometry
):

    if (
        geometry is None
        or
        geometry.is_empty
    ):

        return None

    try:

        if not geometry.is_valid:

            geometry = (
                geometry.buffer(0)
            )

        if (
            geometry is None
            or
            geometry.is_empty
            or
            not geometry.is_valid
        ):

            return None

        return geometry

    except Exception:

        return None


def first_existing(
    columns,
    candidates,
    required=False
):

    upper_map = {
        str(c).strip().upper():
            c

        for c
        in columns
    }


    for candidate in candidates:

        if candidate.upper() in upper_map:

            return upper_map[
                candidate.upper()
            ]


    if required:

        raise RuntimeError(
            "Missing required column. Tried: "
            + ", ".join(
                candidates
            )
        )

    return None


