    )


    lon2 = pd.to_numeric(
        frame[
            "CELL_LONGITUDE_USED"
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    valid = (

        np.isfinite(
            lat1
        )

        &

        np.isfinite(
            lon1
        )

        &

        np.isfinite(
            lat2
        )

        &

        np.isfinite(
            lon2
        )

        &

        (lat1 >= -90)
        &
        (lat1 <= 90)

        &

        (lat2 >= -90)
        &
        (lat2 <= 90)

        &

        (lon1 >= -180)
        &
        (lon1 <= 180)

        &

        (lon2 >= -180)
        &
        (lon2 <= 180)
    )


    output = np.full(
        len(frame),
        np.nan
    )


    if valid.any():

        _, _, meters = GEOD.inv(

            lon1[
                valid
            ],

            lat1[
                valid
            ],

            lon2[
                valid
            ],

            lat2[
                valid
            ]
        )


        output[
            valid
        ] = np.abs(
            np.asarray(
                meters,
                dtype=float
            )
        )


    return output


