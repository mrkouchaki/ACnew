def normalize_name(
    value
):

    value = clean_text(
        value
    ).upper()

    if not value:

        return ""

    value = re.sub(
        r"\b9[\s\-]*1[\s\-]*1\b",
        "911",
        value
    )

    value = value.replace(
        "&",
        " AND "
    )

    value = re.sub(
        r"[^A-Z0-9]+",
        " ",
        value
    )

    value = re.sub(
        r"\s+",
        " ",
        value
    ).strip()

    # Remove only terminal facility/site number.
    value = re.sub(
        r"\s+\d{3,6}$",
        "",
        value
    )

    return value.strip()


def name_qa(
    gmlc_name,
    boundary_name
):

    g = normalize_name(
        gmlc_name
    )

    b = normalize_name(
        boundary_name
    )


    if not g:

        return (
            "GMLC_NAME_MISSING"
        )

    if not b:

        return (
            "BOUNDARY_NAME_MISSING"
        )

    if g == b:

        return (
            "SAME_NORMALIZED"
        )

    return (
        "DIFFERENT"
    )


