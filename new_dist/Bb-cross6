def add_anomaly_classification(
    frame
):

    routed_resolved = (
        frame[
            "ROUTED_NENA_ID_RESOLVED"
        ].ne("")
    )


    caller_unique = (
        frame[
            "CALLER_EXPECTED_STATUS"
        ].eq(
            "UNIQUE_PSAP"
        )
    )


    cell_unique = (
        frame[
            "CELL_EXPECTED_STATUS"
        ].eq(
            "UNIQUE_PSAP"
        )
    )


    caller_same = (

        caller_unique

        &

        (
            frame[
                "CALLER_EXPECTED_NENA_ID"
            ]
            ==
            frame[
                "ROUTED_NENA_ID_RESOLVED"
            ]
        )
    )


    caller_diff = (

        caller_unique

        &

        (
            frame[
                "CALLER_EXPECTED_NENA_ID"
            ]
            !=
            frame[
                "ROUTED_NENA_ID_RESOLVED"
            ]
        )
    )


    cell_same_routed = (

        cell_unique

        &

        (
            frame[
                "CELL_EXPECTED_NENA_ID"
            ]
            ==
            frame[
                "ROUTED_NENA_ID_RESOLVED"
            ]
        )
    )


    cell_same_caller_expected = (

        cell_unique

        &

        caller_unique

        &

        (
            frame[
                "CELL_EXPECTED_NENA_ID"
            ]
            ==
            frame[
                "CALLER_EXPECTED_NENA_ID"
            ]
        )
    )


    caller_outside = (
        frame[
            "CALLER_ROUTED_RELATION"
        ].eq(
            "OUTSIDE"
        )
    )


    high_confidence = (

        routed_resolved

        &

        caller_diff

        &

        caller_outside

        &

        cell_same_caller_expected
    )


    abnormal = (

        routed_resolved

        &

        caller_diff

        &

        caller_outside
    )


    frame[
        "ABNORMAL_ROUTING_FLAG"
    ] = abnormal


    frame[
        "HIGH_CONFIDENCE_ABNORMAL_FLAG"
    ] = high_confidence


    conditions = [

        ~routed_resolved,

        caller_same,

        high_confidence,

        (
            abnormal
            &
            cell_same_routed
        ),

        abnormal,

        (
            routed_resolved
            &
            ~caller_unique
        ),
    ]


    choices = [

        "UNRESOLVED_ROUTED_PSAP",

        "CALLER_EXPECTED_EQUALS_ROUTED",

        "HIGH_CONFIDENCE_CALLER_CELL_EXPECTED_DIFFERS_ROUTED",

        "CALLER_DIFFERS_CELL_SUPPORTS_ROUTED",

        "CALLER_EXPECTED_DIFFERS_ROUTED",

        "CALLER_EXPECTED_UNRESOLVED",
    ]


    frame[
        "ROUTING_ANALYSIS_CLASS"
    ] = np.select(

        conditions,

        choices,

        default=
            "GEOGRAPHIC_QA_OTHER"
    )


    return frame


