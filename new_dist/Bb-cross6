):

    n = len(
        frame
    )


    expected_nena = np.full(
        n,
        "",
        dtype=object
    )


    expected_psap = np.full(
        n,
        "",
        dtype=object
    )


    expected_fcc = np.full(
        n,
        "",
        dtype=object
    )


    expected_name = np.full(
        n,
        "",
        dtype=object
    )


    expected_name_esrk = np.full(
        n,
        "",
        dtype=object
    )


    status = np.full(
        n,
        "INVALID_OR_MISSING_COORDINATE",
        dtype=object
    )


    lat = pd.to_numeric(
        frame[
            lat_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    lon = pd.to_numeric(
        frame[
            lon_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    valid = (

        np.isfinite(
            lat
        )

        &

        np.isfinite(
            lon
        )

        &

        (lat >= -90)
        &
        (lat <= 90)

        &

        (lon >= -180)
        &
        (lon <= 180)

        &

        ~(
            np.isclose(
                lat,
                0
            )
            &
            np.isclose(
                lon,
                0
            )
        )
    )


    valid_positions = np.flatnonzero(
        valid
    )


    if len(
        valid_positions
    ) == 0:

        frame[
            f"{prefix}_EXPECTED_NENA_ID"
        ] = expected_nena

        frame[
            f"{prefix}_EXPECTED_PSAP_ID"
        ] = expected_psap

        frame[
            f"{prefix}_EXPECTED_FCC_PSAP_ID"
        ] = expected_fcc

        frame[
            f"{prefix}_EXPECTED_PSAP_NAME"
        ] = expected_name

        frame[
            f"{prefix}_EXPECTED_PSAP_NAME_ESRK"
        ] = expected_name_esrk

        frame[
            f"{prefix}_EXPECTED_STATUS"
        ] = status

        return frame


    # -------------------------------------------------------------
    # Deduplicate coordinates for faster sjoin.
    # -------------------------------------------------------------

    unique_points = (

        pd.DataFrame(
            {

                "_LAT":
                    lat[
                        valid
                    ],

                "_LON":
                    lon[
                        valid
                    ],
            }
        )

        .drop_duplicates()

        .reset_index(
            drop=True
        )
    )


    unique_points[
        "_POINT_ID"
    ] = np.arange(
        len(
            unique_points
        )
    )


    point_gdf = gpd.GeoDataFrame(

        unique_points,

        geometry=gpd.points_from_xy(

            unique_points[
                "_LON"
            ],

            unique_points[
                "_LAT"
            ]
        ),

        crs="EPSG:4326"
    )


    joined = gpd.sjoin(

        point_gdf,

        boundary_geo[
            [
                "_NENA",
                "geometry"
            ]
        ],

        how="left",

        predicate="intersects"
    )


    point_result = {}


    for point_id, group in joined.groupby(
        "_POINT_ID",
        sort=False
    ):

        ids = sorted(
            {

                clean_text(
                    x
                )

                for x
                in group[
                    "_NENA"
                ]

                if clean_text(
                    x
                )
            }
        )


        if len(
            ids
        ) == 1:

            nena = ids[0]

            meta = (
                meta_by_nena.get(
                    nena,
                    {}
                )
            )


            result = {

                "NENA":
                    nena,

                "PSAP":
                    meta.get(
                        "_PSAP",
                        ""
                    ),

                "FCC":
                    meta.get(
                        "_FCC",
                        ""
                    ),

                "NAME":
                    meta.get(
                        "_PSAP_NAME",
                        ""
                    ),

                "NAME_ESRK":
                    meta.get(
                        "_PSAP_NAME_ESRK",
                        ""
                    ),

                "STATUS":
                    "UNIQUE_PSAP",
            }


        elif len(
            ids
        ) == 0:

            result = {

                "NENA":
                    "",

                "PSAP":
                    "",

                "FCC":
                    "",

                "NAME":
                    "",

                "NAME_ESRK":
                    "",

                "STATUS":
                    "NO_CONTAINING_PSAP",
            }


        else:

            result = {

                "NENA":
                    "|".join(
                        ids
                    ),

                "PSAP":
                    "",

                "FCC":
                    "",

                "NAME":
                    "",

                "NAME_ESRK":
                    "",

                "STATUS":
                    "MULTIPLE_PSAP",
            }


        point_row = (
            unique_points.loc[
                int(
                    point_id
                )
            ]
        )


        point_result[
            (
                float(
                    point_row[
                        "_LAT"
                    ]
                ),

                float(
                    point_row[
                        "_LON"
                    ]
                )
            )
        ] = result


    for position in valid_positions:

        result = (
            point_result.get(
                (
                    float(
                        lat[
                            position
                        ]
                    ),

                    float(
                        lon[
                            position
                        ]
                    )
                )
            )
        )


        if result is None:

            continue


        expected_nena[
            position
        ] = result[
            "NENA"
        ]


        expected_psap[
            position
        ] = result[
            "PSAP"
        ]


        expected_fcc[
            position
        ] = result[
            "FCC"
        ]


        expected_name[
            position
        ] = result[
            "NAME"
        ]


        expected_name_esrk[
            position
        ] = result[
            "NAME_ESRK"
        ]


        status[
            position
        ] = result[
            "STATUS"
        ]


    frame[
        f"{prefix}_EXPECTED_NENA_ID"
    ] = expected_nena


    frame[
        f"{prefix}_EXPECTED_PSAP_ID"
    ] = expected_psap


    frame[
        f"{prefix}_EXPECTED_FCC_PSAP_ID"
    ] = expected_fcc


    frame[
        f"{prefix}_EXPECTED_PSAP_NAME"
    ] = expected_name


    frame[
        f"{prefix}_EXPECTED_PSAP_NAME_ESRK"
    ] = expected_name_esrk


    frame[
        f"{prefix}_EXPECTED_STATUS"
    ] = status


    return frame


