def metric_range_mask(
    values,
    relation,
    minimum,
    maximum
):

    enabled = (
        minimum is not None
        or
        maximum is not None
    )


    if not enabled:

        return None


    values = pd.to_numeric(
        values,
        errors="coerce"
    )


    mask = (
        values.notna()
        &
        relation.eq(
            "OUTSIDE"
        )
    )


    if minimum is not None:

        mask &= (
            values
            >=
            float(
                minimum
            )
        )


    if maximum is not None:

        mask &= (
            values
            <=
            float(
                maximum
            )
        )


    return mask


def apply_candidate_filter(
    frame
):

    caller_mask = metric_range_mask(

        frame[
            "CALLER_TO_ROUTED_BOUNDARY_M"
        ],

        frame[
            "CALLER_ROUTED_RELATION"
        ],

        MIN_CALLER_OUTSIDE_ROUTED_M,

        MAX_CALLER_OUTSIDE_ROUTED_M
    )


    cell_mask = metric_range_mask(

        frame[
            "CELL_TO_ROUTED_BOUNDARY_M"
        ],

        frame[
            "CELL_ROUTED_RELATION"
        ],

        MIN_CELL_OUTSIDE_ROUTED_M,

        MAX_CELL_OUTSIDE_ROUTED_M
    )


    masks = [

        mask

        for mask
        in [
            caller_mask,
            cell_mask
        ]

        if mask is not None
    ]


    # No filters enabled.
    if not masks:

        return pd.Series(
            True,
            index=frame.index
        )


    if len(
        masks
    ) == 1:

        return masks[0]


    if FILTER_MODE.upper() == "OR":

        return (
            masks[0]
            |
            masks[1]
        )


    if FILTER_MODE.upper() == "AND":

        return (
            masks[0]
            &
            masks[1]
        )


    raise ValueError(
        "FILTER_MODE must be OR or AND."
    )


