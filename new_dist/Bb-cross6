route_cache = {}


def resolve_routed_boundary(
    gmlc_nena,
    gmlc_psap,
    gmlc_fcc
):

    nena = canonical_id(
        gmlc_nena
    )

    psap = canonical_id(
        gmlc_psap
    )

    fcc = canonical_id(
        gmlc_fcc
    )


    key = (
        nena,
        psap,
        fcc
    )


    if key in route_cache:

        return route_cache[
            key
        ]


    nena_candidates = (

        {
            nena
        }

        if (
            nena
            and
            nena
            in boundary_nena_ids
        )

        else set()
    )


    psap_candidates = set(
        psap_to_nena.get(
            psap,
            set()
        )
    )


    fcc_candidates = set(
        fcc_to_nena.get(
            fcc,
            set()
        )
    )


    # -------------------------------------------------------------
    # PRIMARY: actual GMLC NENA_ID
    # -------------------------------------------------------------

    if len(
        nena_candidates
    ) == 1:

        chosen = nena


        psap_ok = (

            True

            if not psap_candidates

            else chosen
            in psap_candidates
        )


        fcc_ok = (

            True

            if not fcc_candidates

            else chosen
            in fcc_candidates
        )


        if (
            psap_ok
            and
            fcc_ok
        ):

            method = (
                "NENA_EXACT_IDS_CONSISTENT"
            )

            consistency = (
                "CONSISTENT"
            )

            confidence = (
                "HIGH"
            )


        else:

            method = (
                "NENA_EXACT_WITH_ID_CONFLICT"
            )


            conflicts = []


            if not psap_ok:

                conflicts.append(
                    "PSAP_ID"
                )


            if not fcc_ok:

                conflicts.append(
                    "FCC_PSAP_ID"
                )


            consistency = (
                "CONFLICT_"
                +
                "_".join(
                    conflicts
                )
            )

            confidence = (
                "HIGH_WITH_ID_CONFLICT"
            )


    else:

        # ---------------------------------------------------------
        # PSAP + FCC intersection
        # ---------------------------------------------------------

        intersection = (
            psap_candidates
            &
            fcc_candidates
        )


        if len(
            intersection
        ) == 1:

            chosen = next(
                iter(
                    intersection
                )
            )

            method = (
                "PSAP_AND_FCC_EXACT"
            )

            consistency = (
                "CONSISTENT"
            )

            confidence = (
                "HIGH"
            )


        # ---------------------------------------------------------
        # Unique PSAP_ID
        # ---------------------------------------------------------

        elif len(
            psap_candidates
        ) == 1:

            chosen = next(
                iter(
                    psap_candidates
                )
            )


            if (
                not fcc_candidates

                or

                chosen
                in fcc_candidates
            ):

                method = (
                    "PSAP_ID_UNIQUE"
                )

                consistency = (
                    "CONSISTENT"
                )

                confidence = (
                    "MEDIUM_HIGH"
                )


            else:

                chosen = ""

                method = (
                    "PSAP_FCC_CONFLICT_UNRESOLVED"
                )

                consistency = (
                    "PSAP_FCC_CONFLICT"
                )

                confidence = (
                    "UNRESOLVED"
                )


        # ---------------------------------------------------------
        # PSAP_ID may be NENA without zero padding.
        #
        # Accept ONLY when FCC also supports it.
        # ---------------------------------------------------------

        elif (
            psap
            and
            psap
            in boundary_nena_ids
            and
            (
                not fcc_candidates
                or
                psap
                in fcc_candidates
            )
        ):

            chosen = psap

            method = (
                "PSAP_CANONICAL_TO_NENA"
            )

            consistency = (
                "CONSISTENT"
            )

            confidence = (
                "MEDIUM_HIGH"
            )


        # ---------------------------------------------------------
        # FCC alone only if it resolves to exactly one boundary.
        # ---------------------------------------------------------

        elif len(
            fcc_candidates
        ) == 1:

            chosen = next(
                iter(
                    fcc_candidates
                )
            )

            method = (
                "FCC_ID_UNIQUE_ONLY"
            )

            consistency = (
                "FCC_ONLY"
            )

            confidence = (
                "MEDIUM"
            )


        else:

            chosen = ""

            method = (
                "UNRESOLVED"
            )

            consistency = (
                "UNRESOLVED"
            )

            confidence = (
                "UNRESOLVED"
            )


    metadata = (
        meta_by_nena.get(
            chosen,
            {}
        )

        if chosen

        else {}
    )


    result = {

        "ROUTED_NENA_ID_RESOLVED":
            chosen,

        "ROUTED_BOUNDARY_PSAP_ID":
            metadata.get(
                "_PSAP",
                ""
            ),

        "ROUTED_BOUNDARY_FCC_PSAP_ID":
            metadata.get(
                "_FCC",
                ""
            ),

        "ROUTED_BOUNDARY_PSAP_NAME":
            metadata.get(
                "_PSAP_NAME",
                ""
            ),

        "ROUTED_BOUNDARY_PSAP_NAME_ESRK":
            metadata.get(
                "_PSAP_NAME_ESRK",
                ""
            ),

        "ROUTED_ID_RESOLUTION_METHOD":
            method,

        "ROUTED_ID_CONSISTENCY":
            consistency,

        "ROUTED_ID_CONFIDENCE":
            confidence,
    }


    route_cache[
        key
    ] = result


    return result


