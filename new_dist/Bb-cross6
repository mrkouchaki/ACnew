def add_boundary_distance(
    frame,
    lat_col,
    lon_col,
    nena_col,
    output_prefix
):

    n = len(
        frame
    )


    lat = pd.to_numeric(
        frame[
            lat_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    lon = pd.to_numeric(
        frame[
            lon_col
        ],
        errors="coerce"
    ).to_numpy(
        dtype=float
    )


    ids = (
        frame[
            nena_col
        ]
        .fillna("")
        .astype(str)
        .to_numpy()
    )


    distance = np.full(
        n,
        np.nan
    )


    signed = np.full(
        n,
        np.nan
    )


    relation = np.full(
        n,
        "INVALID_OR_MISSING_COORDINATE",
        dtype=object
    )


    valid = (

        np.isfinite(
            lat
        )

        &

        np.isfinite(
            lon
        )

        &

        (lat >= -90)
        &
        (lat <= 90)

        &

        (lon >= -180)
        &
        (lon <= 180)

        &

        ~(
            np.isclose(
                lat,
                0
            )
            &
            np.isclose(
                lon,
                0
            )
        )
    )


    relation[
        valid
    ] = (
        "UNRESOLVED_BOUNDARY"
    )


    for nena in pd.unique(
        ids[
            valid
            &
            (ids != "")
        ]
    ):

        geometry = (
            boundary_by_nena.get(
                canonical_id(
                    nena
                )
            )
        )


        if geometry is None:

            continue


        idx = np.flatnonzero(

            valid

            &

            (
                ids
                ==
                nena
            )
        )


        if len(
            idx
        ) == 0:

            continue


        if HAS_VECTOR_SHAPELY:

            points = shapely.points(

                lon[
                    idx
                ],

                lat[
                    idx
                ]
            )


            shortest = shapely.shortest_line(

                points,

                geometry.boundary
            )


            near = shapely.get_point(
                shortest,
                1
            )


            near_lon = np.asarray(
                shapely.get_x(
                    near
                ),
                dtype=float
            )


            near_lat = np.asarray(
                shapely.get_y(
                    near
                ),
                dtype=float
            )


            _, _, meters = GEOD.inv(

                lon[
                    idx
                ],

                lat[
                    idx
                ],

                near_lon,

                near_lat
            )


            meters = np.abs(
                np.asarray(
                    meters,
                    dtype=float
                )
            )


            inside = np.asarray(
                shapely.covers(
                    geometry,
                    points
                ),
                dtype=bool
            )


            distance[
                idx
            ] = meters


            signed[
                idx
            ] = np.where(

                inside,

                -meters,

                meters
            )


            boundary_mask = (
                meters <= 0.01
            )


            signed[
                idx[
                    boundary_mask
                ]
            ] = 0.0


            relation[
                idx
            ] = np.where(

                boundary_mask,

                "BOUNDARY",

                np.where(

                    inside,

                    "INSIDE",

                    "OUTSIDE"
                )
            )


        else:

            # Compatibility fallback.
            for position in idx:

                point = Point(
                    lon[
                        position
                    ],
                    lat[
                        position
                    ]
                )


                try:

                    _, near = nearest_points(
                        point,
                        geometry.boundary
                    )


                    _, _, meters = GEOD.inv(

                        lon[
                            position
                        ],

                        lat[
                            position
                        ],

                        near.x,

                        near.y
                    )


                    meters = abs(
                        float(
                            meters
                        )
                    )


                    distance[
                        position
                    ] = meters


                    if (
                        meters
                        <=
                        0.01
                    ):

                        signed[
                            position
                        ] = 0.0

                        relation[
                            position
                        ] = "BOUNDARY"


                    elif geometry.covers(
                        point
                    ):

                        signed[
                            position
                        ] = (
                            -meters
                        )

                        relation[
                            position
                        ] = "INSIDE"


                    else:

                        signed[
                            position
                        ] = meters

                        relation[
                            position
                        ] = "OUTSIDE"


                except Exception:

                    relation[
                        position
                    ] = (
                        "DISTANCE_ERROR"
                    )


    frame[
        f"{output_prefix}_BOUNDARY_M"
    ] = distance


    frame[
        f"{output_prefix}_SIGNED_BOUNDARY_M"
    ] = signed


    frame[
        f"{output_prefix}_RELATION"
    ] = relation


    return frame


